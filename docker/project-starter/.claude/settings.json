{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf .)",
      "Bash(*> .env*)",
      "Bash(*cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git reset --hard*)",
      "Bash(git stash*)",
      "Bash(*--no-verify*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "bkit@bkit-marketplace": true
  },
  "extraKnownMarketplaces": {
    "bkit-marketplace": {
      "source": {
        "source": "github",
        "repo": "popup-studio-ai/bkit-claude-code"
      },
      "autoUpdate": false
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-scan.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-turn.sh"
          }
        ]
      }
    ]
  }
}
