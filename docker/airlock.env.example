# Airlock container env — copy to docker/airlock.env and fill in.
# docker/airlock.env is gitignored: it holds a secret (TS_AUTHKEY). Never commit it.

# Tailscale auth key (reusable/ephemeral). Generate at:
#   https://login.tailscale.com/admin/settings/keys
# Leave blank to authenticate interactively instead (the first-boot log prints
# what to run). The key is a SECRET — do not paste it anywhere but this file.
TS_AUTHKEY=

# Hostname this node registers as on your tailnet (=> https://<name>.<tailnet>.ts.net/).
TS_HOSTNAME=airlock

# Set true only if the host has no /dev/net/tun (then also drop the tun device
# mapping in docker-compose.yml). OrbStack provides /dev/net/tun, so leave false.
# TS_USERSPACE=false

# Timezone for logs/timers.
TZ=Asia/Seoul
