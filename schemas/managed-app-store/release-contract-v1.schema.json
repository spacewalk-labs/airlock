{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airlock.local/schemas/managed-app-store/release-contract-v1.schema.json",
  "title": "Airlock managed app release contract v1",
  "description": "Closed wire schemas for release inputs, signed authority, immutable snapshots, and promotion receipts. Consumers select one $defs entry for each named artifact.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "capabilityList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apps", "channel_id", "organization_id", "schema"],
      "properties": {
        "schema": {"const": "airlock.managed.catalog/v1"},
        "organization_id": {"$ref": "#/$defs/id"},
        "channel_id": {"$ref": "#/$defs/id"},
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["compatibility", "id", "metadata", "policy", "source_label"],
            "properties": {
              "id": {"$ref": "#/$defs/appId"},
              "source_label": {"type": "string", "minLength": 1},
              "policy": {"enum": ["available", "blocked", "required"]},
              "compatibility": {
                "type": "object",
                "additionalProperties": false,
                "required": ["platforms", "profiles"],
                "properties": {
                  "platforms": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
                  "profiles": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
                }
              },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "releaseLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "core", "organization_id", "packages", "schema", "target_profile"],
      "properties": {
        "schema": {"const": "airlock.managed.release-lock/v1"},
        "organization_id": {"$ref": "#/$defs/id"},
        "channel_id": {"$ref": "#/$defs/id"},
        "target_profile": {"$ref": "#/$defs/id"},
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "revision"],
          "properties": {
            "digest": {"$ref": "#/$defs/digest"},
            "revision": {"$ref": "#/$defs/gitRevision"}
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capabilities", "data_compatibility", "deactivator", "digest", "id", "path"],
            "properties": {
              "id": {"$ref": "#/$defs/appId"},
              "path": {"type": "string", "pattern": "^packages/[a-z0-9][a-z0-9-]{0,31}$"},
              "digest": {"$ref": "#/$defs/digest"},
              "capabilities": {"$ref": "#/$defs/capabilityList"},
              "data_compatibility": {"enum": ["backward-compatible-data", "maintenance-required", "stateless"]},
              "deactivator": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci", "created_at", "publisher_id", "reviewed_revision", "reviewed_tree_digest", "schema", "source_repository"],
      "properties": {
        "schema": {"const": "airlock.managed.provenance/v1"},
        "reviewed_revision": {"$ref": "#/$defs/gitRevision"},
        "reviewed_tree_digest": {"$ref": "#/$defs/digest"},
        "publisher_id": {"$ref": "#/$defs/id"},
        "source_repository": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_digest", "result"],
          "properties": {
            "result": {"const": "passed"},
            "evidence_digest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "channel_id", "created_at", "epoch", "organization_id", "publisher_id", "requested_capabilities", "schema", "sequence", "target_profile"],
      "properties": {
        "schema": {"const": "airlock.managed.snapshot/v1"},
        "organization_id": {"$ref": "#/$defs/id"},
        "channel_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "target_profile": {"$ref": "#/$defs/id"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "publisher_id": {"$ref": "#/$defs/id"},
        "requested_capabilities": {"$ref": "#/$defs/capabilityList"},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle.tar", "catalog.json", "packages", "provenance.json", "release.lock"],
          "properties": {
            "bundle.tar": {"$ref": "#/$defs/digest"},
            "catalog.json": {"$ref": "#/$defs/digest"},
            "packages": {"$ref": "#/$defs/digest"},
            "provenance.json": {"$ref": "#/$defs/digest"},
            "release.lock": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "publisher_id", "schema", "signature", "snapshot_digest"],
      "properties": {
        "schema": {"const": "airlock.managed.signature/v1"},
        "algorithm": {"const": "ed25519"},
        "key_id": {"$ref": "#/$defs/digest"},
        "publisher_id": {"$ref": "#/$defs/id"},
        "snapshot_digest": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "contentEncoding": "base64"}
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "issued_at", "organization_id", "publishers", "root_key_id", "root_signature", "schema", "sequence"],
      "properties": {
        "schema": {"const": "airlock.managed.membership/v1"},
        "organization_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "root_key_id": {"$ref": "#/$defs/digest"},
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_id", "epoch"],
            "properties": {
              "channel_id": {"$ref": "#/$defs/id"},
              "epoch": {"type": "integer", "minimum": 1}
            }
          }
        },
        "publishers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability_ceiling", "key_id", "not_after", "not_before", "public_key_der", "publisher_id", "status"],
            "properties": {
              "publisher_id": {"$ref": "#/$defs/id"},
              "key_id": {"$ref": "#/$defs/digest"},
              "public_key_der": {"type": "string", "contentEncoding": "base64"},
              "status": {"enum": ["active", "revoked"]},
              "capability_ceiling": {"$ref": "#/$defs/capabilityList"},
              "not_before": {"$ref": "#/$defs/timestamp"},
              "not_after": {"$ref": "#/$defs/timestamp"}
            }
          }
        },
        "root_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "signature"],
          "properties": {
            "algorithm": {"const": "ed25519"},
            "signature": {"type": "string", "contentEncoding": "base64"}
          }
        }
      }
    },
    "promotionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_digest", "channel_id", "epoch", "membership_digest", "organization_id", "previous_snapshot_digest", "promoted_at", "publisher_id", "publisher_key_id", "receipt_id", "schema", "sequence", "snapshot_digest"],
      "properties": {
        "schema": {"const": "airlock.managed.promotion-receipt/v1"},
        "organization_id": {"$ref": "#/$defs/id"},
        "channel_id": {"$ref": "#/$defs/id"},
        "epoch": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "snapshot_digest": {"$ref": "#/$defs/digest"},
        "bundle_digest": {"$ref": "#/$defs/digest"},
        "publisher_id": {"$ref": "#/$defs/id"},
        "publisher_key_id": {"$ref": "#/$defs/digest"},
        "membership_digest": {"$ref": "#/$defs/digest"},
        "previous_snapshot_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "promoted_at": {"$ref": "#/$defs/timestamp"},
        "receipt_id": {"$ref": "#/$defs/digest"}
      }
    },
    "releaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "membership_floors", "schema"],
      "properties": {
        "schema": {"const": "airlock.managed.release-state/v1"},
        "membership_floors": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["membership_digest", "sequence"],
            "properties": {
              "membership_digest": {"$ref": "#/$defs/digest"},
              "sequence": {"type": "integer", "minimum": 1}
            }
          }
        },
        "channels": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["epoch", "receipt_digest", "sequence", "snapshot_digest"],
            "properties": {
              "epoch": {"type": "integer", "minimum": 1},
              "sequence": {"type": "integer", "minimum": 1},
              "snapshot_digest": {"$ref": "#/$defs/digest"},
              "receipt_digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/catalog"},
    {"$ref": "#/$defs/releaseLock"},
    {"$ref": "#/$defs/provenance"},
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/signature"},
    {"$ref": "#/$defs/membership"},
    {"$ref": "#/$defs/promotionReceipt"},
    {"$ref": "#/$defs/releaseState"}
  ]
}
