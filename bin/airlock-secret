#!/usr/bin/env python3
"""Platform-owned, short-lived secret drop.

Secret values enter through stdin only.  stdout is a bounded JSON metadata contract and
stderr never includes a value, argv, filename, or exception message.  The stable store
path intentionally remains ~/.devterm-secrets: changing the ownership of the lifetime is
this change; changing agent tokens, habits, and scrollback references is a separate one.
"""

import contextlib
import fcntl
import json
import math
import os
import re
import stat
import sys
import time


STORE = os.path.expanduser("~/.devterm-secrets")
TTL_SEC = 30 * 60
MAX_BYTES = 64 * 1024
MAX_INPUT_BYTES = MAX_BYTES * 2 + 1  # CRLF can be twice the normalized LF size.
MAX_FILES = 64
NAME_RE = re.compile(r"^(?!\.)[A-Za-z0-9._-]{1,48}\Z")
LOCK_NAME = ".airlock-secret.lock"


class SecretError(Exception):
    def __init__(self, code, public_message):
        super().__init__(code)
        self.code = code
        self.public_message = public_message


def _ttl_sec():
    """Test seam only; production units deliberately set no app-owned TTL."""
    raw = os.environ.get("AIRLOCK_SECRET_TTL_SEC")
    if raw is None:
        return TTL_SEC
    try:
        value = int(raw)
    except ValueError as exc:
        raise SecretError("configuration", "secret configuration failed") from exc
    if value < 1:
        raise SecretError("configuration", "secret configuration failed")
    return value


def _valid_name(name):
    return isinstance(name, str) and NAME_RE.fullmatch(name) is not None


def _path(name):
    return "~/.devterm-secrets/" + name + ".txt"


def _open_store(create):
    if create:
        try:
            os.mkdir(STORE, 0o700)
        except FileExistsError:
            pass
        except OSError as exc:
            raise SecretError("storage", "secret storage failed") from exc
    try:
        directory = os.open(STORE, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    except OSError as exc:
        # O_NOFOLLOW is the refusal: never chmod, list, or write through a store symlink.
        raise SecretError("storage", "secret storage failed") from exc
    try:
        os.fchmod(directory, 0o700)
    except OSError as exc:
        os.close(directory)
        raise SecretError("storage", "secret storage failed") from exc
    return directory


@contextlib.contextmanager
def _locked_store(create=False):
    directory = _open_store(create)
    if directory is None:
        yield None
        return
    lock_fd = None
    try:
        try:
            lock_fd = os.open(
                LOCK_NAME,
                os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory,
            )
            if not stat.S_ISREG(os.fstat(lock_fd).st_mode):
                raise OSError("lock is not a regular file")
            os.fchmod(lock_fd, 0o600)
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
        except OSError as exc:
            raise SecretError("storage", "secret storage failed") from exc
        yield directory
    finally:
        if lock_fd is not None:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
            os.close(lock_fd)
        os.close(directory)


def _entry_stat(directory, name):
    try:
        return os.stat(name, dir_fd=directory, follow_symlinks=False)
    except FileNotFoundError:
        return None


def _unlink(directory, name):
    os.unlink(name, dir_fd=directory)


def _sweep_locked(directory, now=None):
    now = time.time() if now is None else now
    cutoff = now - _ttl_sec()
    removed = 0
    try:
        names = os.listdir(directory)
    except OSError as exc:
        raise SecretError("storage", "secret storage failed") from exc
    for filename in names:
        if filename.endswith(".tmp"):
            try:
                entry = _entry_stat(directory, filename)
                if entry is not None and (stat.S_ISREG(entry.st_mode) or stat.S_ISLNK(entry.st_mode)):
                    _unlink(directory, filename)
                    removed += 1
            except FileNotFoundError:
                pass
            except OSError as exc:
                raise SecretError("storage", "secret storage failed") from exc
            continue
        if not filename.endswith(".txt"):
            continue
        name = filename[:-4]
        if not _valid_name(name):
            continue
        try:
            entry = _entry_stat(directory, filename)
            if entry is not None and stat.S_ISREG(entry.st_mode) and entry.st_mtime < cutoff:
                _unlink(directory, filename)
                removed += 1
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise SecretError("storage", "secret storage failed") from exc
    if removed:
        try:
            os.fsync(directory)
        except OSError as exc:
            raise SecretError("storage", "secret storage failed") from exc
    return removed


def _normalize(raw):
    if len(raw) > MAX_INPUT_BYTES:
        raise SecretError("too_large", "value too large")
    try:
        value = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise SecretError("invalid_value", "value not encodable") from exc
    value = value.replace("\r\n", "\n").replace("\r", "\n").strip()
    if not value:
        raise SecretError("invalid_value", "value required")
    normalized = (value + "\n").encode("utf-8")
    if len(normalized) > MAX_BYTES:
        raise SecretError("too_large", "value too large")
    return normalized


def _put(name, raw):
    if not _valid_name(name):
        raise SecretError("invalid_name", "invalid name")
    normalized = _normalize(raw)
    final = name + ".txt"
    with _locked_store(create=True) as directory:
        _sweep_locked(directory)
        existing = _entry_stat(directory, final)
        if existing is not None and not stat.S_ISREG(existing.st_mode):
            # Replacing a symlink would not follow it, but refusing it makes the boundary
            # explicit and keeps every path operation on regular files only.
            raise SecretError("storage", "secret storage failed")
        current = 0
        now = time.time()
        for filename in os.listdir(directory):
            if not filename.endswith(".txt") or not _valid_name(filename[:-4]):
                continue
            entry = _entry_stat(directory, filename)
            if entry is not None and stat.S_ISREG(entry.st_mode) \
                    and entry.st_mtime + _ttl_sec() > now:
                current += 1
        if current >= MAX_FILES and existing is None:
            raise SecretError("limit", "secret limit reached")

        suffix = os.urandom(6).hex()
        tmp = "." + name + "." + str(os.getpid()) + "." + suffix + ".tmp"
        fd = None
        created = False
        try:
            fd = os.open(
                tmp,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory,
            )
            created = True
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "wb") as stream:
                fd = None
                stream.write(normalized)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(tmp, final, src_dir_fd=directory, dst_dir_fd=directory)
            created = False
            os.fsync(directory)
        except OSError as exc:
            if fd is not None:
                os.close(fd)
            if created:
                try:
                    _unlink(directory, tmp)
                except OSError:
                    pass
            raise SecretError("storage", "secret storage failed") from exc
        entry = _entry_stat(directory, final)
        remain = max(0, math.ceil(entry.st_mtime + _ttl_sec() - time.time()))
    return {"ok": True, "name": name, "path": _path(name),
            "ttl_sec": _ttl_sec(), "remain_sec": remain}


def _list():
    with _locked_store(create=False) as directory:
        if directory is None:
            return {"ok": True, "secrets": [], "ttl_sec": _ttl_sec()}
        _sweep_locked(directory)
        now = time.time()
        items = []
        try:
            filenames = os.listdir(directory)
        except OSError as exc:
            raise SecretError("storage", "secret storage failed") from exc
        for filename in filenames:
            if not filename.endswith(".txt") or not _valid_name(filename[:-4]):
                continue
            entry = _entry_stat(directory, filename)
            if entry is None or not stat.S_ISREG(entry.st_mode):
                continue
            remain = max(0, math.ceil(entry.st_mtime + _ttl_sec() - now))
            if remain <= 0:
                continue
            items.append({"name": filename[:-4], "path": _path(filename[:-4]),
                          "bytes": entry.st_size, "remain_sec": remain})
        items.sort(key=lambda item: item["name"])
        return {"ok": True, "secrets": items, "ttl_sec": _ttl_sec()}


def _delete(name):
    if not _valid_name(name):
        raise SecretError("invalid_name", "invalid name")
    with _locked_store(create=False) as directory:
        if directory is not None:
            _sweep_locked(directory)
            final = name + ".txt"
            entry = _entry_stat(directory, final)
            if entry is not None and not stat.S_ISREG(entry.st_mode):
                raise SecretError("storage", "secret storage failed")
            try:
                _unlink(directory, final)
                os.fsync(directory)
            except FileNotFoundError:
                pass
            except OSError as exc:
                raise SecretError("storage", "secret deletion failed") from exc
    return {"ok": True, "name": name}


def _sweep():
    with _locked_store(create=False) as directory:
        removed = 0 if directory is None else _sweep_locked(directory)
    return {"ok": True, "removed": removed}


def _emit(payload, rc=0):
    print(json.dumps(payload, ensure_ascii=True, separators=(",", ":")))
    return rc


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        if argv == ["list"]:
            return _emit(_list())
        if argv == ["sweep"]:
            return _emit(_sweep())
        if len(argv) == 3 and argv[0] == "put" and argv[1] == "--":
            # Bounded read: a direct CLI caller gets the same memory ceiling as an HTTP
            # relay, and a value can never be supplied through argv or env.
            raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
            return _emit(_put(argv[2], raw))
        if len(argv) == 3 and argv[0] == "del" and argv[1] == "--":
            return _emit(_delete(argv[2]))
        return _emit({"ok": False, "error": "usage"}, 2)
    except SecretError as exc:
        return _emit({"ok": False, "error": exc.public_message, "code": exc.code}, 1)
    except Exception:
        # No exception formatting: messages can contain a store path or user-controlled
        # filename. The type is not useful to a relay and the value must never appear.
        return _emit({"ok": False, "error": "secret operation failed", "code": "internal"}, 1)


if __name__ == "__main__":
    sys.exit(main())
