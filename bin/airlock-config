#!/usr/bin/env python3
"""airlock-config — the single reader of airlock.toml.

Nothing else in Airlock parses the config; installers/nginx/backends consume it
through this tool. Site-specific facts live only in airlock.toml.

Usage:
  airlock-config validate            # fail-closed sanity checks (run first)
  airlock-config catalog             # installable apps as JSON, with NO config
                                     #   yet (the picker question; see cmd_catalog)
  airlock-config init --owner <login> [--site-name <name>]
                      [--apps a,b,c] # the smallest config that validates -> stdout
  airlock-config apps                # list enabled app names (one per line)
  airlock-config get <dotted.key>    # e.g. auth.owner, apps.devterm.public_port
  airlock-config env <app>           # KEY=VALUE lines for `eval` in bash
  airlock-config json                # full resolved config (defaults merged)
  airlock-config webjson             # frontend-safe subset (/__airlock.json)
  airlock-config plaintext           # app<TAB>listen<TAB>target plaintext rows
  airlock-config plaintext-known     # every plaintext port Airlock could own
  airlock-config package-preview <path>
                                     # validate one local package as JSON without
                                     #   changing config or package trust state
  airlock-config package-info        # installed/shipped manifests as JSON (D1/D6)
  airlock-config dir-package-info <id> <dir>
                                     # package-info for one app resolved from its
                                     #   directory alone (Company source: no
                                     #   [packages.<id>] table on this box)
  airlock-config canonical-package-info <id> <repository-id> <full-40-hex-sha>
                                     # stable six-field release boundary JSON
  airlock-config known-builtins      # shipped ids (hub/core, shadowed excluded) (F15)
  airlock-config sources              # ① candidates: public/company/personal apps + links
  airlock-config prereqs             # assembled prerequisites TSV (F11)
  airlock-config icon-src <app>      # staged tile icon source/destination (F4)
  airlock-config icon-stage <app>    # ORCHESTRATOR-INTERNAL: the one writing
                                     #   verb — stages a declared tile icon
                                     #   into the engine-owned webroot

Requires Python >= 3.11 (tomllib).
"""
from __future__ import annotations

import copy
import contextlib
import glob
import hashlib
import heapq
import io
import json
import os
import re
import shlex
import stat
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote, urlsplit

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover
    sys.stderr.write(
        "airlock-config: Python >= 3.11 required (tomllib missing). "
        "Current: %s\n" % sys.version.split()[0]
    )
    sys.exit(2)

# v1: Tailscale is the only supported auth provider, and its identity header is
# fixed — an operator-chosen header name would be spoofable and insecure.
# See SECURITY.md.
PROVIDER_HEADER = {"tailscale": "Tailscale-User-Login"}

# [agent].provider — which agent CLI a PLATFORM tool runs (dev-monitor's approved
# actions today). The VOCABULARY is not written here: it is read from
# bin/agent_provider.py, the module that also decides what `auto` means. A copy of
# the list in this file would let validate accept a value the selector rejects, or
# refuse one it handles, and neither side would know.
#
# The DEFAULT is `claude`, not `auto`, and that is a compatibility statement rather
# than a preference: the action runner had `claude` written into its argv, so a box
# that never sets this key has to keep running claude. Choosing `auto` is an act.
AGENT_PROVIDER_DEFAULT = "claude"

# Default ports/flags per app. A table's mere presence in [apps.*] enables it;
# omitted keys fall back to these. hub is the only survivor of this table
# (child 4/P3): the nine other built-ins are shipped packages now, and their
# defaults live in their own manifest's [config.defaults] (D2) — see
# airlock.toml.example for the operator-facing documentation of hub's ports.
APP_DEFAULTS: dict[str, dict] = {
    # *_port pairs: http_port/public_port are PLAINTEXT tailnet ports that only
    # 301 to https (served by the loopback redirect_port) — no content, ever.
    "hub":         {"https_port": 443, "http_port": 19901, "nginx_port": 19902,
                    "redirect_port": 19903, "accounts_port": 19904,
                    # The shared usage store the account surface reads. Not a port and
                    # not a secret: a path and a URL, both optional, both READ-ONLY here
                    # — the writer is an out-of-process collector outside this repository
                    # and nothing in this tree ever opens either for writing. That is why
                    # moving them off devterm needed no coordination with it (parent
                    # decision OQ2; devterm keeps both keys as overrides).
                    "fleet_store": "", "fleet_store_url": "",
                    # OpenCode xAI login on the account surface. Off by default: it needs
                    # the `opencode` CLI, which the installer resolves when this is true.
                    "xai": False,
                    # Muse key picker on the account surface. Box-local by nature (reader
                    # binary and assignment sheet), so they
                    # live in this box's airlock.toml — an install that is not handed them
                    # must not wipe them (2026-09-25: a full install rewrote the unit with
                    # both empty and the next restart turned the picker off). Empty =
                    # no Muse on this box. No vault name or URL ships as a default.
                    "muse_secret_bin": "", "muse_registry": ""},
}

# Accepted in ANY app table (not a default: they carry no value when absent).
COMMON_APP_KEYS = frozenset({"external"})


def _is_port_config_key(key: str) -> bool:
    """Return whether a scalar config key names a locally owned TCP port.

    Most packages use ``*_port``. Older external packages used the bare
    ``port`` spelling; excluding it let a listener disappear from the global
    ownership pool while still looking declared in its manifest.
    """
    return key == "port" or key.endswith("_port")

# The non-app sections are closed vocabularies: v1 reads exactly these keys and
# nothing else, so anything else in them is a typo. `[auth]` earns the check on its
# own — a mistyped `collaborators` leaves the operator believing they granted (or
# revoked) access that was never read. Only [apps.*] is open, and only at the table
# level (a local/custom app), never at the key level.
CLOSED_SECTIONS: dict[str, frozenset] = {
    "airlock":  frozenset({"config_version"}),
    # company_repo is the ONE line that says where the Company app repository
    # lives (P3_ENGINE: "one fact, one place"). It is a git URL, never a clone
    # path on this box: the engine reads the pinned main SHA out of its own
    # bare mirror, so an operator's working tree can never become the source of
    # truth for what an install pulls.
    "site":     frozenset({"name", "company_repo"}),
    "auth":     frozenset({"provider", "owner", "collaborators"}),
    "paths":    frozenset({"wiki"}),
    "branding": frozenset({"product", "icon_ring"}),
    # [agent] is a PLATFORM table, deliberately not [apps.<something>].provider: the
    # tool it steers today (dev-monitor's approved actions) is one consumer of a fact
    # about the box, and the next one must not have to restate it. An app that owns a
    # provider key of its own keeps winning inside that app — see airlock.toml.example.
    "agent":    frozenset({"provider"}),
}

# Config keys that were shipped but never implemented. They are NOT errors (that
# would break every box installed from an example that carried them); they get a
# targeted message that says what to do, because a generic "unknown key" warning
# cannot correct what the operator believes the key was doing.
RETIRED_KEYS: dict[str, str] = {
    "apps.dev-monitor.skill_allow":
        "was removed (owner, 2026-08-10). Remove it — but know what it was doing "
        "first: it filtered the `skill` field of an action and nothing else, so the "
        "same card sent as a `prompt` naming the same skill ran anyway. It was never "
        "the lock it reads as. What bounds a run is the approval: the owner reads the "
        "derived plan and clicks, and that plan runs or nothing does (see SECURITY.md).",
    "paths.code_root":
        "is gone (2026-08-23). Remove it. It was never a designed setting: markserv "
        "and filebrowser each demand a root argument, so the installer had to write "
        "one somewhere and it became a config key — and then read as a boundary it "
        "never enforced. The viewer now runs with `--root %h`: the tree is the home "
        "directory of the account the user service runs as, and nothing above it is "
        "served. The root is a fact about that account, not a value to set — this key "
        "is not coming back pointed at home (see SECURITY.md).",
    "paths.mount_exclude":
        "was never implemented — nothing was ever excluded. Remove it. The viewer "
        "hides nothing and has no ignore list: dotfiles, .env included, list and "
        "open like any other file (see SECURITY.md).",
    "auth.read_open":
        "was never implemented — no read-only tier exists. Remove it. Access is "
        "owner + collaborators; nothing else is admitted.",
    "auth.read_open_suffix":
        "was never implemented (see auth.read_open). Remove it — a domain suffix "
        "grants nothing.",
    "site.domain_override":
        "was never implemented — the FQDN is always measured from `tailscale "
        "status`, or taken from AIRLOCK_TS_FQDN. Remove it.",
    "branding.logo":
        "was never implemented — the hub serves hub/assets/ as shipped. Replace "
        "the file in the repo instead, and remove this key.",
}


# ---- packaged apps (docs/design/app-package-contract.md, D1/D2/D6) ----------

# Packaged ids: env export flattens `-` and `_` to the same character
# (_envkey below), so `a-b` and `a_b` would collide.
PACKAGE_ID_RE = re.compile(r"^(?!\.{1,2}\Z)[^/\x00]+\Z")

MANIFEST_NAME = "airlock-app.toml"

# The artifact classes the ledger can record and tear down. Everything an
# app's scripts create OUTSIDE its package dir must be declared in one of them
# (app *data* is deliberately never declared and never torn down).
ARTIFACT_CLASSES = ("units", "fragments", "webroot", "files", "rooted",
                    "containers", "serve_ports")

_WILDCARD_RE = re.compile(r"[*?\[]")

_SERVE_KEYS = ("https", "https_registry")
_PREREQ_FIELDS = ("command", "predicate", "expected", "fix", "note")
_TYPE_NAMES = {"string": str, "integer": int, "boolean": bool}
# Manifest config keys become env vars through _envkey: keep them shell-safe
# and collision-free (`-` would flatten onto `_`).
_MANIFEST_KEY_RE = re.compile(r"^[a-z0-9_]+\Z")
# Prereq fields become TSV row cells: a tab or newline would inject rows (F11).
_CTRL_RE = re.compile(r"[\x00-\x1f\x7f]")
# `core` is the prerequisites pseudo-owner; a package named core would let a
# manifest masquerade as the immutable platform rows (F11).
RESERVED_PACKAGE_IDS = {"hub": "reserved platform core and cannot be shadowed",
                        "core": "the prerequisites pseudo-owner (F11)"}

REPO_ROOT = Path(__file__).resolve().parent.parent


def _state_dir() -> Path:
    env = os.environ.get("AIRLOCK_STATE_DIR", "")
    if env:
        # Verbatim, like the orchestrator's shell. Even abspath() would
        # diverge: it collapses `..` lexically, while the shell's open()
        # resolves any symlink first — same string, two directories.
        return Path(env)
    return Path.home() / ".local/state/airlock"


PLAINTEXT_RETIREMENT_VERSION = 1
PLAINTEXT_RETIREMENT_FILENAME = "plaintext-retirement.json"


def _plaintext_retirement_path() -> Path:
    return _state_dir() / PLAINTEXT_RETIREMENT_FILENAME


def _load_plaintext_retirement(path: Path) -> dict:
    """Reader for the ledger-independent plaintext cleanup record."""
    if not os.path.lexists(path):
        return {"version": PLAINTEXT_RETIREMENT_VERSION, "entries": []}
    try:
        with path.open("r", encoding="utf-8") as handle:
            raw = json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot parse record: {exc}") from exc
    return _normalise_plaintext_retirement(raw)


def _normalise_plaintext_retirement(raw: dict) -> dict:
    """Project a parsed cleanup record through the canonical reader."""
    normalised = [
        {"package": entry["package"], "listen": entry["listen"],
         "target": entry["target"], "state": entry["state"]}
        for entry in raw.get("entries", [])
    ]
    return {"version": raw.get("version", PLAINTEXT_RETIREMENT_VERSION),
            "entries": normalised}


def _read_plaintext_retirement() -> dict:
    path = _plaintext_retirement_path()
    try:
        return _load_plaintext_retirement(path)
    except ValueError:
        return {"version": PLAINTEXT_RETIREMENT_VERSION, "entries": []}


def _read_ledger() -> dict:
    """Read installed apps through the engine's canonical reader."""
    ledger = _ledger_module()
    try:
        return ledger.load_installed()
    except ledger.LedgerError as exc:
        die(f"cannot read installed apps: {exc}", code=2)


_LEDGER_MODULE = None


def _ledger_module():
    """Load the engine module once for its state and artifact helpers."""
    global _LEDGER_MODULE
    if _LEDGER_MODULE is not None:
        return _LEDGER_MODULE
    import importlib.util
    from importlib.machinery import SourceFileLoader
    path = Path(__file__).resolve().parent / "airlock-ledger"
    loader = SourceFileLoader("_airlock_ledger", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    prior = sys.dont_write_bytecode
    sys.dont_write_bytecode = True   # a validator must not write __pycache__
    try:
        loader.exec_module(mod)
    except OSError as e:
        die(f"cannot load the ledger module beside this tool: {path} ({e}).\n"
            "  airlock-config takes both the store SCHEMA and the store VERSION "
            "from that file, so a missing or unreadable one is a broken install "
            "— not an empty ledger. Restore bin/airlock-ledger next to "
            "bin/airlock-config.")
    finally:
        sys.dont_write_bytecode = prior
    _LEDGER_MODULE = mod
    return mod


def die(msg: str, code: int = 1) -> "None":
    sys.stderr.write(f"airlock-config: {msg}\n")
    sys.exit(code)


def log(msg: str) -> "None":
    sys.stderr.write(f"airlock-config: {msg}\n")


def find_config() -> Path:
    # The path is resolved (symlinks included) so a symlinked config and its
    # target agree on the operator configuration origin.
    env = os.environ.get("AIRLOCK_CONFIG")
    if env:
        p = Path(env).expanduser()
        if os.environ.get("AIRLOCK_CONFIG_SNAPSHOT"):
            return p
        if not p.exists():
            die(f"AIRLOCK_CONFIG points to a missing file: {p}")
        return p.resolve()
    # search upward from CWD, then fall back to repo root (parent of bin/)
    for base in [Path.cwd(), *Path.cwd().parents]:
        cand = base / "airlock.toml"
        if cand.exists():
            return cand.resolve()
    fallback = Path(__file__).resolve().parent.parent / "airlock.toml"
    if fallback.exists():
        return fallback.resolve()
    die("no airlock.toml found (copy airlock.toml.example and fill it in)")


def load() -> dict:
    path = find_config()
    read_path = Path(os.environ.get("AIRLOCK_CONFIG_SNAPSHOT") or path)
    try:
        data = read_path.read_bytes()
        cfg = tomllib.loads(data.decode("utf-8"))
        return cfg
    except (OSError, ValueError) as e:
        # ValueError, not just tomllib.TOMLDecodeError (a ValueError
        # subclass): tomllib decodes the bytes as UTF-8 before parsing, so
        # one invalid byte raises a plain UnicodeDecodeError first — missing
        # that turned a clean die() into a raw traceback.
        die(f"{path}: invalid TOML: {e}")


def resolved(cfg: dict) -> dict:
    """Merge configured, installed and current-hook app defaults; expand paths.

    A packaged app's defaults come from its manifest's [config.defaults] — a
    shadowing package REPLACES the built-in schema and defaults, no
    inheritance (D2). Its [audience] default joins the same merge so env
    export and webjson see the effective value (D7)."""
    out = json.loads(json.dumps(cfg))  # deep copy
    apps = out.setdefault("apps", {})
    specs = package_specs(cfg)
    ledger = _ledger_module()
    try:
        runtime_dirs = ledger.app_dirs({})
    except ledger.LedgerError as exc:
        die(f"cannot resolve installed app directories: {exc}", code=2)
    # Registered candidates are sources, not installation membership. Only the
    # installed ledger and the engine's current hook supply implicit app tables.
    for name, directory in runtime_dirs.items():
        if name in specs:
            apps.setdefault(name, {})
    for name, table in list(apps.items()):
        spec = specs.get(name)
        if spec is not None:
            merged = dict(spec["schema"]["defaults"])
            if spec["audience"] is not None:
                merged["audience"] = spec["audience"]["default"]
            else:
                # Fail-closed: a manifest that declares no [audience] serves the
                # owner alone. Silence used to mean "everyone the hub admits",
                # which made reach an accident of being inside the hub server
                # rather than a stated claim — a package could widen its own
                # audience by omitting a block. There is no operator override
                # here on purpose: `audience` is not an allowed key for such a
                # manifest (see the allowed-keys branch), so the only way to
                # serve collaborators is to say so in [audience].
                merged["audience"] = "owner"
            merged.update(table or {})
            apps[name] = merged
            continue
        if name not in APP_DEFAULTS:
            sys.stderr.write(f"airlock-config: warning: unknown app [apps.{name}] "
                             f"(no defaults; typo?)\n")
        merged = dict(APP_DEFAULTS.get(name, {}))
        merged.update(table or {})
        apps[name] = merged
    # The account surface reads hub.fleet_store / hub.xai, but both keys were documented
    # under [apps.devterm] for the months the surface lived there (#347-#349 moved the
    # reader, not the operator's config). A box that set them for devterm and never
    # copied them lost every non-active account's usage and the xAI login with no error
    # (measured 2026-09-14/15). Inherit them: one opinion per box. An explicit hub value
    # still wins.
    hub = apps.get("hub")
    devterm = apps.get("devterm")
    if isinstance(hub, dict) and isinstance(devterm, dict):
        explicit = (cfg.get("apps") or {}).get("hub") or {}
        for key in ("fleet_store", "fleet_store_url", "xai"):
            if key not in explicit and devterm.get(key):
                hub[key] = devterm[key]
    paths = out.setdefault("paths", {})
    for k in ("wiki",):
        if paths.get(k):
            paths[k] = str(_expanduser(str(paths[k])))
    # The platform default joins the same merge the app defaults do, so `get`, `env`
    # and `json` all report the value that will actually be used. A key whose default
    # only exists inside the consumer cannot be read off the box before it runs.
    out.setdefault("agent", {}).setdefault("provider", AGENT_PROVIDER_DEFAULT)
    return out


def identity_header(cfg: dict) -> str:
    provider = cfg.get("auth", {}).get("provider")
    return PROVIDER_HEADER.get(provider, PROVIDER_HEADER["tailscale"])


def cmd_validate(cfg: dict) -> "None":
    identity_header(cfg)
    apps = cfg.get("apps", {})
    # Validator order, fixed (D2): manifest parse -> PackageSpec -> effective
    # schema per app id -> resolved config -> key/type/port/artifact checks.
    specs = package_specs(cfg)
    _validate_keys(cfg)
    package_glyphs = _validate_tile_glyphs(specs)  # active external packages
    shipped_declared, shipped_glyphs = _validate_shipped_tile_glyphs()
    _warn_deprecated_config(cfg, specs)
    _read_ledger()
    packages_resolved(cfg)  # D1/D2: serve values, port spans, disjointness
    app_order(cfg)          # D3/F5: dependency-ordered install sequence
    _emit_glyph_validation_ac(package_glyphs, shipped_declared, shipped_glyphs)
    print("ok: config valid")


def _validate_keys(cfg: dict) -> "None":
    """Retired key = loud warning + how to fix."""
    retired = []
    for dotted, why in RETIRED_KEYS.items():
        section, _, rest = dotted.partition(".")
        if section == "apps":
            # apps.<app>.<key> — an app key lives one level deeper.
            app, _, key = rest.partition(".")
            if key in ((cfg.get("apps") or {}).get(app) or {}):
                retired.append(f"  {dotted} {why}")
            continue
        if rest in (cfg.get(section) or {}):
            retired.append(f"  {dotted} {why}")
    if retired:
        sys.stderr.write("airlock-config: warning: retired config key(s):\n"
                         + "\n".join(retired) + "\n")
    package_specs(cfg)


def _warn_deprecated_config(cfg: dict, specs: dict, only_app: str | None = None) -> "None":
    """Emit manifest-owned migration warnings once per CLI invocation."""
    configured_apps = cfg.get("apps") or {}
    for pid, spec in sorted(specs.items()):
        if only_app is not None and pid != only_app:
            continue
        table = configured_apps.get(pid) or {}
        for key, metadata in sorted(spec["schema"]["deprecated"].items()):
            value = table.get(key)
            configured = bool(value.strip()) if isinstance(value, str) else bool(value)
            if not configured:
                continue
            replacement = metadata["replacement"]
            remove_after = metadata["remove_after"]
            sys.stderr.write(
                f"airlock-config: warning: apps.{pid}.{key} is deprecated; "
                f"use apps.{pid}.{replacement}; remove the legacy key by "
                f"{remove_after}\n")


def _expanduser(raw: str) -> Path:
    try:
        return Path(raw).expanduser()
    except (RuntimeError, OSError) as e:
        die(f"cannot expand {raw!r}: {e}")


def _artifact_roots() -> dict:
    """Absolute roots each artifact class expands under, canonicalised with
    realpath: two roots that alias the same directory through a symlink must
    collide in claim space, or disjointness would let two apps own one real
    path. Env-overridable the same way the test suites already override
    WEBROOT/CONFD, so fixtures never touch the real system."""
    def real(raw) -> Path:
        # expanduser() before realpath(), matching bin/airlock-ledger's
        # _real_root exactly — otherwise AIRLOCK_WEBROOT=~/hub resolves to
        # two DIFFERENT anchors depending on which file computed it (config
        # would treat the literal "~" as a directory name component;
        # realpath does not understand shell tilde expansion on its own).
        return Path(os.path.realpath(os.path.expanduser(str(raw))))
    return {
        "unit_user": real(os.environ.get("AIRLOCK_UNIT_DIR_USER", "").strip()
                          or (Path.home() / ".config/systemd/user")),
        "unit_system": real(os.environ.get("AIRLOCK_UNIT_DIR_SYSTEM", "").strip()
                            or "/etc/systemd/system"),
        "confd": real(os.environ.get("AIRLOCK_CONFD", "").strip()
                      or "/etc/airlock/nginx"),
        "webroot": real(os.environ.get("AIRLOCK_WEBROOT", "").strip()
                        or "/opt/airlock/hub"),
        "home": real(Path.home()),
    }


def _validate_artifacts(pid: str, raw) -> tuple[dict, dict]:
    """Reads [artifacts]; returns all classes (missing ones as empty lists)."""
    if raw is None:
        raw = {}
    out = {}
    unit_scopes = {}
    for cls in ARTIFACT_CLASSES:
        vals = raw.get(cls, []) or []
        if cls == "units":
            names = []
            for v in vals:
                if isinstance(v, dict):
                    name = str(v.get("name", "")).strip()
                    scope = v.get("scope", "user")
                else:
                    name, scope = str(v).strip(), "user"
                names.append(name)
                unit_scopes[name] = scope
            out[cls] = names
        elif cls == "containers":
            out[cls] = list(vals)
        else:
            out[cls] = [str(v).strip() for v in vals]
    return out, unit_scopes


def _validate_https_registries(pid: str, raw) -> list[dict]:
    if raw is None:
        return []
    out = []
    for index, row in enumerate(raw):
        fields = row.get("fields", {}) or {}
        projected = {name: field_path for name, field_path in fields.items()}
        out.append({
            "table": row.get("table"),
            "entries": row.get("entries"),
            "key": row.get("key"),
            "enabled": row.get("enabled"),
            "listen": row.get("listen"),
            "target": row.get("target"),
            "optional": row.get("optional", False),
            "fields": projected,
        })
    return out


def _validate_data_registries(pid: str, raw) -> list[dict]:
    """Read point-in-time registry projections that own no serve route."""
    if raw is None:
        return []
    out = []
    for index, row in enumerate(raw):
        fields = row.get("fields", {}) or {}
        projected = {field_name: field_path for field_name, field_path in fields.items()}
        out.append({
            "name": row.get("name"),
            "table": row.get("table"),
            "entries": row.get("entries"),
            "key": row.get("key"),
            "enabled": row.get("enabled"),
            "optional": row.get("optional", False),
            "enabled_default": row.get("enabled_default"),
            "fields": projected,
        })
    return out


def _validate_mappings(pid: str, raw) -> tuple[dict, list[dict]]:
    if raw is None:
        raw = {}
    https = raw.get("https", {}) or {}
    mappings = {}
    for key, raw_mapping in https.items():
        if isinstance(raw_mapping, dict):
            target = raw_mapping.get("target")
            enabled_key = raw_mapping.get("enabled")
        else:
            target = raw_mapping
            enabled_key = None
        mappings[key] = {"mode": "https", "target_key": target}
        if enabled_key is not None:
            mappings[key]["enabled_key"] = enabled_key
    return mappings, _validate_https_registries(pid, raw.get("https_registry"))


_NO_REGISTRY_DEFAULT = object()


def _json_field(value, path: str, where: str, default=_NO_REGISTRY_DEFAULT):
    current = value
    for part in path.split("."):
        if not isinstance(current, dict) or part not in current:
            return None if default is _NO_REGISTRY_DEFAULT else default
        current = current[part]
    return current


def _resolve_registries(pid: str, spec: dict, app_table: dict) -> tuple[dict, list[dict], dict]:
    """Project the operator's config tables once into mappings, rows and projections.

    A registry declaration names a `[apps.<id>.<table>]` config table, never a file:
    the operator's ⑤ is the only hand-authored copy, and a package that re-read it
    during install could disagree with the ledger about the same install.

    The package consumes the rows carried in package-info; it never re-reads the live
    table during this install.  That keeps gate, instance, and ledger state on one
    point-in-time projection even if the operator edits the table mid-run.
    """
    mappings: dict[str, dict] = {}
    rows: list[dict] = []
    projections: dict[str, dict] = {}
    declared_tables = spec["schema"]["tables"] or {}

    def document_of(declaration: dict) -> tuple[str, str | None, object]:
        """(source label, canonical digest, table value or None when unset)."""
        table = declaration.get("table")
        source = f"apps.{pid}.{table}"
        if table not in declared_tables:
            die(f"package '{pid}' registry names {source}, which the manifest "
                f"does not declare in [config.tables]")
        value = app_table.get(table)
        if not isinstance(value, dict):
            return source, None, None
        canonical = json.dumps(value, sort_keys=True, ensure_ascii=False)
        return source, hashlib.sha256(canonical.encode("utf-8")).hexdigest(), value

    for registry_index, declaration in enumerate(spec["https_registries"]):
        if not declaration.get("table"):
            continue
        source, source_digest, document = document_of(declaration)
        if document is None:
            continue
        entries = _json_field(document, declaration["entries"], source, default=[]) or []
        for entry_index, entry in enumerate(entries):
            where = f"package '{pid}' HTTPS registry {source} entry {entry_index}"
            enabled = _json_field(entry, declaration["enabled"], where)
            entry_key = _json_field(entry, declaration["key"], where)
            if not enabled:
                continue
            listen = _json_field(entry, declaration["listen"], where)
            target = _json_field(entry, declaration["target"], where)
            # Stable synthetic keys identify each registry mapping; the readable
            # id remains in the installer row.
            mapping_key = (
                f"registry_{registry_index}_"
                f"{hashlib.sha256(str(entry_key).encode('utf-8')).hexdigest()}"
            )
            fields = {name: _json_field(entry, field_path, where)
                      for name, field_path in declaration["fields"].items()}
            mappings[mapping_key] = {"listen": listen, "mode": "https", "target": target}
            rows.append({
                "mapping_key": mapping_key,
                "registry_index": registry_index,
                "source": source,
                "source_sha256": source_digest,
                "key": entry_key,
                "listen": listen,
                "target": target,
                "fields": fields,
            })

    for declaration in spec["data_registries"]:
        if not declaration.get("table"):
            continue
        name = declaration["name"]
        source, source_digest, document = document_of(declaration)
        if document is None:
            projections[name] = {
                "source": source,
                "present": False,
                "source_sha256": None,
                "rows": [],
            }
            continue
        entries = _json_field(document, declaration["entries"], source, default=[]) or []
        data_rows = []
        for entry_index, entry in enumerate(entries):
            where = f"package '{pid}' registry {source} entry {entry_index}"
            enabled = _json_field(entry, declaration["enabled"], where,
                                  declaration["enabled_default"])
            entry_key = _json_field(entry, declaration["key"], where)
            if not enabled:
                continue
            data_rows.append({
                "key": entry_key,
                "fields": {name_: _json_field(entry, field_path, where)
                           for name_, field_path in declaration["fields"].items()},
            })
        projections[name] = {
            "source": source,
            "present": True,
            "source_sha256": source_digest,
            "rows": data_rows,
        }
    return mappings, rows, projections


def _validate_plaintext_redirect(pid: str, raw) -> dict:
    if raw is None:
        return {}
    return dict(raw)


def _regular_file(p: Path) -> bool:
    """lstat, not stat: a symlinked manifest or lifecycle script is rejected.
    Shipped manifest discovery keeps the payload within its own directory."""
    try:
        return stat.S_ISREG(os.lstat(p).st_mode)
    except OSError:
        return False


def _mf_die(pid: str, msg: str) -> "None":
    die(f"package '{pid}' manifest: {msg}")


def _validate_deps(pid: str, raw) -> list:
    """[dependencies] apps = [...] — same-box app ids, id-level (D3)."""
    if raw is None:
        return []
    apps = raw.get("apps", []) or []
    return list(apps)


def _validate_config_schema(pid: str, raw) -> dict:
    """[config] — the app's declared key space: required (explicit type),
    defaults (value doubles as type), nested tables' allowed_keys, port spans.
    This replaces APP_DEFAULTS's two roles for packaged apps (D2)."""
    out = {"required": {}, "defaults": {}, "tables": {}, "port_spans": [],
           "runtime_env": [], "deprecated": {}}
    if raw is None:
        return out
    for row in raw.get("required", []) or []:
        out["required"][row.get("name")] = row.get("type")
    for key, val in (raw.get("defaults", {}) or {}).items():
        out["defaults"][key] = val
    for key, metadata in (raw.get("deprecated", {}) or {}).items():
        out["deprecated"][key] = {
            "replacement": metadata.get("replacement"),
            "remove_after": metadata.get("remove_after"),
        }
    for tname, t in (raw.get("tables", {}) or {}).items():
        out["tables"][tname] = list(t.get("allowed_keys") or [])
    for row in raw.get("port_spans", []) or []:
        out["port_spans"].append({"base": row.get("base"), "count": row.get("count")})
    # runtime_env — env-var NAMES the installer WRITES into units, secrets or test
    # seams. Not config: no values, no defaults, not merged into resolved config,
    # never exported.
    out["runtime_env"] = list(raw.get("runtime_env", []) or [])
    return out


def _validate_prereqs(pid: str, raw) -> list:
    """[[prerequisites]] — replaces this app's rows in prerequisites.tsv (F11).
    Owner is always the package id; the five fields are the remaining TSV
    columns."""
    if raw is None:
        return []
    out = []
    for row in raw:
        rec = {field: str(row.get(field, "")).strip() for field in _PREREQ_FIELDS}
        out.append(rec)
    return out


# The hub sprite is the closed set of symbol ids a `glyph` may name. It is
# read from the shipped launcher itself (hub/index.html) rather than from a
# hand-kept list, because the sprite is the document the browser will actually
# resolve the id in — a name that is not there renders as an EMPTY tile, with
# no error anywhere. Measured 2026-08-25: four invented glyph names passed
# validate, install, and smoke, and only the screen showed blank squares.
_SPRITE_PATH = REPO_ROOT / "hub" / "index.html"
_SPRITE_SYMBOL_RE = re.compile(r'<symbol id="([^"]+)"')
_sprite_glyph_cache = None


def sprite_glyphs() -> "frozenset[str]":
    """Symbol ids that exist in the hub sprite."""
    global _sprite_glyph_cache
    if _sprite_glyph_cache is not None:
        return _sprite_glyph_cache
    try:
        html = _SPRITE_PATH.read_text(encoding="utf-8")
    except OSError as e:
        die(f"cannot read the hub sprite at {_SPRITE_PATH}: {e} — glyph names "
            f"cannot be checked, and an unchecked name is a blank tile")
    ids = frozenset(_SPRITE_SYMBOL_RE.findall(html))
    _sprite_glyph_cache = ids
    return ids


def _validate_tile_glyphs(specs: dict) -> int:
    """Count every packaged [tile] glyph (fixture AC bookkeeping only)."""
    checked = 0
    for pid in sorted(specs):
        tile = specs[pid]["tile"]
        if tile is not None and tile["glyph"] is not None:
            checked += 1
    return checked


def _shipped_tile_glyphs() -> list[tuple[str, Path, str]]:
    """Read every shipped manifest's declared glyph, independent of [apps]."""
    declarations = []
    for manifest in sorted((REPO_ROOT / "apps").glob("*/airlock-app.toml")):
        try:
            raw = tomllib.loads(manifest.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as exc:
            die(f"cannot read shipped manifest {manifest}: {exc}")
        tile = raw.get("tile")
        if not isinstance(tile, dict) or "glyph" not in tile:
            continue
        glyph = tile["glyph"]
        declarations.append((manifest.parent.name, manifest, str(glyph).strip()))
    return declarations


def _validate_shipped_tile_glyphs() -> tuple[int, int]:
    """Count shipped-app glyph declarations (fixture AC bookkeeping only)."""
    declarations = _shipped_tile_glyphs()
    return len(declarations), len(declarations)


def _checkout_revision() -> str | None:
    """The checkout revision behind an AC observation, when this is a checkout.

    Installed Airlock deliberately has no Git metadata, so ordinary operator
    output stays the one stable success line.  The card's exact verify command
    runs in a checkout and gets a reproducible evidence coordinate instead.
    """
    if not (REPO_ROOT / ".git").exists():
        return None
    try:
        result = subprocess.run(
            ["git", "-C", str(REPO_ROOT), "rev-parse", "--short=12", "HEAD"],
            check=True, capture_output=True, encoding="utf-8", timeout=2)
    except (OSError, subprocess.SubprocessError):
        return None
    revision = result.stdout.strip()
    return revision if re.fullmatch(r"[0-9a-f]{7,40}", revision) else None


def _emit_glyph_validation_ac(package_glyphs: int, shipped_declared: int,
                              shipped_checked: int) -> None:
    """Emit fixture AC observations when the glyph regression invokes it."""
    if os.environ.get("AIRLOCK_EMIT_AC") != "1":
        return
    revision = _checkout_revision()
    if revision is None:
        return
    sprite_symbols = len(sprite_glyphs())
    print("AC-GLYPH-SPRITE | expected: sprite_symbols > 0 | "
          f"observed: sprite_symbols={sprite_symbols} | verdict: PASS | "
          f"signal: fixture | evidence: hub/index.html@{revision}")
    print("AC-GLYPH-DECLARATIONS | expected: "
          "shipped_glyphs_checked == shipped_glyphs_declared | observed: "
          f"active_package_glyphs_checked={package_glyphs},"
          f"shipped_glyphs_checked={shipped_checked},"
          f"shipped_glyphs_declared={shipped_declared} | verdict: PASS | "
          f"signal: fixture | evidence: bin/airlock-config@{revision}")


def _validate_tile(pid: str, raw):
    """[tile] — the hub's real tile model (label, sub, cat, optional path,
    icon XOR glyph). Omitting the whole table means a no-tile app."""
    if raw is None:
        return None
    label = raw.get("label")
    if isinstance(label, str):
        label = label.strip()
    icon = raw.get("icon")
    if isinstance(icon, str):
        icon = icon.strip()
    return {"label": label, "sub": raw.get("sub", ""), "cat": raw.get("cat"),
            "path": raw.get("path"), "icon": icon, "glyph": raw.get("glyph")}


def _validate_icon_source(pid: str, pdir: Path, rel: str) -> dict:
    """Resolves the declared icon to a source path and the id-scoped staging
    destination (relative to the webroot)."""
    root = Path(os.path.realpath(str(pdir)))
    real = (root / rel).resolve(strict=False)
    return {"src": str(real), "dest": f"assets/apps/{pid}/{Path(rel).name}"}


def _validate_audience(pid: str, raw):
    """[audience] — who this app can serve (D7)."""
    if raw is None:
        return None
    sup = raw.get("supported")
    return {"supported": list(sup) if sup is not None else [],
            "default": raw.get("default")}


# One PackageSpec per (config object, package): manifests are parsed ONCE per
# process and every command projects from the same descriptor. The value
# RETAINS the cfg object: keying on id() alone would let a freed dict's
# address be reused by a different config and silently serve its specs.
_SPEC_CACHE: dict = {}


def _spec_cache_key(cfg: dict):
    return id(cfg)


def package_specs(cfg: dict, selected: set[str] | None = None, *, observation: bool = False) -> dict:
    """Resolve installed/shipped apps (D1) and parse each manifest ONCE into an
    immutable PackageSpec: {id, contract, deps, schema, prerequisites,
    artifacts, tile, audience, lifecycle, dir}. Every consumer — validate,
    apps, package-info, env, webjson, prereqs — is a projection of this
    structure; no command re-reads the manifest. Fatal on any manifest
    violation (F10: unknown fields anywhere are fatal); {} when no apps
    are resolved. Config cross-checks (serve values, spans, disjointness)
    live in packages_resolved. Runtime launcher observation can omit a source
    whose parse already reported failure; required execution inputs stay strict."""
    cached = _SPEC_CACHE.get(_spec_cache_key(cfg))
    if cached is not None:
        return cached[1]
    shipped_root = _shipped_root()
    sources = {}
    shipped_root_real = os.path.realpath(shipped_root)
    for pid in (cfg.get("apps") or {}):
        if selected is not None and pid not in selected:
            continue
        if pid in RESERVED_PACKAGE_IDS:
            continue
        if isinstance(pid, str) and PACKAGE_ID_RE.fullmatch(pid):
            app_dir = shipped_root / pid
            manifest = app_dir / MANIFEST_NAME
            # Canonical containment (matching the known-builtins contract's
            # symlinked-manifest exclusion): `os.path.exists` follows
            # symlinks, so a `$ROOT/apps/<id>` that is itself a symlink to an
            # outside directory would otherwise resolve as shipped and gain
            # the rooted artifact class's trust. Require the real path to
            # sit directly under the real shipped root; a symlinked entry is
            # excluded, not shipped.
            if (os.path.exists(manifest) and not app_dir.is_symlink()
                    and os.path.realpath(app_dir) == os.path.join(shipped_root_real, pid)):
                sources[pid] = ({"path": str(manifest.parent)}, "shipped", True)
    ledger = _ledger_module()
    try:
        installed_dirs = ledger.app_dirs({})
    except ledger.LedgerError as exc:
        die(f"cannot resolve installed app directories: {exc}", code=2)
    for pid, directory in installed_dirs.items():
        if selected is not None and pid not in selected:
            continue
        if pid in RESERVED_PACKAGE_IDS:
            continue
        app_dir = Path(directory)
        if not app_dir.is_dir() or not (app_dir / MANIFEST_NAME).is_file():
            sources.pop(pid, None)  # ③ owns this id even when its source is gone.
            continue
        shipped = (not app_dir.is_symlink()
                   and os.path.realpath(app_dir) == os.path.join(shipped_root_real, pid))
        sources[pid] = ({"path": directory}, "shipped" if shipped else "explicit", shipped)
    prepared = {}
    for pid in sorted(sources):
        table, source_class, bundle_principal = sources[pid]
        raw = table.get("path", "")
        p = _expanduser(str(raw))
        pdir = p.resolve()
        prepared[pid] = (source_class, pdir)

    out = {}
    for pid in sorted(prepared):
        source_class, pdir = prepared[pid]
        try:
            spec = _parse_manifest_spec(pid, pdir, source_class)
        except SystemExit:
            if not observation:
                raise
            continue
        out[pid] = spec
    _SPEC_CACHE[_spec_cache_key(cfg)] = (cfg, out)
    return out


def _read_manifest_document(pid: str | None, pdir: Path) -> dict:
    """Read one manifest for the canonical parser or the path preview.

    Preview has to learn the id from the manifest, while configured packages already
    know it from their table name.  Keeping the byte/TOML read here lets both paths
    feed the same schema and capability parser instead of growing a second validator.
    """
    manifest = pdir / MANIFEST_NAME
    try:
        with manifest.open("rb") as fh:
            return tomllib.load(fh)
    except OSError as e:
        die(f"cannot read {manifest}: {e}")
    except ValueError as e:
        # ValueError (see load()'s identical fix): tomllib's UTF-8 decode happens
        # before TOMLDecodeError's own error class does.
        die(f"{manifest}: invalid TOML: {e}")


def _parse_manifest_spec(pid: str, pdir: Path, source_class: str,
                         *, manifest_document: dict | None = None) -> dict:
    """Parse + validate ONE manifest at `pdir` into the PackageSpec shape
    `package_specs` stores (child 4/P4: extracted so the known-builtins scan
    can parse a SHIPPED manifest the exact same way for an id that has no
    `[apps.pid]` table at all — one parser, no drifting
    copy). Fatal (die/`_mf_die`, i.e. `SystemExit`) on any manifest
    violation, exactly as before the extraction: `package_specs` lets that
    propagate (a CONFIGURED package's manifest must fail loudly), while the
    known-builtins scan wraps this call in `try/except SystemExit` (an
    UNCONFIGURED shipped id with a malformed manifest is simply excluded,
    best-effort, never a reason to crash the whole scan)."""
    manifest = pdir / MANIFEST_NAME
    m = (manifest_document if manifest_document is not None
         else _read_manifest_document(pid, pdir))
    contract = m.get("contract")
    deps = _validate_deps(pid, m.get("dependencies"))
    schema = _validate_config_schema(pid, m.get("config"))
    prereqs = _validate_prereqs(pid, m.get("prerequisites"))
    arts, unit_scopes = _validate_artifacts(pid, m.get("artifacts"))
    tile = _validate_tile(pid, m.get("tile"))
    icon = (None if tile is None or tile["icon"] is None
            else _validate_icon_source(pid, pdir, tile["icon"]))
    audience = _validate_audience(pid, m.get("audience"))
    serve, https_registries = _validate_mappings(pid, m.get("serve"))
    data_registries = _validate_data_registries(pid, m.get("registry"))
    plaintext_redirect = _validate_plaintext_redirect(pid, m.get("plaintext_redirect"))
    requested = set()
    if arts["rooted"]:
        requested.add("rooted-artifact")
    if any(scope == "system" for scope in unit_scopes.values()):
        requested.add("system-unit")
    if plaintext_redirect:
        requested.add("plaintext-redirect")
    capabilities = sorted(requested & {"rooted-artifact", "system-unit"})
    surfaces = set(requested)
    if arts["serve_ports"]:
        surfaces.add("serve-port")
    if serve or https_registries:
        surfaces.add("serve-https")
    surfaces = sorted(surfaces)
    surface_classifications = {
        surface: ("elevated-capability" if surface in {"rooted-artifact", "system-unit"}
                  else "shipped-only-restricted" if surface == "plaintext-redirect"
                  else "baseline-mediated-mapping")
        for surface in surfaces
    }
    # Serve surfaces must be pairwise disjoint per app (structural half):
    # a config key may serve exactly one of {serve_ports (bare or
    # serve.https-mapped)} or {plaintext_redirect public/redirect}. The
    # orchestrator applies cmd_plaintext's rows in config order
    # (install/airlock-install.sh) and a ledger serve mapping
    # separately — a key declared in both surfaces gets two competing
    # rows for the same listen, and whichever runs last silently wins
    # (a 301 redirect replaced by a proxy to a dead port, in the
    # reported repro). The resolved-VALUE half (two DIFFERENT keys that
    # happen to share one config value) is checked in packages_resolved,
    # once actual port numbers are known.
    # F6: install.sh and smoke.sh are the two lifecycle scripts the installer
    # runs for a manifest-bearing package; deactivate.sh is optional.
    lifecycle = {}
    for script, required in (("install.sh", True), ("smoke.sh", True),
                             ("deactivate.sh", False)):
        sp = pdir / script
        lifecycle[script.removesuffix(".sh")] = os.path.lexists(sp)
    return {
        "dir": str(pdir),
        "contract": contract,
        "deps": deps,
        "schema": schema,
        "prerequisites": prereqs,
        "artifacts": arts,
        "unit_scopes": unit_scopes,
        "serve": serve,
        "https_registries": https_registries,
        "data_registries": data_registries,
        "plaintext_redirect": plaintext_redirect,
        "source_class": source_class,
        "requested_capabilities": sorted(requested),
        "effective_capabilities": sorted(requested),
        "capabilities": capabilities,
        "certifications": [],
        "surfaces": surfaces,
        "surface_classifications": surface_classifications,

        "tile": tile,
        "icon": icon,
        "audience": audience,
        "lifecycle": lifecycle,
    }


def cmd_package_preview(cfg: dict, raw_path: str) -> "None":
    """Preview only the selected directory through the engine's package resolver."""
    path = _expanduser(str(raw_path or ""))
    if not path.is_absolute():
        path = find_config().parent / path
    pdir = path.resolve()
    pid = _read_manifest_document(None, pdir).get("id")
    output = io.StringIO()
    with contextlib.redirect_stdout(output):
        cmd_dir_package_info(cfg, pid, str(pdir))
    package = json.loads(output.getvalue())["packages"][pid]
    print(json.dumps({
        "id": pid,
        "path": str(pdir),
        "package": package,
        "requested_capabilities": package["requested_capabilities"],
        "effective_capabilities": package["effective_capabilities"],
        "grants": [],
        "rejected_capabilities": [],
        "installable": True,
    }, indent=2, sort_keys=True))


def packages_resolved(cfg: dict) -> dict:
    """PackageSpecs cross-checked against the resolved config: serve-port
    values, port-span values, and disjoint ownership (D1/D2). Fatal on any
    violation; {} when no packages are configured."""
    specs = package_specs(cfg)
    if not specs:
        return {}
    r_apps = resolved(cfg).get("apps", {})
    out = {}
    for pid, spec in specs.items():
        app_table = r_apps.get(pid) or dict(spec["schema"]["defaults"])
        registry_mappings, registry_rows, registry_projections = _resolve_registries(
            pid, spec, app_table)
        active_serve = {}
        inactive_serve_keys = set()
        for key, mapping in spec["serve"].items():
            enabled_key = mapping.get("enabled_key")
            if enabled_key is not None:
                enabled = app_table.get(enabled_key)
                if not enabled:
                    inactive_serve_keys.add(key)
                    continue
            active_serve[key] = mapping
        spv = {}
        for key in spec["artifacts"]["serve_ports"]:
            if key in inactive_serve_keys:
                continue
            spv[key] = app_table.get(key)
        serve_mappings = {key: {"listen": val, "mode": "http", "target": val}
                          for key, val in spv.items()}
        for key, mapping in active_serve.items():
            target = app_table.get(mapping["target_key"])
            serve_mappings[key] = {"listen": spv.get(key), "mode": mapping["mode"],
                                   "target": target}
        for key, mapping in registry_mappings.items():
            serve_mappings[key] = mapping
            spv[key] = mapping["listen"]
        redirect_mappings = _plaintext_redirect_mappings(spec, app_table)
        serve_mappings.update(redirect_mappings)
        spv.update({key: mapping["listen"] for key, mapping in redirect_mappings.items()})
        # Serve surfaces must be pairwise disjoint per app (resolved-value
        # half): two DIFFERENT keys can still resolve to the same port
        # number once the operator's actual config values are known.
        redirect_ports: dict[int, str] = {}
        for public_key, redirect_key in spec["plaintext_redirect"].items():
            for k in (public_key, redirect_key):
                v = app_table.get(k)
                if isinstance(v, int) and not isinstance(v, bool):
                    redirect_ports[v] = k
        spans = []
        for span in spec["schema"]["port_spans"]:
            base = app_table.get(span["base"])
            count = app_table.get(span["count"])
            spans.append([span["base"], base, count])
        arts_out = {c: list(spec["artifacts"][c]) for c in ARTIFACT_CLASSES}
        arts_out["serve_ports"] = [
            key for key in arts_out["serve_ports"]
            if key not in inactive_serve_keys
        ]
        arts_out["serve_ports"].extend(sorted(registry_mappings))
        arts_out["serve_ports"].extend(sorted(redirect_mappings))
        if spec["icon"] is not None:
            # The engine records this app's staged icon directory.
            arts_out["webroot"] = arts_out["webroot"] + [f"assets/apps/{glob.escape(pid)}"]
        out[pid] = dict(spec, artifacts=arts_out, serve=active_serve,
                        serve_port_values=spv, serve_mappings=serve_mappings,
                        serve_registry_rows=registry_rows,
                        registry_projections=registry_projections,
                        port_span_values=spans,
                        # The resolved plaintext_redirect ports (public AND
                        # redirect — a redirect target is a real bound
                        # socket too), for _validate_disjoint's cross-app
                        # and built-in ownership checks (Major N1): the
                        # intra-app check above stops at this package's own
                        # boundary, so a distinct package (or the built-in
                        # registry) declaring the identical port was
                        # invisible to ownership until this rides along.
                        # A sorted list, not a set: this dict is JSON-dumped
                        # whole by cmd_package_info for bin/airlock-ledger to
                        # consume, and a set is not JSON-serializable.
                        plaintext_redirect_ports=sorted(redirect_ports))
    return out


def dependency_order(names: list[str], deps: dict[str, list[str]]) -> list[str]:
    """Dependencies first; input order breaks ties. Unresolved cycles retain input order."""
    configured = set(names)
    pos = {n: i for i, n in enumerate(names)}   # config input order, for ties
    edges: dict = {n: set() for n in names}   # X -> {Y}: X runs before Y
    indeg = {n: 0 for n in names}

    def add(x, y):
        if y not in edges[x]:
            edges[x].add(y)
            indeg[y] += 1

    for pid, required in deps.items():
        if pid not in configured:
            continue
        for dep in required:
            if dep in configured:
                add(dep, pid)
    ready = sorted((pos[n], n) for n in names if indeg[n] == 0)
    heapq.heapify(ready)
    order = []
    while ready:
        _, n = heapq.heappop(ready)
        order.append(n)
        for m in sorted(edges[n]):
            indeg[m] -= 1
            if indeg[m] == 0:
                heapq.heappush(ready, (pos[m], m))
    if len(order) != len(names):
        # A dependency cycle: the stuck nodes never reach indeg 0. Append
        # them in original config order instead of refusing the install —
        # their relative order among themselves is unresolvable, but a total
        # order over every configured app is still produced (and the loop
        # above already terminated: Kahn's queue only shrinks).
        seen = set(order)
        order.extend(n for _, n in sorted((pos[n], n) for n in names if n not in seen))
    return order


def app_order(cfg: dict) -> list:
    """Order configured apps by their real manifest edges, preserving input-order ties."""
    return dependency_order(list(cfg.get("apps") or {}),
                            {app: spec["deps"] for app, spec in package_specs(cfg).items()})


# ---- shipped apps ---------------------------------------------------------


def _shipped_root() -> Path:
    return Path(os.environ.get("AIRLOCK_SHIPPED_APPS_ROOT")
                or Path(__file__).resolve().parent.parent / "apps")


def _shipped_dirs(cfg: dict) -> dict:
    """{id: pdir} for every entry under the shipped root that could resolve
    as an implicit shipped package — same canonical-containment and
    regular-non-symlink-manifest rules package_specs applies at its shipped-
    detection step (`bin/airlock-config` sources-building loop), but scanning
    the WHOLE shipped root instead of only ids already named in
    `[apps.*]` — regardless of whether the id is currently configured (F15
    amendment: the listing is config-independent; only hub/core and shadowed
    ids are excluded here)."""
    root = _shipped_root()
    root_real = os.path.realpath(root)
    installed_dirs = {}
    if cfg:  # catalog/init inspect the shipped tree without box state
        ledger = _ledger_module()
        try:
            installed_dirs = ledger.app_dirs({})
        except ledger.LedgerError as exc:
            die(f"cannot resolve installed app directories: {exc}", code=2)
    out = {}
    if not os.path.isdir(root):
        return out
    for app_dir in sorted(root.iterdir()):
        pid = app_dir.name
        if pid in RESERVED_PACKAGE_IDS:
            continue
        if (pid in installed_dirs
                and os.path.realpath(installed_dirs[pid]) != os.path.join(root_real, pid)):
            continue
        if PACKAGE_ID_RE.fullmatch(pid) is None:
            continue
        if not app_dir.is_dir() or app_dir.is_symlink():
            continue
        if os.path.realpath(app_dir) != os.path.join(root_real, pid):
            continue
        manifest = app_dir / MANIFEST_NAME
        if not _regular_file(manifest):
            continue
        out[pid] = app_dir
    return out


def known_builtin_specs(cfg: dict) -> dict:
    """{id: PackageSpec} for every shipped id whose manifest actually
    parses. Best-effort (F15 amendment: 'shipped ids with PARSEABLE regular
    non-symlink manifests') — reuses `_parse_manifest_spec`, the identical
    parser `package_specs` uses for a configured package (one manifest
    reader; no drifting hand-rolled second copy), but here a manifest
    violation excludes the id instead of aborting the whole scan: this
    command must stay usable to DIAGNOSE a box, including one where some
    OTHER shipped app's manifest happens to be broken, not join the set of
    things that can wedge every install."""
    out = {}
    for pid, pdir in _shipped_dirs(cfg).items():
        try:
            out[pid] = _parse_manifest_spec(pid, pdir, "shipped")
        except SystemExit:
            continue
    return out


def cmd_known_builtins(cfg: dict) -> "None":
    for pid in sorted(known_builtin_specs(cfg)):
        print(pid)


# Upstream build availability is not manifest grammar: airlock-app.toml has no
# key for "this app has no arm64 build". `orca` is the only shipped app with the
# limit, and it enforces it in its own installer (apps/orca/install.sh refuses
# any arch but x86_64) rather than in its manifest. Recorded here instead of
# adding a manifest key because a schema addition drags install/test-manifest.sh
# and the render goldens along for an app the launcher task has already agreed
# may be dropped (docs/tasks/active/macos-app-launcher.md, "Owner decisions").
# install/test-catalog.sh asserts this table still matches that installer guard,
# so the two cannot drift apart in silence.
ARCH_LIMITS = {"orca": ["x86_64"]}


def cmd_catalog() -> "None":
    """Every shipped app a launcher could offer to install — answered with NO
    airlock.toml in existence.

    This is the one question that necessarily precedes a config: a picker has
    to show what is installable before the operator has chosen anything, and
    every other subcommand runs after `load()` (see main). It is a projection
    of `known_builtin_specs`, so it reads manifests through the same parser an
    actual install uses and cannot drift from what would really be installed.

    Two absences are deliberate, not gaps:

    - `hub` never appears. It is a RESERVED_PACKAGE_IDS platform core with no
      apps/hub tree — always installed, never a choice, so a picker that
      offered it would be offering to switch off the entrance.
    - An app may carry `tile: null` (feedback today): a backend with no
      launcher entry. It stays in the output because the catalog is a faithful
      projection of the tree; rendering nothing for it is the caller's job,
      exactly as hub/index.html already does for the same case in webjson.

    `arch` is reported, not applied. Emitting the constraint instead of
    filtering on the running host keeps this output a function of the tree
    alone — testable, and identical whether it runs on the Mac or inside the
    Linux machine. The caller compares it against its own architecture.
    ("The tree" is the shipped root, which AIRLOCK_SHIPPED_APPS_ROOT selects;
    the operator's airlock.toml never reaches this command.)

    `unavailable` lists shipped ids that are present in the tree but produced no
    installable app — a manifest that will not parse, one that cannot be read, or
    a directory the shipped-root rules exclude. It is normally empty, and a caller
    that ignores it silently loses apps.
    """
    root = _shipped_root()
    try:
        dirs = _shipped_dirs({})
    except OSError as e:
        # An unreadable root (wrong permissions, a broken mount) used to surface
        # as a raw traceback. Guarded here rather than inside _shipped_dirs,
        # which known-builtins also calls: this command is the one
        # a GUI shells out to, and a traceback is not a message it can show.
        die(f"cannot read the shipped app root {root}: {e}")
    if not dirs:
        # An empty catalog is never a real answer: this repository ships apps, so
        # zero of them means the root is wrong (AIRLOCK_SHIPPED_APPS_ROOT points
        # somewhere else, or this is not an Airlock checkout) — not that there is
        # nothing to install. Returning `{"apps": []}` with exit 0 would render as
        # an empty picker with no error, which is the failure looking like success.
        die(f"no app manifests under {root} — this is not an Airlock checkout, or "
            "AIRLOCK_SHIPPED_APPS_ROOT points at the wrong tree.")
    specs = known_builtin_specs({})
    # known_builtin_specs is best-effort by contract: a shipped id whose manifest
    # does not parse is DROPPED so that one broken app cannot wedge a diagnostic
    # scan. Right for that command, silent for this one — a picker would simply
    # not show the app, and nobody would learn why.
    #
    # `dirs` is NOT the right set to subtract from. _shipped_dirs filters through
    # _regular_file, which turns every OSError into False, so a manifest that
    # cannot be stat'd is already gone before this line and would be missing from
    # BOTH lists. Scan the root's own entries instead: anything that looks like a
    # shipped app and did not produce a spec gets named, whatever the reason.
    candidates = set()
    for entry in root.iterdir():
        pid = entry.name
        if pid in RESERVED_PACKAGE_IDS or PACKAGE_ID_RE.fullmatch(pid) is None:
            continue
        # os.path.lexists is NOT usable here: like _regular_file it answers False
        # for "no such entry" and for "cannot tell", which is the exact conflation
        # this scan exists to undo. lstat separates them — FileNotFoundError means
        # there is genuinely no manifest (not an app, skip it), any other OSError
        # means we could not look, and something we cannot look at is precisely
        # what must be reported rather than silently dropped.
        try:
            if not entry.is_dir():
                continue
            (entry / MANIFEST_NAME).lstat()
        except FileNotFoundError:
            continue
        except OSError:
            candidates.add(pid)
            continue
        candidates.add(pid)
    # Union with `dirs`, not just this scan's own findings. The tree is walked more
    # than once (here, and inside known_builtin_specs); an entry that vanished
    # between the walks would otherwise be absent from candidates AND from specs,
    # which is the silent loss this field exists to prevent. Seen once is enough.
    unavailable = sorted((candidates | set(dirs)) - set(specs))
    apps = []
    for pid in sorted(specs):
        spec = specs[pid]
        entry = {
            "id": pid,
            "tile": spec["tile"],
            "requires": spec["deps"],
            "audience": spec["audience"],
            "prerequisites": spec["prerequisites"],
        }
        if pid in ARCH_LIMITS:
            entry["arch"] = list(ARCH_LIMITS[pid])
        apps.append(entry)
    if not apps:
        # The root held entries but none of them yielded an installable app. Same
        # reasoning as the empty-root case above, one step later: exiting 0 with an
        # empty list hands a picker "Airlock ships nothing" and no way to say why.
        detail = (f"{len(unavailable)} entr(ies) yielded no manifest: "
                  + ", ".join(unavailable)) if unavailable else "every entry was excluded"
        die(f"no installable app under {root} — {detail}.")
    print(json.dumps({"apps": apps, "unavailable": unavailable},
                     indent=2, sort_keys=True))


_TOML_ESCAPES = {"\\": "\\\\", '"': '\\"', "\b": "\\b", "\t": "\\t",
                 "\n": "\\n", "\f": "\\f", "\r": "\\r"}


def _toml_str(value: str) -> str:
    """Quote a value as a TOML basic string.

    NOT json.dumps. JSON and TOML agree on most of this, and disagree on the one
    case that matters: json.dumps defaults to ensure_ascii, which spells a non-BMP
    character as a UTF-16 surrogate pair (`\\ud83d\\ude00`), and TOML forbids
    escaped surrogates outright. So `--site-name '\N{GRINNING FACE} home'` produced a
    file that no TOML parser would read, and the operator met that as a validate
    error several screens after naming their box.

    TOML files are UTF-8, so everything printable goes in literally; only the
    quote, the backslash, and the C0 controls (plus DEL) need escaping.
    """
    out = []
    for ch in value:
        if ch in _TOML_ESCAPES:
            out.append(_TOML_ESCAPES[ch])
        elif ch < " " or ch == "\x7f":
            out.append(f"\\u{ord(ch):04X}")
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def cmd_init(owner: str, site_name, selected: list) -> "None":
    """Write the smallest airlock.toml that validates, to STDOUT.

    The macOS launcher's picker (docs/tasks/active/macos-app-launcher.md,
    Phase 1b) is mechanically this: one real input — a Tailscale login — plus
    one table per ticked app. airlock.toml.example is 186
    lines and shows a port for nearly every app, which reads as "choose twenty
    ports"; every one of them is defaulted by the manifests, so none of that
    belongs in a generated file.

    STDOUT, not a file. There is then no path to clobber and no --force to get
    wrong, and the caller redirects. It also means this command can be tested
    without a filesystem.

    Two things it does NOT do:

    - It does not know about architecture. The apps run in the Linux
      environment, whose arch is not this machine's; `catalog` reports each
      app's constraint and the caller compares. Guessing here would refuse
      orca on an amd64 machine driven from an arm64 Mac.
    - It does not resolve paths. Whatever string is passed becomes the value:
      inside an OrbStack machine the Mac's files live under /mnt/mac, and only
      the caller knows which side of that boundary it is naming.
    """
    catalog = known_builtin_specs({})
    # Close the dependency set rather than emitting a config that fails at
    # validate (notepad without publish dies in app_order). Closing it silently
    # would install an app nobody ticked, so the additions are reported — one
    # place owns the rule, and the caller can still say why the box grew an app.
    requested = []
    for value in selected:
        if value in catalog or value == "hub":
            requested.append(value)
        else:
            requested.extend(part if part in catalog else part.strip()
                             for part in value.split(",") if part.strip())
    chosen, added = set(requested) - {"hub"}, set()
    frontier = list(chosen)
    while frontier:
        pid = frontier.pop()
        if pid not in catalog:
            die(f"app '{pid}' is not shipped in this checkout — "
                "`airlock-config catalog` lists what it ships", code=2)
        for dep in catalog[pid]["deps"]:
            if dep not in chosen:
                chosen.add(dep)
                added.add(dep)
                frontier.append(dep)
    if added:
        print("added as dependencies: " + ", ".join(sorted(added)), file=sys.stderr)
    # Dependencies before dependents, ties alphabetical. app_order re-derives the
    # real order from manifest edges anyway; this only makes the FILE readable and
    # its byte layout a deterministic function of the inputs.
    ordered, placed = [], set()
    for pid in sorted(chosen):
        stack, on_stack = [pid], {pid}
        while stack:
            cur = stack[-1]
            # `d in chosen` matters: without it this loop closes the dependency
            # set a SECOND time, quietly. Two owners of one rule, and the quiet
            # one wins — delete the closure above and every dependency still
            # lands in the file, just with no "added as dependencies" line to
            # tell the operator. Ordering orders; closing is done, once, above.
            # `d not in on_stack` breaks a dependency cycle instead of
            # re-descending into it forever: `placed` only stops an app being
            # EMITTED twice, never being VISITED again, so without this the
            # loop would spin on an a -> b -> a manifest defect.
            pending = [d for d in sorted(catalog[cur]["deps"])
                       if d in chosen and d not in placed and d not in on_stack]
            if pending:
                nxt = pending[0]
                stack.append(nxt)
                on_stack.add(nxt)
                continue
            if cur not in placed:
                placed.add(cur)
                ordered.append(cur)
            on_stack.discard(stack.pop())
    lines = ["[airlock]", "config_version = 2"]
    if site_name:
        lines += ["", "[site]", f"name = {_toml_str(str(site_name))}"]
    lines += ["", "[auth]", 'provider = "tailscale"', f"owner = {_toml_str(owner)}"]
    # [apps.hub] is not a choice: cmd_validate requires it ("the entrance") and
    # it is a RESERVED_PACKAGE_ID with no apps/hub tree, so it never appears in
    # `catalog` either. A picker cannot offer to switch off the front door.
    lines += ["", "[apps.hub]"]
    lines += [f"[apps.{_toml_str(pid)}]" for pid in ordered]
    print("\n".join(lines))


def _plaintext_redirect_mappings(spec: dict, table: dict) -> dict:
    """Resolve declared plaintext listeners for the engine's ingress step."""
    mappings = {}
    seen = set()
    for public_key, redirect_key in sorted(spec["plaintext_redirect"].items()):
        listen, target = table.get(public_key), table.get(redirect_key)
        if (isinstance(listen, int) and not isinstance(listen, bool)
                and isinstance(target, int) and not isinstance(target, bool)
                and listen not in seen):
            seen.add(listen)
            mappings[public_key] = {"listen": listen, "mode": "http", "target": target}
    return mappings


def cmd_icon_src(cfg: dict, app: str) -> "None":
    """F4 staging re-check: re-run the strict-resolve/regular/readable/
    contained validation at the moment the orchestrator is about to copy
    (validate-to-stage TOCTOU), then print two lines — the resolved source
    path and the webroot-relative destination. No output = no icon to stage."""
    specs = package_specs(cfg, {app})
    spec = specs.get(app)
    if spec is None or spec["icon"] is None:
        return
    icon = _validate_icon_source(app, Path(spec["dir"]), spec["tile"]["icon"])
    print(icon["src"])
    print(icon["dest"])


def cmd_icon_stage(cfg: dict, app: str) -> "None":
    """Revalidate and atomically stage the app's declared tile icon."""
    specs = package_specs(cfg, {app})
    spec = specs.get(app)
    if spec is None:
        return
    if spec["icon"] is None:
        return
    icon = _validate_icon_source(app, Path(spec["dir"]), spec["tile"]["icon"])
    base = Path(os.path.realpath(str(_artifact_roots()["webroot"])))
    d = base
    for comp in ("assets", "apps", app):
        d = d / comp
        if not os.path.lexists(d):
            try:
                os.mkdir(d)
            except OSError as e:
                die(f"package '{app}': cannot create {d}: {e}")
    name = Path(icon["dest"]).name
    target = d / name
    src_fd = os.open(icon["src"], os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(src_fd, "rb") as fh:
        data = fh.read()
    tmp = d / f".{name}.staging"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW,
                     0o644)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.replace(tmp, target)
    except OSError as e:
        die(f"package '{app}': staging write failed: {e}")
    print(icon["dest"])


def _prereq_tsv_path() -> Path:
    env = os.environ.get("AIRLOCK_PREREQUISITES", "").strip()
    if env:
        return Path(env)
    return Path(__file__).resolve().parent.parent / "install" / "prerequisites.tsv"


def _prerequisite_rows(specs: dict, path: Path) -> list[list[str]]:
    """Assemble core rows and the already selected package prerequisites."""
    rows = []
    for rawline in path.read_text(encoding="utf-8").splitlines():
        if not rawline or rawline.startswith("#"):
            continue
        fields = rawline.split("\t")
        if fields[0] not in specs:
            rows.append(fields)
    for pid, spec in sorted(specs.items()):
        for row in spec.get("prerequisites", []):
            rows.append([pid, row["command"], row["predicate"], row["expected"],
                         row["fix"], row["note"]])
    return rows


def cmd_prereqs(cfg: dict) -> "None":
    """Serialize the canonical assembled rows as the legacy TSV view.

    Owner replacement and manifest row appending belong to _prerequisite_rows.
    Executable/version evaluation belongs to preflight. Row order and cardinality
    are preserved; a manifest with no prerequisites replaces its old TSV rows.
    """
    try:
        specs = package_specs(cfg)
    except SystemExit as e:
        raise SystemExit(2) from e
    path = _prereq_tsv_path()
    try:
        rows = _prerequisite_rows(specs, path)
    except (OSError, UnicodeError) as e:
        die(f"prerequisites declaration file not readable: {path} ({e})", code=2)
    for row in rows:
        print("\t".join(row))


def cmd_package_info(cfg: dict, selected: list[str] | None = None) -> "None":
    """Everything bash needs about resolved apps, as one JSON object. Consumed
    by the orchestrator and bin/airlock-ledger (which parses no TOML).

    ``site.company_repo`` rides along because it is the same class of fact:
    configuration this box reads, handed to a consumer that parses no TOML.
    Absent, the key is an empty string — a box with no Company source is a
    normal state, not an error."""
    if selected is not None:
        cfg = copy.deepcopy(cfg)
        cfg["apps"] = {pid: (cfg.get("apps") or {}).get(pid, {}) for pid in selected}
        package_specs(cfg, set(selected))
    rendered = json.dumps({
        "config_path": str(find_config()),
        "order": app_order(cfg),
        "company_repo": str((resolved(cfg).get("site") or {}).get("company_repo") or ""),
        "packages": packages_resolved(cfg),
    }, indent=2, sort_keys=True)
    print(rendered)


def cmd_dir_package_info(cfg: dict, package_id: str, raw_dir: str) -> "None":
    """Resolve one directory with the same parser and config resolver as package-info.

    Configured apps retain their operator values; an app absent from config uses
    manifest defaults. The directory supplied by the engine owns source selection.
    """
    pdir = Path(_expanduser(raw_dir)).resolve()
    if not PACKAGE_ID_RE.fullmatch(package_id):
        die(f"package id {package_id!r} is not a valid id", code=2)
    shipped = os.path.realpath(pdir) == os.path.join(os.path.realpath(_shipped_root()), package_id)
    spec = _parse_manifest_spec(package_id, pdir, "shipped" if shipped else "explicit")
    candidate = copy.deepcopy(cfg)
    candidate.setdefault("apps", {}).setdefault(package_id, {})
    _SPEC_CACHE[_spec_cache_key(candidate)] = (candidate, {package_id: spec})
    print(json.dumps({"packages": packages_resolved(candidate)}, indent=2, sort_keys=True))


def cmd_canonical_package_info(cfg: dict, package_id: str,
                               source_repository_id: str,
                               source_sha: str) -> "None":
    """Emit the stable release-boundary projection for one admitted package.

    Repository identity and commit are caller assertions because this tool's
    config may point outside its own checkout.  The release layer already owns
    that pinned source boundary; guessing it here would create false provenance.
    """
    package_specs(cfg, {package_id})
    packages = packages_resolved(cfg)
    spec = packages[package_id]
    out = {
        "package_id": package_id,
        "schema_version": 1,
        "source_repository_id": source_repository_id,
        "source_sha": source_sha,
        "surfaces": list(spec["surfaces"]),
        "surface_classifications": dict(spec["surface_classifications"]),

    }
    sys.stdout.write(json.dumps(out, sort_keys=True, separators=(",", ":")) + "\n")


def cmd_apps(cfg: dict) -> "None":
    for name in app_order(cfg):
        print(name)


# Tailnet-facing PLAINTEXT ports, by app. These never carry content: each is
# wired to the app's redirect_port, whose only response is a 301 to https.
_PLAINTEXT_PORT_KEYS = ("http_port", "public_port")


def cmd_plaintext(cfg: dict) -> "None":
    """`<app> <listen_port> <redirect_port>` per enabled app with a plaintext port.

    The orchestrator owns this wiring (it must happen AFTER nginx is reloaded, or
    the plaintext port would point at a redirect server nginx is not serving yet)
    and uses the same list to retire mappings that config no longer asks for.
    """
    packaged = packages_resolved(cfg)
    for name, table in sorted(resolved(cfg).get("apps", {}).items()):
        if name in packaged:
            # A packaged app's plaintext surface is its DECLARED serve ports
            # only — a generic sweep row would create a mapping no ledger
            # record names, unreclaimable after removal.
            continue
        redirect = (table or {}).get("redirect_port")
        if not redirect:
            continue
        for k in _PLAINTEXT_PORT_KEYS:
            if k in table:
                print(f"{name}\t{table[k]}\t{redirect}")
                break
    # Manifest-bearing apps: a row is MODE-derived, never class/key-derived —
    # printing straight from serve_port_values (raw ints, mode-blind) gave a
    # package that declares BOTH serve.https and a plaintext_redirect-less
    # bare serve_ports key an http row for its HTTPS listen port too, which
    # the orchestrator then created as a real (wrong) http listener that
    # plaintext-known's mode filter correctly excluded — an unsweepable
    # mistake. A row exists iff (a) an explicit 301 pairs two declared keys
    # (plaintext_redirect), or (b) a serve_mappings entry is ITSELF mode
    # "http" (a bare declared serve_ports key with no [serve.https]
    # override) — for both source classes; nothing else ever emits a row.
    for pid, pkg in sorted(packaged.items()):
        table = resolved(cfg).get("apps", {}).get(pid) or dict(pkg["schema"]["defaults"])
        # Built from ONE (listen -> row) table, not printed as each surface
        # is walked: package_specs/packages_resolved already refuse a
        # manifest that lets two surfaces name the same listen, but this is
        # the internal backstop — even if that validation were bypassed (a
        # hand-built package-info, a future bug), one listen can still only
        # ever emit ONE row here, never two competing ones for the
        # orchestrator to apply in an order-dependent, silently-last-wins
        # sequence.
        rows: dict[int, tuple[int, int]] = {}
        for public, redirect in sorted(pkg["plaintext_redirect"].items()):
            rows[table[public]] = (table[public], table[redirect])
        for _key, mapping in sorted(pkg["serve_mappings"].items()):
            if mapping["mode"] == "http":
                rows[mapping["listen"]] = (mapping["listen"], mapping["target"])
        for listen, target in (rows[k] for k in sorted(rows)):
            print(f"{pid}\t{listen}\t{target}")


def cmd_plaintext_retirement_known() -> "None":
    for port in sorted({entry["listen"] for entry in
                        _read_plaintext_retirement()["entries"]
                        if entry["state"] == "committed"}):
        print(port)


def _shipped_plaintext_redirect_defaults() -> set:
    """DEFAULT public-port values of every SHIPPED manifest's
    plaintext_redirect, obtained from the common manifest parser's
    shadow-agnostic shipped view — REGARDLESS of current config.

    This fallback predates the independent plaintext retirement sidecar. A
    shipped manifest persists in-tree even when the app is fully removed
    from airlock.toml, so its DEFAULT value remains knowable — the same
    backstop APP_DEFAULTS gives a removed built-in. A committed sidecar row
    is now the authoritative recovery path for an operator-picked custom
    plaintext_redirect port; this scan still covers old/pre-sidecar boxes.

    Best-effort and read-only: a missing/malformed manifest contributes
    nothing rather than failing the whole sweep (nothing here grants
    removal authority — it only ever feeds a conservative stale-port list).
    """
    ports = set()
    # Empty cfg is deliberate: stale-default retirement is shadow-agnostic.
    # `known_builtin_specs` walks every canonical bundle entry and uses the
    # same complete manifest parser result as configured packages;
    # this function never opens TOML itself.
    for spec in known_builtin_specs({}).values():
        defaults = spec["schema"]["defaults"]
        for public_key in spec["plaintext_redirect"]:
            v = defaults.get(public_key)
            if isinstance(v, int) and not isinstance(v, bool):
                ports.add(v)
    return ports


def cmd_plaintext_known(cfg: dict) -> "None":
    """Every plaintext port Airlock could own — defaults AND configured values.

    Used to retire `tailscale serve` mappings for apps that were removed from
    airlock.toml. Committed plaintext-retirement rows preserve exact package
    custom ports; built-in/shipped defaults retain compatibility for mappings
    created before that sidecar existed. The installer turns off only ports in
    this conservative union and never an unrecognised live listener.

    Mode-aware (child 4): the consumer, `ts_stale_plaintext_ports`, only ever
    retires a PLAIN http listener (it skips any live TCP entry tailscale
    marks HTTPS) — so this list must carry http-mode ports only. A packaged
    app's `serve.https` mapping shares the SAME config key/port space as a
    plain declared `serve_ports` value; mixing an https-mode port into this
    set would misname it as "ours to sweep as plaintext" even though it was
    never a plaintext mapping.
    """
    ports = {entry["listen"] for entry in
             _read_plaintext_retirement()["entries"]
             if entry["state"] == "committed"}
    if os.environ.get("AIRLOCK_PROJECT_IDS") is not None:
        # The running engine already recorded the app-owned transport endpoints.
        # Reading unrelated source manifests cannot grant cleanup ownership.
        ports.update(_ledger_module().recorded_active_ports(_read_ledger(), mode="http"))
        for hub in (APP_DEFAULTS["hub"], (cfg.get("apps") or {}).get("hub") or {}):
            ports.update(value for key in _PLAINTEXT_PORT_KEYS
                         if isinstance(value := hub.get(key), int) and not isinstance(value, bool))
        for port in sorted(ports):
            print(port)
        return
    packaged = packages_resolved(cfg)
    for table in APP_DEFAULTS.values():
        for k in _PLAINTEXT_PORT_KEYS:
            v = (table or {}).get(k)
            if isinstance(v, int) and not isinstance(v, bool):
                ports.add(v)
    for name, table in (cfg.get("apps") or {}).items():
        if name in packaged:
            # A packaged app owns only its DECLARED/recorded serve values; an
            # undeclared config port was never mapped by us and must not be
            # sweepable as stale (it could be someone else's live mapping).
            continue
        for k in _PLAINTEXT_PORT_KEYS:
            v = (table or {}).get(k)
            if isinstance(v, int) and not isinstance(v, bool):
                ports.add(v)
    # Packaged serve ports are ours too — both the currently declared values and
    # every value recorded by the engine, so the stale sweep can retire a
    # REMOVED package's custom port (the D6 closure of the forgotten-port gap:
    # the config lines are gone, but the record still names the number) — but
    # only the http-mode half of that mapping set (mode-aware, above).
    for pkg in packaged.values():
        ports.update(m["listen"] for m in pkg["serve_mappings"].values()
                     if m["mode"] == "http")
    # A packaged app's plaintext_redirect public port is a genuine plaintext
    # http listener the ORCHESTRATOR maps (D2's plaintext_redirect stays
    # orchestrator-owned, not ledgered) — cmd_plaintext already emits a row
    # for it, so this list must carry it too, or removing the app leaves a
    # public port `plaintext` no longer wants but `plaintext-known` never
    # named, and the stale sweep has nothing to retire it by.
    for pid, pkg in packaged.items():
        table = resolved(cfg).get("apps", {}).get(pid) or {}
        for public_key in pkg["plaintext_redirect"]:
            v = table.get(public_key)
            if isinstance(v, int) and not isinstance(v, bool):
                ports.add(v)
    # A shipped app removed from config entirely (no [apps.X] table, no
    # packages entry) drops out of `packaged` above too — its manifest is
    # still in-tree, so its DEFAULT plaintext_redirect port is still swept.
    ports.update(_shipped_plaintext_redirect_defaults())
    ports.update(_ledger_module().recorded_active_ports(_read_ledger(), mode="http"))
    for p in sorted(ports):
        print(p)


def _dig(cfg: dict, dotted: str):
    cur = cfg
    remaining = dotted
    while remaining:
        keys = [key for key in cur if remaining == key or remaining.startswith(key + ".")] if isinstance(cur, dict) else []
        if not keys:
            die(f"key not found: {dotted}")
        part = max(keys, key=len)
        cur = cur[part]
        remaining = remaining[len(part) + 1:]
    return cur


def cmd_get(cfg: dict, dotted: str) -> "None":
    selected = None if dotted == "apps" else set()
    if dotted.startswith("apps."):
        path = dotted[len("apps."):]
        ids = set(cfg.get("apps") or {}) | set(_read_ledger())
        if app_id := os.environ.get("AIRLOCK_APP_ID"):
            ids.add(app_id)
        matches = [pid for pid in ids if path == pid or path.startswith(pid + ".")]
        selected.add(max(matches, key=len) if matches else path.split(".")[0])
    package_specs(cfg, selected)
    val = _dig(resolved(cfg), dotted)
    if isinstance(val, bool):
        print("true" if val else "false")
    elif isinstance(val, (list, dict)):
        print(json.dumps(val))
    else:
        print(val)


def _envkey(app: str, key: str) -> str:
    prefix = re.sub(r"[^A-Za-z0-9_]", "_", app).upper()
    return f"AIRLOCK_{prefix}_{key.upper()}"


def cmd_env(cfg: dict, app: str) -> "None":
    specs = package_specs(cfg, {app})
    _warn_deprecated_config(cfg, specs, only_app=app)
    r = resolved(cfg)
    if app not in r.get("apps", {}):
        die(f"app configuration source not found: {app}")
    site = r.get("site", {})
    auth = r.get("auth", {})
    paths = r.get("paths", {})
    brand = r.get("branding", {})
    collaborators = auth.get("collaborators", []) or []
    common = {
        "AIRLOCK_SITE_NAME": site.get("name", "Airlock"),
        "AIRLOCK_PRODUCT": brand.get("product", "Airlock"),
        # Empty = app favicons ship as-is. Set on a box to ring its app icons so a
        # browser tab says WHICH Airlock it is (see install/lib.sh ring_icon_svg).
        "AIRLOCK_ICON_RING": brand.get("icon_ring", ""),
        "AIRLOCK_AUTH_PROVIDER": auth.get("provider", ""),
        "AIRLOCK_IDENTITY_HEADER": identity_header(cfg),
        "AIRLOCK_OWNER": auth.get("owner", ""),
        "AIRLOCK_COLLABORATORS": ",".join(collaborators),
        "AIRLOCK_WIKI": paths.get("wiki", ""),
        # Platform, not per-app: it rides in `common` so any installer that wires an
        # agent-running tool reads the same value, without a manifest key of its own.
        "AIRLOCK_AGENT_PROVIDER": r.get("agent", {}).get("provider",
                                                         AGENT_PROVIDER_DEFAULT),
    }
    lines = [f"{k}={shlex.quote(str(v))}" for k, v in common.items()]
    for key, val in r["apps"][app].items():
        # Nested tables (e.g. [apps.publish.public_target]) are not flattened into
        # env — installers read them explicitly via `airlock-config get a.b.c`.
        if isinstance(val, dict):
            continue
        v = ("true" if val else "false") if isinstance(val, bool) else str(val)
        lines.append(f"{_envkey(app, key)}={shlex.quote(v)}")
    print("\n".join(lines))


def cmd_json(cfg: dict, selected: list[str] | None = None) -> "None":
    if selected is not None:
        package_specs(cfg, set(selected))
    out = resolved(cfg)
    if selected is not None:
        out["apps"] = {pid: table for pid, table in out.get("apps", {}).items()
                       if pid in selected}
    print(json.dumps(out, indent=2, sort_keys=True))


# Public ports the frontend may link to (external tabs). Everything else
# (gate/backend/loopback ports, owner, identity header) is deliberately omitted.
_PUBLIC_PORT_KEYS = ("https_port", "public_port")


# ── ① sources ────────────────────────────────────────────────────────────────
#
# One reader for every candidate this box can offer, so the launcher's tile map
# (webjson) and the store's three menus read the same list under the same rules.
#
# It reads NO install record. "Is this installed" is the ledger adapter's
# answer (apps/dev-monitor/backend/devmon_apps.py installed_ids), not a source's
# — a source that also answered it would be a second place for the two to
# disagree, which is the defect that shipped (an [apps.notes] table made a failed
# install read as installed).
#
# A links.toml that will not parse yields no links and one line on stderr. It
# does not die: one company's file must never be able to stop this box from
# installing, projecting or publishing anything else.
_PERSONAL_LINKS = "~/.config/airlock/links.toml"
_LINK_RESERVED_TABLES = frozenset({"links"})


def _https_url(value) -> "str | None":
    """The value when it is an https URL with a host, else None.

    Plain http is refused for the same reason a package [tile] href is: the
    browser, not this file, decides the mixed-content fight, and it decides it
    by refusing the whole page.
    """
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text:
        return None
    try:
        parsed = urlsplit(text)
        _ = parsed.port          # also rejects a malformed/out-of-range port
        host = parsed.hostname
    except ValueError:
        return None
    if parsed.scheme != "https" or not host or parsed.username or parsed.password:
        return None
    return text


def _link_table(link_id: str, table: Any, path: Path, origin: str,
                audience: str) -> "dict | None":
    """One validated link row, or None with a line on stderr saying why.

    The row is skipped whole only for the two fields the row cannot exist
    without — a name and an https url. An unusable `icon` is dropped instead,
    because a glyph beside it exists precisely for the case where the image
    does not load, and losing the link over its artwork would be backwards.
    """
    if not isinstance(table, dict):
        return None
    name = table.get("name")
    if not isinstance(name, str) or not name.strip() or any(
            ord(c) < 32 or ord(c) == 127 for c in name):
        sys.stderr.write(f"airlock-config: warning: skipping link {link_id} in "
                         f"{path}: no usable name\n")
        return None
    url = _https_url(table.get("url"))
    if url is None:
        sys.stderr.write(f"airlock-config: warning: skipping link {link_id} in "
                         f"{path}: url must be https\n")
        return None
    row = {"id": link_id, "origin": origin, "name": name.strip(), "url": url,
           "desc": str(table.get("desc") or "").strip(), "audience": audience}
    icon = _https_url(table.get("icon"))
    if table.get("icon") is not None and icon is None:
        sys.stderr.write(f"airlock-config: warning: link {link_id} in {path} has "
                         f"an icon that is not an https URL; using its glyph\n")
    if icon:
        row["icon"] = icon
    glyph = table.get("glyph")
    if isinstance(glyph, str) and glyph.strip():
        row["glyph"] = glyph.strip()
    return row


def _read_links(path: Path, origin: str, audience: str) -> list:
    try:
        raw = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return []
    except UnicodeDecodeError as e:
        # Not an OSError, and not caught by one: a links file saved in the wrong
        # encoding used to take the whole `sources` and `webjson` down with a
        # traceback, when the promise is that this file alone is skipped.
        sys.stderr.write(f"airlock-config: warning: links at {path} are not "
                         f"valid UTF-8 ({e}); skipping that file\n")
        return []
    except OSError as e:
        sys.stderr.write(f"airlock-config: warning: cannot read links at "
                         f"{path}: {e}\n")
        return []
    return _links_text(raw, path, origin, audience)


def _links_text(raw: str, path: Path, origin: str, audience: str) -> list:
    try:
        document = tomllib.loads(raw)
    except (tomllib.TOMLDecodeError, ValueError) as e:
        sys.stderr.write(f"airlock-config: warning: skipping links in {path}: "
                         f"{e}\n")
        return []
    rows = []
    for link_id in sorted(document):
        if link_id in _LINK_RESERVED_TABLES:
            continue
        if PACKAGE_ID_RE.fullmatch(link_id) is None:
            sys.stderr.write(f"airlock-config: warning: skipping link table "
                             f"[{link_id}] in {path}: not a usable id\n")
            continue
        row = _link_table(link_id, document[link_id], path, origin, audience)
        if row is not None:
            rows.append(row)
    return rows


def _tile_candidate(app_id: str, tile: Any, icon_dest=None) -> "dict | None":
    """A store row's display fields from a manifest [tile].

    `icon` is the staged hub path the launcher will fetch, not the file on the
    package directory: an app that is not installed yet has no staged icon, and
    the launcher's image -> glyph -> default chain is what turns that 404 into a
    glyph rather than a blank square.

    A manifest with no [tile] at all is a SUPPORTED app (feedback is one), and it
    draws no launcher tile — but it is still installable, updatable and already
    installed on some boxes. So it keeps a store row under its own id rather than
    disappearing from the only surface that can install it.
    """
    if not isinstance(tile, dict):
        return {"id": app_id, "name": app_id, "desc": ""}
    glyph = tile.get("glyph")
    glyph = glyph.strip() if isinstance(glyph, str) and glyph.strip() else None
    icon = icon_dest if icon_dest else tile.get("icon")
    row = {"id": app_id, "name": str(tile.get("label") or "").strip() or app_id,
           "desc": str(tile.get("sub") or "").strip()}
    if glyph:
        row["glyph"] = glyph
    if isinstance(icon, str) and icon.strip():
        row["icon"] = icon.strip()
    path = tile.get("path")
    if isinstance(path, str) and path.strip():
        row["path"] = path.strip()
    return row


def _app_icon_url(app_id: str, filename: str) -> str:
    return f"/assets/apps/{quote(app_id, safe='')}/{quote(filename, safe='')}"


def _company_app_candidates(mirror: Path, sha: str) -> list:
    """Read only manifests in the engine's pinned Company commit."""
    ledger = _ledger_module()
    entries = ledger._git_bytes(["-C", str(mirror), "ls-tree", "-z", "--name-only", f"{sha}:apps"],
                          "list Company apps")
    if entries.returncode:
        return []
    rows = []
    for raw_id in entries.stdout.split(b"\0")[:-1]:
        app_id = os.fsdecode(raw_id)
        if PACKAGE_ID_RE.fullmatch(app_id) is None:
            continue
        try:
            result = ledger._git(["-C", str(mirror), "show",
                                  f"{sha}:apps/{app_id}/{MANIFEST_NAME}"], "read Company manifest")
            if result.returncode:
                continue
            document = tomllib.loads(result.stdout)
        except (ValueError, tomllib.TOMLDecodeError) as exc:
            sys.stderr.write(f"airlock-config: warning: skipping Company app {app_id}: {exc}\n")
            continue
        if document.get("id", app_id) != app_id:
            continue
        tile = document.get("tile")
        icon = tile.get("icon") if isinstance(tile, dict) else None
        dest = _app_icon_url(app_id, Path(icon.strip()).name) if isinstance(icon, str) and icon.strip() else None
        rows.append(_tile_candidate(app_id, tile, dest))
    return rows


def read_sources(cfg: dict) -> dict:
    """① — every candidate this box can offer, with the origin that decides reach.

    Returns {"apps": {"public": [...], "company": [...], "personal": [...]},
             "links": [...], "links_path": str, "company_repo": str|None}
    where `company_repo` is the configured source read through the engine mirror,
    or None when its pinned commit could not be read.

    An id appears once. An app beats a link, and among apps a later origin
    beats an earlier one, so a Company app wins over the same id registered as
    a personal package and a shipped app wins over both. Every dropped duplicate
    is named on stderr rather than silently losing its row.
    """
    personal_links = _expanduser(_PERSONAL_LINKS)
    # 🔴 ONE Company key. `[site] company_repo` is the one that says where the
    # Company repository is (P3_ENGINE PR1, #856).
    #
    # The engine owns the Company mirror and the commit used by apply/plan.
    site = cfg.get("site") or {}
    declared = site.get("company_repo") if isinstance(site, dict) else None
    declared = declared.strip() if isinstance(declared, str) else ""
    repo, company_rows, company_links = None, [], []
    if declared:
        ledger = _ledger_module()
        try:
            mirror = ledger.company_mirror_path()
            ledger.fixture_boundary({"Company mirror": str(mirror)}, tools=())
            sha = ledger.pin_main({"company_repo": declared})
            company_rows = _company_app_candidates(mirror, sha)
            links = subprocess.run(["git", "-C", str(mirror), "show", f"{sha}:links.toml"],
                                   capture_output=True, check=False, timeout=60)
            if links.returncode == 0:
                try:
                    company_links = _links_text(links.stdout.decode("utf-8"), mirror / "links.toml", "company", "shared")
                except UnicodeDecodeError as exc:
                    sys.stderr.write(f"airlock-config: warning: Company links are not valid UTF-8 ({exc}); skipping that file\n")
            repo = ledger.company_repo({"company_repo": declared})
        except ledger.LedgerError as exc:
            sys.stderr.write(f"airlock-config: warning: Company source unavailable: {exc}\n")

    def candidates(specs: dict, *, local: bool = False) -> list:
        rows = []
        for pid in sorted(specs):
            row = _tile_candidate(pid, specs[pid]["tile"],
                                  None if specs[pid]["icon"] is None else _app_icon_url(pid, Path(specs[pid]["icon"]["dest"]).name))
            if local:
                row["source"] = specs[pid]["dir"]
            rows.append(row)
        return rows

    # Every configured package that is not a shipped builtin belongs in Personal;
    # only `store_rows` decides which of them this box actually has. A shipped id
    # is excluded because it is already a Public candidate, and listing it twice
    # made every `sources` call print one duplicate warning per enabled app.
    shipped = set(known_builtin_specs(cfg))
    configured = {pid: spec for pid, spec in package_specs(cfg).items()
                  if spec.get("source_class") != "builtin" and pid not in shipped}
    apps: dict = {}
    for origin, rows in (
            ("personal", candidates(configured, local=True)),
            ("company", company_rows),
            ("public", candidates(known_builtin_specs(cfg)))):
        for row in rows:
            if row is None:
                continue
            previous = apps.get(row["id"])
            if previous is not None:
                sys.stderr.write(f"airlock-config: warning: {row['id']} is "
                                 f"offered by both {previous['origin']} and "
                                 f"{origin}; keeping {origin}\n")
            apps[row["id"]] = dict(row, origin=origin)
    grouped = {"public": [], "company": [], "personal": []}
    for row in apps.values():
        grouped[row["origin"]].append(row)
    for rows in grouped.values():
        rows.sort(key=lambda row: row["id"])

    links: dict = {}
    for rows in (company_links,
                 _read_links(personal_links, "personal", "owner")):
        for row in rows:
            previous = links.get(row["id"])
            if previous is not None:
                sys.stderr.write(f"airlock-config: warning: link {row['id']} is "
                                 f"offered by both {previous['origin']} and "
                                 f"{row['origin']}; keeping {row['origin']}\n")
                continue
            links[row["id"]] = row
    kept = []
    for row in links.values():
        if row["id"] in apps:
            sys.stderr.write(f"airlock-config: warning: link {row['id']} shares an "
                             f"id with an app; the app wins\n")
            continue
        kept.append(row)
    kept.sort(key=lambda row: row["id"])

    return {"apps": grouped, "links": kept, "links_path": str(personal_links),
            "company_repo": repo}


def cmd_sources(cfg: dict) -> "None":
    """`airlock-config sources` — the ① reader, as JSON."""
    print(json.dumps(read_sources(cfg), indent=2, sort_keys=True))


def cmd_webjson(cfg: dict) -> "None":
    """Frontend-safe config for the hub launcher (served as /__airlock.json).

    Contains ONLY what the browser needs: product name and the enabled apps with
    their public port (if any). No owner, no identity header, no internal ports.
    """
    project_ids = os.environ.get("AIRLOCK_PROJECT_IDS")
    if project_ids is not None:
        package_specs(cfg, set(json.loads(project_ids)), observation=True)
    r = resolved(cfg)
    specs = package_specs(cfg)
    # WHICH apps are installed is the engine's answer, not this file's, once the
    # engine is driving: `airlock-ledger project` passes the id list it just
    # wrote to ③ (AIRLOCK_PROJECT_IDS) and a configured-but-not-installed app
    # must not appear in the launcher. Absent that variable — which is every
    # caller today except the engine — this reads airlock.toml exactly as
    # before, so no existing box changes behaviour because a var is unset.
    # Presentation (port, tile, audience) still comes from config below: an id
    # that is in ③ but has no [apps.<id>] table is a Company app, and rendering
    # its tile from the manifest is the Company 일원화 PR (card PR4), not here.
    project_ids = os.environ.get("AIRLOCK_PROJECT_IDS")
    if project_ids is not None:
        installed = set(json.loads(project_ids))
        configured = {k: v for k, v in r.get("apps", {}).items() if k in installed}
        r = dict(r, apps=configured)
    apps = {}
    for name, table in r.get("apps", {}).items():
        entry = {}
        for k in _PUBLIC_PORT_KEYS:
            if k in table:
                entry["port"] = table[k]
                break
        # Ported same-box tools navigate in-place; only a genuinely third-party
        # service marked external=true opens a new tab (see hub/index.html).
        if table.get("external"):
            entry["external"] = True
        # F14 (packaged ids only — the built-in payload is byte-identical):
        # the effective audience (so the launcher can hide owner-only tiles
        # fail-closed) and the manifest tile (data for the launcher; the
        # built-in APPS table retired in child 4/P3 — hub/index.html's
        # airlockTileMeta now reads manifest webjson tile data alone).
        spec = specs.get(name)
        if spec is not None:
            # The launcher must distinguish "packaged, declares no tile"
            # (render nothing) from hub — the only id that ever reaches
            # webjson with spec is None now (it has no apps/hub tree and
            # [packages.hub] is reserved) — which carries no "packaged" key
            # at all and is filtered out of the tile grid by name anyway.
            entry["packaged"] = True
            entry["source_class"] = spec["source_class"]
            # Always carry an audience: resolved() gives an undeclared manifest
            # the fail-closed "owner", and the launcher filter treats anything
            # that is not "shared" as owner-only. Emitting nothing here would
            # hand the launcher an undefined it has to guess about.
            entry["audience"] = table.get("audience", "owner")
            if spec["tile"] is not None:
                tile = {"label": spec["tile"]["label"],
                        "sub": spec["tile"]["sub"],
                        "cat": spec["tile"]["cat"]}
                if spec["tile"]["path"] is not None:
                    tile["path"] = spec["tile"]["path"]
                if spec["tile"]["glyph"] is not None:
                    tile["glyph"] = spec["tile"]["glyph"]
                if spec["icon"] is not None:
                    tile["icon"] = _app_icon_url(name, Path(spec["icon"]["dest"]).name)
                entry["tile"] = tile
        apps[name] = entry
    # Links reach the launcher through this projection rather than through the
    # owner API, because a collaborator must see the company links too (owner
    # decision 2026-08-25) and the owner API is owner-only. One reader (①) feeds
    # both this and the store, so a tile and a store row cannot name a link
    # differently. `link: true` is what the launcher reads to say "this leaves
    # the Airlock gate" — `external` alone cannot, because a packaged app on its
    # own port is external too and is still behind the gate.
    for link in read_sources(cfg)["links"]:
        if link["id"] in apps:
            continue
        tile = {"label": link["name"], "sub": link["desc"], "path": link["url"]}
        if link.get("icon"):
            tile["icon"] = link["icon"]
        if link.get("glyph"):
            tile["glyph"] = link["glyph"]
        apps[link["id"]] = {"external": True, "link": True,
                            "audience": link["audience"], "tile": tile}
    out = {
        "product": r.get("branding", {}).get("product", "Airlock"),
        "site": r.get("site", {}).get("name", "Airlock"),
        "apps": apps,
    }
    # The deployment FQDN, so the launcher can build separate-port links that
    # match the TLS cert no matter which origin the page was loaded from. Not a
    # secret: it is the address the browser is already talking to. Measured by
    # the installer (AIRLOCK_TS_FQDN); absent = the launcher falls back to
    # location.hostname.
    fqdn = os.environ.get("AIRLOCK_TS_FQDN", "").strip()
    if fqdn:
        out["fqdn"] = fqdn
    print(json.dumps(out, indent=2, sort_keys=True))


def main(argv: list[str]) -> int:
    if not argv:
        die("usage: airlock-config "
            "<validate|apps|catalog|init|plaintext|get|env|json|package-preview|"
            "dir-package-info> [arg]",
            code=2)
    cmd, rest = argv[0], argv[1:]
    # `catalog` runs BEFORE load(): it answers "what could I install?", which is
    # asked when no airlock.toml exists yet. Every command below this line needs
    # one, so the dispatch cannot wait for the shared `cfg`.
    if cmd == "init":
        # Same reason as catalog: this command exists to CREATE the config that
        # every command below load() requires, so it cannot wait for one.
        owner = site_name = None
        apps: list = []
        rest_iter = iter(rest)
        for arg in rest_iter:
            if arg in ("--owner", "--site-name", "--apps"):
                value = next(rest_iter, None)
                if value is None:
                    die(f"{arg} requires a value", code=2)
                if arg == "--owner":
                    owner = value
                elif arg == "--site-name":
                    site_name = value
                else:
                    # Accumulate, do not replace: a caller that builds the list in
                    # pieces (`--apps a --apps b`) would otherwise lose the first
                    # one silently, and end up with a box missing an app nobody
                    # noticed was dropped. The catalog resolves exact IDs before
                    # interpreting legacy comma lists and their optional spaces.
                    apps.append(value)
            else:
                die(f"unknown argument for init: {arg}\n"
                    "  usage: airlock-config init --owner <login> "
                    "[--site-name <name>] "
                    "[--apps a,b,c]", code=2)
        if owner is None:
            die("init requires --owner <login>", code=2)
        cmd_init(owner, site_name, apps)
        return 0
    if cmd == "catalog":
        if rest:
            die("catalog takes no arguments", code=2)
        cmd_catalog()
        return 0
    cfg = load()
    if cmd == "validate":
        cmd_validate(cfg)
    elif cmd == "apps":
        cmd_apps(cfg)
    elif cmd == "plaintext":
        cmd_plaintext(cfg)
    elif cmd == "plaintext-known":
        cmd_plaintext_known(cfg)
    elif cmd == "plaintext-retirement-known":
        cmd_plaintext_retirement_known()
    elif cmd == "get":
        if not rest:
            die("get requires a dotted.key", code=2)
        cmd_get(cfg, rest[0])
    elif cmd == "env":
        if not rest:
            die("env requires an app name", code=2)
        cmd_env(cfg, rest[0])
    elif cmd == "json":
        cmd_json(cfg, rest or None)
    elif cmd == "webjson":
        cmd_webjson(cfg)
    elif cmd == "package-preview":
        if len(rest) != 1:
            die("package-preview requires exactly one package directory path", code=2)
        cmd_package_preview(cfg, rest[0])
    elif cmd == "package-info":
        cmd_package_info(cfg, rest or None)
    elif cmd == "dir-package-info":
        if len(rest) != 2:
            die("dir-package-info requires <package-id> <directory>", code=2)
        cmd_dir_package_info(cfg, rest[0], rest[1])
    elif cmd == "canonical-package-info":
        if len(rest) != 3:
            die("canonical-package-info requires <package-id> "
                "<source-repository-id> <full-40-hex-sha>", code=2)
        cmd_canonical_package_info(cfg, rest[0], rest[1], rest[2])
    elif cmd == "known-builtins":
        cmd_known_builtins(cfg)
    elif cmd == "sources":
        cmd_sources(cfg)
    elif cmd == "prereqs":
        cmd_prereqs(cfg)
    elif cmd == "icon-src":
        if not rest:
            die("icon-src requires an app name", code=2)
        cmd_icon_src(cfg, rest[0])
    elif cmd == "icon-stage":
        if not rest:
            die("icon-stage requires an app name", code=2)
        cmd_icon_stage(cfg, rest[0])
    else:
        die(f"unknown command: {cmd}", code=2)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
