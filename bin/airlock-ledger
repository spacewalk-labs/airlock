#!/usr/bin/env python3
"""airlock-ledger — the installed-state journal for packaged apps.

The caller owns the process-wide lock.  This tool deliberately does not take
one, and it never reads TOML: package-info JSON is its only configuration
input.

Usage:
  airlock-ledger plan
  airlock-ledger plan --dependency-snapshot <path>
  airlock-ledger intent <id>
  airlock-ledger commit <id> [--active-ports "18900 18901"]
  airlock-ledger preflight-remove <id> [--for-upgrade] [--active-ports "..."]
  airlock-ledger remove <id> [--for-upgrade] [--active-ports "..."]
  airlock-ledger teardown <id> [--active-ports "..."]
  airlock-ledger list
  airlock-ledger audit-lock-override <id>
"""
from __future__ import annotations

import copy
import glob
import hashlib
import json
import os
import pwd
import re
import shutil
import secrets
import stat
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, NoReturn


LEDGER_VERSION = 7
LEDGER_FILENAME = "app-ledger.json"
TRANSACTION_VERSION = 1
TRANSACTION_FILENAME = "install-transaction.json"
TRANSACTION_PHASES = frozenset((
    "prepared", "installing", "rolling_back", "committed", "rolled_back", "degraded",
))
TRANSACTION_TERMINAL_PHASES = frozenset(("committed", "rolled_back", "degraded"))
TRANSACTION_ACTIONS = frozenset(("fresh", "reinstall", "upgrade-diff",
                                 "upgrade-deactivate", "remove", "teardown-intent"))
RESOURCE_RESULT_SCHEMA = "airlock.resource-result/v1"
RESOURCE_RESULT_CLASSES = ("filesystem", "systemd", "docker", "ingress")
RESOURCE_RESULT_OPERATIONS = ("apply", "verify", "compensate")
RESOURCE_RESULT_STATUSES = frozenset((
    "applied", "verified", "compensated", "failed", "not_declared", "unsupported",
))
# What an install was AUTHORIZED to do, recorded on the record itself so a
# later load checks the decision admission already made instead of re-deriving
# policy against a config that may have changed since. Closed: an unknown name
# is fatal, because a reader that tolerated one would carry a claim it cannot
# check and silently drop it on the next write. Every member must be provable
# from the record's own contents — `plaintext-redirect` is deliberately absent
# because no path writes it and `_intent_record` stores nothing to check such a
# claim against, which would turn "checked" into "trusted" without saying so.
CAPABILITIES = ("rooted-artifact", "system-unit")
MANAGED_CAPABILITIES = CAPABILITIES
ARTIFACT_CLASSES = ("units", "fragments", "webroot", "files", "rooted", "serve_ports")
LEGACY_ARTIFACT_CLASSES = ("units", "fragments", "webroot", "files", "serve_ports")
PACKAGE_ARTIFACT_CLASSES = ARTIFACT_CLASSES + ("containers",)
PATH_CLASSES = ("units", "fragments", "webroot", "files", "rooted")
PRIVILEGED_CHECKPOINT_CLASSES = frozenset((("units", "system"), ("rooted", None)))
LIFECYCLE_KEYS = ("install", "smoke", "deactivate")
DESTRUCTIVE_ACTIONS = frozenset(("remove", "teardown-intent", "upgrade-deactivate"))
UNIT_SUFFIXES = (".service", ".socket", ".timer", ".path", ".target")
AUDIT_EVENT_FIELDS = ("type", "package_id", "argument", "recorded_digest",
                      "admitted_digest", "recorded_at", "receipt_sha256")
INTENT_RECORD_FIELDS_V5 = (
    "path", "digest", "artifacts_declared", "serve_port_values", "lifecycle",
    "roots", "deps", "anchors", "serve_mappings", "unit_scopes", "order",
    "source_class", "capabilities",
)
INTENT_RECORD_FIELDS_V6 = INTENT_RECORD_FIELDS_V5 + ("container_runtime",)
INTENT_RECORD_FIELDS_V7 = INTENT_RECORD_FIELDS_V6 + ("managed_authority",)
COMMITTED_RECORD_FIELDS_V5 = (
    "path", "digest", "lifecycle", "artifacts", "deps", "serve_mappings",
    "unit_scopes", "order", "roots", "source_class", "capabilities",
)
COMMITTED_RECORD_FIELDS_V6 = COMMITTED_RECORD_FIELDS_V5 + ("container_runtime",)
COMMITTED_RECORD_FIELDS_V7 = COMMITTED_RECORD_FIELDS_V6 + ("managed_authority",)
STORE_FIELDS_V5 = ("version", "entries", "events")
STORE_FIELDS_V6 = STORE_FIELDS_V5
STORE_FIELDS_V7 = STORE_FIELDS_V6
MANAGED_AUTHORITY_SCHEMA = "airlock.managed.intent-authority/v1"
MANAGED_AUTHORITY_FIELDS = (
    "anchor_sha256", "authority_membership_digest", "authority_sequence",
    "capabilities", "channel_id", "config_sha256", "core_digest",
    "core_revision", "enrollment_digest", "epoch", "fetched_public_revision",
    "installed_measurer_sha256", "lock_digest", "next_measurer_sha256",
    "organization_id", "package_digest", "promotion_receipt_digest",
    "public_tree", "publisher_key_id", "receipt_sha256", "root_key_id",
    "schema", "selection_digest", "selection_sequence", "sequence",
    "snapshot_digest", "state_digest", "target_profile",
)
MANAGED_RUN_AUTHORITY_SCHEMA = "airlock.managed.run-authorities/v1"
TRUSTED_MEASURER_ACTIVATION_SCHEMA = "airlock.trusted-measurer.activation/v1"
TRUSTED_MEASURER_TARGET = "/opt/airlock/libexec/airlock-managed-release"
TRUSTED_MEASURER_ACTIVATION_STATES = frozenset(("owed", "durable"))
CONTAINER_RUNTIME_INTENT_FIELDS = (
    "runtime", "daemon_identity", "install_nonce", "declarations",
)
CONTAINER_RUNTIME_COMMITTED_FIELDS = CONTAINER_RUNTIME_INTENT_FIELDS + ("objects",)
CONTAINER_OBJECT_FIELDS = ("id", "name")
# Mirrors PACKAGE_ID_RE in bin/airlock-config (the config owns the grammar;
# the store re-checks it so a hand-made entry cannot smuggle an id the CLI
# cannot address, e.g. one starting with '-').
_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}\Z")
_MANAGED_ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}\Z")
_MANAGED_DIGEST_RE = re.compile(r"^sha256:[0-9a-f]{64}\Z")
_GIT_OID_RE = re.compile(r"^[0-9a-f]{40}\Z")
# Deps name CONFIGURED APP ids, not package ids: in stage 3 a dependency may
# legitimately target a legacy-grammar app ([apps.My_App]), and rejecting it
# here would wedge plan/remove — including the documented per-app teardown
# escape hatch — on a config validate had already accepted. Mirrors
# APP_NAME_RE in bin/airlock-config.
_DEP_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*\Z")
# Mirrors _WILDCARD_RE in bin/airlock-config: unit claims are literal names
# ONLY (contract decision, child 4 round 5) — a glob-shaped unit name wedges
# commit permanently (unit_scopes is keyed by expanded basenames, which a
# pattern never equals) and "*.service" globs the entire system unit dir at
# teardown. The manifest reader already refuses this at validate; the store
# re-checks it here so a hand-edited record cannot smuggle one past to
# expansion/removal.
_UNIT_WILDCARD_RE = re.compile(r"[*?\[]")
_CONTAINER_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*\Z")
_CONTAINER_ID_RE = re.compile(r"^[0-9a-f]{64}\Z")
_NONCE_RE = re.compile(r"^[A-Za-z0-9_-]{16,128}\Z")
_DAEMON_ID_RE = re.compile(r"^docker:[A-Za-z0-9][A-Za-z0-9:_-]{0,255}\Z")
_PACKAGE_LABEL = "io.airlock.package"
_NONCE_LABEL = "io.airlock.install-nonce"
_PACKAGE_INFO_INPUT_SHA256: str | None = None


class LedgerError(Exception):
    """An expected, user-facing ledger failure."""


def die(message: str, code: int = 1) -> NoReturn:
    """Print one consistently-prefixed diagnostic and exit."""
    sys.stderr.write(f"airlock-ledger: {message}\n")
    raise SystemExit(code)


def fail(message: str) -> NoReturn:
    raise LedgerError(message)


def log(message: str) -> None:
    sys.stderr.write(f"airlock-ledger: {message}\n")


def is_dry_run() -> bool:
    return os.environ.get("AIRLOCK_DRY_RUN") == "1"


def _expand_path(raw: str) -> str:
    return os.path.abspath(os.path.expanduser(raw))


def state_dir() -> Path:
    env = os.environ.get("AIRLOCK_STATE_DIR")
    if env:
        # The orchestrator's shell builds the lock path from this value
        # verbatim, so the store must too. Even abspath() would diverge: it
        # collapses `..` lexically, while the shell's open() resolves any
        # symlink first — same string, two directories.
        return Path(env)
    return Path(_expand_path("~/.local/state/airlock"))


def ledger_path() -> Path:
    return state_dir() / LEDGER_FILENAME


def _real_root(raw: str) -> str:
    """Roots are canonicalised with realpath (matching airlock-config's claim
    space): a record must name the real directory, or an alias root would
    record paths a later run classifies differently."""
    return os.path.realpath(os.path.expanduser(raw))


def _canonical_artifact(path: str) -> str:
    """One path space for records and ownership comparison: the real parent
    directory plus the entry's own name. The leaf is never resolved — a
    recorded symlink is owned (and removed) as a link, not as its target.
    Trailing slashes are stripped first, or `/x/link/` would resolve the
    leaf while `/x/link` keeps it — two objects for one declaration."""
    path = os.path.expanduser(str(path))
    path = path.rstrip("/") or "/"
    parent = os.path.dirname(path) or "/"
    return os.path.join(os.path.realpath(parent), os.path.basename(path))


def _unit_dir(which: str) -> str:
    if which == "user":
        raw = os.environ.get("AIRLOCK_UNIT_DIR_USER") or "~/.config/systemd/user"
    else:
        raw = os.environ.get("AIRLOCK_UNIT_DIR_SYSTEM") or "/etc/systemd/system"
    return _real_root(raw)


def _conf_dir() -> str:
    return _real_root(os.environ.get("AIRLOCK_CONFD") or "/etc/airlock/nginx")


def _webroot() -> str:
    return _real_root(os.environ.get("AIRLOCK_WEBROOT") or "/opt/airlock/hub")


def _platform_dir(which: str) -> str:
    """The two static platform dirs a rooted pattern may anchor under.
    Env-overridable the same way every other root above is (the fixture
    seam _unit_dir/_conf_dir/_webroot already provide), so a test fixture
    never globs the real box's /etc/airlock or /opt/airlock — the
    equivalence harness measured exactly that host-dependence
    (install/test-equivalence.sh). Unset, these are the literal platform
    paths, byte-for-byte the pre-seam behaviour. An override is validated
    with the SAME rule the dynamic webroot anchor gets: one that collapses
    to "/" or an FHS system root must not silently authorize the whole
    filesystem — but unlike the dynamic anchor (silently excluded, other
    anchors remain), a broken platform override fails loudly, because
    excluding it would refuse every shipped rooted artifact with no hint
    why."""
    env = "AIRLOCK_PLATFORM_ETC" if which == "etc" else "AIRLOCK_PLATFORM_OPT"
    raw = (os.environ.get(env) or "").strip()
    if not raw:
        return "/etc/airlock" if which == "etc" else "/opt/airlock"
    resolved = _real_root(raw)
    if _rooted_dynamic_anchor_forbidden(resolved):
        fail(f"{env}={raw!r} resolves to {resolved!r}, which cannot anchor "
             "rooted artifacts (needs at least two path components outside "
             "the protected system roots)")
    return resolved


def _rooted_substitute(pattern: str, webroot_parent: str) -> str:
    """Resolve a declared rooted pattern's anchor: the ${webroot_parent}
    token first, then the two static platform anchors, re-anchored onto
    _platform_dir's current value. THE one substitution — expansion,
    anchor recording (_pattern_anchor), record validation, and
    bin/airlock-config's manifest validation all call this, so no site can
    resolve a pattern into a different space than the allowlist admits
    (the hand-copied-drift hazard airlock-config's containment check
    already documents)."""
    s = pattern.replace("${webroot_parent}", webroot_parent)
    for literal, which in (("/etc/airlock", "etc"), ("/opt/airlock", "opt")):
        if s == literal or s.startswith(literal + "/"):
            return _platform_dir(which) + s[len(literal):]
    return s


ROOT_KEYS = ("unit_user", "unit_system", "confd", "webroot", "home")


def _current_roots() -> dict[str, str]:
    return {"unit_user": _unit_dir("user"), "unit_system": _unit_dir("system"),
            "confd": _conf_dir(), "webroot": _webroot(),
            "home": os.path.realpath(os.path.expanduser("~"))}


def _rooted_webroot_parent(roots: dict[str, str]) -> str:
    """RESOLUTION only: where a record's ${webroot_parent} token expands to —
    the record's OWN roots snapshot, since that is where the artifact was
    actually written on disk. This confers no authority by itself; see
    _rooted_authorization_allowlist for the (deliberately different)
    authorization boundary."""
    return str(Path(roots["webroot"]).parent)


# A denylist enumeration of FHS system roots is a losing game — round 3
# closed webroot_parent="/" (AIRLOCK_WEBROOT=/hub), but the same collapse one
# level narrower (AIRLOCK_WEBROOT=/opt/hub -> webroot_parent="/opt") was not
# on the list, and re-admitted /opt (authorizing sudo rm -rf of any top-level
# /opt entry) while /var/hub was refused only because /var happened to be
# enumerated. A RULE instead: the anchor must have at least two path
# components (/opt/airlock qualifies; /opt does not — no single top-level
# directory is ever a legitimate dynamic anchor, named or not). The old
# enumeration stays too, as a floor: belt-and-braces if the length rule is
# ever refactored wrong, though every entry in it is already <2 components
# and so already covered by the rule alone.
_ROOTED_FORBIDDEN_DYNAMIC_ANCHORS = frozenset((
    "/", "/etc", "/usr", "/bin", "/sbin", "/lib", "/lib64", "/boot",
    "/sys", "/proc", "/dev", "/run", "/root", "/home", "/var",
))


def _rooted_dynamic_anchor_forbidden(anchor: str) -> bool:
    real = os.path.realpath(anchor)
    depth = len([part for part in real.split("/") if part])
    return depth < 2 or real in _ROOTED_FORBIDDEN_DYNAMIC_ANCHORS


def _rooted_refusal_hint() -> str:
    """An extra sentence for a rooted refusal message when the CURRENT
    dynamic anchor is itself the reason — distinguishes "your webroot is too
    shallow" from "this pattern genuinely names somewhere else"."""
    if _rooted_dynamic_anchor_forbidden(_rooted_webroot_parent(_current_roots())):
        return (" — the current webroot's parent is a protected system "
                "directory, so ${webroot_parent} grants no authority here; "
                "move the webroot to a deeper path, or manage this artifact "
                "by hand")
    return ""


def _rooted_authorization_allowlist() -> tuple[str, ...]:
    """The anchors a rooted path must sit under to be TOUCHED at all — the
    two static platform dirs, plus the CURRENT LIVE environment's webroot
    parent, ITSELF validated before it joins the set. Deliberately NEVER
    derived from a record's own roots snapshot (D6 child-4 amendment, round
    2 fix): a hand-written record can claim any roots.webroot it likes
    (roots.webroot=/etc/attacker-hub makes /etc/passwd's parent "/etc" pass
    a record-derived allowlist), so trusting record data here would let a
    fabricated record authorize removing anything its author names. A
    legitimate record whose webroot genuinely changed since it was recorded
    is refused here too, loudly — fail-closed over trusting record-supplied
    roots is the accepted trade. The dynamic anchor gets the SAME scrutiny
    (round 3 fix): a webroot that collapses to "/" or an FHS system root
    must not silently authorize the whole filesystem — the anchor is simply
    excluded, so any rooted pattern that needed it is refused, same as if
    the artifact genuinely lived somewhere else."""
    dynamic = _rooted_webroot_parent(_current_roots())
    # _platform_dir, not literals: the anchors must live in the same space
    # patterns are substituted into (_rooted_substitute), or an env-scoped
    # fixture's own expansion would be refused by an allowlist still naming
    # the real box's dirs. Unset env resolves to the same two literals.
    anchors = [_platform_dir("etc"), _platform_dir("opt")]
    if not _rooted_dynamic_anchor_forbidden(dynamic):
        anchors.append(dynamic)
    return tuple(anchors)


def _rooted_contains(path: str) -> bool:
    """Does `path`'s parent sit under one of the rooted AUTHORIZATION
    anchors, canonically? Used both to validate a declared pattern (after
    ${webroot_parent} substitution) and to gate an actual removal — always
    against the live-environment allowlist, never a record's own roots."""
    parent = os.path.realpath(os.path.dirname(path.rstrip("/")) or "/")
    return any(parent == os.path.realpath(root)
               or parent.startswith(os.path.realpath(root).rstrip("/") + os.sep)
               for root in _rooted_authorization_allowlist())


def _is_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _validate_lifecycle(value: Any, where: str) -> None:
    if not isinstance(value, dict) or set(value) != set(LIFECYCLE_KEYS):
        fail(f"{where}: lifecycle must contain install, smoke, and deactivate")
    if any(not isinstance(value[key], bool) for key in LIFECYCLE_KEYS):
        fail(f"{where}: lifecycle values must be boolean")


def _validate_container_declarations(value: Any, where: str) -> None:
    if not isinstance(value, list) or any(not isinstance(item, str) for item in value):
        fail(f"{where}: expected a string list")
    if len(value) != len(set(value)):
        fail(f"{where}: declarations must not contain duplicates")
    for item in value:
        literal = item[:-1] if item.endswith("*") else item
        if (not literal or item.count("*") != (1 if item.endswith("*") else 0)
                or not _CONTAINER_NAME_RE.fullmatch(literal)):
            fail(f"{where}: {item!r} must be a literal container name or a "
                 "non-empty literal prefix followed by one final '*'")
    for index, left in enumerate(value):
        for right in value[index + 1:]:
            if _container_claims_overlap([left], [right]):
                fail(f"{where}: declarations {left!r} and {right!r} overlap")


def _validate_container_runtime(value: Any, where: str, *, committed: bool) -> None:
    if value is None:
        return
    required = set(CONTAINER_RUNTIME_COMMITTED_FIELDS if committed
                   else CONTAINER_RUNTIME_INTENT_FIELDS)
    if not isinstance(value, dict) or set(value) != required:
        fail(f"{where}: invalid container runtime shape")
    if value["runtime"] != "docker":
        fail(f"{where}.runtime: only 'docker' is supported")
    daemon_identity = value["daemon_identity"]
    if not isinstance(daemon_identity, str) or not _DAEMON_ID_RE.fullmatch(daemon_identity):
        fail(f"{where}.daemon_identity: invalid Docker daemon identity")
    nonce = value["install_nonce"]
    if not isinstance(nonce, str) or not _NONCE_RE.fullmatch(nonce):
        fail(f"{where}.install_nonce: invalid nonce")
    _validate_container_declarations(value["declarations"],
                                     f"{where}.declarations")
    if committed:
        objects = value["objects"]
        if not isinstance(objects, list):
            fail(f"{where}.objects: expected a list")
        ids: set[str] = set()
        names: set[str] = set()
        for index, obj in enumerate(objects):
            owhere = f"{where}.objects[{index}]"
            if not isinstance(obj, dict) or set(obj) != set(CONTAINER_OBJECT_FIELDS):
                fail(f"{owhere}: expected exactly id and name")
            object_id, name = obj["id"], obj["name"]
            if not isinstance(object_id, str) or not _CONTAINER_ID_RE.fullmatch(object_id):
                fail(f"{owhere}.id: expected a full 64-hex Docker id")
            if not isinstance(name, str) or not _CONTAINER_NAME_RE.fullmatch(name):
                fail(f"{owhere}.name: invalid container name")
            if not _container_name_matches(name, value["declarations"]):
                fail(f"{owhere}.name: outside the recorded declarations")
            if object_id in ids or name in names:
                fail(f"{where}.objects: ids and names must be unique")
            ids.add(object_id)
            names.add(name)


def _validate_artifact_map(value: Any, where: str, declared: bool, *, version: int = LEDGER_VERSION,
                           roots: dict[str, str] | None = None) -> None:
    classes = ARTIFACT_CLASSES if version >= 3 else LEGACY_ARTIFACT_CLASSES
    if not isinstance(value, dict) or set(value) != set(classes):
        fail(f"{where}: artifacts must contain {', '.join(classes)}")
    for name in classes:
        items = value[name]
        if not isinstance(items, list):
            fail(f"{where}.{name}: expected a list")
        if name == "serve_ports" and not declared:
            if any(not _is_int(item) or not 1 <= item <= 65535 for item in items):
                fail(f"{where}.serve_ports: expected integer ports")
        elif any(not isinstance(item, str) for item in items):
            fail(f"{where}.{name}: expected string paths/patterns")
        elif (name != "serve_ports" and not declared
                and any(not os.path.isabs(item) for item in items)):
            # Committed artifacts are recorded fully expanded; a relative
            # entry would teardown whatever the future cwd makes of it.
            fail(f"{where}.{name}: recorded paths must be absolute")
        if name == "units":
            for item in items:
                base = os.path.basename(str(item))
                if base.startswith("-") or not base.endswith(UNIT_SUFFIXES):
                    # A leading '-' would parse as a systemctl option; a
                    # non-unit suffix is not a unit file at all.
                    fail(f"{where}.units: {item!r} is not a safe unit file name")
                if declared and ("/" in str(item) or "**" in str(item)
                                 or _UNIT_WILDCARD_RE.search(str(item))):
                    fail(f"{where}.units: {item!r} must be a bare unit file name "
                         "without globs ('*', '?', '[') or recursive globs")
                if not declared and ("**" in str(item)
                                     or _UNIT_WILDCARD_RE.search(str(item))):
                    # A committed unit is an expanded literal path — glob
                    # characters can only arrive in a hand-written record,
                    # and teardown basenames the entry straight into
                    # `systemctl disable --now`, where '*.service' is a
                    # pattern over every system unit (round 6: the intent
                    # branch above did not cover committed records).
                    fail(f"{where}.units: {item!r} must be a literal unit path "
                         "without globs ('*', '?', '[')")
        # Declared patterns re-checked against the manifest grammar: a
        # hand-made intent must not smuggle what validate would refuse
        # (a relative files pattern deletes whatever the future cwd holds).
        if declared and name in ("fragments", "webroot"):
            for item in items:
                s = str(item)
                segs = [x for x in s.split("/") if x]
                if s.startswith("/") or not segs or any(x in (".", "..") for x in segs):
                    fail(f"{where}.{name}: {item!r} must be a relative pattern "
                         "with no '.' or '..' segments")
                if any(c in seg for seg in segs[:-1] for c in "*?["):
                    fail(f"{where}.{name}: {item!r} — glob characters are only "
                         "allowed in the final segment")
                if "**" in s:
                    fail(f"{where}.{name}: {item!r} — recursive globs are not "
                         "part of the artifact grammar")
        if declared and name == "files":
            for item in items:
                s = str(item)
                if not (s.startswith("/") or s.startswith("~")):
                    fail(f"{where}.files: {item!r} must be absolute or ~-prefixed")
                if any(x in (".", "..") for x in s.split("/")):
                    # '.' would alias the parent (~/. is the whole home).
                    fail(f"{where}.files: {item!r} must not contain '.' or '..' segments")
                if any(c in seg for seg in s.split("/")[:-1] for c in "*?["):
                    fail(f"{where}.files: {item!r} — glob characters are only "
                         "allowed in the final segment")
                if "**" in s:
                    fail(f"{where}.files: {item!r} — recursive globs are not "
                         "part of the artifact grammar")
                if s.startswith("~") and (not s.startswith("~/") or not s[2:].strip("/")):
                    fail(f"{where}.files: {item!r} — only ~/<path> is supported "
                         "(a named user's home is not ours to claim, and the "
                         "whole home is not an artifact)")
        if declared and name == "serve_ports":
            for item in items:
                if not isinstance(item, str) or not re.fullmatch(r"[a-z0-9_]+", item):
                    fail(f"{where}.serve_ports: {item!r} is not a config key name")
        if declared and name == "rooted":
            # A hand-made (or malicious) intent must not smuggle a rooted
            # pattern validate would refuse: re-run the same grammar check
            # bin/airlock-config applies at manifest validate-time.
            # ${webroot_parent} SUBSTITUTES against the record's own roots
            # snapshot (that is where the pattern resolves on disk), but the
            # ALLOWLIST check is always against the live environment — never
            # the record's roots — or a record claiming roots.webroot under
            # an attacker-chosen directory could smuggle an arbitrary path
            # (e.g. /etc/passwd) past validate by making its own fabricated
            # webroot_parent equal that path's parent.
            if roots is None:
                fail(f"{where}.rooted: cannot validate without a roots snapshot")
            for item in items:
                s = str(item)
                substituted = _rooted_substitute(s, _rooted_webroot_parent(roots))
                if not os.path.isabs(substituted) or any(
                        x in (".", "..") for x in substituted.split("/")):
                    fail(f"{where}.rooted: {item!r} must be absolute after "
                         "${webroot_parent} substitution with no '.' or '..' segments")
                if any(c in seg for seg in substituted.split("/")[:-1] for c in "*?[") \
                        or "**" in substituted:
                    fail(f"{where}.rooted: {item!r} permits glob characters only in "
                         "the final segment (no **)")
                if not _rooted_contains(substituted):
                    fail(f"{where}.rooted: {item!r} is outside the rooted allowlist "
                         "(checked against the current environment)" + _rooted_refusal_hint())


def _validate_port_values(value: Any, where: str) -> None:
    if not isinstance(value, dict):
        fail(f"{where}: expected an object")
    for key, port in value.items():
        if not isinstance(key, str) or not _is_int(port) or not 1 <= port <= 65535:
            fail(f"{where}: invalid port value for {key!r}")


def _validate_serve_mappings(value: Any, where: str) -> None:
    if not isinstance(value, dict):
        fail(f"{where}: expected an object")
    for key, mapping in value.items():
        if (not isinstance(key, str) or not isinstance(mapping, dict)
                or set(mapping) != {"listen", "mode", "target"}
                or mapping.get("mode") not in ("http", "https")
                or not _is_int(mapping.get("listen")) or not _is_int(mapping.get("target"))
                or not 1 <= mapping["listen"] <= 65535 or not 1 <= mapping["target"] <= 65535):
            fail(f"{where}: mappings must be {{key: {{listen, mode, target}}}}")


def _validate_unit_scopes(value: Any, units: list[Any], where: str) -> None:
    names = {os.path.basename(str(x)) for x in units}
    if not isinstance(value, dict) or set(value) != names:
        fail(f"{where}: must map exactly the unit names")
    if any(v not in ("user", "system", "both") for v in value.values()):
        fail(f"{where}: values must be user, system, or both")


def _validate_order(value: Any, where: str) -> None:
    if value is not None and (not _is_int(value) or value < 1):
        fail(f"{where}: order must be a positive integer or null")


def _validate_source_class(value: Any, where: str, *, managed: bool = False) -> None:
    allowed = ("shipped", "explicit", "managed") if managed else ("shipped", "explicit")
    if value not in allowed:
        names = ", ".join(repr(item) for item in allowed)
        fail(f"{where}: source_class must be one of {names}")


def _validate_capabilities(value: Any, where: str, *,
                           allowed: tuple[str, ...] = CAPABILITIES) -> None:
    """A record's claim about what it was authorized to do. Canonical form is
    part of the contract: `write_store` dumps with sort_keys=True, so a record
    that came back unsorted or with a repeat was hand-edited, and accepting it
    would give one claim two spellings that compare unequal (the stale-intent
    guard at command_intent diffs recorded surfaces literally)."""
    if not isinstance(value, list):
        fail(f"{where}: capabilities must be a list")
    if any(not isinstance(item, str) for item in value):
        fail(f"{where}: capabilities must be a list of strings")
    for item in value:
        if item not in allowed:
            fail(f"{where}: unknown capability {item!r} "
                 f"(known: {', '.join(allowed)})")
    if len(set(value)) != len(value):
        fail(f"{where}: capabilities must not repeat a name")
    if value != sorted(value):
        fail(f"{where}: capabilities must be sorted")


def _validate_managed_authority(value: Any, where: str) -> None:
    if not isinstance(value, dict) or set(value) != set(MANAGED_AUTHORITY_FIELDS):
        fail(f"{where}: invalid closed managed authority shape")
    if value["schema"] != MANAGED_AUTHORITY_SCHEMA:
        fail(f"{where}: unsupported managed authority schema")
    for field in (
        "anchor_sha256", "config_sha256", "installed_measurer_sha256",
        "next_measurer_sha256", "receipt_sha256",
    ):
        if not _is_hex_digest(value[field]):
            fail(f"{where}.{field}: must be a bare lowercase sha256")
    for field in (
        "authority_membership_digest", "core_digest", "enrollment_digest",
        "lock_digest", "package_digest", "promotion_receipt_digest",
        "publisher_key_id", "root_key_id", "selection_digest",
        "snapshot_digest", "state_digest",
    ):
        if not isinstance(value[field], str) or not _MANAGED_DIGEST_RE.fullmatch(value[field]):
            fail(f"{where}.{field}: must be a sha256-prefixed lowercase digest")
    for field in ("core_revision", "fetched_public_revision", "public_tree"):
        if not isinstance(value[field], str) or not _GIT_OID_RE.fullmatch(value[field]):
            fail(f"{where}.{field}: must be a full lowercase 40-hex git identity")
    for field in ("authority_sequence", "epoch", "selection_sequence", "sequence"):
        if not _is_int(value[field]) or value[field] < 1:
            fail(f"{where}.{field}: must be a positive integer")
    for field in ("channel_id", "organization_id", "target_profile"):
        if not isinstance(value[field], str) or not _MANAGED_ID_RE.fullmatch(value[field]):
            fail(f"{where}.{field}: must be a managed identity")
    _validate_capabilities(
        value["capabilities"], f"{where}.capabilities", allowed=MANAGED_CAPABILITIES,
    )


def _validate_record_managed_authority(record: dict[str, Any], where: str) -> None:
    authority = record["managed_authority"]
    if record["source_class"] == "managed":
        _validate_managed_authority(authority, f"{where}.managed_authority")
        if authority["capabilities"] != record["capabilities"]:
            fail(f"{where}: managed authority capabilities differ from the record")
        # authority.package_digest is the signed release file-manifest digest;
        # record.digest is the ledger's independent mutation digest. Admission
        # and commit remeasure both ABIs, so a loader must preserve rather than
        # incorrectly equate these deliberately different durable identities.
    elif authority is not None:
        fail(f"{where}: explicit/shipped records require managed_authority null")


def _unit_scopes_include_system(unit_scopes: dict[str, str]) -> bool:
    return any(scope in ("system", "both") for scope in unit_scopes.values())


def _require_system_unit_scope_claim(unit_scopes: dict[str, str],
                                     capabilities: list[str] | None,
                                     where: str, *, symmetric: bool) -> None:
    """Check agreement between requested unit scope and the recorded claim.

    Package facts and intents describe the complete declaration, so they can
    prove both directions.  A committed record describes only artifacts that
    were found; its claim may legitimately survive a conditional system unit
    that was absent at commit time, so callers use the one-way form there.
    """
    has_system_scope = _unit_scopes_include_system(unit_scopes)
    claims_system = "system-unit" in (capabilities or ())
    if has_system_scope and not claims_system:
        fail(f"{where}: unit_scopes has system/both but capabilities does not "
             "claim 'system-unit'")
    if symmetric and claims_system and not has_system_scope:
        fail(f"{where}: capabilities claims 'system-unit' but unit_scopes has "
             "no system/both")


def _recorded_system_unit_paths(artifacts: dict[str, list[Any]],
                                roots: dict[str, str]) -> list[str]:
    """Recorded unit paths whose exact parent is the record's system root."""
    system_root = os.path.normpath(roots["unit_system"])
    return [str(unit) for unit in artifacts["units"]
            if os.path.normpath(os.path.dirname(str(unit))) == system_root]


def _record_capabilities(record: dict[str, Any], kind: str) -> list[str]:
    """What a stored record can prove about ITSELF, for the read normalisation
    that has to give a pre-v4 record a capability list.

    Derived from the record alone — no config (the box being read may have none
    to hand: teardown of a deleted app is exactly the case) and no live
    environment (the box's AIRLOCK_UNIT_DIR_* may have moved since, and the
    question here is where this install PUT its units, not where a unit would
    go today). Fresh records never come through here; they carry the list
    bin/airlock-config derived at admission."""
    claimed: set[str] = set()
    artifacts = record["artifacts_declared"] if kind == "intent" else record["artifacts"]
    if artifacts["rooted"]:
        claimed.add("rooted-artifact")
    # "both" counts. It does not mean "user"; it means scope unknown, search
    # BOTH roots (expand_declared), so such a record can own a system unit —
    # and recording no claim would strand that unit the moment the capability
    # is gated. Every pre-v3 record normalises to "both", which is why this
    # is not a hypothetical.
    if _unit_scopes_include_system(record["unit_scopes"]):
        claimed.add("system-unit")
    if kind == "committed" and "system-unit" not in claimed:
        # A committed record's units are RECORDED absolute paths — the ground
        # truth its scope map only summarises — so a record whose scopes say
        # "user" but whose paths sit in the system unit dir still owns one.
        # Against the record's own roots snapshot, per the docstring.
        if _recorded_system_unit_paths(artifacts, record["roots"]):
            claimed.add("system-unit")
    return sorted(claimed)


def _is_hex_digest(value: Any) -> bool:
    return (isinstance(value, str) and len(value) == 64
            and all(c in "0123456789abcdef" for c in value))


def _validate_events(value: Any, where: str) -> None:
    if not isinstance(value, list):
        fail(f"{where}: events must be a list")
    required = set(AUDIT_EVENT_FIELDS)
    for index, event in enumerate(value):
        label = f"{where}.events[{index}]"
        if not isinstance(event, dict) or set(event) != required:
            fail(f"{label}: invalid audit event shape")
        if event["type"] != "package-lock-override":
            fail(f"{label}: unknown event type {event['type']!r}")
        package_id = event["package_id"]
        if not isinstance(package_id, str) or not _ID_RE.fullmatch(package_id):
            fail(f"{label}: invalid package id {package_id!r}")
        if event["argument"] != f"--dangerously-admit-unverified={package_id}":
            fail(f"{label}: argument does not exactly name its package")
        if not _is_hex_digest(event["recorded_digest"]):
            fail(f"{label}: recorded_digest must be a bare lowercase 64-hex string")
        if not _is_hex_digest(event["admitted_digest"]):
            fail(f"{label}: admitted_digest must be a bare lowercase 64-hex string")
        recorded_at = event["recorded_at"]
        if not isinstance(recorded_at, str) or not recorded_at.endswith("Z"):
            fail(f"{label}: recorded_at must be a UTC timestamp ending in Z")
        try:
            parsed_at = datetime.fromisoformat(recorded_at[:-1] + "+00:00")
        except ValueError:
            fail(f"{label}: recorded_at must be a valid UTC timestamp")
        if parsed_at.utcoffset() != timezone.utc.utcoffset(parsed_at):
            fail(f"{label}: recorded_at must be a UTC timestamp")
        if not _is_hex_digest(event["receipt_sha256"]):
            fail(f"{label}: receipt_sha256 must be a bare lowercase 64-hex string")


def _validate_provenance(record: dict[str, Any], kind: str, where: str) -> None:
    if not isinstance(record["path"], str) or not os.path.isabs(record["path"]):
        fail(f"{where}: {kind} path must be an absolute string")
    if not _is_hex_digest(record["digest"]):
        fail(f"{where}: {kind} digest must be a 64-hex sha256")


def _validate_deps(value: Any, app_id: str, where: str) -> None:
    if not isinstance(value, list):
        fail(f"{where}: deps must be a list of id strings")
    if any(not isinstance(dep, str) or not _DEP_RE.fullmatch(dep) for dep in value):
        fail(f"{where}: deps must be a list of valid id strings")
    if len(value) != len(set(value)):
        fail(f"{where}: deps must not contain duplicates")
    if app_id in value:
        fail(f"{where}: deps must not contain a self-reference to {app_id!r}")


def _validate_record(record: Any, kind: str, where: str, *,
                     app_id: str = "", version: int = LEDGER_VERSION) -> None:
    if not isinstance(record, dict):
        fail(f"{where}: {kind} record must be an object")
    if kind == "intent":
        required = {"path", "digest", "artifacts_declared", "serve_port_values",
                    "lifecycle", "roots"}
        if version >= 2:
            required.add("deps")
            required.add("anchors")
        if version >= 3:
            required.update(("serve_mappings", "unit_scopes", "order", "source_class"))
        if version >= 4:
            required.add("capabilities")
        if version >= 5:
            required = set(INTENT_RECORD_FIELDS_V5)
        if version >= 6:
            required = set(INTENT_RECORD_FIELDS_V6)
        if version >= 7:
            required = set(INTENT_RECORD_FIELDS_V7)
        if set(record) != required:
            fail(f"{where}: invalid intent record shape")
        _validate_provenance(record, kind, where)
        if version >= 2:
            _validate_deps(record["deps"], app_id, f"{where}.deps")
            anchors = record["anchors"]
            if (not isinstance(anchors, dict)
                    or any(not isinstance(k, str) or not isinstance(v, str)
                           or not os.path.isabs(v) for k, v in anchors.items())):
                fail(f"{where}.anchors: expected a map of pattern keys to "
                     "absolute resolved directories")
        roots = record["roots"]
        if (not isinstance(roots, dict) or set(roots) != set(ROOT_KEYS)
                or any(not isinstance(v, str) or not os.path.isabs(v)
                       for v in roots.values())):
            fail(f"{where}: roots must record the five absolute expansion bases")
        _validate_artifact_map(record["artifacts_declared"], f"{where}.artifacts_declared", True,
                               version=version, roots=roots)
        _validate_port_values(record["serve_port_values"], f"{where}.serve_port_values")
        # The value map must be exactly the declared key set — an undeclared
        # value would make its port a teardown target nothing declared.
        if set(record["serve_port_values"]) != set(record["artifacts_declared"]["serve_ports"]):
            fail(f"{where}: serve_port_values keys must equal artifacts_declared.serve_ports")
        _validate_lifecycle(record["lifecycle"], f"{where}.lifecycle")
        if version >= 3:
            _validate_serve_mappings(record["serve_mappings"], f"{where}.serve_mappings")
            _validate_unit_scopes(record["unit_scopes"], record["artifacts_declared"]["units"], f"{where}.unit_scopes")
            _validate_order(record["order"], f"{where}.order")
            _validate_source_class(
                record["source_class"], f"{where}.source_class", managed=version >= 7,
            )
            if version == 3 and record["artifacts_declared"]["rooted"] and record["source_class"] != "shipped":
                # v3 ONLY, and it stays. In v3 `source_class` was the
                # authorisation record itself, so no legitimate writer of that
                # version could produce a rooted explicit-class record — one on
                # disk was hand-written, and refusing it is the ledger's own
                # defence (Blocker C) rather than a policy re-decision. Nothing
                # is lost by keeping it: a grant cannot exist in a v3 record.
                # It is deliberately not carried into v4, where a grant may
                # legitimately authorise an explicit package and the claim is
                # recorded on the record instead.
                fail(f"{where}: artifacts_declared.rooted is shipped-only "
                     f"(source_class={record['source_class']!r})")
        if version >= 4:
            _validate_capabilities(
                record["capabilities"], f"{where}.capabilities",
                allowed=(MANAGED_CAPABILITIES
                         if version >= 7 and record["source_class"] == "managed"
                         else CAPABILITIES),
            )
            # Successor to the shipped-only assertion (Blocker C), which
            # re-decided POLICY at load time: it read source_class, a fact the
            # record cannot prove and whose meaning lives in a config that may
            # have granted the capability since — so the first granted rooted
            # install wrote a record the next run refused to READ, dying before
            # it could tear anything down. This reads the record instead.
            #
            # Biconditional, and only on the intent record: what an intent
            # proves is its DECLARATION, and both directions are wrong records.
            # A declaration with no claim is an install nothing authorized; a
            # claim with no declaration is a claim with no evidence behind it.
            claims_rooted = "rooted-artifact" in record["capabilities"]
            if record["artifacts_declared"]["rooted"] and not claims_rooted:
                fail(f"{where}: artifacts_declared.rooted is non-empty but "
                     "capabilities does not claim 'rooted-artifact'")
            if claims_rooted and not record["artifacts_declared"]["rooted"]:
                fail(f"{where}: capabilities claims 'rooted-artifact' but "
                     "artifacts_declared.rooted is empty")
            _require_system_unit_scope_claim(record["unit_scopes"],
                                             record["capabilities"], where,
                                             symmetric=True)
        if version >= 6:
            _validate_container_runtime(record["container_runtime"],
                                        f"{where}.container_runtime",
                                        committed=False)
        if version >= 7:
            _validate_record_managed_authority(record, where)
    else:
        required = {"path", "digest", "lifecycle", "artifacts"}
        if version >= 2:
            required.add("deps")
        if version >= 3:
            required.update(("serve_mappings", "unit_scopes", "order", "roots", "source_class"))
        if version >= 4:
            required.add("capabilities")
        if version >= 5:
            required = set(COMMITTED_RECORD_FIELDS_V5)
        if version >= 6:
            required = set(COMMITTED_RECORD_FIELDS_V6)
        if version >= 7:
            required = set(COMMITTED_RECORD_FIELDS_V7)
        if set(record) != required:
            fail(f"{where}: invalid committed record shape")
        _validate_provenance(record, kind, where)
        if version >= 2:
            _validate_deps(record["deps"], app_id, f"{where}.deps")
        _validate_lifecycle(record["lifecycle"], f"{where}.lifecycle")
        _validate_artifact_map(record["artifacts"], f"{where}.artifacts", False, version=version)
        if version >= 3:
            _validate_serve_mappings(record["serve_mappings"], f"{where}.serve_mappings")
            _validate_unit_scopes(record["unit_scopes"], record["artifacts"]["units"], f"{where}.unit_scopes")
            _validate_order(record["order"], f"{where}.order")
            _validate_source_class(
                record["source_class"], f"{where}.source_class", managed=version >= 7,
            )
            if version == 3 and record["artifacts"]["rooted"] and record["source_class"] != "shipped":
                # v3 only — the intent branch above says why.
                fail(f"{where}: artifacts.rooted is shipped-only "
                     f"(source_class={record['source_class']!r})")
            # The roots snapshot AT COMMIT TIME (child-4 fix): used ONLY to
            # resolve ${webroot_parent} for a rooted pattern back to where it
            # was written — it confers no removal authority (Blocker C,
            # round 2): execution-time allowlist checks always use the live
            # environment instead, never this snapshot.
            croots = record["roots"]
            if (not isinstance(croots, dict) or set(croots) != set(ROOT_KEYS)
                    or any(not isinstance(v, str) or not os.path.isabs(v)
                           for v in croots.values())):
                fail(f"{where}: roots must record the five absolute expansion bases")
        if version >= 4:
            _validate_capabilities(
                record["capabilities"], f"{where}.capabilities",
                allowed=(MANAGED_CAPABILITIES
                         if version >= 7 and record["source_class"] == "managed"
                         else CAPABILITIES),
            )
            # ONE WAY here, unlike the intent record above. A committed
            # record holds the FOUND artifacts, not the declared ones (see
            # command_commit's unit_scopes comment), so a package whose
            # rooted path was conditional on something the installer decided
            # commits with rooted: [] while still legitimately claiming the
            # capability — a biconditional would refuse that healthy commit.
            # What stays provable is the direction teardown acts on: a
            # recorded rooted path with no claim standing behind it.
            if record["artifacts"]["rooted"] and "rooted-artifact" not in record["capabilities"]:
                fail(f"{where}: artifacts.rooted is non-empty but capabilities "
                     "does not claim 'rooted-artifact'")
            _require_system_unit_scope_claim(record["unit_scopes"],
                                             record["capabilities"], where,
                                             symmetric=False)
            if (_recorded_system_unit_paths(record["artifacts"], record["roots"])
                    and "system-unit" not in record["capabilities"]):
                fail(f"{where}: artifacts.units contains a system unit but "
                     "capabilities does not claim 'system-unit'")
        if version >= 6:
            _validate_container_runtime(record["container_runtime"],
                                        f"{where}.container_runtime",
                                        committed=True)
        if version >= 7:
            _validate_record_managed_authority(record, where)


def _validate_store(store: Any, path: Path, *, upgrade_managed: bool = False) -> dict[str, Any]:
    if not isinstance(store, dict) or "version" not in store:
        fail(f"{path}: invalid ledger shape")
    version = store.get("version")
    # 3 is spelled out, not written as LEDGER_VERSION: every previous store
    # version must stay in this set by NAME, or raising the constant silently
    # evicts the one version most boxes are actually on and kills them here —
    # before the normalisation below, which exists to upgrade them, ever runs.
    if not _is_int(version) or version not in (1, 2, 3, 4, 5, 6, LEDGER_VERSION):
        hint = ""
        if _is_int(version) and version > LEDGER_VERSION:
            hint = ("; this state was written by a newer airlock, so the tree is "
                    "older than the state it is reading — upgrade (or restore) the "
                    "airlock checkout rather than editing the ledger")
        fail(f"{path}: unsupported ledger version {store.get('version')!r}; "
             f"this airlock reads up to version {LEDGER_VERSION}{hint}")
    expected_top = (set(STORE_FIELDS_V7)
                    if version >= 5 else {"version", "entries"})
    if set(store) != expected_top:
        fail(f"{path}: invalid ledger shape")
    if version >= 5:
        _validate_events(store["events"], str(path))
    entries = store.get("entries")
    if not isinstance(entries, dict):
        fail(f"{path}: invalid ledger shape: entries must be an object")
    for app_id, entry in entries.items():
        if not isinstance(app_id, str) or not _ID_RE.fullmatch(app_id):
            fail(f"{path}: invalid ledger entry id {app_id!r}")
        if not isinstance(entry, dict):
            fail(f"{path}: invalid ledger entry for {app_id!r}")
        if set(entry) - {"committed", "intent"}:
            fail(f"{path}: invalid ledger entry for {app_id!r}")
        present = False
        for kind in ("committed", "intent"):
            record = entry.get(kind)
            if record is None:
                continue
            present = True
            _validate_record(record, kind, f"{path}: entry {app_id!r}.{kind}",
                             app_id=app_id, version=version)
        if not present:
            fail(f"{path}: empty ledger entry for {app_id!r}")
    if version >= LEDGER_VERSION:
        return store
    # One read-normalisation staircase, not a set of sibling branches: an older
    # store is deep-copied ONCE (the caller's dict is never mutated under it),
    # walked up through every step it is behind, and returned as the store the
    # rest of the tool sees. A step written as a sibling of the v1/v2 branch
    # would be skipped by exactly the stores that need it most — a v1 file would
    # come back stamped LEDGER_VERSION with the newest fields missing, and
    # write_store would then refuse its own output.
    normalised = copy.deepcopy(store)
    # Keep this validator's historical public normalisation contract at v6.
    # Actual ledger read/write boundaries opt into the v7 managed-authority
    # migration below. This lets callers which only validate legacy audit
    # shapes keep observing v6 while no mutable ledger command can operate on
    # or persist an un-upgraded store.
    normalised["version"] = 6
    normalised.setdefault("events", [])
    if version in (1, 2):
        for entry in normalised["entries"].values():
            for kind in ("committed", "intent"):
                record = entry.get(kind)
                if record is not None:
                    record.setdefault("deps", [])
                    if kind == "intent":
                        record.setdefault("anchors", {})
                        record["serve_mappings"] = {
                            k: {"listen": p, "mode": "http", "target": p}
                            for k, p in record["serve_port_values"].items()}
                        record["artifacts_declared"]["rooted"] = []
                        record["unit_scopes"] = {n: "both" for n in record["artifacts_declared"]["units"]}
                    else:
                        record["serve_mappings"] = {
                            str(p): {"listen": p, "mode": "http", "target": p}
                            for p in record["artifacts"]["serve_ports"]}
                        record["artifacts"]["rooted"] = []
                        record["unit_scopes"] = {os.path.basename(n): "both" for n in record["artifacts"]["units"]}
                        # A legacy committed record never had a roots
                        # snapshot (rooted didn't exist yet) — its rooted
                        # list is always [] just above, so the live
                        # environment is a safe stand-in (nothing will ever
                        # resolve ${webroot_parent} against it).
                        record["roots"] = _current_roots()
                    record["order"] = None
                    # Conservative default (Blocker C, round 2): a legacy
                    # record never carried source_class, and its rooted list
                    # is always [] (rooted did not exist pre-v3), so
                    # "explicit" costs nothing. Since store v4 no rooted GATE
                    # reads it either (they read capabilities, which the
                    # v3 -> v4 step below derives from the record itself); it
                    # remains a compared surface in the stale-intent sweep.
                    record["source_class"] = "explicit"
    # v3 -> v4. Runs AFTER the block above because that block writes this
    # step's inputs: pre-v3 records have no `rooted` list and no `unit_scopes`
    # at all until the fixups synthesise them.
    for entry in normalised["entries"].values():
        for kind in ("committed", "intent"):
            record = entry.get(kind)
            if record is not None and "capabilities" not in record:
                record["capabilities"] = _record_capabilities(record, kind)
    # v1-v5 -> v6. Older stores had no runtime object class; null is the only
    # honest migration because no immutable ids or ownership nonce were ever
    # recorded by those versions.
    for entry in normalised["entries"].values():
        for kind in ("committed", "intent"):
            record = entry.get(kind)
            if record is not None:
                record.setdefault("container_runtime", None)
    if upgrade_managed:
        # v1-v6 -> v7. No older record carried an authenticated managed issuer
        # binding. Null preserves its existing explicit/shipped provenance
        # without inventing authority during migration.
        normalised["version"] = LEDGER_VERSION
        for entry in normalised["entries"].values():
            for kind in ("committed", "intent"):
                record = entry.get(kind)
                if record is not None:
                    record.setdefault("managed_authority", None)
    return normalised


def load_store() -> dict[str, Any]:
    """Read the ledger fail-closed; a missing file is the only empty case."""
    path = ledger_path()
    if not os.path.lexists(path):
        return {"version": LEDGER_VERSION, "entries": {}, "events": []}
    try:
        with path.open("r", encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(f"{path}: cannot parse ledger: {exc}")
    return _validate_store(raw, path, upgrade_managed=True)


def _ensure_state_dir() -> Path:
    directory = state_dir()
    try:
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(directory, 0o700)
    except OSError as exc:
        fail(f"cannot create state directory {directory}: {exc}")
    return directory


def write_store(store: dict[str, Any], *, require_directory_sync: bool = False) -> None:
    """Replace the ledger in one same-directory atomic operation. Validated
    first: this tool must never persist a store it would refuse to re-read."""
    path = ledger_path()
    # The validator RETURNS the normalised store — an older candidate comes
    # back stamped LEDGER_VERSION with the fields that version added already
    # derived — so every persisted mutation is current by construction.
    # Persisting the caller's own dict instead would write back the shape the
    # file was read in and leave the upgrade permanently pending.
    store = _validate_store(store, path, upgrade_managed=True)
    directory = _ensure_state_dir()
    temp_name: str | None = None
    try:
        fd, temp_name = tempfile.mkstemp(prefix=".app-ledger.", suffix=".tmp", dir=directory)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(store, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(temp_name, path)
        temp_name = None
        if require_directory_sync:
            directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
    except (OSError, TypeError, ValueError) as exc:
        fail(f"cannot atomically write ledger {path}: {exc}")
    finally:
        if temp_name is not None:
            try:
                os.unlink(temp_name)
            except OSError:
                pass


def read_package_info() -> dict[str, Any]:
    global _PACKAGE_INFO_INPUT_SHA256
    raw_bytes = sys.stdin.buffer.read()
    _PACKAGE_INFO_INPUT_SHA256 = hashlib.sha256(raw_bytes).hexdigest()
    try:
        raw = raw_bytes.decode("utf-8")
    except UnicodeDecodeError as exc:
        fail(f"stdin: package-info is not UTF-8: {exc}")
    if not raw.strip():
        return {}
    try:
        info = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"stdin: invalid package-info JSON: {exc}")
    if not isinstance(info, dict):
        fail("stdin: package-info must be a JSON object")
    packages = info.get("packages", {})
    if not isinstance(packages, dict):
        fail("stdin: package-info packages must be an object")
    return info


def _normalise_package(app_id: str, raw: Any) -> dict[str, Any]:
    if not isinstance(raw, dict):
        fail(f"package-info: packages.{app_id} must be an object")
    directory = raw.get("dir")
    if not isinstance(directory, str) or not directory:
        fail(f"package-info: packages.{app_id}.dir must be a non-empty string")
    raw_artifacts = raw.get("artifacts", {})
    if not isinstance(raw_artifacts, dict) or set(raw_artifacts) - set(PACKAGE_ARTIFACT_CLASSES):
        fail(f"package-info: packages.{app_id}.artifacts has unknown keys")
    artifacts: dict[str, list[str]] = {}
    for name in ARTIFACT_CLASSES:
        values = raw_artifacts.get(name, [])
        if not isinstance(values, list) or any(not isinstance(item, str) for item in values):
            fail(f"package-info: packages.{app_id}.artifacts.{name} must be a string list")
        artifacts[name] = list(values)
    raw_containers = raw_artifacts.get("containers", [])
    _validate_container_declarations(
        raw_containers, f"package-info: packages.{app_id}.artifacts.containers")

    raw_ports = raw.get("serve_port_values", {})
    _validate_port_values(raw_ports, f"package-info: packages.{app_id}.serve_port_values")
    port_values = {str(key): int(value) for key, value in raw_ports.items()}
    raw_mappings = raw.get("serve_mappings")
    if raw_mappings is None:
        raw_mappings = {k: {"listen": p, "mode": "http", "target": p}
                        for k, p in port_values.items()}
    _validate_serve_mappings(raw_mappings, f"package-info: packages.{app_id}.serve_mappings")
    mappings = copy.deepcopy(raw_mappings)
    raw_scopes = raw.get("unit_scopes", {n: "user" for n in artifacts["units"]})
    _validate_unit_scopes(raw_scopes, artifacts["units"], f"package-info: packages.{app_id}.unit_scopes")
    if any(v == "both" for v in raw_scopes.values()):
        fail(f"package-info: packages.{app_id}.unit_scopes may not declare both")
    source_class = raw.get("source_class", "explicit")
    if source_class not in ("explicit", "shipped", "managed"):
        fail(f"package-info: packages.{app_id}.source_class must be explicit, shipped, or managed")
    signed_package_digest = raw.get("signed_package_digest")
    if source_class == "managed":
        if (not isinstance(signed_package_digest, str)
                or not _MANAGED_DIGEST_RE.fullmatch(signed_package_digest)):
            fail(f"package-info: packages.{app_id}.signed_package_digest is required "
                 "for managed source and must be a sha256-prefixed digest")
    elif signed_package_digest is not None:
        fail(f"package-info: packages.{app_id}.signed_package_digest is managed-only")
    # The ledger is a pure CONSUMER of this list: bin/airlock-config derives it
    # from the manifest request, where the policy that decides it lives. No
    # default here — a package-info without it is a producer that never learned
    # to derive one, and defaulting would write a record claiming nothing while
    # its artifacts say otherwise.
    if "capabilities" not in raw:
        fail(f"package-info: packages.{app_id}.capabilities is required at "
             f"ledger store v{LEDGER_VERSION} (derived by bin/airlock-config "
             "from the package's declared artifacts)")
    _validate_capabilities(
        raw["capabilities"], f"package-info: packages.{app_id}.capabilities",
        allowed=MANAGED_CAPABILITIES if source_class == "managed" else CAPABILITIES,
    )
    # Consistency, not policy. WHETHER a package may use rooted artifacts is
    # decided at admission and stays there (bin/airlock-config's manifest gate
    # still refuses explicit + rooted); re-deciding it here would refuse the
    # granted install this store version exists to be able to record — the
    # same bug as the load-time shipped-only assertion, one layer down. What
    # the ledger checks is that the two facts it was handed agree, both ways,
    # so a producer that derives a list its own artifacts contradict is loud.
    if bool(artifacts["rooted"]) != ("rooted-artifact" in raw["capabilities"]):
        fail(f"package-info: packages.{app_id}: artifacts.rooted and the "
             f"'rooted-artifact' capability disagree (rooted={artifacts['rooted']!r}, "
             f"capabilities={raw['capabilities']!r})")
    _require_system_unit_scope_claim(raw_scopes, raw["capabilities"],
                                     f"package-info: packages.{app_id}",
                                     symmetric=True)

    raw_lifecycle = raw.get("lifecycle", {})
    if not isinstance(raw_lifecycle, dict) or set(raw_lifecycle) - set(LIFECYCLE_KEYS):
        fail(f"package-info: packages.{app_id}.lifecycle has unknown keys")
    lifecycle = {}
    for key in LIFECYCLE_KEYS:
        value = raw_lifecycle.get(key, False)
        if not isinstance(value, bool):
            fail(f"package-info: packages.{app_id}.lifecycle.{key} must be boolean")
        lifecycle[key] = value
    deps = raw.get("deps", [])
    _validate_deps(deps, app_id, f"package-info: packages.{app_id}")
    return {
        "dir": directory,
        "artifacts": artifacts,
        "containers": list(raw_containers),
        "serve_port_values": port_values,
        "serve_mappings": mappings,
        "unit_scopes": dict(raw_scopes),
        "source_class": source_class,
        "signed_package_digest": signed_package_digest,
        "capabilities": list(raw["capabilities"]),
        "lifecycle": lifecycle,
        "deps": list(deps),
    }


def packages_from_info(info: dict[str, Any]) -> dict[str, dict[str, Any]]:
    packages = info.get("packages", {})
    result: dict[str, dict[str, Any]] = {}
    for app_id, raw in packages.items():
        if not isinstance(app_id, str):
            fail("package-info: package ids must be strings")
        result[app_id] = _normalise_package(app_id, raw)
    return result


def canonical_package_path(package: dict[str, Any]) -> str:
    return os.path.realpath(os.path.expanduser(package["dir"]))


def _length_prefixed(hasher: "hashlib._Hash", field: bytes) -> None:
    hasher.update(len(field).to_bytes(8, "big"))
    hasher.update(field)


def digest_tree(root: str) -> str:
    """Hash every package entry in byte-sorted relative-path order."""
    try:
        root_stat = os.stat(root)
    except OSError as exc:
        fail(f"cannot digest package tree {root}: {exc}")
    if not stat.S_ISDIR(root_stat.st_mode):
        fail(f"cannot digest package tree {root}: package path is not a directory")

    entries: list[tuple[bytes, bytes, int, bytes]] = []

    def visit(directory: str, prefix: str) -> None:
        try:
            children = list(os.scandir(directory))
        except OSError as exc:
            fail(f"cannot read package tree {root}: {exc}")
        for child in children:
            relative = child.name if not prefix else f"{prefix}/{child.name}"
            relative_bytes = os.fsencode(relative)
            try:
                child_stat = child.stat(follow_symlinks=False)
            except OSError as exc:
                fail(f"cannot stat package entry {os.path.join(root, relative)}: {exc}")
            mode = stat.S_IMODE(child_stat.st_mode)
            if stat.S_ISREG(child_stat.st_mode):
                try:
                    with open(child.path, "rb") as fh:
                        content = fh.read()
                except OSError as exc:
                    fail(f"cannot read package entry {os.path.join(root, relative)}: {exc}")
                entries.append((relative_bytes, b"f", mode, content))
            elif stat.S_ISDIR(child_stat.st_mode):
                entries.append((relative_bytes, b"d", mode, b""))
                visit(child.path, relative)
            elif stat.S_ISLNK(child_stat.st_mode):
                try:
                    target = os.fsencode(os.readlink(child.path))
                except OSError as exc:
                    fail(f"cannot read package symlink {os.path.join(root, relative)}: {exc}")
                entries.append((relative_bytes, b"l", mode, target))
            else:
                fail(f"special file is not allowed in package tree: {os.path.join(root, relative)}")

    visit(root, "")
    entries.sort(key=lambda item: item[0])
    hasher = hashlib.sha256()
    for relative, kind, mode, content in entries:
        _length_prefixed(hasher, relative)
        _length_prefixed(hasher, kind)
        _length_prefixed(hasher, str(mode).encode("ascii"))
        _length_prefixed(hasher, content)
    return hasher.hexdigest()


def managed_release_package_digest(root: str) -> str:
    """Re-measure a managed package with the signed release manifest ABI.

    ``digest_tree`` is the ledger's mutation identity and includes directory
    entries. UPDATE_CHANNEL release.lock instead signs canonical JSON over
    file/symlink rows. Both measurements must hold; equating their unrelated
    hashes rejects every authentic managed package.
    """
    try:
        root_info = os.lstat(root)
    except OSError as exc:
        fail(f"cannot digest managed package tree {root}: {exc}")
    if not stat.S_ISDIR(root_info.st_mode) or stat.S_ISLNK(root_info.st_mode):
        fail(f"cannot digest managed package tree {root}: package path is not a real directory")

    rows: list[tuple[bytes, dict[str, Any]]] = []

    def visit(directory: str, prefix: str) -> None:
        try:
            children = list(os.scandir(directory))
        except OSError as exc:
            fail(f"cannot read managed package tree {root}: {exc}")
        for child in children:
            relative = child.name if not prefix else f"{prefix}/{child.name}"
            try:
                child_info = child.stat(follow_symlinks=False)
            except OSError as exc:
                fail(f"cannot stat managed package entry {os.path.join(root, relative)}: {exc}")
            if stat.S_ISDIR(child_info.st_mode):
                visit(child.path, relative)
                continue
            row: dict[str, Any] = {"path": relative}
            if stat.S_ISREG(child_info.st_mode):
                try:
                    with open(child.path, "rb") as handle:
                        raw = handle.read()
                except OSError as exc:
                    fail(f"cannot read managed package entry {os.path.join(root, relative)}: {exc}")
                row.update({
                    "digest": "sha256:" + hashlib.sha256(raw).hexdigest(),
                    "mode": f"{stat.S_IMODE(child_info.st_mode):04o}",
                    "type": "file",
                })
            elif stat.S_ISLNK(child_info.st_mode):
                try:
                    target = os.readlink(child.path)
                    target.encode("utf-8")
                except (OSError, UnicodeError) as exc:
                    fail(f"cannot read managed package symlink {os.path.join(root, relative)}: {exc}")
                target_path = Path(target)
                if target_path.is_absolute() or ".." in target_path.parts:
                    fail(f"managed package symlink escapes package tree: {relative}")
                row.update({"mode": "0777", "target": target, "type": "symlink"})
            else:
                fail(f"special file is not allowed in managed package tree: {os.path.join(root, relative)}")
            rows.append((os.fsencode(relative), row))

    visit(root, "")
    manifest = [row for _relative, row in sorted(rows, key=lambda item: item[0])]
    raw = (json.dumps(
        manifest, ensure_ascii=False, separators=(",", ":"), sort_keys=True,
    ) + "\n").encode()
    return "sha256:" + hashlib.sha256(raw).hexdigest()


def _managed_authority_for_intent(
        app_id: str, package: dict[str, Any], package_digest: str,
) -> dict[str, Any] | None:
    tx = load_transaction(required=False)
    active = tx is not None and tx["phase"] not in TRANSACTION_TERMINAL_PHASES
    authorities = tx.get("managed_authorities", {}) if active else {}
    if package["source_class"] != "managed":
        if app_id in authorities:
            fail(f"transaction managed authority for {app_id} cannot authorize "
                 f"source_class={package['source_class']!r}")
        return None
    if not active or tx is None:
        fail(f"managed package {app_id} requires an active bound install transaction")
    if app_id not in tx["planned"] or app_id not in authorities:
        fail(f"managed package {app_id} has no transaction-bound authority")
    if (_PACKAGE_INFO_INPUT_SHA256 is None
            or _PACKAGE_INFO_INPUT_SHA256 != tx["package_sha256"]):
        fail(f"managed package {app_id} package-info differs from its transaction binding")
    authority = authorities[app_id]
    _validate_managed_authority(authority, f"managed package {app_id} authority")
    expected_signed_digest = package.get("signed_package_digest")
    if (authority["package_digest"] != expected_signed_digest
            or managed_release_package_digest(package["dir"]) != expected_signed_digest):
        fail(f"managed package {app_id} signed/tree/authority digests differ")
    if authority["capabilities"] != package["capabilities"]:
        fail(f"managed package {app_id} capabilities differ from transaction authority")
    if authority["config_sha256"] != tx["config_sha256"]:
        fail(f"managed package {app_id} config differs from transaction authority")
    return copy.deepcopy(authority)


def _intent_record(app_id: str, package: dict[str, Any], store: dict[str, Any], *,
                   bind_managed: bool = False) -> dict[str, Any]:
    path = canonical_package_path(package)
    if "capabilities" not in package:
        # There is more than one producer of package facts (package-info via
        # _normalise_package, and bin/airlock-config's hand-built adopt dict),
        # so a third one arriving without a derivation is a real possibility.
        # LedgerError, never a bare KeyError: _cmd_adopt_write_locked catches
        # only LedgerError, and the operator gets a diagnosis, not a traceback.
        fail(f"package facts for {app_id} carry no capabilities — every producer "
             "must derive them (bin/airlock-config's manifest spec, or a copy of "
             "that spec's list on the adopt path)")
    digest = digest_tree(path)
    managed_authority = (_managed_authority_for_intent(app_id, package, digest)
                         if bind_managed else None)
    declarations = list(package.get("containers") or ())
    container_runtime = None
    if declarations and not is_dry_run():
        daemon_identity = _docker_daemon_identity()
        committed = (store["entries"].get(app_id) or {}).get("committed")
        previous = committed.get("container_runtime") if committed is not None else None
        # Same-tree reconcile is the sole nonce-reuse path. The committed
        # immutable ids remain authoritative and are admitted separately
        # before this intent can be persisted.
        if (committed is not None and committed["path"] == path
                and committed["digest"] == digest and previous is not None
                and previous["declarations"] == declarations):
            if previous["daemon_identity"] != daemon_identity:
                fail(f"same-digest reconcile for {app_id} reached a different "
                     "Docker daemon; refusing nonce reuse")
            nonce = previous["install_nonce"]
        else:
            nonce = secrets.token_urlsafe(32)
        container_runtime = {
            "runtime": "docker",
            "daemon_identity": daemon_identity,
            "install_nonce": nonce,
            "declarations": declarations,
        }
    return {
        "path": path,
        "digest": digest,
        "artifacts_declared": copy.deepcopy(package["artifacts"]),
        "serve_port_values": copy.deepcopy(package["serve_port_values"]),
        "serve_mappings": copy.deepcopy(package["serve_mappings"]),
        "unit_scopes": copy.deepcopy(package["unit_scopes"]),
        "order": max((r.get("order") or 0 for e in store["entries"].values()
                      for r in (e.get("intent"), e.get("committed")) if isinstance(r, dict)), default=0) + 1,
        # Provenance only, as of store v4: the gates that used to read it
        # (load, expansion, rooted removal) read `capabilities` below. Kept
        # because it is what admission was looking at, and the stale-intent
        # sweep still discriminates on it.
        "source_class": package["source_class"],
        # What admission authorized, recorded as history: the record is read
        # long after the config that produced it may be gone, so this is
        # carried from the resolver's determination and never re-derived here.
        "capabilities": sorted(package["capabilities"]),
        "managed_authority": managed_authority,
        "lifecycle": copy.deepcopy(package["lifecycle"]),
        "deps": copy.deepcopy(package["deps"]),
        # The roots the declaration meant AT INTENT TIME: repair after a
        # crash must expand against these, or a changed root env would make
        # the expansion empty and orphan what the installer already created.
        "roots": _current_roots(),
        # Where each declared pattern's fixed prefix RESOLVED at intent time,
        # so teardown can tell a post-record redirect from a box that was
        # always laid out that way.
        "anchors": _record_anchors(package["artifacts"], _current_roots()),
        "container_runtime": container_runtime,
    }


def _sort_paths(paths: list[str] | set[str]) -> list[str]:
    return sorted(set(paths), key=os.fsencode)


def _pattern_roots(roots: dict[str, str]) -> dict[str, tuple[str, ...]]:
    return {"fragments": (roots["confd"],), "webroot": (roots["webroot"],),
            "units": (roots["unit_user"], roots["unit_system"]),
            "files": ("",), "rooted": ("",)}


def _pattern_anchor(cls: str, pattern: str, root: str, roots: dict[str, str]) -> str:
    """Where a declared pattern's fixed directory prefix RESOLVES TO right now.

    Recorded at intent time and compared at teardown. This is what tells a
    tree that was redirected AFTER the record (the hazard) from one that was
    always laid out that way (~/.local pointing into a dotfiles checkout is
    an ordinary box, and its artifacts must stay removable): the first
    changes the anchor, the second does not."""
    if cls in ("files", "rooted"):
        raw = pattern
        if cls == "rooted":
            raw = _rooted_substitute(raw, str(Path(roots["webroot"]).parent))
        if raw.startswith("~/"):
            raw = os.path.join(roots["home"], raw[2:].lstrip("/"))
        rooted = os.path.abspath(raw)
    else:
        rooted = os.path.join(root, os.path.expanduser(pattern))
    # `webroot = ["mydir/"]` and `["mydir"]` name ONE object (the same rule
    # _canonical_artifact states): without this the trailing-slash form would
    # anchor on the claimed directory itself, so the app's own symlink there
    # would look like a redirect and wedge its teardown.
    rooted = rooted.rstrip("/") or "/"
    head = rooted
    while head and any(ch in os.path.basename(head) for ch in "*?["):
        head = os.path.dirname(head)
    head = os.path.dirname(head) if head == rooted else head
    return os.path.realpath(head or "/")


def _record_anchors(declared: dict[str, Any], roots: dict[str, str]) -> dict[str, str]:
    out: dict[str, str] = {}
    for cls, cls_roots in _pattern_roots(roots).items():
        for pattern in declared.get(cls, []):
            for root in cls_roots:
                out[f"{cls}|{root}|{pattern}"] = _pattern_anchor(cls, str(pattern), root, roots)
    return out


def _rooted_artifact(path: str, root: str | tuple[str, ...], where: str) -> str:
    """Canonicalise a match that is supposed to live under a platform root,
    and REFUSE it if the canonical form escapes.

    glob() walks a symlinked intermediate directory ($WEBROOT/assets/apps ->
    /elsewhere), so a match can canonicalise outside the root it was expanded
    under. Recording that path would put an external directory in the ledger,
    and teardown removes recorded directories — the record itself becomes the
    weapon. Fail closed instead: the operator repairs the redirected tree,
    and nothing outside a root is ever recorded or removed."""
    canonical = _canonical_artifact(path)
    roots = (root,) if isinstance(root, str) else root
    for candidate in roots:
        real = os.path.realpath(candidate)
        if canonical == real or canonical.startswith(real.rstrip("/") + os.sep):
            return canonical
    fail(f"{where}: {path} resolves to {canonical}, outside the platform root"
         f"{'s' if len(roots) > 1 else ''} it was expanded under "
         f"({', '.join(os.path.realpath(r) for r in roots)}) — a symlinked "
         "directory inside the root redirects the claim space; repair the "
         "tree (the ledger never records or removes a path outside a root)")


def _redirected_ancestor(path: str) -> str | None:
    """The first ANCESTOR component of `path` that is a symlink today, or None.

    Every recorded path was canonicalised with a real parent chain, so a
    symlinked ancestor now means the tree was redirected after the record was
    written. Removing through it would delete whatever the link points at —
    the record becoming a weapon (the leaf itself may be a symlink: that is
    owned as a link and removed as one)."""
    parent = os.path.dirname(os.path.normpath(path))
    seen = set()
    while parent and parent not in ("/", ".") and parent not in seen:
        seen.add(parent)
        if os.path.islink(parent):
            return parent
        parent = os.path.dirname(parent)
    return None


def _check_anchor(anchors: dict[str, str] | None, cls: str, root: str,
                  patterns: list[Any], roots: dict[str, str], where: str) -> None:
    """Refuse to expand a declaration whose fixed prefix no longer resolves
    where it did when the record was written.

    That is the precise statement of the hazard: not "an ancestor is a
    symlink" (a box whose ~/.local points into a dotfiles checkout is
    ordinary, and its artifacts must stay removable), but "this declaration
    now names somewhere else than it did". Only teardown passes anchors;
    recording is permissive by design (D2 canonicalises an aliased claim into
    the one claim space). Records written before anchors existed carry an
    empty map and are simply not compared."""
    if not anchors:
        return
    for pattern in patterns:
        key = f"{cls}|{root}|{pattern}"
        recorded = anchors.get(key)
        if recorded is None:
            continue
        current = _pattern_anchor(cls, str(pattern), root, roots)
        if current != recorded and str(pattern).endswith("/"):
            # An intermediate build of this child anchored a trailing-slash
            # claim one level deeper (on the claimed directory itself). Accept
            # that older shape too, or a record written by it could never be
            # torn down — the wedge this whole mechanism exists to prevent.
            legacy = os.path.join(current, os.path.basename(
                str(pattern).rstrip("/")))
            if legacy == recorded:
                continue
        if current != recorded:
            fail(f"{where}: {pattern!r} resolved under {recorded} when the "
                 f"record was written and now resolves under {current} — the "
                 "declaration no longer names what it claimed, so nothing is "
                 "removed through it. Move the artifacts back to the recorded "
                 "location — re-creating an empty directory would drop the "
                 "record while the files it named live on elsewhere — or tear "
                 "the app down before moving them. The record is kept until "
                 "then.")


def _glob_matches(pattern: str) -> list[str]:
    # recursive=False: `**` is rejected by the declared grammar — a recursive
    # glob descends through symlinked directories, escaping the claim space.
    # include_hidden: a dotfile an installer writes under a `*` claim must be
    # recorded, or teardown would leave it orphaned (a stray .env is exactly
    # what must never survive with no record naming it).
    return _sort_paths([os.path.abspath(match)
                        for match in glob.glob(pattern, recursive=False, include_hidden=True)])


def _relative_pattern(root: str, pattern: str, where: str) -> str:
    expanded = os.path.expanduser(pattern)
    if os.path.isabs(expanded):
        fail(f"{where}: absolute artifact pattern is not allowed: {pattern!r}")
    parts = expanded.replace(os.sep, "/").split("/")
    if ".." in parts:
        fail(f"{where}: artifact pattern escapes its root: {pattern!r}")
    # Only the declared pattern globs; a root that happens to contain glob
    # characters is a literal directory name.
    return os.path.join(glob.escape(root), expanded)


def expand_declared(declared: dict[str, Any], port_values: dict[str, Any],
                    roots: dict[str, str] | None = None, *,
                    anchors: dict[str, str] | None = None,
                    unit_scopes: dict[str, str] | None = None,
                    capabilities: list[str] | None = None) -> dict[str, list[Any]]:
    """Expand each class against its root (the record's own roots snapshot
    when repairing an intent; the live env otherwise) without following
    matches."""
    if roots is None:
        roots = _current_roots()
    _validate_artifact_map(declared, "artifacts_declared", True, roots=roots)
    if declared["rooted"] and "rooted-artifact" not in (capabilities or ()):
        # Belt-and-braces: _validate_record already ties a non-empty rooted
        # declaration to the claim at load time, so this should be
        # unreachable in practice — but expansion must never depend on
        # every caller having gone through full record validation first.
        fail("artifacts_declared.rooted: the record does not claim the "
             f"'rooted-artifact' capability (capabilities={capabilities!r})")
    scopes = unit_scopes or {name: "both" for name in declared["units"]}
    _require_system_unit_scope_claim(scopes, capabilities,
                                     "artifacts_declared.units", symmetric=False)
    expanded: dict[str, list[Any]] = {}
    for name, root in (("fragments", roots["confd"]), ("webroot", roots["webroot"])):
        matches: list[str] = []
        for pattern in declared[name]:
            rooted = _relative_pattern(root, pattern, f"artifacts_declared.{name}")
            matches.extend(_glob_matches(rooted))
        _check_anchor(anchors, name, root, declared[name], roots,
                      f"artifacts_declared.{name}")
        expanded[name] = _sort_paths(
            _rooted_artifact(m, root, f"artifacts_declared.{name}")
            for m in matches)
    matches = []
    for pattern in declared["files"]:
        if pattern.startswith("~/"):
            # ~ means the HOME recorded in the roots snapshot, escaped so a
            # home path containing glob characters stays literal. The grammar
            # guarantees a non-empty remainder.
            rooted = os.path.join(glob.escape(roots["home"]), pattern[2:].lstrip("/"))
        else:
            rooted = os.path.abspath(pattern)
        matches.extend(_glob_matches(rooted))
    _check_anchor(anchors, "files", "", declared["files"], roots,
                  "artifacts_declared.files")
    expanded["files"] = _sort_paths(_canonical_artifact(m) for m in matches)
    matches = []
    for pattern in declared["rooted"]:
        rooted = _rooted_substitute(pattern, _rooted_webroot_parent(roots))
        matches.extend(_glob_matches(rooted))
    _check_anchor(anchors, "rooted", "", declared["rooted"], roots,
                  "artifacts_declared.rooted")
    rooted_canon = [_canonical_artifact(m) for m in matches]
    # Containment applies to the EXPANSION too, not just the declared
    # pattern: a glob's non-final segment can walk through a symlinked
    # directory the pattern-level check never sees (the same hazard
    # `_check_anchor` exists for on other classes).
    for m in rooted_canon:
        if not _rooted_contains(m):
            fail(f"artifacts_declared.rooted: {m} resolved outside the rooted "
                 "allowlist (checked against the current environment) — "
                 "the declaration or the environment changed since it was "
                 "recorded" + _rooted_refusal_hint())
    expanded["rooted"] = _sort_paths(rooted_canon)
    ports: list[int] = []
    for value in port_values.values():
        if not _is_int(value) or not 1 <= value <= 65535:
            fail(f"serve_port_values contains invalid port {value!r}")
        ports.append(int(value))
    expanded["serve_ports"] = sorted(set(ports))

    matches = []
    unit_roots = (roots["unit_user"], roots["unit_system"])
    for pattern in declared["units"]:
        selected = unit_roots if scopes.get(pattern, "both") == "both" else (roots[f"unit_{scopes[pattern]}"],)
        for root in selected:
            rooted = _relative_pattern(root, pattern, "artifacts_declared.units")
            matches.extend(_glob_matches(rooted))
        for _uroot in selected:
            _check_anchor(anchors, "units", _uroot, [pattern], roots,
                          "artifacts_declared.units")
    expanded["units"] = _sort_paths(
        _rooted_artifact(m, unit_roots, "artifacts_declared.units")
        for m in matches)
    return expanded


def _committed_artifacts(record: dict[str, Any]) -> dict[str, list[Any]]:
    artifacts = record.get("artifacts", {})
    _validate_artifact_map(artifacts, "committed.artifacts", False)
    if artifacts.get("rooted") and "rooted-artifact" not in (record.get("capabilities") or ()):
        # Belt-and-braces, matching expand_declared's own gate: a committed
        # record's rooted list is only ever teardown-reachable through this
        # function.
        fail("committed.artifacts.rooted: the record does not claim the "
             f"'rooted-artifact' capability (capabilities={record.get('capabilities')!r})")
    _require_system_unit_scope_claim(record.get("unit_scopes") or {},
                                     record.get("capabilities"),
                                     "committed.artifacts.units", symmetric=False)
    roots = record.get("roots") or {}
    if (set(roots) == set(ROOT_KEYS)
            and _recorded_system_unit_paths(artifacts, roots)
            and "system-unit" not in (record.get("capabilities") or ())):
        fail("committed.artifacts.units contains a system unit but the record "
             "does not claim 'system-unit' "
             f"(capabilities={record.get('capabilities')!r})")
    result: dict[str, list[Any]] = {}
    for name in PATH_CLASSES:
        result[name] = _sort_paths([_expand_path(path) for path in artifacts[name]])
    result["serve_ports"] = sorted(set(int(port) for port in artifacts["serve_ports"]))
    return result


def _intent_artifacts(record: dict[str, Any], *,
                      for_teardown: bool = False) -> dict[str, list[Any]]:
    return expand_declared(record["artifacts_declared"], record["serve_port_values"],
                           record.get("roots"),
                           anchors=record.get("anchors") if for_teardown else None,
                           unit_scopes=record.get("unit_scopes"),
                           capabilities=record.get("capabilities"))


def _record_artifact_sets(artifacts: dict[str, list[Any]]) -> tuple[set[str], set[int]]:
    paths: set[str] = set()
    for name in PATH_CLASSES:
        paths.update(_canonical_artifact(str(path)) for path in artifacts[name])
    return paths, set(int(port) for port in artifacts["serve_ports"])


def _check_commit_conflicts(store: dict[str, Any], app_id: str, new_artifacts: dict[str, list[Any]]) -> None:
    new_paths, new_ports = _record_artifact_sets(new_artifacts)
    for other_id in sorted(store["entries"]):
        if other_id == app_id:
            continue
        entry = store["entries"][other_id]
        for kind in ("committed", "intent"):
            record = entry.get(kind)
            if record is None:
                continue
            artifacts = _committed_artifacts(record) if kind == "committed" else _intent_artifacts(record)
            old_paths, old_ports = _record_artifact_sets(artifacts)
            path_overlap = sorted((p for p in new_paths
                                   if any(_paths_related(p, q) for q in old_paths)),
                                  key=os.fsencode)
            if path_overlap:
                fail(f"commit for {app_id} claims artifact {path_overlap[0]} already owned by {other_id}")
            port_overlap = sorted(new_ports & old_ports)
            if port_overlap:
                fail(f"commit for {app_id} claims serve port :{port_overlap[0]} already owned by {other_id}")


def _copy_artifacts(artifacts: dict[str, list[Any]]) -> dict[str, list[Any]]:
    return {name: list(artifacts[name]) for name in ARTIFACT_CLASSES}


def _paths_related(a: str, b: str) -> bool:
    """Equal, ancestor, or descendant — one object or one containing the
    other. A directory claim and a claim on its contents own the same tree."""
    return a == b or _is_under(a, b) or _is_under(b, a)


def _artifact_difference(old: dict[str, list[Any]], new: dict[str, list[Any]]) -> dict[str, list[Any]]:
    # Path classes diff against the union of the new expansion's paths, not
    # class-by-class: a path that merely moved class (webroot -> files) is
    # still owned and must not be torn down as old-only. Containment counts
    # as ownership too — an upgrade that turns a directory claim into a
    # claim on its contents (or back) must not rmtree what it just claimed.
    new_paths: set[str] = set()
    for name in PATH_CLASSES:
        new_paths.update(_canonical_artifact(str(p)) for p in new[name])

    def _still_owned(path: str) -> bool:
        canon = _canonical_artifact(path)
        return any(_paths_related(canon, q) for q in new_paths)

    result: dict[str, list[Any]] = {}
    for name in PATH_CLASSES:
        result[name] = _sort_paths(p for p in (str(x) for x in old[name])
                                   if not _still_owned(p))
    result["serve_ports"] = sorted(set(old["serve_ports"]) - set(new["serve_ports"]))
    return result


def _container_name_matches(name: str, declarations: list[str]) -> bool:
    return any(name.startswith(item[:-1]) if item.endswith("*") else name == item
               for item in declarations)


def _container_claims_overlap(left: list[str], right: list[str]) -> bool:
    for a in left:
        ap, aw = (a[:-1], True) if a.endswith("*") else (a, False)
        for b in right:
            bp, bw = (b[:-1], True) if b.endswith("*") else (b, False)
            if ((not aw and not bw and ap == bp)
                    or (aw and bw and (ap.startswith(bp) or bp.startswith(ap)))
                    or (aw and not bw and bp.startswith(ap))
                    or (not aw and bw and ap.startswith(bp))):
                return True
    return False


def _check_container_claim_conflicts(store: dict[str, Any], app_id: str,
                                     declarations: list[str]) -> None:
    if not declarations:
        return
    for other_id, entry in sorted(store["entries"].items()):
        if other_id == app_id:
            continue
        for kind in ("committed", "intent"):
            record = entry.get(kind)
            runtime = record.get("container_runtime") if record is not None else None
            if runtime is not None and _container_claims_overlap(
                    declarations, runtime["declarations"]):
                fail(f"container claim for {app_id} overlaps {other_id}.{kind}")


_DOCKER_BASE: list[str] | None = None


def _docker_base() -> list[str]:
    global _DOCKER_BASE
    if _DOCKER_BASE is not None:
        return _DOCKER_BASE
    candidates = (["docker"], ["sudo", "-n", "docker"])
    for candidate in candidates:
        try:
            probe = subprocess.run(candidate + ["info"], check=False,
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
        except OSError:
            continue
        if probe.returncode == 0:
            _DOCKER_BASE = list(candidate)
            return _DOCKER_BASE
    fail("Docker daemon unavailable (tried docker and sudo -n docker)")


def _docker(args: list[str]) -> subprocess.CompletedProcess[str]:
    command = _docker_base() + args
    try:
        return subprocess.run(command, check=False, text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as exc:
        fail(f"Docker command failed to start: {exc}")


def _docker_daemon_identity() -> str:
    """Stable Engine identity, independent of direct-vs-sudo client choice."""
    result = _docker(["info", "--format", "{{.ID}}"])
    if result.returncode != 0:
        fail(f"Docker daemon identity query failed with exit {result.returncode}")
    raw = result.stdout.strip()
    identity = f"docker:{raw}"
    if not _DAEMON_ID_RE.fullmatch(identity):
        fail("Docker daemon identity query returned an invalid value")
    return identity


def _require_container_daemon(runtime: dict[str, Any] | None,
                              where: str) -> None:
    if runtime is None:
        return
    current = _docker_daemon_identity()
    if current != runtime["daemon_identity"]:
        fail(f"{where}: Docker daemon identity changed "
             f"(recorded={runtime['daemon_identity']!r}, current={current!r}); "
             "refusing to treat objects on another daemon as absent")


def _container_absent(object_id: str, inspect_exit: int) -> bool:
    """Prove absence from the daemon's own object list, never from its prose.

    Error text is not a contract: the runtime has shipped several phrasings for
    a missing object and changes their casing between releases. Matching the
    wording fails in both directions -- a removed container is demoted to
    UNKNOWN the day the phrasing changes, wedging teardown, and an object that
    is still listed would be retired on the strength of a reply that merely
    reads like an absence. A structured, exit-code-checked re-query answers the
    only question that matters, and stays UNKNOWN whenever it cannot.
    """
    probe = _container_id_query()
    if probe.returncode != 0:
        log(f"Docker inspect {object_id} is UNKNOWN (exit {inspect_exit}); the "
            f"absence re-query also failed with exit {probe.returncode}")
        return False
    try:
        listed = _container_ids_from(probe)
    except LedgerError as exc:
        # _inspect_container's callers treat it as total -- several of them run
        # mid-teardown outside any handler. An unusable list must therefore
        # close as UNKNOWN here rather than abort the loop from inside a probe.
        log(f"Docker inspect {object_id} is UNKNOWN (exit {inspect_exit}); the "
            f"absence re-query returned an unusable list: {exc}")
        return False
    if object_id in listed:
        log(f"Docker inspect {object_id} is UNKNOWN (exit {inspect_exit}); the "
            "daemon still lists the object")
        return False
    return True


def _inspect_container(object_id: str) -> tuple[str, dict[str, Any] | None]:
    """Return PRESENT/ABSENT/UNKNOWN; ABSENT only once the daemon's own
    container list no longer carries the id. Callers must retain the ledger
    record for UNKNOWN."""
    result = _docker(["inspect", object_id])
    if result.returncode != 0:
        if _container_absent(object_id, result.returncode):
            return "ABSENT", None
        return "UNKNOWN", None
    try:
        values = json.loads(result.stdout)
    except json.JSONDecodeError:
        log(f"Docker inspect {object_id} returned invalid JSON (UNKNOWN)")
        return "UNKNOWN", None
    if not isinstance(values, list) or len(values) != 1 or not isinstance(values[0], dict):
        log(f"Docker inspect {object_id} returned an invalid object shape (UNKNOWN)")
        return "UNKNOWN", None
    raw = values[0]
    returned_id = raw.get("Id")
    raw_name = raw.get("Name")
    config = raw.get("Config")
    if not isinstance(config, dict):
        log(f"Docker inspect {object_id} returned an invalid Config (UNKNOWN)")
        return "UNKNOWN", None
    raw_labels = config.get("Labels")
    labels = {} if raw_labels is None else raw_labels
    if (not isinstance(returned_id, str) or not _CONTAINER_ID_RE.fullmatch(returned_id)
            or returned_id != object_id or not isinstance(raw_name, str)
            or not raw_name.startswith("/") or not isinstance(labels, dict)
            or any(not isinstance(k, str) or not isinstance(v, str)
                   for k, v in labels.items())):
        log(f"Docker inspect {object_id} returned an invalid identity (UNKNOWN)")
        return "UNKNOWN", None
    name = raw_name[1:]
    if not _CONTAINER_NAME_RE.fullmatch(name):
        log(f"Docker inspect {object_id} returned an invalid name (UNKNOWN)")
        return "UNKNOWN", None
    return "PRESENT", {"id": returned_id, "name": name, "labels": labels}


def _container_id_query(*, app_id: str | None = None,
                        nonce: str | None = None) -> subprocess.CompletedProcess[str]:
    """Raw id listing. Kept free of _inspect_container so the absence probe in
    _container_absent cannot recurse back into the query it is answering."""
    args = ["ps", "-aq", "--no-trunc"]
    if app_id is not None:
        args += ["--filter", f"label={_PACKAGE_LABEL}={app_id}"]
    if nonce is not None:
        args += ["--filter", f"label={_NONCE_LABEL}={nonce}"]
    return _docker(args)


def _container_ids_from(result: subprocess.CompletedProcess[str]) -> list[str]:
    ids = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(ids) != len(set(ids)) or any(not _CONTAINER_ID_RE.fullmatch(x) for x in ids):
        fail("Docker container enumeration returned invalid full ids")
    return ids


def _enumerate_containers(*, app_id: str | None = None,
                          nonce: str | None = None) -> list[dict[str, Any]]:
    result = _container_id_query(app_id=app_id, nonce=nonce)
    if result.returncode != 0:
        fail(f"Docker container enumeration failed with exit {result.returncode}")
    ids = _container_ids_from(result)
    objects: list[dict[str, Any]] = []
    for object_id in ids:
        state, obj = _inspect_container(object_id)
        if state == "ABSENT":
            continue
        if state == "UNKNOWN" or obj is None:
            fail(f"Docker container enumeration could not establish {object_id}")
        if ((app_id is None or obj["labels"].get(_PACKAGE_LABEL) == app_id)
                and (nonce is None or obj["labels"].get(_NONCE_LABEL) == nonce)):
            objects.append(obj)
    return objects


def _runtime_objects(runtime: dict[str, Any] | None) -> dict[str, dict[str, str]]:
    if runtime is None:
        return {}
    return {obj["id"]: obj for obj in runtime.get("objects", [])}


def _check_live_container_admission(app_id: str, declarations: list[str],
                                    *, allowed_pairs: set[tuple[str, str]] = frozenset()) -> None:
    for obj in _enumerate_containers():
        if not _container_name_matches(obj["name"], declarations):
            continue
        pair = (obj["labels"].get(_PACKAGE_LABEL, ""),
                obj["labels"].get(_NONCE_LABEL, ""))
        if pair not in allowed_pairs:
            fail(f"container namespace collision for {app_id}: {obj['name']} "
                 f"({obj['id']}) is not owned by an admitted record")


def _capture_container_runtime(app_id: str, intent_runtime: dict[str, Any] | None,
                               committed_runtime: dict[str, Any] | None = None, *,
                               allowed_pairs: set[tuple[str, str]] = frozenset()) -> dict[str, Any] | None:
    if intent_runtime is None:
        return None
    _require_container_daemon(intent_runtime, f"container capture for {app_id}")
    if (committed_runtime is not None
            and committed_runtime["daemon_identity"] != intent_runtime["daemon_identity"]):
        fail(f"container capture for {app_id}: intent and committed records "
             "name different Docker daemons")
    nonce = intent_runtime["install_nonce"]
    declarations = intent_runtime["declarations"]
    exact = _enumerate_containers(app_id=app_id, nonce=nonce)
    for obj in exact:
        if not _container_name_matches(obj["name"], declarations):
            fail(f"container {obj['id']} carries the active labels but name "
                 f"{obj['name']!r} is outside the declaration")
    exact_ids = {obj["id"] for obj in exact}
    for obj in _enumerate_containers():
        pair = (obj["labels"].get(_PACKAGE_LABEL, ""),
                obj["labels"].get(_NONCE_LABEL, ""))
        if (_container_name_matches(obj["name"], declarations)
                and obj["id"] not in exact_ids and pair not in allowed_pairs):
            fail(f"container namespace collision for {app_id}: {obj['name']} "
                 "does not carry both active-record labels")
    _require_container_daemon(intent_runtime, f"container capture for {app_id}")
    objects = sorted(({"id": obj["id"], "name": obj["name"]} for obj in exact),
                     key=lambda obj: (obj["name"], obj["id"]))
    if committed_runtime is not None and committed_runtime["install_nonce"] == nonce:
        expected = sorted(committed_runtime["objects"],
                          key=lambda obj: (obj["name"], obj["id"]))
        if objects != expected:
            fail("same-digest container reconcile changed an immutable id or name")
    return {
        "runtime": "docker",
        "daemon_identity": intent_runtime["daemon_identity"],
        "install_nonce": nonce,
        "declarations": list(declarations), "objects": objects,
    }


def container_install_admission_for_load(app_id: str, entry: dict[str, Any]) -> dict[str, str] | None:
    """Second, pre-lifecycle admission gate consumed by airlock-config env."""
    if not isinstance(entry, dict):
        fail(f"container load gate for {app_id}: invalid ledger entry")
    intent = entry.get("intent")
    if not isinstance(intent, dict):
        return None
    runtime = intent.get("container_runtime")
    if runtime is None:
        return None
    _require_container_daemon(runtime, f"container load gate for {app_id}")
    committed = entry.get("committed")
    committed_runtime = (committed.get("container_runtime")
                         if isinstance(committed, dict) else None)
    mode = "fresh"
    if committed is not None:
        if (committed_runtime is None
                or committed_runtime["install_nonce"] != runtime["install_nonce"]):
            fail(f"container load gate for {app_id}: intent is not a "
                 "same-nonce reconcile of the committed runtime")
        _capture_container_runtime(app_id, runtime, committed_runtime)
        mode = "reuse-required"
    else:
        exact = _enumerate_containers(
            app_id=app_id, nonce=runtime["install_nonce"])
        # Objects carrying this intent's own nonce are this run's own work: the
        # nonce is journaled before any create, and the gate is consumed again
        # from smoke -- after install created them, before the commit that ends
        # "fresh". Refusing them would make that commit unreachable and leave
        # every later run fresh again, so the refusal could never clear itself.
        # What must still fail is an object wearing the active labels under a
        # name the declaration never claimed, which is exactly what the
        # commit-time capture refuses.
        for obj in exact:
            if not _container_name_matches(obj["name"], runtime["declarations"]):
                fail(f"container load gate for {app_id}: container {obj['id']} "
                     f"carries the active labels but name {obj['name']!r} is "
                     "outside the declaration")
        _check_live_container_admission(
            app_id, runtime["declarations"],
            allowed_pairs={(app_id, runtime["install_nonce"])})
        _require_container_daemon(runtime, f"container load gate for {app_id}")
    return {
        "install_nonce": runtime["install_nonce"],
        "mode": mode,
        "daemon_identity": runtime["daemon_identity"],
    }


def container_install_nonce_for_load(app_id: str, entry: dict[str, Any]) -> str | None:
    admission = container_install_admission_for_load(app_id, entry)
    return admission["install_nonce"] if admission is not None else None


def _prepare_container_teardown(app_id: str, runtime: dict[str, Any] | None,
                                dry: bool) -> dict[str, Any] | None:
    if runtime is None:
        return None
    if dry:
        return {"runtime": runtime, "objects": _runtime_objects(runtime)}
    _require_container_daemon(runtime, f"container teardown preflight for {app_id}")
    nonce = runtime["install_nonce"]
    recorded = _runtime_objects(runtime)
    exact = _enumerate_containers(app_id=app_id, nonce=nonce)
    candidates = dict(recorded)
    for obj in exact:
        candidates.setdefault(obj["id"], {"id": obj["id"], "name": obj["name"]})
    # Establish every candidate identity before any removal. Unexpected
    # exact-nonce objects are intentionally included even outside the claim.
    for object_id, expected in candidates.items():
        state, obj = _inspect_container(object_id)
        if state == "ABSENT":
            continue
        if state == "UNKNOWN" or obj is None:
            fail(f"cannot establish container {object_id} before teardown")
        if (obj["labels"].get(_PACKAGE_LABEL) != app_id
                or obj["labels"].get(_NONCE_LABEL) != nonce):
            fail(f"container {object_id} identity labels changed; refusing removal")
        if object_id in recorded and obj["name"] != expected["name"]:
            fail(f"container {object_id} recorded name changed from "
                 f"{expected['name']!r} to {obj['name']!r}; refusing removal")
    # Foreign namespace matches are diagnostics only during removal.
    exact_ids = {obj["id"] for obj in exact}
    for obj in _enumerate_containers():
        if (_container_name_matches(obj["name"], runtime["declarations"])
                and obj["id"] not in exact_ids):
            log(f"foreign container collision left untouched: {obj['name']} ({obj['id']})")
    _require_container_daemon(runtime, f"container teardown preflight for {app_id}")
    return {"runtime": runtime, "objects": candidates}


def _execute_container_teardown(app_id: str, plan: dict[str, Any] | None,
                                dry: bool) -> bool:
    if plan is None:
        return True
    runtime = plan["runtime"]
    nonce = runtime["install_nonce"]
    recorded = _runtime_objects(runtime)
    if dry:
        log(f"[dry] would remove Docker containers with exact labels "
            f"{_PACKAGE_LABEL}={app_id}, {_NONCE_LABEL}={nonce}")
        return True
    try:
        _require_container_daemon(runtime, f"container teardown execution for {app_id}")
    except LedgerError as exc:
        log(str(exc))
        return False
    ok = True
    for object_id in sorted(plan["objects"]):
        state, obj = _inspect_container(object_id)
        if state == "ABSENT":
            continue
        if state == "UNKNOWN" or obj is None:
            ok = False
            continue
        if (obj["labels"].get(_PACKAGE_LABEL) != app_id
                or obj["labels"].get(_NONCE_LABEL) != nonce
                or (object_id in recorded and obj["name"] != recorded[object_id]["name"])):
            log(f"container {object_id} identity changed after preflight; refusing removal")
            ok = False
            continue
        result = _docker(["rm", "-f", object_id])
        if result.returncode != 0:
            log(f"docker rm -f {object_id} failed with exit {result.returncode}")
            ok = False
        post_state, _ = _inspect_container(object_id)
        if post_state != "ABSENT":
            log(f"container {object_id} is not proven ABSENT after removal")
            ok = False
        elif result.returncode == 0:
            log(f"removed container {object_id}")
    try:
        _require_container_daemon(runtime, f"final container oracle for {app_id}")
        remaining = _enumerate_containers(app_id=app_id, nonce=nonce)
        _require_container_daemon(runtime, f"final container oracle for {app_id}")
    except LedgerError as exc:
        log(f"final container label-set query failed: {exc}")
        return False
    if remaining:
        log(f"final container label-set is not empty ({len(remaining)} present)")
        ok = False
    return ok


def _container_runtimes_are_empty(app_id: str,
                                  runtimes: list[dict[str, Any] | None],
                                  dry: bool) -> bool:
    """One write-adjacent snapshot for every runtime record being retired."""
    active = [runtime for runtime in runtimes if runtime is not None]
    if not active or dry:
        return True
    try:
        current = _docker_daemon_identity()
        recorded_identities = {runtime["daemon_identity"] for runtime in active}
        if recorded_identities != {current}:
            fail(f"write-adjacent oracle for {app_id}: Docker daemon identity "
                 f"does not match every retired record ({sorted(recorded_identities)!r} "
                 f"vs {current!r})")
        nonces = {runtime["install_nonce"] for runtime in active}
        # One Docker snapshot, then exact in-code post-filtering for the union.
        # Sequential per-nonce queries leave an earlier nonce unguarded while
        # the later one is checked.
        remaining = [obj for obj in _enumerate_containers()
                     if obj["labels"].get(_PACKAGE_LABEL) == app_id
                     and obj["labels"].get(_NONCE_LABEL) in nonces]
        if _docker_daemon_identity() != current:
            fail(f"write-adjacent oracle for {app_id}: Docker daemon changed "
                 "during the final snapshot")
    except LedgerError as exc:
        log(f"write-adjacent container label-set query failed: {exc}")
        return False
    if remaining:
        log(f"write-adjacent container label-set is not empty "
            f"({len(remaining)} present)")
        return False
    return True


def parse_active_ports(raw: str | None, info: dict[str, Any]) -> set[tuple[str, int]]:
    ports: set[tuple[str, int]] = set()
    if raw:
        for token in raw.replace(",", " ").split():
            try:
                port = int(token)
            except ValueError:
                fail(f"--active-ports contains a non-integer value: {token!r}")
            if not 1 <= port <= 65535:
                fail(f"--active-ports contains an invalid port: {port}")
            ports.add(("http", port))
    for package in packages_from_info(info).values():
        ports.update((m["mode"], m["listen"]) for m in package["serve_mappings"].values())
    return ports


def _recorded_active_ports(store: dict[str, Any], exclude_id: str) -> set[tuple[str, int]]:
    """(mode, listen) pairs occupied by every OTHER live ledger record.

    BOTH the committed and intent record of each other id are considered —
    not just one or the other — since during an in-progress upgrade the two
    can name different mappings and either could be the one still actually
    live. `off` clears the whole listen address (D2's child-4 amendment), so
    a record we are not currently touching must guard that address exactly
    like a currently-configured mapping does — two ledger entries can
    legitimately share a (mode, listen) pair mid-run (an upgrade in
    progress, or a config edit that hands a port from one id to another
    within the same reconcile batch)."""
    ports: set[tuple[str, int]] = set()
    for other_id, entry in store.get("entries", {}).items():
        if other_id == exclude_id or not isinstance(entry, dict):
            continue
        for kind in ("committed", "intent"):
            record = entry.get(kind)
            if not isinstance(record, dict):
                continue
            mappings = record.get("serve_mappings") or {}
            ports.update((m["mode"], m["listen"]) for m in mappings.values()
                         if isinstance(m, dict) and "mode" in m and "listen" in m)
    return ports


def _dedupe_mappings(already_covered: dict[str, Any], candidate: dict[str, Any]) -> dict[str, Any]:
    """`candidate`'s entries whose (mode, listen) is NOT already present in
    `already_covered` (Minor E): committed and intent retain independent
    artifact batches, and when both map the same address the second batch
    must not reissue the off the first already covered — a second off that
    itself errors would otherwise keep the
    whole entry and repeat the (harmless but noisy, and retry-blocking)
    duplicate on every re-run. Committed wins (matches _removal_order's own
    committed-over-intent precedence) — the caller passes committed's
    mappings as `already_covered` and dedupes intent's against them.

    Returns an empty dict, never omits the argument, when everything was
    already covered — `_teardown_ports` must see an explicit empty mapping
    (not None) or its no-mappings fallback would resweep every raw port as
    http and reintroduce the very duplicate this function exists to avoid."""
    covered = {(m["mode"], m["listen"]) for m in already_covered.values()}
    return {k: m for k, m in candidate.items() if (m["mode"], m["listen"]) not in covered}


def _dropped_serve_mappings(old_mappings: dict[str, Any], new_mappings: dict[str, Any]) -> dict[str, Any]:
    """Mappings a diff drops, computed on (mode, listen) IDENTITY — never on
    bare port numbers.

    A diff-based teardown must never reuse the NEW record's mappings: by
    definition those no longer cover anything the diff is dropping at all
    (the port's key disappeared, or the same key's listen number changed) —
    `_teardown_ports` ignores its `ports` argument whenever `mappings` is
    given, so handing it the new mappings silently swept nothing for the
    dropped entry and left the old TLS/http listener live forever (no other
    path ever reclaims it). And a NUMBER-only diff misses a same-listen MODE
    flip entirely (http -> https on the SAME port): the number survives in
    both the old and new sets, so a diff keyed on port numbers alone sees no
    change at all (Major: same-listen mode flip invisible to the diff) —
    this compares the full (mode, listen) pair instead."""
    new_keys = {(m["mode"], m["listen"]) for m in new_mappings.values()}
    result: dict[tuple[str, int], dict[str, Any]] = {}
    for mapping in old_mappings.values():
        key = (mapping["mode"], mapping["listen"])
        if key not in new_keys:
            result[key] = mapping
    return {f"{mode}:{listen}": mapping for (mode, listen), mapping in result.items()}


def _run_command(args: list[str], description: str) -> int | None:
    try:
        result = subprocess.run(args, check=False)
    except OSError as exc:
        log(f"{description} failed: {exc}")
        return None
    if result.returncode != 0:
        log(f"{description} failed with exit {result.returncode}")
    return result.returncode


def _is_under(path: str, root: str) -> bool:
    try:
        return os.path.commonpath((path, root)) == root
    except ValueError:
        return False


def _remove_plain_path(path: str, recursive: bool) -> bool:
    if os.path.islink(path) or not os.path.isdir(path):
        os.unlink(path)
        return True
    if recursive:
        shutil.rmtree(path)
    else:
        os.rmdir(path)
    return True


def _protected_state_path(path: str) -> bool:
    """The ledger, its lock, and the state directory are never app artifacts;
    removing them through a record would erase the record of the removal.
    Compared canonically so a symlinked alias cannot slip past."""
    return _is_under(_canonical_artifact(path),
                     os.path.realpath(str(state_dir())))


def _plain_artifact_refusal(path: str) -> str | None:
    if _protected_state_path(path):
        return f"refusing to remove {path}: inside the platform state directory"
    redirected = _redirected_ancestor(path)
    if redirected is not None:
        return (f"refusing to remove {path}: {redirected} is now a symlink, so the "
                "recorded path no longer names what it named when it was recorded "
                "(repair the tree, then re-run)")
    return None


def _remove_artifact_path(path: str, dry: bool) -> bool:
    path = _expand_path(path)
    refusal = _plain_artifact_refusal(path)
    if refusal is not None:
        log(refusal)
        return False
    if not os.path.lexists(path):
        return True
    if dry:
        log(f"[dry] would remove {path}")
        return True
    try:
        _remove_plain_path(path, recursive=True)
    except OSError as exc:
        log(f"remove {path} failed: {exc}")
        return False
    log(f"removed {path}")
    return True


def _rooted_artifact_refusal(path: str,
                             capabilities: list[str] | None) -> str | None:
    """Return a pure execution-time refusal, without touching the path.

    The claim comes from the record that outlives its original config.  The
    allowlist comes from the live environment, never the record's roots
    snapshot: a hand-written record cannot authorize its own removal target.
    This same predicate is used by aggregate preflight and the final removal
    recheck so the two boundaries cannot drift.
    """
    if "rooted-artifact" not in (capabilities or ()):
        return (f"refusing to remove rooted artifact {path}: the record does not "
                "claim the 'rooted-artifact' capability "
                f"(capabilities={capabilities!r})")
    if not _rooted_contains(path):
        return (f"refusing to remove rooted artifact {path}: outside the rooted "
                "allowlist (checked against the current environment, not the "
                "record) — restore the webroot this record was created under, "
                "or remove the artifact by hand" + _rooted_refusal_hint())
    if _protected_state_path(path) or _redirected_ancestor(path) is not None:
        return f"refusing to remove rooted artifact {path}: redirected or protected path"
    return None


def _remove_rooted_artifact_path(path: str, dry: bool, capabilities: list[str] | None) -> bool:
    path = _expand_path(path)
    refusal = _rooted_artifact_refusal(path, capabilities)
    if refusal is not None:
        log(refusal)
        return False
    if not os.path.lexists(path):
        return True
    if dry:
        log(f"[dry] would run sudo rm -rf -- {path}")
        return True
    return _run_command(["sudo", "rm", "-rf", "--", path], f"sudo rm -rf -- {path}") == 0


def _unit_scope(path: str) -> tuple[str, str]:
    """Return the expanded unit path and its current exact-parent scope."""
    path = _expand_path(path)
    parent = os.path.dirname(path)
    if parent == _unit_dir("user"):
        return path, "user"
    if parent == _unit_dir("system"):
        return path, "system"
    fail(f"recorded unit {path} is outside the configured unit directories; "
         "refusing to touch it blind — the record is kept")


def _preflight_teardown_artifacts(artifacts: dict[str, list[Any]],
                                  capabilities: list[str] | None) -> list[tuple[str, str]]:
    """Resolve and authorize the complete artifact set before any mutation.

    This is deliberately repeated at the execution boundary even though a
    normal command loaded a validated record.  Internal callers and future
    refactors must not be able to remove an earlier artifact before a later
    protected, redirected, unauthorized, or out-of-policy artifact is
    discovered. Predictable policy/shape refusals belong here; runtime I/O
    failures remain retryable results of the individual removal operations.
    """
    units = [_unit_scope(str(path)) for path in artifacts["units"]]
    if (any(scope == "system" for _, scope in units)
            and "system-unit" not in (capabilities or ())):
        fail("artifacts.units contains a system unit but capabilities does not "
             f"claim 'system-unit' (capabilities={capabilities!r})")
    for name in ("fragments", "webroot", "files"):
        for raw_path in artifacts[name]:
            path = _expand_path(str(raw_path))
            refusal = _plain_artifact_refusal(path)
            if refusal is not None:
                fail(refusal)
    for raw_path in artifacts["rooted"]:
        path = _expand_path(str(raw_path))
        refusal = _rooted_artifact_refusal(path, capabilities)
        if refusal is not None:
            fail(refusal)
    return units


def _unit_status(path: str, scope: str) -> dict[str, str] | None:
    """Unknown/failed queries are never evidence that a unit has stopped."""
    command = (["systemctl", "--user"] if scope == "user"
               else ["sudo", "systemctl"])
    command += ["show", os.path.basename(path),
                "--property=LoadState,ActiveState,MainPID,ControlPID,ControlGroup"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except OSError as exc:
        log(f"unit status query for {path} failed: {exc}")
        return None
    if result.returncode != 0:
        log(f"unit status query for {path} failed with exit {result.returncode}")
        return None
    state = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if (state.get("LoadState") not in {"loaded", "masked", "not-found"}
            or not state.get("ActiveState")
            or (path.endswith(".service")
                and not all(state.get(key) for key in ("MainPID", "ControlPID")))):
        log(f"unit status query for {path} returned incomplete or invalid state")
        return None
    return state


def _is_service_template(name: str) -> bool:
    return name.endswith("@.service")


def _template_instance_matches(template: str, name: str) -> bool:
    if not _is_service_template(template):
        return False
    prefix = template[:-len(".service")]
    return (name.startswith(prefix) and name.endswith(".service")
            and len(name) > len(prefix) + len(".service"))


def _unit_invocations(path: str, scope: str) -> list[str]:
    """Return concrete unit names that systemctl may safely invoke.

    A template fragment is an artifact, but ``foo@.service`` is not an
    invocable unit. Ask the manager for the concrete instances it currently
    knows and keep the wildcard inside one argv element (never shell-expand
    it). With --no-legend/--plain every non-empty output line begins with the
    full unit name.
    """
    name = os.path.basename(path)
    if not _is_service_template(name):
        return [name]
    pattern = name[:-len("@.service")] + "@*.service"
    command = (["systemctl", "--user"] if scope == "user"
               else ["sudo", "systemctl"])
    command += ["list-units", "--all", "--full", "--plain",
                "--no-legend", "--no-pager", pattern]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except OSError as exc:
        fail(f"cannot enumerate instances of template unit {name}: {exc}")
    if result.returncode != 0:
        fail(f"cannot enumerate instances of template unit {name} "
             f"(rc={result.returncode})")
    instances: list[str] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        candidate = line.split(None, 1)[0]
        if not _template_instance_matches(name, candidate):
            fail(f"cannot classify template unit {name}: unexpected list-units row {line!r}")
        if candidate not in instances:
            instances.append(candidate)
    return instances


def _unit_is_stopped(path: str, state: dict[str, str]) -> bool:
    service = path.endswith(".service")
    no_manager_process = (service and state["MainPID"] == "0"
                          and state["ControlPID"] == "0")
    stopped = ((state["ActiveState"] == "inactive"
                and (not service or no_manager_process))
               # A timed-out stop leaves a failed unit even after SIGKILL completed.
               # Accept that terminal state only with stronger evidence than the
               # inactive path: systemd must report no main/control PID and an
               # explicitly empty cgroup. Missing/unknown or residual cgroups remain
               # refusals, so a failed unit alone is never proof that teardown is safe.
               or (state["ActiveState"] == "failed" and no_manager_process
                   and state.get("ControlGroup") == ""))
    if not stopped:
        log(f"unit {path} is not proven stopped: ActiveState={state['ActiveState']} "
            f"MainPID={state.get('MainPID', '-')} ControlPID={state.get('ControlPID', '-')} "
            f"ControlGroup={state.get('ControlGroup', '<unknown>')!r}")
    return stopped


def _stop_units(units: list[tuple[str, str]], dry: bool) -> bool:
    # Stored order is not a dependency order: old records often put a service
    # before its timer. Stop every activation source (including targets) first.
    # No disable here: it can unlink linked fragments and implicitly reload.
    for path, scope in sorted(units, key=lambda unit: unit[0].endswith(".service")):
        if dry:
            log(f"[dry] would stop and verify inactive unit {path}")
            continue
        if not os.path.lexists(path):
            state = _unit_status(path, scope)
            if state is None:
                return False
            if state["LoadState"] == "not-found" and _unit_is_stopped(path, state):
                continue
        command = (["systemctl", "--user"] if scope == "user"
                   else ["sudo", "systemctl"]) + ["stop", os.path.basename(path)]
        if _run_command(command, " ".join(command)) != 0:
            return False
        state = _unit_status(path, scope)
        if state is None or not _unit_is_stopped(path, state):
            return False
    # Recheck the whole set immediately before the first destructive operation.
    # A later stop can have changed a unit we already checked.
    if not dry:
        for path, scope in units:
            state = _unit_status(path, scope)
            if state is None or not _unit_is_stopped(path, state):
                return False
    return True


def _teardown_unit(path: str, dry: bool, capabilities: list[str] | None,
                   *, preflight_scope: str | None = None,
                   unit_names: list[str] | None = None) -> tuple[bool, str]:
    """Deletion stage, called only after the batch stop barrier.

    Returns (ok, scope): scope is 'user'/'system' whenever the recorded
    path lies under that root (even if already absent — the batch reload in
    teardown_artifacts must still be retryable)."""
    path, scope = _unit_scope(path)
    if preflight_scope is not None and scope != preflight_scope:
        fail(f"recorded unit {path} changed scope after teardown preflight; "
             "refusing to touch it")
    if scope == "system" and "system-unit" not in (capabilities or ()):
        fail("artifacts.units contains a system unit but capabilities does not "
             f"claim 'system-unit' (capabilities={capabilities!r})")
    template = _is_service_template(os.path.basename(path))
    if unit_names is None:
        unit_names = [] if template else [os.path.basename(path)]
    if not os.path.lexists(path) and not (template and unit_names):
        return True, scope
    if dry:
        log(f"[dry] would disable and remove unit {path}")
        return True, scope
    # The batch has already proved every unit stopped. Disable only now:
    # it may itself remove linked fragments. Suppress its implicit reload;
    # the caller reloads each scope once after all fragment removals.
    if scope == "user":
        for unit_name in unit_names:
            if _run_command(["systemctl", "--user", "disable", "--no-reload", unit_name],
                            f"systemctl --user disable --no-reload {unit_name}") != 0:
                log(f"disable failed for {path}; no explicit fragment removal attempted "
                    "(disable may already have removed links); record retained for retry")
                return False, scope
        if not os.path.lexists(path):
            return True, scope
        try:
            _remove_plain_path(path, recursive=False)
        except FileNotFoundError:
            # `systemctl --user disable` removes a SYMLINKED unit file itself,
            # so by the time we reach the unlink the path is legitimately gone.
            # The lexists() guard at the top of this function runs BEFORE the
            # disable and cannot see that. Counting it as a failure deadlocks
            # the record: the teardown never completes, the record is kept, and
            # every later run re-plans the same teardown and dies at the same
            # unlink. The system branch below never had this — `sudo rm -f`
            # tolerates absence. The postcondition is what matters, and it holds.
            log(f"{path} was already gone (its disable removed it)")
            return True, scope
        except OSError as exc:
            log(f"remove {path} failed: {exc}")
            return False, scope
    else:
        for unit_name in unit_names:
            if _run_command(["sudo", "systemctl", "disable", "--no-reload", unit_name],
                            f"sudo systemctl disable --no-reload {unit_name}") != 0:
                log(f"disable failed for {path}; no explicit fragment removal attempted "
                    "(disable may already have removed links); record retained for retry")
                return False, scope
        if not os.path.lexists(path):
            return True, scope
        if _run_command(["sudo", "rm", "-f", path], f"sudo rm {path}") != 0:
            return False, scope
    if os.path.lexists(path):
        log(f"unit fragment {path} still exists after removal; record retained for retry")
        return False, scope
    log(f"removed {path}")
    return True, scope


def _reload_units(scopes: set[str], dry: bool) -> bool:
    """One daemon-reload per touched scope, after the unit batch. Run (and
    retried) whenever units are recorded in the scope, even already-absent
    ones — a reload that failed after the file was removed would otherwise
    never run again."""
    ok = True
    if "user" in scopes:
        if dry:
            log("[dry] would run systemctl --user daemon-reload")
        elif _run_command(["systemctl", "--user", "daemon-reload"],
                          "systemctl --user daemon-reload") != 0:
            ok = False
    if "system" in scopes:
        if dry:
            log("[dry] would run sudo systemctl daemon-reload")
        elif _run_command(["sudo", "systemctl", "daemon-reload"],
                          "sudo systemctl daemon-reload") != 0:
            ok = False
    return ok


def _teardown_ports(ports: list[int], active_ports: set[tuple[str, int]], dry: bool,
                    mappings: dict[str, Any] | None = None) -> bool:
    ok = True
    # `mappings is not None`, not `mappings or ...`: a caller that dedupes
    # mappings across two records (command_teardown, command_remove) can
    # legitimately end up with an EMPTY dict for one of them (every port it
    # would have covered was already claimed by the other) — `or` would
    # treat that the same as "no mappings given" and fall back to sweeping
    # every raw port as http, reissuing exactly the duplicate off the caller
    # deduped away.
    candidate = (mappings if mappings is not None
                else {str(p): {"mode": "http", "listen": p} for p in ports}).values()
    for mapping in sorted(candidate, key=lambda m: (m["mode"], m["listen"])):
        mode, port = mapping["mode"], mapping["listen"]
        if (mode, port) in active_ports:
            if dry:
                log(f"[dry] skipped serve off --{mode}={port} (active)")
            else:
                log(f"skipped serve off --{mode}={port} (active)")
            continue
        if dry:
            log(f"[dry] would run sudo tailscale serve --{mode}={port} off")
            continue
        result = _run_command(["sudo", "tailscale", "serve", f"--{mode}={port}", "off"],
                              f"sudo tailscale serve --{mode}={port} off")
        if result == 0:
            log(f"removed serve --{mode}={port}")
        else:
            ok = False
    return ok


def teardown_artifacts(artifacts: dict[str, list[Any]], active_ports: set[tuple[str, int]], dry: bool,
                       mappings: dict[str, Any] | None = None, *,
                       capabilities: list[str] | None) -> bool:
    return _teardown_artifact_batches([(artifacts, mappings, capabilities)], active_ports, dry)


def _teardown_artifact_batches(batches: list[tuple[dict[str, list[Any]],
                                                 dict[str, Any] | None,
                                                 list[str] | None]],
                               active_ports: set[tuple[str, int]], dry: bool) -> bool:
    # Authorize each record independently, then stop the UNION before deleting
    # anything: an interrupted upgrade can split a service and its timer across
    # committed/intent records with different capability claims.
    prepared = [(artifacts, mappings, capabilities,
                 _preflight_teardown_artifacts(artifacts, capabilities))
                for artifacts, mappings, capabilities in batches]
    units = list(dict.fromkeys(unit for *_, batch_units in prepared for unit in batch_units))
    invocation_names: dict[tuple[str, str], list[str]] = {}
    invocations: list[tuple[str, str]] = []
    for path, scope in units:
        if dry and _is_service_template(os.path.basename(path)):
            log(f"[dry] would enumerate, stop, and disable instances of template unit {path}")
            names: list[str] = []
        else:
            names = _unit_invocations(path, scope)
        invocation_names[(path, scope)] = names
        for name in names:
            invocation = (os.path.join(os.path.dirname(path), name), scope)
            if invocation not in invocations:
                invocations.append(invocation)
    if not _stop_units(invocations, dry):
        log("unit stop/verification failed; no disable, artifact removal or reload "
            "attempted; all fragments and the record are kept for retry")
        return False
    ok = True
    removed: set[str] = set()
    for _, _, capabilities, batch_units in prepared:
        for path, scope in batch_units:
            if path in removed:
                continue
            unit_ok, _ = _teardown_unit(
                path, dry, capabilities, preflight_scope=scope,
                unit_names=invocation_names[(path, scope)])
            ok = unit_ok and ok
            removed.add(path)
    ok = _reload_units({scope for _, scope in units}, dry) and ok
    # Once units are stopped, other artifact removals remain independent and
    # errors are aggregated. Any failure keeps the caller's ledger record.
    for artifacts, mappings, capabilities, _ in prepared:
        for name in ("fragments", "webroot", "files"):
            for path in artifacts[name]:
                ok = _remove_artifact_path(str(path), dry) and ok
        for path in artifacts["rooted"]:
            ok = _remove_rooted_artifact_path(str(path), dry, capabilities) and ok
        ok = _teardown_ports([int(port) for port in artifacts["serve_ports"]],
                             active_ports, dry, mappings) and ok
    return ok


def _drop_committed(store: dict[str, Any], app_id: str) -> dict[str, Any]:
    result = copy.deepcopy(store)
    entry = result["entries"].get(app_id)
    if entry is None:
        return result
    entry.pop("committed", None)
    if not entry:
        result["entries"].pop(app_id, None)
    return result


def _drop_entry(store: dict[str, Any], app_id: str) -> dict[str, Any]:
    result = copy.deepcopy(store)
    result["entries"].pop(app_id, None)
    return result


def _dependency_record(store: dict[str, Any], app_id: str) -> tuple[dict[str, Any], str]:
    """Return the one record the destructive planner already trusts."""
    entry = store["entries"][app_id]
    committed = entry.get("committed")
    if committed is not None:
        return committed, "committed"
    intent = entry.get("intent")
    if intent is not None:
        return intent, "intent"
    fail(f"removal plan has no dependency snapshot for {app_id}")


def _dependency_snapshot(store: dict[str, Any], destructive_ids: list[str],
                         packages: dict[str, dict[str, Any]]) -> dict[str, Any]:
    """Serialize removal deps plus selected-mode publication evidence."""
    rows = []
    for app_id in sorted(destructive_ids, key=os.fsencode):
        record, record_kind = _dependency_record(store, app_id)
        rows.append({
            "app_id": app_id,
            "deps": sorted(record["deps"], key=os.fsencode),
            "record_kind": record_kind,
        })
    candidate_serve_mappings = []
    for app_id in sorted(packages, key=os.fsencode):
        committed = (store["entries"].get(app_id) or {}).get("committed")
        candidate_serve_mappings.append({
            "app_id": app_id,
            "matches_committed": (
                committed is not None
                and packages[app_id]["serve_mappings"] == committed["serve_mappings"]
            ),
        })
    return {
        "schema": "airlock.ledger-dependencies/v2",
        "rows": rows,
        "candidate_serve_mappings": candidate_serve_mappings,
    }


def _removal_order(store: dict[str, Any], destructive_ids: list[str]) -> list[str]:
    """Return destructive ids in the one reverse-topological removal order.

    A selected entry contributes exactly one dependency snapshot: committed
    wins over intent, and intent is used only when committed is absent. Any
    referenced id is retained as a virtual graph node so it can affect the
    deterministic order even when it has no ledger entry.
    """
    graph: dict[str, set[str]] = {app_id: set() for app_id in destructive_ids}
    indegree: dict[str, int] = {app_id: 0 for app_id in destructive_ids}
    for app_id in destructive_ids:
        record, _record_kind = _dependency_record(store, app_id)
        for dependency in record["deps"]:
            graph.setdefault(dependency, set()).add(app_id)
            indegree.setdefault(dependency, 0)
            indegree[app_id] += 1

    selected = set(destructive_ids)
    ranks = {app_id: _dependency_record(store, app_id)[0]["order"]
             for app_id in destructive_ids}
    ranked = all(v is not None for v in ranks.values()) and len(set(ranks.values())) == len(ranks)
    def sort_key(node: str):
        if not ranked:
            return os.fsencode(node)
        return (0, os.fsencode(node)) if node not in selected else (1, ranks[node], os.fsencode(node))
    ready = sorted((node for node, degree in indegree.items() if degree == 0), key=sort_key)
    order: list[str] = []
    while ready:
        node = ready.pop(0)
        order.append(node)
        for dependent in sorted(graph[node], key=os.fsencode):
            indegree[dependent] -= 1
            if indegree[dependent] == 0:
                ready.append(dependent)
        ready.sort(key=sort_key)

    if len(order) != len(graph):
        unresolved = sorted((node for node, degree in indegree.items() if degree > 0),
                            key=os.fsencode)
        names = ", ".join(unresolved)
        fail("cyclic dependency in removal plan involving "
             f"{names}; use bin/airlock-teardown <id> for each affected app")

    return [app_id for app_id in reversed(order) if app_id in selected]


def _desired_package_map(info: dict[str, Any]) -> dict[str, dict[str, Any]]:
    return packages_from_info(info)


def command_plan(store: dict[str, Any], info: dict[str, Any],
                 dependency_snapshot: str | None = None) -> int:
    packages = _desired_package_map(info)
    ids = sorted(set(packages) | set(store["entries"]))
    refusals: list[str] = []
    lines: list[tuple[str, str]] = []
    action_by_id: dict[str, str] = {}
    for app_id in ids:
        desired = packages.get(app_id)
        entry = store["entries"].get(app_id, {})
        committed = entry.get("committed")
        intent = entry.get("intent")
        if desired is not None:
            if committed is None:
                action = "fresh"
            else:
                path = canonical_package_path(desired)
                digest = digest_tree(path)
                if path == committed["path"] and digest == committed["digest"]:
                    action = "reinstall"
                elif committed["lifecycle"]["deactivate"]:
                    action = "upgrade-deactivate"
                else:
                    action = "upgrade-diff"
        elif committed is not None:
            if committed["lifecycle"]["deactivate"]:
                action = "remove"
            else:
                action = "refuse"
                refusals.append(app_id)
        elif intent is not None:
            action = "teardown-intent"
        else:
            continue
        lines.append((action, app_id))

        action_by_id[app_id] = action

    destructive_ids = [app_id for action, app_id in lines
                       if action in DESTRUCTIVE_ACTIONS]
    if destructive_ids:
        removal_ids = iter(_removal_order(store, destructive_ids))
        ordered_lines: list[tuple[str, str]] = []
        for action, app_id in lines:
            if action in DESTRUCTIVE_ACTIONS:
                replacement = next(removal_ids)
                ordered_lines.append((action_by_id[replacement], replacement))
            else:
                ordered_lines.append((action, app_id))
        lines = ordered_lines

    if dependency_snapshot is not None:
        _atomic_json(
            Path(dependency_snapshot),
            _dependency_snapshot(store, destructive_ids, packages),
        )

    for action, app_id in lines:
        print(f"{action}\t{app_id}")
    sys.stdout.flush()
    for app_id in refusals:
        log(f"cannot remove {app_id}: no deactivator was recorded; the only exit is bin/airlock-teardown {app_id}")
    return 3 if refusals else 0


def command_handoffs(store: dict[str, Any], info: dict[str, Any], app_id: str) -> int:
    """List removed owners that must yield a resource immediately before app_id.

    This is a read-only projection of the same canonical artifact/port/container
    claim spaces used by commit. It cannot authorize teardown; remove performs
    the normal execution-time capability and containment checks afterwards.
    """
    packages = _desired_package_map(info)
    package = packages.get(app_id)
    if package is None:
        fail(f"package-info has no configured package {app_id}")
    candidate = _intent_record(app_id, package, store)
    candidate_artifacts = _intent_artifacts(candidate)
    new_paths, new_ports = _record_artifact_sets(candidate_artifacts)
    new_containers = ((candidate.get("container_runtime") or {}).get("declarations") or [])
    selected: list[str] = []
    for other_id, entry in store["entries"].items():
        if other_id == app_id or other_id in packages:
            continue
        record = entry.get("committed") or entry.get("intent")
        if record is None:
            continue
        artifacts = (_committed_artifacts(record) if entry.get("committed") is not None
                     else _intent_artifacts(record))
        old_paths, old_ports = _record_artifact_sets(artifacts)
        old_containers = ((record.get("container_runtime") or {}).get("declarations") or [])
        paths_overlap = any(_paths_related(left, right)
                            for left in new_paths for right in old_paths)
        if (paths_overlap or bool(new_ports & old_ports)
                or _container_claims_overlap(new_containers, old_containers)):
            selected.append(other_id)
    if selected:
        selected = _removal_order(store, selected)
    for other_id in selected:
        print(other_id)
    return 0


def command_intent(store: dict[str, Any], info: dict[str, Any], app_id: str,
                   active_ports_raw: str | None = None) -> int:
    packages = _desired_package_map(info)
    package = packages.get(app_id)
    if package is None:
        fail(f"package-info has no configured package {app_id}")
    record = _intent_record(app_id, package, store, bind_managed=True)
    entry_now = store["entries"].get(app_id) or {}
    old_intent = entry_now.get("intent")
    committed_now = entry_now.get("committed")
    runtime = record["container_runtime"]
    old_runtime = old_intent.get("container_runtime") if old_intent is not None else None
    committed_runtime = (committed_now.get("container_runtime")
                         if committed_now is not None else None)
    declarations = runtime["declarations"] if runtime is not None else []
    retired_runtime = None
    _check_container_claim_conflicts(store, app_id, declarations)
    result = copy.deepcopy(store)
    entry = result["entries"].setdefault(app_id, {})
    entry["intent"] = record
    # Gate before any destruction: a candidate the write gate would refuse
    # must fail before the stale cleanup below touches anything.
    _validate_store(result, ledger_path())
    if not is_dry_run() and runtime is not None:
        _require_container_daemon(runtime, f"container intent admission for {app_id}")
        same_committed = (committed_runtime is not None
                          and committed_runtime["install_nonce"] == runtime["install_nonce"])
        if committed_runtime is not None and not same_committed:
            fail(f"container-backed upgrade for {app_id} still has a committed "
                 "runtime; remove it before recording a fresh nonce")
        allowed_pairs: set[tuple[str, str]] = set()
        if old_runtime is not None:
            allowed_pairs.add((app_id, old_runtime["install_nonce"]))
        if same_committed:
            allowed_pairs.add((app_id, committed_runtime["install_nonce"]))
        _check_live_container_admission(app_id, declarations,
                                        allowed_pairs=allowed_pairs)
        if same_committed:
            # Prove the committed immutable set before stale-intent cleanup;
            # a refusal discoverable from the candidate must precede mutation.
            _capture_container_runtime(
                app_id, runtime, committed_runtime,
                allowed_pairs=({(app_id, old_runtime["install_nonce"])}
                               if old_runtime is not None else set()))
        # A crash intent is not silently overwritten. Unless it is the same
        # committed nonce being reconciled, remove and prove its exact label
        # set empty before a fresh intent can replace it.
        if (old_runtime is not None
                and (not same_committed
                     or old_runtime["install_nonce"] != runtime["install_nonce"])):
            old_plan = _prepare_container_teardown(app_id, old_runtime, False)
            if not _execute_container_teardown(app_id, old_plan, False):
                fail(f"stale container intent for {app_id} could not be torn down; "
                     "record kept so a re-run can retry")
            retired_runtime = old_runtime
        if same_committed:
            _capture_container_runtime(app_id, runtime, committed_runtime)
        else:
            _check_live_container_admission(app_id, declarations)
    elif not is_dry_run() and old_runtime is not None:
        if committed_runtime is not None:
            fail(f"container-backed upgrade for {app_id} still has a committed "
                 "runtime; remove it before clearing the declaration")
        old_plan = _prepare_container_teardown(app_id, old_runtime, False)
        if not _execute_container_teardown(app_id, old_plan, False):
            fail(f"stale container intent for {app_id} could not be torn down; "
                 "record kept so a re-run can retry")
        retired_runtime = old_runtime
    if old_intent is not None and (
            old_intent.get("roots") != record["roots"]
            or old_intent.get("artifacts_declared") != record["artifacts_declared"]
            or old_intent.get("serve_port_values") != record["serve_port_values"]
            # The guard must compare the FULL recorded surface, not just the
            # P1-era fields (Major C): unit_scopes and serve_mappings carry
            # information artifacts_declared/serve_port_values do not (which
            # scope a unit resolves under; which mode/target a port maps
            # to), so a scope or mode change between two crashed-install
            # intents used to replace the old record with zero teardown
            # calls — orphaning an enabled unit (D6's orphan rule broken by
            # the exact mechanism meant to enforce it) or leaving a stale
            # off-address with nothing to reclaim it. source_class rides
            # along as recorded provenance, and capabilities gets its own row
            # for the same Major C reason: since store v4 it is what the
            # teardown BELOW is authorized by (teardown_artifacts takes the
            # OLD intent's list), so two intents that disagree on it are two
            # different records — deriving it from artifacts_declared would
            # only cover 'rooted-artifact', never 'system-unit'.
            or old_intent.get("unit_scopes") != record["unit_scopes"]
            or old_intent.get("serve_mappings") != record["serve_mappings"]
            or old_intent.get("source_class") != record["source_class"]
            or old_intent.get("capabilities") != record["capabilities"]
            or old_intent.get("managed_authority") != record["managed_authority"]):
        # The stale intent may have expanded under different roots or
        # declarations; replacing it would drop the only record naming what
        # its crashed install already created. Tear down ONLY what neither
        # the new declaration nor this id's committed record still owns —
        # the caller's active-ports list keeps live mappings up.
        protected = {name: list(_intent_artifacts(record)[name])
                     for name in ARTIFACT_CLASSES}
        if committed_now is not None:
            committed_arts = _committed_artifacts(committed_now)
            for name in ARTIFACT_CLASSES:
                protected[name] = list(protected[name]) + list(committed_arts[name])
        # strict_links: this expansion feeds a teardown, so it must refuse a
        # declaration whose parent chain was redirected after the record.
        stale = _artifact_difference(_intent_artifacts(old_intent, for_teardown=True),
                                     protected)
        stale_active = (parse_active_ports(active_ports_raw, info)
                        | _recorded_active_ports(store, app_id))
        # The OLD intent's mappings that the NEW one no longer names, on
        # (mode, listen) identity — never the NEW record's mappings, which
        # by construction never cover an entry this sweep is retiring.
        stale_mappings = _dropped_serve_mappings(old_intent["serve_mappings"], record["serve_mappings"])
        if not teardown_artifacts(stale, stale_active, is_dry_run(), stale_mappings,
                                  capabilities=old_intent["capabilities"]):
            fail(f"stale intent for {app_id} could not be torn down (see above); "
                 "record kept so a re-run can retry")
    if is_dry_run():
        log(f"[dry] would record intent {app_id}")
    else:
        _require_container_daemon(runtime, f"container intent write for {app_id}")
        if not _container_runtimes_are_empty(app_id, [retired_runtime], False):
            fail(f"stale container intent for {app_id} reappeared before the "
                 "replacement write; old record kept")
        write_store(result)
        log(f"recorded intent {app_id}")
    print(record["digest"])
    return 0


def command_commit(store: dict[str, Any], info: dict[str, Any], app_id: str,
                   active_ports_raw: str | None) -> int:
    packages = _desired_package_map(info)
    package = packages.get(app_id)
    if package is None:
        fail(f"package-info has no configured package {app_id}")
    entry = store["entries"].get(app_id)
    if not entry or entry.get("intent") is None:
        fail(f"no intent record for {app_id}")
    intent = entry["intent"]
    if package["source_class"] == "managed" or intent["source_class"] == "managed":
        if package["source_class"] != "managed" or intent["source_class"] != "managed":
            fail(f"managed package {app_id} source class changed between intent and commit")
        current_digest = digest_tree(canonical_package_path(package))
        if current_digest != intent["digest"]:
            fail(f"managed package {app_id} tree changed between intent and commit")
        authority_now = _managed_authority_for_intent(
            app_id, package, current_digest,
        )
        if authority_now != intent["managed_authority"]:
            fail(f"managed package {app_id} authority changed between intent and commit")
    active_transaction = load_transaction(required=False)
    if (active_transaction is not None
            and active_transaction.get("app_scoped_plan") is not None
            and app_id in active_transaction["planned"]):
        _require_current_resource_result(app_id)
    active_ports = (parse_active_ports(active_ports_raw, info)
                    | _recorded_active_ports(store, app_id))
    new_artifacts = _intent_artifacts(intent)
    _check_commit_conflicts(store, app_id, new_artifacts)
    intent_runtime = intent.get("container_runtime")
    declarations = (intent_runtime["declarations"]
                    if intent_runtime is not None else [])
    _check_container_claim_conflicts(store, app_id, declarations)
    old_committed = entry.get("committed")
    old_committed_runtime = (old_committed.get("container_runtime")
                             if old_committed is not None else None)
    new_container_runtime = (intent_runtime if is_dry_run()
                             else _capture_container_runtime(
                                 app_id, intent_runtime, old_committed_runtime))
    if is_dry_run() and intent_runtime is not None:
        new_container_runtime = {
            **copy.deepcopy(intent_runtime),
            "objects": (copy.deepcopy(old_committed_runtime["objects"])
                        if old_committed_runtime is not None
                        and old_committed_runtime["install_nonce"]
                        == intent_runtime["install_nonce"] else []),
        }
    # A committed record's unit_scopes maps exactly the RECORDED units (the
    # D6 "expanded artifact list"), not every declared name — a declared
    # unit an installer never created (a conditional unit gated on a config
    # flag, e.g.) is simply absent from artifacts.units, and unit_scopes
    # must shrink with it or the exact-shape validator would refuse an
    # otherwise-healthy commit.
    found_unit_names = {os.path.basename(str(p)) for p in new_artifacts["units"]}
    committed_unit_scopes = {name: scope for name, scope in intent["unit_scopes"].items()
                             if name in found_unit_names}
    committed = {
        "path": intent["path"],
        "digest": intent["digest"],
        "lifecycle": copy.deepcopy(intent["lifecycle"]),
        "deps": copy.deepcopy(intent["deps"]),
        "serve_mappings": copy.deepcopy(intent["serve_mappings"]),
        "unit_scopes": committed_unit_scopes,
        "order": intent["order"],
        # The roots snapshot rides into the committed record too (it used to
        # be dropped here): resolution only (${webroot_parent} for a rooted
        # pattern, at removal-EXPANSION time) — it confers no removal
        # authority (Blocker C: execution-time allowlist checks always use
        # the live environment, never this).
        "roots": copy.deepcopy(intent["roots"]),
        "source_class": intent["source_class"],
        # Carried forward from the intent, NOT re-derived from the artifacts
        # just above: those are the FOUND set (see the unit_scopes comment),
        # so a capability whose artifact turned out to be conditional would
        # vanish from the record teardown later reads.
        "capabilities": list(intent["capabilities"]),
        # The issuer decision is immutable run evidence: commit copies it from
        # the intent rather than accepting or deriving a later authority.
        "managed_authority": copy.deepcopy(intent["managed_authority"]),
        "artifacts": _copy_artifacts(new_artifacts),
        "container_runtime": new_container_runtime,
    }
    result = copy.deepcopy(store)
    result["entries"][app_id] = {"committed": committed}
    # Validate the candidate BEFORE the destructive record diff: a store the
    # write gate would refuse must fail before anything is torn down.
    _validate_store(result, ledger_path())
    if old_committed is not None:
        old_artifacts = _committed_artifacts(old_committed)
        diff = _artifact_difference(old_artifacts, new_artifacts)
        # The OLD committed record's mappings the NEW one no longer names,
        # on (mode, listen) identity (Major D: a numeric-only port diff
        # misses a same-listen mode flip entirely) — never the NEW record's
        # mappings, which by construction never cover an entry the diff is
        # retiring.
        diff_mappings = _dropped_serve_mappings(old_committed["serve_mappings"], committed["serve_mappings"])
        if not teardown_artifacts(diff, active_ports, is_dry_run(), diff_mappings,
                                  capabilities=old_committed["capabilities"]):
            # Committing now would drop the only record naming the artifact
            # that refused to go (D6) — keep old committed + intent; the next
            # run re-installs and retries this diff.
            fail(f"record-diff teardown for {app_id} is incomplete (see above); "
                 "old committed record kept so a re-run can retry")
    if is_dry_run():
        log(f"[dry] would commit {app_id}")
    else:
        write_store(result)
        log(f"committed {app_id}")
    return 0


def _refuse_remove(app_id: str) -> int:
    log(f"refusing to remove {app_id}: no deactivator was recorded; the only exit is bin/airlock-teardown {app_id}")
    return 3


def _deactivator_matches(record: dict[str, Any], app_id: str) -> bool:
    path = record["path"]
    if not os.path.isdir(path):
        return False
    try:
        return digest_tree(path) == record["digest"]
    except LedgerError:
        return False


def _run_deactivator(record: dict[str, Any], app_id: str, dry: bool) -> None:
    path = record["path"]
    script = os.path.join(path, "deactivate.sh")
    if dry:
        log(f"[dry] would run {script}")
        return
    # lstat at the moment of execution: the digest records only a symlink's
    # TARGET STRING, so a script swapped to a symlink after the digest check
    # would run unverified external content behind an unchanged digest (D6).
    try:
        mode = os.lstat(script).st_mode
    except OSError as exc:
        fail(f"deactivator for {app_id} is unreadable: {exc}; ledger retained")
    if not stat.S_ISREG(mode):
        fail(f"deactivator for {app_id} is not a regular non-symlink file; "
             "ledger retained")
    environment = os.environ.copy()
    environment["AIRLOCK_ROOT"] = environment.get("AIRLOCK_ROOT") or str(Path(__file__).resolve().parent.parent)
    environment["AIRLOCK_APP_DIR"] = path
    environment["AIRLOCK_APP_ID"] = app_id
    environment.pop("AIRLOCK_INSTALL_NONCE", None)
    runtime = record.get("container_runtime")
    if runtime is not None:
        environment["AIRLOCK_INSTALL_NONCE"] = runtime["install_nonce"]
    try:
        result = subprocess.run(["bash", script], cwd=path, env=environment, check=False)
    except OSError as exc:
        fail(f"deactivator for {app_id} failed to start: {exc}; ledger retained")
    if result.returncode != 0:
        fail(f"deactivator for {app_id} failed with exit {result.returncode}; ledger retained")
    log(f"deactivator ran for {app_id}")


def command_remove(store: dict[str, Any], info: dict[str, Any], app_id: str,
                   for_upgrade: bool, active_ports_raw: str | None) -> int:
    entry = store["entries"].get(app_id)
    if entry is None:
        fail(f"no ledger entry for {app_id}")
    committed = entry.get("committed")
    intent = entry.get("intent")
    dry = is_dry_run()
    active_ports = (parse_active_ports(active_ports_raw, info)
                    | _recorded_active_ports(store, app_id))

    if committed is None:
        if intent is None:
            fail(f"no ledger entry for {app_id}")
        if for_upgrade:
            log(f"[dry] would keep intent {app_id} for upgrade" if dry else f"kept intent {app_id} for upgrade")
            return 0
        intent_artifacts = _intent_artifacts(intent, for_teardown=True)
        _preflight_teardown_artifacts(intent_artifacts, intent["capabilities"])
        intent_container_plan = _prepare_container_teardown(
            app_id, intent.get("container_runtime"), dry)
        ok = _execute_container_teardown(app_id, intent_container_plan, dry)
        ok = teardown_artifacts(intent_artifacts, active_ports, dry,
                                intent["serve_mappings"],
                                capabilities=intent["capabilities"]) and ok
        if not ok:
            fail(f"teardown of intent {app_id} is incomplete (see above); "
                 "record kept so a re-run can retry")
        if dry:
            log(f"[dry] would drop intent {app_id}")
        else:
            if not _container_runtimes_are_empty(
                    app_id, [intent.get("container_runtime")], False):
                fail(f"intent container set for {app_id} reappeared before the "
                     "ledger write; record kept")
            write_store(_drop_entry(store, app_id))
            log(f"dropped intent {app_id}")
        return 0

    if not committed["lifecycle"]["deactivate"] and not for_upgrade:
        return _refuse_remove(app_id)

    if for_upgrade and not committed["lifecycle"]["deactivate"]:
        container_plan = _prepare_container_teardown(
            app_id, committed.get("container_runtime"), dry)
        if not _execute_container_teardown(app_id, container_plan, dry):
            fail(f"container teardown for upgrade of {app_id} is incomplete; "
                 "committed record kept so a re-run can retry")
        if dry:
            log(f"[dry] would remove committed record {app_id} for upgrade")
        else:
            if not _container_runtimes_are_empty(
                    app_id, [committed.get("container_runtime")], False):
                fail(f"container set for upgrade of {app_id} reappeared before "
                     "the ledger write; committed record kept")
            write_store(_drop_committed(store, app_id))
            log(f"removed committed record {app_id} for upgrade")
        return 0

    # Resolve and authorize every record this command may act on before the
    # deactivator (or any individual teardown) runs.  In-progress upgrades can
    # leave committed and intent records side by side; a bad second record may
    # not be discovered after the first record has already mutated the box.
    committed_artifacts = _committed_artifacts(committed)
    _preflight_teardown_artifacts(committed_artifacts, committed["capabilities"])
    committed_container_plan = _prepare_container_teardown(
        app_id, committed.get("container_runtime"), dry)
    intent_artifacts = None
    intent_container_plan = None
    if intent is not None and not for_upgrade:
        intent_artifacts = _intent_artifacts(intent, for_teardown=True)
        _preflight_teardown_artifacts(intent_artifacts, intent["capabilities"])
        intent_container_plan = _prepare_container_teardown(
            app_id, intent.get("container_runtime"), dry)

    if committed["lifecycle"]["deactivate"] and _deactivator_matches(committed, app_id):
        _run_deactivator(committed, app_id, dry)
    else:
        prefix = "[dry] " if dry else ""
        log(f"{prefix}deactivator did not run for {app_id}; tearing down recorded artifacts")
    ok = _execute_container_teardown(app_id, committed_container_plan, dry)
    batches = [(committed_artifacts, committed["serve_mappings"], committed["capabilities"])]
    if intent is not None and not for_upgrade:
        intent_mappings = _dedupe_mappings(committed["serve_mappings"], intent["serve_mappings"])
        assert intent_artifacts is not None
        ok = _execute_container_teardown(app_id, intent_container_plan, dry) and ok
        batches.append((intent_artifacts, intent_mappings, intent["capabilities"]))
    ok = _teardown_artifact_batches(batches, active_ports, dry) and ok
    if not ok:
        fail(f"removal of {app_id} is incomplete (see above); "
             "ledger record kept so a re-run can retry")
    if dry:
        log(f"[dry] would drop committed record {app_id}")
    else:
        retired_runtimes = [committed.get("container_runtime")]
        if not for_upgrade and intent is not None:
            retired_runtimes.append(intent.get("container_runtime"))
        if not _container_runtimes_are_empty(app_id, retired_runtimes, False):
            fail(f"container set for {app_id} reappeared before the ledger "
                 "write; record kept")
        result = _drop_committed(store, app_id) if for_upgrade else _drop_entry(store, app_id)
        write_store(result)
        log(f"dropped committed record {app_id}" if for_upgrade else f"dropped ledger entry {app_id}")
    return 0


def command_teardown(store: dict[str, Any], info: dict[str, Any], app_id: str,
                     active_ports_raw: str | None) -> int:
    entry = store["entries"].get(app_id)
    if entry is None:
        fail(f"no ledger entry for {app_id}")
    committed = entry.get("committed")
    intent = entry.get("intent")
    if committed is None and intent is None:
        fail(f"no ledger entry for {app_id}")
    dry = is_dry_run()
    active_ports = (parse_active_ports(active_ports_raw, info)
                    | _recorded_active_ports(store, app_id))
    # Keep each record's capabilities and mapping ownership; the shared unit
    # stop barrier spans both records before either can delete a fragment.
    committed_artifacts = _committed_artifacts(committed) if committed is not None else None
    intent_artifacts = (_intent_artifacts(intent, for_teardown=True)
                        if intent is not None else None)
    if committed_artifacts is not None:
        _preflight_teardown_artifacts(committed_artifacts, committed["capabilities"])
    if intent_artifacts is not None:
        _preflight_teardown_artifacts(intent_artifacts, intent["capabilities"])
    committed_container_plan = (_prepare_container_teardown(
        app_id, committed.get("container_runtime"), dry)
        if committed is not None else None)
    intent_container_plan = (_prepare_container_teardown(
        app_id, intent.get("container_runtime"), dry)
        if intent is not None else None)

    log(f"{'[dry] ' if dry else ''}platform-performed, no deactivator ran for {app_id}")
    ok = True
    intent_mappings = (_dedupe_mappings(committed["serve_mappings"], intent["serve_mappings"])
                       if committed is not None and intent is not None
                       else (intent["serve_mappings"] if intent is not None else {}))
    batches = []
    if committed is not None:
        assert committed_artifacts is not None
        ok = _execute_container_teardown(app_id, committed_container_plan, dry) and ok
        batches.append((committed_artifacts, committed["serve_mappings"], committed["capabilities"]))
    if intent is not None:
        assert intent_artifacts is not None
        ok = _execute_container_teardown(app_id, intent_container_plan, dry) and ok
        batches.append((intent_artifacts, intent_mappings, intent["capabilities"]))
    ok = _teardown_artifact_batches(batches, active_ports, dry) and ok
    if not ok:
        fail(f"teardown of {app_id} is incomplete (see above); "
             "ledger entry kept so a re-run can retry")
    if dry:
        log(f"[dry] would drop ledger entry {app_id}")
    else:
        retired_runtimes = [record.get("container_runtime")
                            for record in (committed, intent)
                            if record is not None]
        if not _container_runtimes_are_empty(app_id, retired_runtimes, False):
            fail(f"container set for {app_id} reappeared before the ledger "
                 "write; entry kept")
        write_store(_drop_entry(store, app_id))
        log(f"dropped ledger entry {app_id}")
    return 0


# ---------------------------------------------------------------------------
# Durable install transaction.  The ordinary ledger remains the ownership
# source of truth; this sidecar only preserves the last committed bytes and
# runtime state long enough to compensate one installer run.

def transaction_path() -> Path:
    return state_dir() / TRANSACTION_FILENAME


def _transaction_root(transaction_id: str) -> Path:
    return state_dir() / "install-checkpoints" / transaction_id


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as fh:
            while True:
                block = fh.read(1024 * 1024)
                if not block:
                    break
                digest.update(block)
    except OSError as exc:
        fail(f"cannot hash checkpoint {path}: {exc}")
    return digest.hexdigest()


def _atomic_json(path: Path, value: Any) -> None:
    directory = path.parent
    try:
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        if path.is_symlink() or directory.is_symlink():
            fail(f"refusing redirected transaction path: {path}")
        fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=directory)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(value, fh, indent=2, sort_keys=True)
                fh.write("\n")
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(temporary, path)
            temporary = ""
            directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        finally:
            if temporary:
                try:
                    os.unlink(temporary)
                except OSError:
                    pass
    except LedgerError:
        raise
    except (OSError, TypeError, ValueError) as exc:
        fail(f"cannot atomically write transaction {path}: {exc}")


def _validate_trusted_measurer_activation(value: Any, tx: dict[str, Any], path: Path) -> None:
    fields = {"new_path", "new_sha256", "old_path", "old_sha256",
              "schema", "state", "target"}
    if not isinstance(value, dict) or set(value) != fields:
        fail(f"{path}: invalid trusted measurer activation shape")
    if value["schema"] != TRUSTED_MEASURER_ACTIVATION_SCHEMA:
        fail(f"{path}: unsupported trusted measurer activation schema")
    if value["state"] not in TRUSTED_MEASURER_ACTIVATION_STATES:
        fail(f"{path}: invalid trusted measurer activation state")
    if value["target"] != TRUSTED_MEASURER_TARGET:
        fail(f"{path}: trusted measurer activation target is not fixed")
    expected = {
        "new_path": f"/opt/airlock/libexec/.airlock-managed-release.{tx['id']}.new",
        "old_path": f"/opt/airlock/libexec/.airlock-managed-release.{tx['id']}.old",
    }
    for key, expected_path in expected.items():
        if value[key] != expected_path:
            fail(f"{path}: trusted measurer {key} differs from the transaction id")
    for key in ("new_sha256", "old_sha256"):
        if not _is_hex_digest(value[key]):
            fail(f"{path}: trusted measurer {key} must be a lowercase sha256")
    authorities = tx.get("managed_authorities")
    if not isinstance(authorities, dict) or not authorities:
        fail(f"{path}: trusted measurer activation requires managed authorities")
    old_hashes = {authority["installed_measurer_sha256"] for authority in authorities.values()}
    new_hashes = {authority["next_measurer_sha256"] for authority in authorities.values()}
    if old_hashes != {value["old_sha256"]} or new_hashes != {value["new_sha256"]}:
        fail(f"{path}: trusted measurer hashes differ from managed authorities")


def _validate_transaction(value: Any, path: Path) -> dict[str, Any]:
    fields = {"version", "id", "started_at", "config_sha256", "package_sha256",
              "phase", "planned", "actions", "touched", "deactivated", "checkpoints",
              "ledger_snapshot", "error", "restore_results"}
    optional_fields = {"forward_keep", "app_scoped_plan", "resource_results",
                       "managed_authorities", "managed_authority_sha256",
                       "trusted_measurer_activation"}
    if not isinstance(value, dict) or not (fields <= set(value) <= fields | optional_fields):
        fail(f"{path}: invalid transaction shape")
    if "forward_keep" in value:
        _validate_forward_keep(value["forward_keep"], value, path)
    if value["version"] != TRANSACTION_VERSION:
        fail(f"{path}: unsupported transaction version {value['version']!r}")
    if not re.fullmatch(r"[0-9a-f]{32}", str(value["id"])):
        fail(f"{path}: invalid transaction id")
    for key in ("config_sha256", "package_sha256"):
        if not _is_hex_digest(value[key]):
            fail(f"{path}: {key} must be a lowercase sha256")
    if "app_scoped_plan" in value:
        binding = value["app_scoped_plan"]
        if (not isinstance(binding, dict)
                or set(binding) != {"plan_sha256", "dependency_snapshot_sha256"}
                or not _is_hex_digest(binding.get("plan_sha256"))
                or not _is_hex_digest(binding.get("dependency_snapshot_sha256"))):
            fail(f"{path}: invalid app-scoped plan binding")
    if "resource_results" in value:
        results = value["resource_results"]
        if (not isinstance(results, dict)
                or not set(results).issubset(set(value.get("planned") or []))):
            fail(f"{path}: invalid resource result owners")
        for app_id, operations in results.items():
            if (not isinstance(operations, dict)
                    or not set(operations).issubset(RESOURCE_RESULT_OPERATIONS)):
                fail(f"{path}: invalid resource results for {app_id}")
            for operation, result in operations.items():
                _validate_resource_result_shape(result, operation, app_id)
    if ("managed_authorities" in value) != ("managed_authority_sha256" in value):
        fail(f"{path}: managed authorities require their SHA-256 binding")
    if "managed_authorities" in value:
        authorities = value["managed_authorities"]
        if (not isinstance(authorities, dict) or not authorities
                or "app_scoped_plan" not in value
                or not isinstance(value.get("actions"), dict)
                or not isinstance(value.get("planned"), list)
                or any(not isinstance(item, str) for item in value["planned"])
                or not set(authorities).issubset(set(value["planned"]))):
            fail(f"{path}: invalid managed authority owners")
        for app_id, authority in authorities.items():
            if (not isinstance(app_id, str) or not _ID_RE.fullmatch(app_id)
                    or value["actions"].get(app_id) in DESTRUCTIVE_ACTIONS):
                fail(f"{path}: invalid managed authority owner {app_id!r}")
            _validate_managed_authority(
                authority, f"{path}: managed authority {app_id!r}",
            )
            if authority["config_sha256"] != value["config_sha256"]:
                fail(f"{path}: managed authority {app_id!r} differs from transaction config")
        expected_authority_sha = hashlib.sha256(_canonical_json_bytes({
            "authorities": authorities,
            "schema": MANAGED_RUN_AUTHORITY_SCHEMA,
        })).hexdigest()
        if (not _is_hex_digest(value["managed_authority_sha256"])
                or value["managed_authority_sha256"] != expected_authority_sha):
            fail(f"{path}: managed authority SHA-256 differs from its durable mapping")
    if "trusted_measurer_activation" in value:
        _validate_trusted_measurer_activation(
            value["trusted_measurer_activation"], value, path,
        )
    if value["phase"] not in TRANSACTION_PHASES:
        fail(f"{path}: invalid transaction phase {value['phase']!r}")
    activation = value.get("trusted_measurer_activation")
    if isinstance(activation, dict):
        if value["phase"] == "rolled_back":
            fail(f"{path}: rolled-back transaction cannot retain trusted measurer activation")
        if activation["state"] == "durable" and value["phase"] != "committed":
            fail(f"{path}: durable trusted measurer activation requires committed apps")
    if value.get("managed_authorities") and value["phase"] == "committed" \
            and activation is None:
        fail(f"{path}: committed managed transaction lacks trusted measurer activation")
    for key in ("planned", "touched", "deactivated"):
        items = value[key]
        if (not isinstance(items, list) or len(items) != len(set(items))
                or any(not isinstance(item, str) or not _ID_RE.fullmatch(item) for item in items)):
            fail(f"{path}: {key} must be unique package ids")
    if (not isinstance(value["actions"], dict)
            or set(value["actions"]) != set(value["planned"])
            or any(action not in TRANSACTION_ACTIONS for action in value["actions"].values())):
        fail(f"{path}: actions must map every planned app to a ledger plan action")
    if not set(value["touched"]).issubset(value["planned"]):
        fail(f"{path}: touched apps must be planned")
    if not set(value["deactivated"]).issubset(value["touched"]):
        fail(f"{path}: deactivated apps must be touched")
    if not isinstance(value["checkpoints"], dict) or not isinstance(value["restore_results"], dict):
        fail(f"{path}: checkpoints and restore_results must be objects")
    if value["phase"] != "committed" and set(value["checkpoints"]) != set(value["planned"]):
        fail(f"{path}: checkpoints must cover every planned app")
    if not set(value["restore_results"]).issubset(value["touched"]):
        fail(f"{path}: restore results must name touched apps")
    if value["error"] is not None and not isinstance(value["error"], dict):
        fail(f"{path}: error must be null or an object")
    snapshot = value["ledger_snapshot"]
    if (not isinstance(snapshot, dict) or set(snapshot) != {"file", "sha256"}
            or snapshot["file"] != "ledger.json" or not _is_hex_digest(snapshot["sha256"])):
        fail(f"{path}: invalid ledger snapshot receipt")
    return value


def load_transaction(*, required: bool = True) -> dict[str, Any] | None:
    path = transaction_path()
    if not os.path.lexists(path):
        if required:
            fail("no install transaction exists")
        return None
    if path.is_symlink() or not path.is_file():
        fail(f"{path}: transaction must be a regular non-symlink file")
    try:
        with path.open("r", encoding="utf-8") as fh:
            value = json.load(fh)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(f"{path}: cannot parse transaction: {exc}")
    return _validate_transaction(value, path)


def write_transaction(value: dict[str, Any]) -> None:
    _validate_transaction(value, transaction_path())
    _atomic_json(transaction_path(), value)


def _transaction_checkpoint_path(tx: dict[str, Any], relative: str) -> Path:
    if not re.fullmatch(r"[A-Za-z0-9._/-]+", relative) or relative.startswith("/") \
            or ".." in Path(relative).parts:
        fail(f"transaction {tx['id']}: unsafe checkpoint path {relative!r}")
    root = _transaction_root(tx["id"])
    path = root / relative
    if root.is_symlink() or _redirected_ancestor(str(path)) is not None:
        fail(f"transaction {tx['id']}: checkpoint path is redirected")
    return path


def _checkpoint_io_failure(path: str, exc: OSError) -> NoReturn:
    if isinstance(exc, FileNotFoundError):
        fail(f"checkpoint artifact is missing: {path}")
    if isinstance(exc, PermissionError):
        fail(f"checkpoint artifact is unreadable: {path}: {exc}")
    fail(f"cannot inspect checkpoint artifact {path}: {exc}")


def _capture_checkpoint_tree(bundle: tarfile.TarFile, source: str, *,
                             privileged: bool) -> list[str]:
    """Validate and archive one tree in a single recursive walk.

    A descendant Unix socket is live IPC rather than restorable state. Record
    its relative path and omit it; every top-level socket and every other
    special type remains a hard failure.
    """
    ephemeral: list[str] = []
    permitted_groups = {os.getegid(), *os.getgroups()}

    def visit(path: str, arcname: str, relative: str) -> None:
        try:
            item_stat = os.lstat(path)
        except OSError as exc:
            _checkpoint_io_failure(path, exc)
        mode = item_stat.st_mode
        if (not privileged and
                (item_stat.st_uid != os.geteuid() or item_stat.st_gid not in permitted_groups)):
            fail(f"checkpoint metadata for {path} cannot be restored by this user")
        if stat.S_ISSOCK(mode):
            if not relative:
                fail(f"unsupported top-level Unix socket checkpoint artifact at {path}")
            ephemeral.append(relative)
            return
        if stat.S_ISREG(mode):
            if item_stat.st_nlink != 1:
                fail(f"unsupported hard-linked checkpoint artifact at {path}")
            try:
                with open(path, "rb") as fh:
                    opened = os.fstat(fh.fileno())
                    if not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1:
                        fail(f"checkpoint artifact changed type while being read: {path}")
                    member = bundle.gettarinfo(fileobj=fh, arcname=arcname)
                    if member is None or not member.isreg():
                        fail(f"cannot describe checkpoint artifact {path}")
                    bundle.addfile(member, fh)
            except LedgerError:
                raise
            except OSError as exc:
                _checkpoint_io_failure(path, exc)
            return
        if stat.S_ISDIR(mode):
            try:
                member = bundle.gettarinfo(path, arcname)
                if member is None or not member.isdir():
                    fail(f"checkpoint artifact changed type while being read: {path}")
                bundle.addfile(member)
                with os.scandir(path) as entries:
                    children = sorted(entries, key=lambda entry: os.fsencode(entry.name))
            except LedgerError:
                raise
            except OSError as exc:
                _checkpoint_io_failure(path, exc)
            for entry in children:
                child_relative = entry.name if not relative else f"{relative}/{entry.name}"
                visit(entry.path, f"{arcname}/{entry.name}", child_relative)
            return
        if stat.S_ISLNK(mode):
            try:
                member = bundle.gettarinfo(path, arcname)
            except OSError as exc:
                _checkpoint_io_failure(path, exc)
            if member is None or not member.issym():
                fail(f"checkpoint artifact changed type while being read: {path}")
            bundle.addfile(member)
            return
        fail(f"unsupported checkpoint artifact type at {path}; only files, directories, symlinks, and descendant Unix sockets are transactional")

    visit(source, "payload", "")
    return sorted(ephemeral, key=os.fsencode)


def _validated_ephemeral_sockets(value: Any, where: str) -> list[str]:
    if (not isinstance(value, list)
            or any(not isinstance(path, str) for path in value)
            or value != sorted(set(value), key=os.fsencode)
            or any(not path or os.path.isabs(path)
                   or os.path.normpath(path) != path
                   or ".." in Path(path).parts for path in value)):
        fail(f"invalid ephemeral socket receipt for {where}")
    return value


def _privileged_checkpoint_archive(app_id: str, artifact_class: str, scope: str | None,
                                   source: str, archive: Path) -> list[str]:
    try:
        fd = os.open(archive, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as output:
            result = subprocess.run(
                ["sudo", os.path.realpath(__file__), "_checkpoint-helper", "archive",
                 app_id, artifact_class, scope or "-", str(state_dir()), source],
                stdout=output,
                stderr=subprocess.PIPE,
                text=False,
                check=False,
            )
    except OSError as exc:
        fail(f"cannot invoke sudo checkpoint helper for {source}: {exc}")
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", errors="replace").strip()
        suffix = f": {detail}" if detail else ""
        fail(f"sudo could not capture checkpoint artifact {source} (rc={result.returncode}){suffix}")
    try:
        receipt = json.loads(result.stderr.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        fail(f"sudo checkpoint helper returned an invalid receipt for {source}: {exc}")
    if not isinstance(receipt, dict) or set(receipt) != {"ephemeral_sockets"}:
        fail(f"sudo checkpoint helper returned an invalid receipt for {source}")
    return _validated_ephemeral_sockets(receipt["ephemeral_sockets"], source)


def _checkpoint_helper_state(requested: str) -> None:
    """Bind helper authorization to the invoking operator's exact state store."""
    owner_uid = os.geteuid()
    if os.geteuid() == 0:
        sudo_user = os.environ.get("SUDO_USER", "")
        sudo_uid = os.environ.get("SUDO_UID", "")
        if not sudo_user or not sudo_uid.isdigit() or int(sudo_uid) == 0:
            fail("checkpoint helper requires a non-root sudo invoking user")
        try:
            account = pwd.getpwnam(sudo_user)
        except KeyError:
            fail("checkpoint helper cannot resolve the sudo invoking user")
        if account.pw_uid != int(sudo_uid) or not os.path.isabs(account.pw_dir):
            fail("checkpoint helper received an inconsistent sudo invoking user")
        owner_uid = account.pw_uid
        os.environ["HOME"] = account.pw_dir
    if not os.path.isabs(requested) or requested != os.path.normpath(requested):
        fail("checkpoint helper requires one normalized absolute state directory")
    state = Path(requested)
    ledger = state / LEDGER_FILENAME
    try:
        state_stat = os.lstat(state)
        ledger_stat = os.lstat(ledger)
    except OSError as exc:
        fail(f"checkpoint helper cannot inspect the invoking state store: {exc}")
    if (not stat.S_ISDIR(state_stat.st_mode)
            or state_stat.st_uid != owner_uid or stat.S_IMODE(state_stat.st_mode) & 0o022):
        fail("checkpoint helper state directory is not a private invoking-user directory")
    if (not stat.S_ISREG(ledger_stat.st_mode)
            or ledger_stat.st_uid != owner_uid or stat.S_IMODE(ledger_stat.st_mode) & 0o077):
        fail("checkpoint helper ledger is not a private invoking-user regular file")
    os.environ["AIRLOCK_STATE_DIR"] = requested


def _authorize_checkpoint_helper(app_id: str, artifact_class: str,
                                 scope: str | None, checkpoint_state: str,
                                 source: str) -> None:
    _checkpoint_helper_state(checkpoint_state)
    if not _ID_RE.fullmatch(app_id):
        fail("checkpoint helper received an invalid package id")
    if (artifact_class, scope) not in PRIVILEGED_CHECKPOINT_CLASSES:
        fail("checkpoint helper accepts only rooted artifacts and system units")
    if not os.path.isabs(source) or source != os.path.normpath(source):
        fail("checkpoint helper requires one normalized absolute artifact path")
    store = load_store()
    committed = (store["entries"].get(app_id) or {}).get("committed")
    if committed is None:
        fail(f"checkpoint helper has no committed record for {app_id}")
    artifacts = _committed_artifacts(committed)
    units = _preflight_teardown_artifacts(artifacts, committed["capabilities"])
    allowed = (source in artifacts["rooted"] if artifact_class == "rooted"
               else (source, "system") in units)
    if not allowed:
        fail(f"checkpoint helper path/class is not an exact committed artifact for {app_id}")


def _checkpoint_helper_archive(app_id: str, artifact_class: str,
                               scope: str | None, checkpoint_state: str,
                               source: str) -> int:
    """Privileged half of checkpoint capture; stdout is the archive bytes."""
    _authorize_checkpoint_helper(
        app_id, artifact_class, scope, checkpoint_state, source)
    try:
        with tarfile.open(fileobj=sys.stdout.buffer, mode="w|", format=tarfile.PAX_FORMAT,
                          dereference=False) as bundle:
            ephemeral = _capture_checkpoint_tree(bundle, source, privileged=True)
    except (OSError, tarfile.TarError) as exc:
        fail(f"cannot create privileged checkpoint archive for {source}: {exc}")
    sys.stderr.write(json.dumps({"ephemeral_sockets": ephemeral}, sort_keys=True) + "\n")
    return 0


def _write_checkpoint_archive(app_id: str, artifact_class: str, scope: str | None,
                              source: str, archive: Path) -> tuple[str, list[str]]:
    privileged = (artifact_class, scope) in PRIVILEGED_CHECKPOINT_CLASSES
    try:
        archive.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if privileged:
            ephemeral = _privileged_checkpoint_archive(
                app_id, artifact_class, scope, source, archive)
        else:
            with tarfile.open(archive, "x", format=tarfile.PAX_FORMAT,
                              dereference=False) as bundle:
                ephemeral = _capture_checkpoint_tree(bundle, source, privileged=False)
        os.chmod(archive, 0o600)
        with archive.open("rb") as fh:
            os.fsync(fh.fileno())
    except LedgerError:
        try:
            archive.unlink()
        except OSError:
            pass
        raise
    except (OSError, tarfile.TarError) as exc:
        try:
            archive.unlink()
        except OSError:
            pass
        fail(f"cannot create checkpoint archive for {source}: {exc}")
    return _sha256_file(archive), ephemeral


def _capture_unit_state(name: str, scope: str) -> dict[str, bool]:
    prefix = ["systemctl", "--user"] if scope == "user" else ["sudo", "systemctl"]
    try:
        active = subprocess.run(prefix + ["is-active", "--quiet", name], check=False).returncode
        enabled = subprocess.run(prefix + ["is-enabled", "--quiet", name], check=False).returncode
    except OSError as exc:
        fail(f"cannot capture unit state for {name}: {exc}")
    if active not in (0, 3) or enabled not in (0, 1):
        fail(f"cannot classify unit state for {name} (active rc={active}, enabled rc={enabled})")
    return {"active": active == 0, "enabled": enabled == 0}


def _checkpoint_record(store: dict[str, Any], app_id: str, action: str, root: Path) -> dict[str, Any]:
    entry = store["entries"].get(app_id) or {}
    committed = entry.get("committed")
    if committed is None:
        return {"artifacts": [], "units": {}, "mappings": {}}
    if action == "upgrade-deactivate" and committed.get("container_runtime") is not None:
        fail(f"container-backed upgrade for {app_id} cannot be losslessly restored; refusing before mutation")
    artifacts = _committed_artifacts(committed)
    units = _preflight_teardown_artifacts(artifacts, committed["capabilities"])
    unit_scope = {path: scope for path, scope in units}
    captured: list[dict[str, Any]] = []
    seen: set[str] = set()
    index = 0
    for artifact_class in PATH_CLASSES:
        for path in artifacts[artifact_class]:
            path = str(path)
            if path in seen:
                continue
            seen.add(path)
            scope = unit_scope.get(path)
            item: dict[str, Any] = {"path": path, "class": artifact_class,
                                    "scope": scope, "existed": True,
                                    "archive": None, "sha256": None,
                                    "ephemeral_sockets": []}
            relative = f"{app_id}/{index:06d}.tar"
            archive = root / relative
            item["archive"] = relative
            item["sha256"], item["ephemeral_sockets"] = _write_checkpoint_archive(
                app_id, artifact_class, scope, path, archive)
            captured.append(item)
            index += 1
    states: dict[str, dict[str, Any]] = {}
    for path, scope in units:
        name = os.path.basename(path)
        if _is_service_template(name):
            instances = {instance: _capture_unit_state(instance, scope)
                         for instance in _unit_invocations(path, scope)}
            states[name] = {"scope": scope, "instances": instances}
        else:
            states[name] = {"scope": scope, **_capture_unit_state(name, scope)}
    return {"artifacts": captured, "units": states,
            "mappings": copy.deepcopy(committed["serve_mappings"])}


def _read_ledger_snapshot(tx: dict[str, Any]) -> dict[str, Any]:
    path = _transaction_checkpoint_path(tx, tx["ledger_snapshot"]["file"])
    if _sha256_file(path) != tx["ledger_snapshot"]["sha256"]:
        fail(f"transaction {tx['id']}: ledger checkpoint digest mismatch")
    try:
        with path.open("r", encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(f"transaction {tx['id']}: cannot parse ledger checkpoint: {exc}")
    return _validate_store(raw, path, upgrade_managed=True)


def _validate_checkpoint_archives(tx: dict[str, Any]) -> None:
    saved_store = _read_ledger_snapshot(tx)
    for app_id, checkpoint in tx["checkpoints"].items():
        if app_id not in tx["planned"] or not isinstance(checkpoint, dict):
            fail(f"transaction {tx['id']}: invalid checkpoint owner {app_id!r}")
        if set(checkpoint) != {"artifacts", "units", "mappings"}:
            fail(f"transaction {tx['id']}: invalid checkpoint shape for {app_id}")
        committed = (saved_store["entries"].get(app_id) or {}).get("committed")
        expected_items: list[tuple[str, str, str | None]] = []
        expected_units: dict[str, str] = {}
        expected_mappings: dict[str, Any] = {}
        if committed is not None:
            expected_artifacts = _committed_artifacts(committed)
            expected_unit_pairs = _preflight_teardown_artifacts(
                expected_artifacts, committed["capabilities"])
            unit_scope = {path: scope for path, scope in expected_unit_pairs}
            seen: set[str] = set()
            for artifact_class in PATH_CLASSES:
                for path in expected_artifacts[artifact_class]:
                    if str(path) not in seen:
                        expected_items.append((str(path), artifact_class, unit_scope.get(str(path))))
                        seen.add(str(path))
            expected_units = {os.path.basename(path): scope for path, scope in expected_unit_pairs}
            expected_mappings = committed["serve_mappings"]
        actual_items: list[tuple[str, str, str | None]] = []
        for item in checkpoint["artifacts"]:
            required = {"path", "class", "scope", "existed", "archive", "sha256"}
            allowed = (required, required | {"ephemeral_sockets"})
            if not isinstance(item, dict) or set(item) not in allowed:
                fail(f"transaction {tx['id']}: invalid artifact receipt for {app_id}")
            if (not isinstance(item["path"], str) or not os.path.isabs(item["path"])
                    or item["class"] not in PATH_CLASSES
                    or not isinstance(item["existed"], bool)
                    or item["scope"] not in (None, "user", "system")):
                fail(f"transaction {tx['id']}: invalid artifact values for {app_id}")
            actual_items.append((item["path"], item["class"], item["scope"]))
            ephemeral = _validated_ephemeral_sockets(
                item.get("ephemeral_sockets", []), item["path"])
            if not item["existed"]:
                if (item["archive"] is not None or item["sha256"] is not None
                        or ephemeral):
                    fail(f"transaction {tx['id']}: absent artifact has an archive")
                continue
            if not isinstance(item["archive"], str) or not _is_hex_digest(item["sha256"]):
                fail(f"transaction {tx['id']}: invalid archive receipt for {item['path']}")
            archive = _transaction_checkpoint_path(tx, item["archive"])
            if _sha256_file(archive) != item["sha256"]:
                fail(f"transaction {tx['id']}: checkpoint digest mismatch for {item['path']}")
        if actual_items != expected_items:
            fail(f"transaction {tx['id']}: artifact inventory differs from saved ledger for {app_id}")
        if (not isinstance(checkpoint["units"], dict)
                or set(checkpoint["units"]) != set(expected_units)):
            fail(f"transaction {tx['id']}: unit inventory differs from saved ledger for {app_id}")
        for name, state in checkpoint["units"].items():
            if not isinstance(state, dict) or state.get("scope") != expected_units[name]:
                fail(f"transaction {tx['id']}: invalid unit state for {app_id}/{name}")
            if _is_service_template(name):
                instances = state.get("instances")
                if (set(state) != {"scope", "instances"}
                        or not isinstance(instances, dict)
                        or any(not _template_instance_matches(name, instance)
                               or not isinstance(instance_state, dict)
                               or set(instance_state) != {"active", "enabled"}
                               or not isinstance(instance_state["active"], bool)
                               or not isinstance(instance_state["enabled"], bool)
                               for instance, instance_state in instances.items())):
                    fail(f"transaction {tx['id']}: invalid unit state for {app_id}/{name}")
            elif (set(state) != {"scope", "active", "enabled"}
                  or not isinstance(state["active"], bool)
                  or not isinstance(state["enabled"], bool)):
                fail(f"transaction {tx['id']}: invalid unit state for {app_id}/{name}")
        if checkpoint["mappings"] != expected_mappings:
            fail(f"transaction {tx['id']}: mappings differ from saved ledger for {app_id}")


def _canonical_json_bytes(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _resource_binding(tx: dict[str, Any], app_id: str,
                      record: dict[str, Any]) -> dict[str, Any]:
    scoped = tx.get("app_scoped_plan")
    if scoped is None:
        fail("resource results require an app-scoped transaction")
    return {
        "transaction_id": tx["id"],
        "app_id": app_id,
        "action": tx["actions"][app_id],
        "config_sha256": tx["config_sha256"],
        "package_sha256": tx["package_sha256"],
        "source_sha256": record["digest"],
        "plan_sha256": scoped["plan_sha256"],
        "dependency_snapshot_sha256": scoped["dependency_snapshot_sha256"],
    }


def _resource_declared(record: dict[str, Any], resource_class: str) -> bool:
    if resource_class == "filesystem":
        if "artifacts_declared" in record:
            return any(record["artifacts_declared"].get(name)
                       for name in ("fragments", "webroot", "files", "rooted"))
        return any(record["artifacts"].get(name)
                   for name in ("fragments", "webroot", "files", "rooted"))
    if resource_class == "systemd":
        source = record.get("artifacts_declared") or record.get("artifacts") or {}
        return bool(source.get("units"))
    if resource_class == "docker":
        return record.get("container_runtime") is not None
    return bool(record.get("serve_mappings"))


def _resource_owned(record: dict[str, Any], app_id: str) -> dict[str, list[dict[str, Any]]]:
    artifacts = (_intent_artifacts(record) if "artifacts_declared" in record
                 else _committed_artifacts(record))
    filesystem = [
        {"class": artifact_class, "path": str(path)}
        for artifact_class in ("fragments", "webroot", "files", "rooted")
        for path in artifacts[artifact_class]
    ]
    systemd = []
    for path in artifacts["units"]:
        resolved, scope = _unit_scope(str(path))
        systemd.append({"name": os.path.basename(resolved), "path": resolved,
                        "scope": scope})
    runtime = record.get("container_runtime")
    if runtime is None:
        docker = []
    elif "artifacts_declared" in record:
        committed_runtime = None
        current = (load_store()["entries"].get(app_id) or {}).get("committed")
        if current is not None:
            committed_runtime = current.get("container_runtime")
        captured = _capture_container_runtime(app_id, runtime, committed_runtime)
        docker = copy.deepcopy((captured or {}).get("objects") or [])
    else:
        docker = copy.deepcopy(runtime.get("objects") or [])
    ingress = [
        {"key": key, "listen": mapping["listen"], "mode": mapping["mode"],
         "target": mapping["target"]}
        for key, mapping in sorted(record.get("serve_mappings", {}).items())
    ]
    return {
        "filesystem": sorted(filesystem, key=lambda item: (item["path"], item["class"])),
        "systemd": sorted(systemd, key=lambda item: (item["scope"], item["name"])),
        "docker": sorted(docker, key=lambda item: (item["name"], item["id"])),
        "ingress": ingress,
    }


def _resource_path_observation(item: dict[str, Any]) -> dict[str, Any]:
    path = item["path"]
    try:
        meta = os.lstat(path)
        if stat.S_ISREG(meta.st_mode):
            kind = "file"
            digest = _sha256_file(Path(path))
        elif stat.S_ISDIR(meta.st_mode):
            kind = "directory"
            digest = None
        elif stat.S_ISLNK(meta.st_mode):
            kind = "symlink"
            digest = hashlib.sha256(os.fsencode(os.readlink(path))).hexdigest()
        else:
            fail(f"owned filesystem artifact has unsupported type: {path}")
    except OSError as exc:
        fail(f"cannot observe owned filesystem artifact {path}: {exc}")
    return {**item, "kind": kind, "mode": stat.S_IMODE(meta.st_mode),
            "sha256": digest}


def _resource_unit_observations(owned: list[dict[str, Any]]) -> list[dict[str, Any]]:
    observations = []
    for item in owned:
        if _is_service_template(item["name"]):
            instances = {
                name: _capture_unit_state(name, item["scope"])
                for name in _unit_invocations(item["path"], item["scope"])
            }
            observations.append({**item, "instances": instances})
        else:
            observations.append({**item, **_capture_unit_state(
                item["name"], item["scope"])})
    return observations


def _serve_status() -> dict[str, Any]:
    try:
        result = subprocess.run(["tailscale", "serve", "status", "--json"],
                                check=False, text=True, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)
    except OSError as exc:
        fail(f"cannot inspect Tailscale serve state: {exc}")
    if result.returncode != 0:
        fail(f"Tailscale serve status failed with exit {result.returncode}")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        fail(f"Tailscale serve status returned invalid JSON: {exc}")
    if not isinstance(value, dict) or not isinstance(value.get("TCP", {}), dict) \
            or not isinstance(value.get("Web", {}), dict):
        fail("Tailscale serve status returned an invalid shape")
    return value


def _resource_ingress_observations(owned: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not owned:
        return []
    status = _serve_status()
    tcp = status.get("TCP") or {}
    web = status.get("Web") or {}
    observations = []
    for item in owned:
        port = str(item["listen"])
        tcp_row = tcp.get(port, tcp.get(f":{port}"))
        if not isinstance(tcp_row, dict):
            fail(f"Tailscale serve mapping is absent for {item['mode']}:{port}")
        actual_mode = "https" if tcp_row.get("HTTPS") is True else "http"
        if actual_mode != item["mode"]:
            fail(f"Tailscale serve mode differs at :{port}")
        expected_proxy = f"http://127.0.0.1:{item['target']}"
        proxies = []
        for address, server in web.items():
            if not isinstance(address, str) or not isinstance(server, dict):
                continue
            address_port = address.rsplit(":", 1)[-1]
            if address_port != port:
                continue
            handlers = server.get("Handlers") or {}
            if not isinstance(handlers, dict):
                continue
            for handler in handlers.values():
                if isinstance(handler, dict) and isinstance(handler.get("Proxy"), str):
                    proxies.append(handler["Proxy"])
        if expected_proxy not in proxies:
            fail(f"Tailscale serve target differs at {item['mode']}:{port}")
        observations.append({**item, "proxy": expected_proxy})
    return observations


def _resource_result(tx: dict[str, Any], app_id: str, operation: str,
                     provider_ok: bool, *, record: dict[str, Any] | None = None,
                     owned_override: dict[str, list[dict[str, Any]]] | None = None,
                     error: str | None = None) -> dict[str, Any]:
    if operation not in RESOURCE_RESULT_OPERATIONS:
        fail(f"unknown resource result operation: {operation}")
    if app_id not in tx["planned"]:
        fail(f"transaction {tx['id']} did not plan {app_id}")
    if record is None:
        entry = load_store()["entries"].get(app_id) or {}
        record = entry.get("intent") or entry.get("committed")
    if record is None:
        fail(f"no resource authority exists for {app_id}")
    classes: dict[str, Any] = {}
    inventory_error = None
    try:
        owned = owned_override if owned_override is not None else _resource_owned(record, app_id)
    except LedgerError as exc:
        owned = {name: [] for name in RESOURCE_RESULT_CLASSES}
        inventory_error = str(exc)
    success_status = {"apply": "applied", "verify": "verified",
                      "compensate": "compensated"}[operation]
    for resource_class in RESOURCE_RESULT_CLASSES:
        declared = _resource_declared(record, resource_class) or bool(owned[resource_class])
        class_error = error or inventory_error
        observations: list[dict[str, Any]] = []
        if provider_ok and class_error is None and declared:
            try:
                if operation in {"apply", "compensate"}:
                    observations = copy.deepcopy(owned[resource_class])
                elif resource_class == "filesystem":
                    observations = [_resource_path_observation(item)
                                    for item in owned[resource_class]]
                elif resource_class == "systemd":
                    observations = _resource_unit_observations(owned[resource_class])
                elif resource_class == "docker":
                    observations = copy.deepcopy(owned[resource_class])
                else:
                    observations = _resource_ingress_observations(owned[resource_class])
            except LedgerError as exc:
                class_error = str(exc)
        if not declared:
            status = "not_declared"
        elif not provider_ok or class_error is not None:
            status = "failed"
        else:
            status = success_status
        classes[resource_class] = {
            "status": status,
            "owned": copy.deepcopy(owned[resource_class]),
            "observations": observations,
            "error": class_error,
        }
    failed = [name for name, value in classes.items()
              if value["status"] in {"failed", "unsupported"}]
    body = {
        "schema": RESOURCE_RESULT_SCHEMA,
        "transaction_id": tx["id"],
        "app_id": app_id,
        "operation": operation,
        "binding": _resource_binding(tx, app_id, record),
        "classes": classes,
        "verdict": "failed" if failed else "passed",
        "error": (error or inventory_error or
                  (f"resource class failure: {', '.join(failed)}" if failed else None)),
    }
    body["result_digest"] = hashlib.sha256(_canonical_json_bytes(body)).hexdigest()
    return body


def _validate_resource_result_shape(value: Any, operation: str | None = None,
                                    app_id: str | None = None) -> dict[str, Any]:
    fields = {"schema", "transaction_id", "app_id", "operation", "binding", "classes",
              "verdict", "error", "result_digest"}
    if not isinstance(value, dict) or set(value) != fields:
        fail("invalid resource result shape")
    if value["schema"] != RESOURCE_RESULT_SCHEMA:
        fail("unsupported resource result schema")
    if operation is not None and value["operation"] != operation:
        fail("resource result operation mismatch")
    if app_id is not None and value["app_id"] != app_id:
        fail("resource result app mismatch")
    if (value["operation"] not in RESOURCE_RESULT_OPERATIONS
            or not _ID_RE.fullmatch(str(value["app_id"]))
            or not re.fullmatch(r"[0-9a-f]{32}", str(value["transaction_id"]))
            or value["verdict"] not in {"passed", "failed"}
            or value["error"] is not None and not isinstance(value["error"], str)):
        fail("invalid resource result values")
    binding_fields = {"transaction_id", "app_id", "action", "config_sha256",
                      "package_sha256", "source_sha256", "plan_sha256",
                      "dependency_snapshot_sha256"}
    binding = value["binding"]
    if (not isinstance(binding, dict) or set(binding) != binding_fields
            or binding["transaction_id"] != value["transaction_id"]
            or binding["app_id"] != value["app_id"]
            or binding["action"] not in TRANSACTION_ACTIONS
            or any(not _is_hex_digest(binding[key]) for key in (
                "config_sha256", "package_sha256", "source_sha256", "plan_sha256",
                "dependency_snapshot_sha256"))):
        fail("invalid resource result binding")
    classes = value["classes"]
    if not isinstance(classes, dict) or set(classes) != set(RESOURCE_RESULT_CLASSES):
        fail("resource result must contain exactly four resource classes")
    for resource_class, result in classes.items():
        if (not isinstance(result, dict)
                or set(result) != {"status", "owned", "observations", "error"}
                or result["status"] not in RESOURCE_RESULT_STATUSES
                or not isinstance(result["owned"], list)
                or not isinstance(result["observations"], list)
                or result["error"] is not None and not isinstance(result["error"], str)
                or any(not isinstance(item, dict) for item in result["owned"])
                or any(not isinstance(item, dict) for item in result["observations"])):
            fail(f"invalid {resource_class} resource result")
    digest = value["result_digest"]
    body = dict(value)
    body.pop("result_digest")
    if not _is_hex_digest(digest) or digest != hashlib.sha256(
            _canonical_json_bytes(body)).hexdigest():
        fail("resource result digest mismatch")
    return value


def _write_resource_result(tx: dict[str, Any], result: dict[str, Any]) -> None:
    _validate_resource_result_shape(result, result["operation"], result["app_id"])
    tx.setdefault("resource_results", {}).setdefault(result["app_id"], {})[
        result["operation"]] = result
    write_transaction(tx)


def _merge_resource_owned(*inventories: dict[str, list[dict[str, Any]]]
                          ) -> dict[str, list[dict[str, Any]]]:
    merged: dict[str, list[dict[str, Any]]] = {}
    for resource_class in RESOURCE_RESULT_CLASSES:
        by_value: dict[bytes, dict[str, Any]] = {}
        for inventory in inventories:
            for item in inventory[resource_class]:
                by_value[_canonical_json_bytes(item)] = copy.deepcopy(item)
        merged[resource_class] = [by_value[key] for key in sorted(by_value)]
    return merged


def command_transaction_resource_result(operation: str, app_id: str,
                                        outcome: str) -> int:
    if operation not in {"apply", "verify"} or outcome not in {"passed", "failed"}:
        fail("transaction-resource-result requires <apply|verify> <id> <passed|failed>")
    if not _ID_RE.fullmatch(app_id):
        fail(f"invalid package id: {app_id!r}")
    tx = load_transaction()
    assert tx is not None
    if tx["phase"] in TRANSACTION_TERMINAL_PHASES:
        fail(f"transaction {tx['id']} is already {tx['phase']}")
    if app_id not in tx["touched"]:
        fail(f"transaction {tx['id']} has not touched {app_id}")
    result = _resource_result(
        tx, app_id, operation, outcome == "passed",
        error=None if outcome == "passed" else f"{operation} provider returned failure",
    )
    _write_resource_result(tx, result)
    sys.stdout.buffer.write(_canonical_json_bytes(result))
    return 0 if result["verdict"] == "passed" else 1


def _require_current_resource_result(app_id: str) -> None:
    tx = load_transaction()
    assert tx is not None
    stored = ((tx.get("resource_results") or {}).get(app_id) or {}).get("verify")
    if stored is None:
        fail(f"app-scoped commit for {app_id} requires a verified resource result")
    _validate_resource_result_shape(stored, "verify", app_id)
    expected = _resource_result(tx, app_id, "verify", True)
    if expected != stored:
        fail(f"resource result for {app_id} is stale or its ownership/binding changed")
    if stored["verdict"] != "passed":
        fail(f"resource verification failed for {app_id}")


def _managed_json_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            fail(f"managed authority sidecar repeats JSON key {key!r}")
        value[key] = item
    return value


def _read_managed_authority_sidecar(raw_path: str, expected_sha256: str) -> dict[str, dict[str, Any]]:
    if not _is_hex_digest(expected_sha256):
        fail("transaction-begin managed authority SHA-256 must be lowercase 64-hex")
    if (not os.path.isabs(raw_path) or raw_path != os.path.normpath(raw_path)):
        fail("transaction-begin managed authority file must be one normalized absolute path")
    path = Path(raw_path)
    parent = path.parent
    try:
        parent_info = os.lstat(parent)
        path_info = os.lstat(path)
        parent_resolved = parent.resolve(strict=True)
    except OSError as exc:
        fail(f"cannot inspect managed authority sidecar {path}: {exc}")
    if (not stat.S_ISDIR(parent_info.st_mode) or parent.is_symlink()
            or parent_resolved != parent
            or parent_info.st_uid != os.geteuid()
            or stat.S_IMODE(parent_info.st_mode) != 0o700):
        fail("managed authority sidecar parent must be a private invoking-user directory")
    if (not stat.S_ISREG(path_info.st_mode) or path.is_symlink()
            or path_info.st_uid != os.geteuid()
            or stat.S_IMODE(path_info.st_mode) != 0o600):
        fail("managed authority sidecar must be a private invoking-user regular file")
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
        with os.fdopen(fd, "rb") as handle:
            opened = os.fstat(handle.fileno())
            if (opened.st_dev != path_info.st_dev or opened.st_ino != path_info.st_ino
                    or not stat.S_ISREG(opened.st_mode) or opened.st_uid != os.geteuid()
                    or stat.S_IMODE(opened.st_mode) != 0o600):
                fail("managed authority sidecar changed while it was opened")
            raw = handle.read(1024 * 1024 + 1)
    except OSError as exc:
        fail(f"cannot read managed authority sidecar {path}: {exc}")
    if len(raw) > 1024 * 1024:
        fail("managed authority sidecar exceeds 1 MiB")
    if hashlib.sha256(raw).hexdigest() != expected_sha256:
        fail("managed authority sidecar differs from its supplied SHA-256")
    try:
        value = json.loads(raw, object_pairs_hook=_managed_json_pairs)
    except (UnicodeError, json.JSONDecodeError) as exc:
        fail(f"managed authority sidecar is invalid JSON: {exc}")
    if raw != _canonical_json_bytes(value):
        fail("managed authority sidecar must be canonical JSON with one trailing newline")
    if (not isinstance(value, dict)
            or set(value) != {"authorities", "schema"}
            or value.get("schema") != MANAGED_RUN_AUTHORITY_SCHEMA
            or not isinstance(value.get("authorities"), dict)
            or not value["authorities"]):
        fail("managed authority sidecar has an unsupported closed shape")
    authorities = value["authorities"]
    for app_id, authority in authorities.items():
        if not isinstance(app_id, str) or not _ID_RE.fullmatch(app_id):
            fail(f"managed authority sidecar has invalid package id {app_id!r}")
        _validate_managed_authority(authority, f"managed authority sidecar {app_id!r}")
    return copy.deepcopy(authorities)


def _transaction_begin_arguments(
        arguments: list[str],
) -> tuple[list[str], dict[str, dict[str, Any]] | None, str | None]:
    authority_path: str | None = None
    authority_sha256: str | None = None
    specs: list[str] = []
    for argument in arguments:
        if argument.startswith("--managed-authority-file="):
            if authority_path is not None:
                fail("transaction-begin accepts --managed-authority-file once")
            authority_path = argument.split("=", 1)[1]
            if not authority_path:
                fail("transaction-begin requires --managed-authority-file=<path>")
        elif argument.startswith("--managed-authority-sha256="):
            if authority_sha256 is not None:
                fail("transaction-begin accepts --managed-authority-sha256 once")
            authority_sha256 = argument.split("=", 1)[1]
        elif argument in {"--managed-authority-file", "--managed-authority-sha256"}:
            fail(f"transaction-begin requires {argument}=<value>")
        elif argument.startswith("-"):
            fail(f"transaction-begin received unknown option {argument!r}")
        else:
            specs.append(argument)
    if bool(authority_path) != bool(authority_sha256):
        fail("transaction-begin requires managed authority file and SHA-256 together")
    authorities = (_read_managed_authority_sidecar(authority_path, authority_sha256)
                   if authority_path is not None and authority_sha256 is not None else None)
    return specs, authorities, authority_sha256


def command_transaction_begin(arguments: list[str]) -> int:
    specs, managed_authorities, managed_authority_sha256 = _transaction_begin_arguments(arguments)
    actions: dict[str, str] = {}
    for spec in specs:
        action, separator, app_id = spec.partition(":")
        if (not separator or action not in TRANSACTION_ACTIONS
                or not _ID_RE.fullmatch(app_id) or app_id in actions):
            fail("transaction-begin requires unique <plan-action>:<package-id> values")
        actions[app_id] = action
    app_ids = list(actions)
    if not app_ids:
        fail("transaction-begin requires one or more plan actions")
    for key in ("AIRLOCK_CONFIG_SNAPSHOT_SHA256", "AIRLOCK_INSTALL_PKG_INFO_SHA256"):
        if not _is_hex_digest(os.environ.get(key)):
            fail(f"transaction-begin requires {key}=<lowercase sha256>")
    scoped_plan_sha = os.environ.get("AIRLOCK_APP_SCOPED_PLAN_SHA256")
    dependency_snapshot_sha = os.environ.get("AIRLOCK_LEDGER_DEPENDENCIES_SHA256")
    if bool(scoped_plan_sha) != bool(dependency_snapshot_sha):
        fail("transaction-begin requires both app-scoped plan and dependency snapshot digests")
    if scoped_plan_sha is not None:
        if not _is_hex_digest(scoped_plan_sha):
            fail("transaction-begin requires AIRLOCK_APP_SCOPED_PLAN_SHA256=<lowercase sha256>")
        if not _is_hex_digest(dependency_snapshot_sha):
            fail("transaction-begin requires AIRLOCK_LEDGER_DEPENDENCIES_SHA256=<lowercase sha256>")
    if managed_authorities is not None:
        if scoped_plan_sha is None:
            fail("transaction-begin managed authorities require an app-scoped plan binding")
        if not set(managed_authorities).issubset(actions):
            fail("transaction-begin managed authorities must name planned apps")
        for app_id, authority in managed_authorities.items():
            if actions[app_id] in DESTRUCTIVE_ACTIONS:
                fail(f"transaction-begin managed authority cannot bind destructive-only app {app_id}")
            if authority["config_sha256"] != os.environ["AIRLOCK_CONFIG_SNAPSHOT_SHA256"]:
                fail(f"transaction-begin managed authority for {app_id} differs from config binding")
        package_info = read_package_info()
        if _PACKAGE_INFO_INPUT_SHA256 != os.environ["AIRLOCK_INSTALL_PKG_INFO_SHA256"]:
            fail("transaction-begin managed package-info differs from its supplied SHA-256")
        packages = packages_from_info(package_info)
        managed_planned = {
            app_id for app_id in actions
            if app_id in packages and packages[app_id]["source_class"] == "managed"
        }
        if managed_planned != set(managed_authorities):
            fail("transaction-begin managed authorities differ from planned managed packages")
        for app_id, authority in managed_authorities.items():
            package = packages.get(app_id)
            if package is None:
                fail(f"transaction-begin managed authority has no package-info entry for {app_id}")
            if package["signed_package_digest"] != authority["package_digest"]:
                fail(f"transaction-begin managed authority for {app_id} differs from signed package digest")
            if package["capabilities"] != authority["capabilities"]:
                fail(f"transaction-begin managed authority for {app_id} differs from package capabilities")
    previous = load_transaction(required=False)
    if (previous is not None
            and (previous.get("trusted_measurer_activation") or {}).get("state") != "durable"
            and "trusted_measurer_activation" in previous):
        fail(f"transaction {previous['id']} still owes trusted measurer activation")
    if previous is not None and previous["phase"] not in {"committed", "rolled_back"}:
        fail(f"unfinished transaction {previous['id']} is {previous['phase']}; recover it before starting another")
    if previous is not None:
        _remove_transaction_checkpoints(previous)
    store = load_store()
    transaction_id = secrets.token_hex(16)
    checkpoint_parent = state_dir() / "install-checkpoints"
    root = checkpoint_parent / transaction_id
    try:
        if os.path.lexists(checkpoint_parent):
            if checkpoint_parent.is_symlink() or not checkpoint_parent.is_dir():
                fail(f"refusing redirected checkpoint directory: {checkpoint_parent}")
        else:
            checkpoint_parent.mkdir(mode=0o700)
        os.chmod(checkpoint_parent, 0o700)
        root.mkdir(mode=0o700)
        os.chmod(root, 0o700)
    except OSError as exc:
        fail(f"cannot create transaction checkpoint directory {root}: {exc}")
    try:
        snapshot_path = root / "ledger.json"
        _atomic_json(snapshot_path, store)
        tx = {
            "version": TRANSACTION_VERSION,
            "id": transaction_id,
            "started_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "config_sha256": os.environ["AIRLOCK_CONFIG_SNAPSHOT_SHA256"],
            "package_sha256": os.environ["AIRLOCK_INSTALL_PKG_INFO_SHA256"],
            "phase": "prepared", "planned": app_ids, "actions": actions,
            "touched": [], "deactivated": [],
            "checkpoints": {},
            "ledger_snapshot": {"file": "ledger.json", "sha256": _sha256_file(snapshot_path)},
            "error": None, "restore_results": {},
        }
        if scoped_plan_sha is not None:
            tx["app_scoped_plan"] = {
                "plan_sha256": scoped_plan_sha,
                "dependency_snapshot_sha256": dependency_snapshot_sha,
            }
            tx["resource_results"] = {}
        if managed_authorities is not None:
            tx["managed_authorities"] = copy.deepcopy(managed_authorities)
            tx["managed_authority_sha256"] = managed_authority_sha256
        for app_id in app_ids:
            tx["checkpoints"][app_id] = _checkpoint_record(store, app_id, actions[app_id], root)
        _validate_checkpoint_archives(tx)
        write_transaction(tx)
    except BaseException:
        if not os.path.lexists(transaction_path()):
            shutil.rmtree(root, ignore_errors=True)
        raise
    print(transaction_id)
    return 0


def _transaction_update_list(field: str, app_id: str) -> int:
    if not _ID_RE.fullmatch(app_id):
        fail(f"invalid package id: {app_id!r}")
    tx = load_transaction()
    assert tx is not None
    if tx["phase"] in TRANSACTION_TERMINAL_PHASES:
        fail(f"transaction {tx['id']} is already {tx['phase']}")
    if app_id not in tx["planned"]:
        fail(f"transaction {tx['id']} did not plan {app_id}")
    if app_id not in tx[field]:
        tx[field].append(app_id)
    if field == "deactivated" and app_id not in tx["touched"]:
        tx["touched"].append(app_id)
    tx["phase"] = "installing"
    write_transaction(tx)
    return 0


def command_transaction_fail(phase: str, app_id: str) -> int:
    if not phase or (app_id != "-" and not _ID_RE.fullmatch(app_id)):
        fail("transaction-fail requires <phase> <package-id|->")
    tx = load_transaction()
    assert tx is not None
    if tx["phase"] in TRANSACTION_TERMINAL_PHASES:
        fail(f"transaction {tx['id']} is already {tx['phase']}")
    message = os.environ.get("AIRLOCK_TRANSACTION_ERROR", "installer failed")
    tx["error"] = {"phase": phase, "app": None if app_id == "-" else app_id,
                   "message": message[:1000]}
    tx["phase"] = "degraded"
    write_transaction(tx)
    return 0


def _safe_extract_archive(archive: Path, destination: Path) -> tuple[Path, list[tarfile.TarInfo]]:
    try:
        with tarfile.open(archive, "r") as bundle:
            members = bundle.getmembers()
            for member in members:
                parts = Path(member.name).parts
                if not parts or parts[0] != "payload" or ".." in parts or member.name.startswith("/"):
                    fail(f"unsafe checkpoint member {member.name!r}")
                if not (member.isdir() or member.isreg() or member.issym()):
                    fail(f"unsupported checkpoint member {member.name!r}")
            for member in sorted((m for m in members if m.isdir()), key=lambda m: len(Path(m.name).parts)):
                target = destination.joinpath(*Path(member.name).parts)
                target.mkdir(parents=True, exist_ok=True)
            for member in (m for m in members if m.isreg()):
                target = destination.joinpath(*Path(member.name).parts)
                target.parent.mkdir(parents=True, exist_ok=True)
                source = bundle.extractfile(member)
                if source is None:
                    fail(f"cannot read checkpoint member {member.name!r}")
                with source, target.open("xb") as output:
                    shutil.copyfileobj(source, output)
                os.chmod(target, stat.S_IMODE(member.mode))
            for member in (m for m in members if m.issym()):
                target = destination.joinpath(*Path(member.name).parts)
                target.parent.mkdir(parents=True, exist_ok=True)
                os.symlink(member.linkname, target)
            for member in sorted((m for m in members if m.isdir()),
                                 key=lambda m: len(Path(m.name).parts), reverse=True):
                os.chmod(destination.joinpath(*Path(member.name).parts), stat.S_IMODE(member.mode))
    except LedgerError:
        raise
    except (OSError, tarfile.TarError) as exc:
        fail(f"cannot extract checkpoint {archive}: {exc}")
    return destination / "payload", members


def _restore_archive_item(tx: dict[str, Any], item: dict[str, Any]) -> None:
    path = item["path"]
    if not item["existed"]:
        return
    archive = _transaction_checkpoint_path(tx, item["archive"])
    if _sha256_file(archive) != item["sha256"]:
        fail(f"checkpoint digest mismatch for {path}")
    temporary = Path(tempfile.mkdtemp(prefix="restore.", dir=archive.parent))
    try:
        payload, members = _safe_extract_archive(archive, temporary)
        privileged = item["class"] == "rooted" or (item["class"] == "units" and item["scope"] == "system")
        if privileged:
            if _run_command(["sudo", "rm", "-rf", "--", path], f"sudo rm -rf -- {path}") != 0:
                fail(f"cannot clear restore target {path}")
            if _run_command(["sudo", "mkdir", "-p", os.path.dirname(path)],
                            f"sudo mkdir -p {os.path.dirname(path)}") != 0:
                fail(f"cannot create restore parent for {path}")
            if _run_command(["sudo", "cp", "-a", "--", str(payload), path],
                            f"sudo cp -a -- checkpoint {path}") != 0:
                fail(f"cannot restore {path}")
        else:
            refusal = _plain_artifact_refusal(path)
            if refusal is not None:
                fail(refusal)
            if os.path.lexists(path):
                _remove_plain_path(path, recursive=True)
            Path(path).parent.mkdir(parents=True, exist_ok=True)
            if payload.is_symlink():
                os.symlink(os.readlink(payload), path)
            elif payload.is_dir():
                shutil.copytree(payload, path, symlinks=True, copy_function=shutil.copy2)
            else:
                shutil.copy2(payload, path, follow_symlinks=False)
        for member in members:
            relative = Path(member.name).parts[1:]
            target = os.path.join(path, *relative) if relative else path
            owner = f"{member.uid}:{member.gid}"
            if privileged:
                if _run_command(["sudo", "chown", "-h", owner, target],
                                f"sudo chown -h {owner} {target}") != 0:
                    fail(f"cannot restore owner for {target}")
                if not member.issym() and _run_command(
                        ["sudo", "chmod", f"{stat.S_IMODE(member.mode):o}", target],
                        f"sudo chmod {stat.S_IMODE(member.mode):o} {target}") != 0:
                    fail(f"cannot restore mode for {target}")
            else:
                try:
                    os.chown(target, member.uid, member.gid, follow_symlinks=False)
                    if not member.issym():
                        os.chmod(target, stat.S_IMODE(member.mode))
                except OSError as exc:
                    fail(f"cannot restore metadata for {target}: {exc}")
    finally:
        shutil.rmtree(temporary, ignore_errors=True)


def _restore_unit_states(checkpoint: dict[str, Any]) -> bool:
    ok = True
    scopes = {state["scope"] for state in checkpoint["units"].values()}
    for scope in sorted(scopes):
        args = ["systemctl", "--user", "daemon-reload"] if scope == "user" \
            else ["sudo", "systemctl", "daemon-reload"]
        ok = _run_command(args, " ".join(args)) == 0 and ok
    for recorded_name, state in checkpoint["units"].items():
        prefix = ["systemctl", "--user"] if state["scope"] == "user" else ["sudo", "systemctl"]
        unit_states = (state["instances"].items() if _is_service_template(recorded_name)
                       else ((recorded_name, state),))
        for name, unit_state in unit_states:
            enable = "enable" if unit_state["enabled"] else "disable"
            active = "start" if unit_state["active"] else "stop"
            ok = _run_command(prefix + [enable, name], f"restore {enable} {name}") == 0 and ok
            ok = _run_command(prefix + [active, name], f"restore {active} {name}") == 0 and ok
    return ok


def _restore_mappings(checkpoint: dict[str, Any]) -> bool:
    ok = True
    for mapping in checkpoint["mappings"].values():
        target = f"http://127.0.0.1:{mapping['target']}"
        args = ["sudo", "tailscale", "serve", "--bg",
                f"--{mapping['mode']}={mapping['listen']}", target]
        ok = _run_command(args, "restore " + " ".join(args[1:])) == 0 and ok
    return ok


def _container_runtime_is_intact(app_id: str, runtime: dict[str, Any]) -> bool:
    if _docker_daemon_identity() != runtime["daemon_identity"]:
        return False
    expected = {(obj["id"], obj["name"]) for obj in runtime["objects"]}
    actual = {(obj["id"], obj["name"]) for obj in _enumerate_containers()
              if obj["labels"].get(_PACKAGE_LABEL) == app_id
              and obj["labels"].get(_NONCE_LABEL) == runtime["install_nonce"]}
    return actual == expected


def _checkpoint_item_matches_live(tx: dict[str, Any], app_id: str,
                                  item: dict[str, Any]) -> bool:
    """Re-capture through the same primitive and compare its two receipts."""
    path = item["path"]
    if not item["existed"]:
        return not os.path.lexists(path)
    archive = _transaction_checkpoint_path(tx, item["archive"])
    temporary = Path(tempfile.mkdtemp(prefix="compare.", dir=archive.parent))
    try:
        current = temporary / "current.tar"
        digest, ephemeral = _write_checkpoint_archive(
            app_id, item["class"], item["scope"], path, current)
        return (digest == item["sha256"]
                and ephemeral == item.get("ephemeral_sockets", []))
    except LedgerError:
        return False
    finally:
        shutil.rmtree(temporary, ignore_errors=True)

FORWARD_KEEP_APP = "dev-monitor"
FORWARD_KEEP_FIELDS = {"app", "database", "backup_sha256", "target_sha256",
                       "decided_at", "candidate"}


def _validate_forward_keep(value: Any, tx: dict[str, Any], path: Path) -> None:
    if (not isinstance(value, dict) or set(value) != FORWARD_KEEP_FIELDS
            or value["app"] != FORWARD_KEEP_APP
            or not isinstance(value["database"], str) or not value["database"].startswith("/")
            or not _is_hex_digest(value["backup_sha256"]) or not _is_hex_digest(value["target_sha256"])
            or not isinstance(value["decided_at"], str)
            or value["candidate"] not in ("pending", "active", "inactive")):
        fail(f"{path}: invalid forward-keep decision")
    if value["app"] not in tx["touched"]:
        fail(f"{path}: forward-keep names {value['app']}, which the transaction did not touch")


def _forward_keep_evidence_holds(decision: dict[str, Any]) -> str | None:
    """Re-read the database evidence the decision was made on; None when it still holds.

    The decision lives in the transaction body, so it cannot go missing on its own --
    but the database can change underneath it. Restore therefore proves the bytes are
    the ones classified as sound before it keeps anything.
    """
    database = Path(decision["database"])
    marker = Path(str(database) + ".pre-endstate.target.json")
    for path, what in ((database, "database"), (marker, "canonical target marker")):
        if path.is_symlink() or not path.is_file():
            return f"{what} is not a regular file"
    try:
        actual = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return "canonical target marker is unreadable"
    if not isinstance(actual, dict) or actual.get("backup_sha256") != decision["backup_sha256"]:
        return "canonical target marker no longer names the decided backup"
    if _sha256_file(database) != decision["target_sha256"]:
        return "database bytes differ from the ones the decision was made on"
    return None


def command_transaction_keep_forward(app_id: str, database: str,
                                     backup_sha256: str, target_sha256: str) -> int:
    """Record, in the transaction itself, that dev-monitor's candidate stays on its
    converted database through the restore.

    Bound three ways so that a caller holding only the transaction id cannot exempt an
    app from rollback: the app is fixed, the candidate tree must still match the intent
    the ledger journaled, and the database evidence must hold right now -- the marker
    names this backup and the database bytes are the ones classified as sound.
    """
    if app_id != FORWARD_KEEP_APP:
        fail(f"only {FORWARD_KEEP_APP} can be kept forward, not {app_id!r}")
    if not (_is_hex_digest(backup_sha256) and _is_hex_digest(target_sha256)):
        fail("transaction-keep-forward requires two lowercase sha256 digests")
    if not database.startswith("/"):
        fail("transaction-keep-forward requires an absolute database path")
    tx = load_transaction()
    assert tx is not None
    if tx["phase"] in {"committed", "rolled_back"}:
        fail(f"transaction {tx['id']} is already {tx['phase']}")
    if app_id not in tx["touched"]:
        fail(f"transaction {tx['id']} did not touch {app_id}")
    existing = tx.get("forward_keep")
    if existing is not None:
        if (existing["database"], existing["backup_sha256"], existing["target_sha256"]) \
                != (database, backup_sha256, target_sha256):
            fail(f"transaction {tx['id']} already holds a different forward-keep decision")
        return 0
    store = load_store()
    intent = (store["entries"].get(app_id) or {}).get("intent")
    if intent is None:
        fail(f"{app_id} has no journaled intent to keep")
    if digest_tree(intent["path"]) != intent["digest"]:
        fail(f"{app_id} candidate tree no longer matches its journaled intent; refusing to keep it")
    decision = {"app": app_id, "database": database, "backup_sha256": backup_sha256,
                "target_sha256": target_sha256, "candidate": "pending",
                "decided_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")}
    reason = _forward_keep_evidence_holds(decision)
    if reason is not None:
        fail(f"refusing to keep {app_id} forward: {reason}")
    tx["forward_keep"] = decision
    write_transaction(tx)
    log(f"transaction {tx['id']}: keeping {app_id} forward on its converted database")
    return 0


def command_transaction_keep_forward_candidate(state: str) -> int:
    if state not in ("active", "inactive"):
        fail("transaction-keep-forward-candidate requires active|inactive")
    tx = load_transaction()
    assert tx is not None
    if tx.get("forward_keep") is None:
        fail(f"transaction {tx['id']} holds no forward-keep decision")
    tx["forward_keep"]["candidate"] = state
    write_transaction(tx)
    return 0


def command_transaction_trusted_measurer_owed() -> int:
    tx = load_transaction()
    assert tx is not None
    if tx["phase"] in TRANSACTION_TERMINAL_PHASES:
        fail(f"transaction {tx['id']} is already {tx['phase']}")
    authorities = tx.get("managed_authorities")
    if not isinstance(authorities, dict) or not authorities:
        fail(f"transaction {tx['id']} has no managed authorities")
    old_hashes = {authority["installed_measurer_sha256"] for authority in authorities.values()}
    new_hashes = {authority["next_measurer_sha256"] for authority in authorities.values()}
    if len(old_hashes) != 1 or len(new_hashes) != 1:
        fail("managed authorities disagree on trusted measurer rotation")
    activation = {
        "new_path": f"/opt/airlock/libexec/.airlock-managed-release.{tx['id']}.new",
        "new_sha256": next(iter(new_hashes)),
        "old_path": f"/opt/airlock/libexec/.airlock-managed-release.{tx['id']}.old",
        "old_sha256": next(iter(old_hashes)),
        "schema": TRUSTED_MEASURER_ACTIVATION_SCHEMA,
        "state": "owed",
        "target": TRUSTED_MEASURER_TARGET,
    }
    existing = tx.get("trusted_measurer_activation")
    if existing is not None and existing != activation:
        fail(f"transaction {tx['id']} already has different trusted measurer activation")
    tx["trusted_measurer_activation"] = activation
    write_transaction(tx)
    return 0


def command_transaction_trusted_measurer_durable() -> int:
    tx = load_transaction()
    assert tx is not None
    activation = tx.get("trusted_measurer_activation")
    if tx["phase"] != "committed" or not isinstance(activation, dict):
        fail("trusted measurer activation can become durable only after commit")
    if activation["state"] == "durable":
        return 0
    if activation["state"] != "owed":
        fail("trusted measurer activation is not owed")
    activation["state"] = "durable"
    write_transaction(tx)
    return 0


def command_transaction_trusted_measurer_clear() -> int:
    tx = load_transaction()
    assert tx is not None
    activation = tx.get("trusted_measurer_activation")
    if tx["phase"] in {"committed", "rolled_back"} or not isinstance(activation, dict):
        fail("trusted measurer activation can be cleared only before terminal restore")
    if activation["state"] != "owed":
        fail("only an owed trusted measurer activation can be cleared")
    del tx["trusted_measurer_activation"]
    write_transaction(tx)
    return 0


def command_transaction_restore() -> int:
    tx = load_transaction()
    assert tx is not None
    if tx["phase"] == "rolled_back":
        return 0
    if tx["phase"] == "committed":
        fail(f"transaction {tx['id']} is committed and cannot be restored")
    if "trusted_measurer_activation" in tx:
        fail("trusted measurer activation must be restored and cleared before transaction restore")
    try:
        _validate_checkpoint_archives(tx)
        saved_store = _read_ledger_snapshot(tx)
    except LedgerError as exc:
        tx["phase"] = "degraded"
        if tx["error"] is None:
            tx["error"] = {"phase": "restore-verify", "app": None,
                           "message": str(exc)[:1000]}
        else:
            # Preserve the first installer failure and add the independent
            # recovery failure beside it; one must never overwrite the other.
            tx["error"]["restore_message"] = str(exc)[:1000]
        write_transaction(tx)
        log(f"transaction {tx['id']} degraded before restore: {exc}")
        return 1
    # Re-run the existing ledger's containment gates against today's roots
    # before removing or restoring a single path.
    for app_id in tx["touched"]:
        saved = (saved_store["entries"].get(app_id) or {}).get("committed")
        if saved is not None:
            artifacts = _committed_artifacts(saved)
            _preflight_teardown_artifacts(artifacts, saved["capabilities"])
    resource_records: dict[str, dict[str, Any]] = {}
    resource_owned: dict[str, dict[str, list[dict[str, Any]]]] = {}
    resource_inventory_errors: dict[str, str] = {}
    if tx.get("app_scoped_plan") is not None:
        current_store = load_store()
        for app_id in tx["touched"]:
            current_entry = current_store["entries"].get(app_id) or {}
            saved_entry = saved_store["entries"].get(app_id) or {}
            records = [record for record in (
                current_entry.get("intent"), current_entry.get("committed"),
                saved_entry.get("committed"), saved_entry.get("intent"),
            ) if record is not None]
            if not records:
                continue
            resource_records[app_id] = records[0]
            inventories = []
            try:
                for record in records:
                    inventories.append(_resource_owned(record, app_id))
                resource_owned[app_id] = _merge_resource_owned(*inventories)
            except LedgerError as exc:
                resource_owned[app_id] = {
                    resource_class: [] for resource_class in RESOURCE_RESULT_CLASSES
                }
                resource_inventory_errors[app_id] = str(exc)
    kept = tx.get("forward_keep")
    if kept is not None:
        reason = _forward_keep_evidence_holds(kept)
        if reason is not None:
            # Decided on evidence that no longer holds: restoring the old package over
            # this database would be a guess, and so would keeping the candidate.
            tx["phase"] = "degraded"
            tx["restore_results"][kept["app"]] = {"status": "failed", "error": reason[:1000]}
            write_transaction(tx)
            log(f"transaction {tx['id']} degraded before restore: forward-keep evidence changed: {reason}")
            return 1
    tx["phase"] = "rolling_back"
    write_transaction(tx)
    all_ok = True
    for app_id in reversed(tx["touched"]):
        if kept is not None and app_id == kept["app"]:
            # Neither the checkpointed package nor its unit states come back: they
            # were never shown to be compatible with the converted database. The
            # candidate stays as the journaled intent for the next run to finish.
            status = "kept-forward-" + ("inactive" if kept["candidate"] == "inactive" else "active")
            tx["restore_results"][app_id] = {"status": status, "error": None}
            write_transaction(tx)
            log(f"kept {app_id} forward: candidate retained on its converted database ({kept['candidate']})")
            if app_id in resource_records:
                resource_result = _resource_result(
                    tx, app_id, "compensate", False,
                    record=resource_records[app_id],
                    owned_override=resource_owned[app_id],
                    error="candidate was kept forward and not compensated",
                )
                _write_resource_result(tx, resource_result)
            continue
        result = {"status": "restoring", "error": None}
        tx["restore_results"][app_id] = result
        write_transaction(tx)
        try:
            current = load_store()
            saved_entry = saved_store["entries"].get(app_id)
            saved_committed = (saved_entry or {}).get("committed")
            current_entry = current["entries"].get(app_id) or {}
            checkpoint = tx["checkpoints"].get(app_id) or {"artifacts": [], "units": {}, "mappings": {}}
            unchanged_committed = (app_id not in tx["deactivated"]
                                   and saved_entry is not None
                                   and current_entry == saved_entry)
            if (saved_committed is not None
                    and saved_committed.get("container_runtime") is not None):
                if (current_entry.get("committed") == saved_committed
                        and _container_runtime_is_intact(
                            app_id, saved_committed["container_runtime"])
                        and all(_checkpoint_item_matches_live(tx, app_id, item)
                                for item in checkpoint["artifacts"])):
                    unchanged_committed = True
                else:
                    fail("committed container runtime or non-socket artifacts changed and have no lossless checkpoint; existing runtime was preserved for manual recovery")
            if current["entries"].get(app_id) and not unchanged_committed:
                command_teardown(current, {}, app_id, None)
            if not unchanged_committed:
                for item in checkpoint["artifacts"]:
                    _restore_archive_item(tx, item)
            current = load_store()
            restored = copy.deepcopy(current)
            if saved_entry is not None:
                restored["entries"][app_id] = copy.deepcopy(saved_entry)
            else:
                restored["entries"].pop(app_id, None)
            write_store(restored, require_directory_sync=True)
            if (not unchanged_committed and
                    (not _restore_unit_states(checkpoint) or not _restore_mappings(checkpoint))):
                fail("unit or serve mapping restoration failed")
            result["status"] = "restored"
        except (LedgerError, OSError) as exc:
            result["status"] = "failed"
            result["error"] = str(exc)[:1000]
            all_ok = False
            log(f"restore failed for {app_id}: {exc}")
        if app_id in resource_records:
            resource_error = resource_inventory_errors.get(app_id) or result["error"]
            resource_result = _resource_result(
                tx, app_id, "compensate", result["status"] == "restored",
                record=resource_records[app_id],
                owned_override=resource_owned[app_id],
                error=resource_error,
            )
            _write_resource_result(tx, resource_result)
        write_transaction(tx)
    tx["phase"] = "rolled_back" if all_ok else "degraded"
    write_transaction(tx)
    log(f"transaction {tx['id']} {tx['phase']}")
    return 0 if all_ok else 1


def _remove_transaction_checkpoints(tx: dict[str, Any]) -> None:
    root = _transaction_root(tx["id"])
    parent = state_dir() / "install-checkpoints"
    if root.parent != parent or root.name != tx["id"] or root.is_symlink():
        fail(f"refusing unsafe checkpoint cleanup path {root}")
    if root.exists():
        shutil.rmtree(root)


def command_transaction_finish(phase: str) -> int:
    if phase != "committed":
        fail("transaction-finish accepts only committed; rollback is decided by transaction-restore")
    tx = load_transaction()
    assert tx is not None
    if tx["phase"] in TRANSACTION_TERMINAL_PHASES:
        fail(f"transaction {tx['id']} is already {tx['phase']}")
    if tx.get("managed_authorities"):
        activation = tx.get("trusted_measurer_activation")
        if not isinstance(activation, dict) or activation.get("state") != "owed":
            fail("managed transaction requires an owed trusted measurer activation before commit")
    tx["phase"] = "committed"
    write_transaction(tx)
    try:
        _remove_transaction_checkpoints(tx)
    except (LedgerError, OSError) as exc:
        # The durable terminal decision is already made. Checkpoint cleanup is
        # a space warning, never a reason to lie that a committed install must
        # be rolled back.
        log(f"warning: committed transaction checkpoint cleanup failed: {exc}")
    log(f"transaction {tx['id']} committed")
    return 0


def command_transaction_show() -> int:
    tx = load_transaction(required=False)
    if tx is None:
        return 0
    print(json.dumps(tx, sort_keys=True))
    return 0


def transaction_cli(argv: list[str]) -> int:
    command = argv[0]
    if command == "transaction-begin":
        return command_transaction_begin(argv[1:])
    if command in {"transaction-touch", "transaction-deactivated"} and len(argv) == 2:
        return _transaction_update_list("touched" if command.endswith("touch") else "deactivated", argv[1])
    if command == "transaction-fail" and len(argv) == 3:
        return command_transaction_fail(argv[1], argv[2])
    if command == "transaction-resource-result" and len(argv) == 4:
        return command_transaction_resource_result(argv[1], argv[2], argv[3])
    if command == "transaction-restore" and len(argv) == 1:
        return command_transaction_restore()
    if command == "transaction-keep-forward" and len(argv) == 5:
        return command_transaction_keep_forward(argv[1], argv[2], argv[3], argv[4])
    if command == "transaction-keep-forward-candidate" and len(argv) == 2:
        return command_transaction_keep_forward_candidate(argv[1])
    if command == "transaction-trusted-measurer-owed" and len(argv) == 1:
        return command_transaction_trusted_measurer_owed()
    if command == "transaction-trusted-measurer-durable" and len(argv) == 1:
        return command_transaction_trusted_measurer_durable()
    if command == "transaction-trusted-measurer-clear" and len(argv) == 1:
        return command_transaction_trusted_measurer_clear()
    if command == "transaction-finish" and len(argv) == 2:
        return command_transaction_finish(argv[1])
    if command == "transaction-show" and len(argv) == 1:
        return command_transaction_show()
    fail("usage: airlock-ledger transaction-{begin|touch|deactivated|fail|resource-result|restore|keep-forward|trusted-measurer-owed|trusted-measurer-durable|trusted-measurer-clear|finish|show} ...")


def command_list(store: dict[str, Any]) -> int:
    for app_id in sorted(store["entries"]):
        entry = store["entries"][app_id]
        committed = entry.get("committed")
        intent = entry.get("intent")
        states = []
        if committed is not None:
            states.append("committed")
        if intent is not None:
            states.append("intent")
        record = committed or intent
        if committed is not None:
            artifact_count = sum(len(committed["artifacts"][name]) for name in ARTIFACT_CLASSES)
            runtime = committed.get("container_runtime")
            if runtime is not None:
                artifact_count += len(runtime["objects"])
        else:
            artifact_count = sum(len(intent["artifacts_declared"][name]) for name in PATH_CLASSES)
            artifact_count += len(intent["serve_port_values"])
            runtime = intent.get("container_runtime")
            if runtime is not None:
                artifact_count += len(runtime["declarations"])
        print(f"{app_id}\tstate={'+'.join(states)}\tpath={record['path']}"
              f"\tdigest={record['digest'][:12]}\tartifacts={artifact_count}")
    return 0


def command_audit_lock_override(store: dict[str, Any], info: dict[str, Any],
                                app_id: str) -> int:
    """Persist the exceptional admission fact before any package mutation.

    The caller already holds the ledger writer lock. The event records the
    canonical package-info mismatch fact, but it is not tamper-proof: an actor
    who can write this owner-controlled ledger can also rewrite its history.
    A one-way receipt binds finalization to this invocation without pretending
    the ledger is a security boundary.
    """
    if is_dry_run():
        fail("audit-lock-override is not available during a dry run")
    packages = info.get("packages") or {}
    raw = packages.get(app_id)
    if not isinstance(raw, dict) or raw.get("source_class") != "explicit":
        fail(f"package-info has no configured explicit package {app_id}")
    override = raw.get("lock_override")
    required = {"argument", "recorded_digest", "admitted_digest"}
    if not isinstance(override, dict) or set(override) != required:
        fail(f"package-info carries no break-glass lock mismatch for {app_id}")
    receipt = secrets.token_hex(32)
    event = {
        "type": "package-lock-override",
        "package_id": app_id,
        "argument": override["argument"],
        "recorded_digest": override["recorded_digest"],
        "admitted_digest": override["admitted_digest"],
        "recorded_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "receipt_sha256": hashlib.sha256(receipt.encode()).hexdigest(),
    }
    result = copy.deepcopy(store)
    result["events"].append(event)
    # Audit must survive a crash before lifecycle mutation begins. Existing
    # ledger mutations retain their historical atomic-replace contract; this
    # exceptional pre-mutation barrier additionally requires directory
    # durability before returning the one-run receipt.
    write_store(result, require_directory_sync=True)
    log("DANGEROUS: admitting unverified package lock mismatch: "
        f"{event['argument']}\n"
        f"  recorded digest: {event['recorded_digest']}\n"
        f"  admitted digest: {event['admitted_digest']}")
    print(receipt)
    return 0


def parse_cli(argv: list[str]) -> tuple[str, str | None, bool, str | None, str | None]:
    if not argv:
        fail("usage: airlock-ledger "
             "{plan|handoffs|intent|commit|preflight-remove|remove|teardown|list|audit-lock-override} ...")
    command = argv[0]
    if command not in {"plan", "handoffs", "intent", "commit", "preflight-remove", "remove", "teardown", "list",
                       "audit-lock-override"}:
        fail(f"unknown subcommand: {command}")
    positional: list[str] = []
    for_upgrade = False
    active_ports: str | None = None
    dependency_snapshot: str | None = None
    index = 1
    while index < len(argv):
        argument = argv[index]
        if argument == "--for-upgrade":
            if command not in {"remove", "preflight-remove"} or for_upgrade:
                fail("--for-upgrade is only accepted once by remove/preflight-remove")
            for_upgrade = True
        elif argument == "--active-ports":
            if active_ports is not None or index + 1 >= len(argv):
                fail("--active-ports requires one value")
            index += 1
            active_ports = argv[index]
        elif argument.startswith("--active-ports="):
            if active_ports is not None:
                fail("--active-ports is accepted only once")
            active_ports = argument.split("=", 1)[1]
        elif argument == "--dependency-snapshot":
            if command != "plan" or dependency_snapshot is not None or index + 1 >= len(argv):
                fail("--dependency-snapshot requires one path and is accepted only once by plan")
            index += 1
            dependency_snapshot = argv[index]
        elif argument.startswith("--dependency-snapshot="):
            if command != "plan" or dependency_snapshot is not None:
                fail("--dependency-snapshot is accepted only once by plan")
            dependency_snapshot = argument.split("=", 1)[1]
            if not dependency_snapshot:
                fail("--dependency-snapshot requires a path")
        elif argument.startswith("-"):
            fail(f"unknown option: {argument}")
        else:
            positional.append(argument)
        index += 1

    expected = {"plan": 0, "list": 0, "handoffs": 1, "intent": 1, "commit": 1,
                "preflight-remove": 1, "remove": 1,
                "teardown": 1, "audit-lock-override": 1}[command]
    if len(positional) != expected:
        fail(f"usage: airlock-ledger {command}"
             + (" <id>" if expected else ""))
    return (command, positional[0] if positional else None, for_upgrade,
            active_ports, dependency_snapshot)


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    if (len(raw_argv) == 7 and raw_argv[0] == "_checkpoint-helper"
            and raw_argv[1] == "archive"):
        scope = None if raw_argv[4] == "-" else raw_argv[4]
        return _checkpoint_helper_archive(
            raw_argv[2], raw_argv[3], scope, raw_argv[5], raw_argv[6])
    if raw_argv and raw_argv[0].startswith("transaction-"):
        return transaction_cli(raw_argv)
    command, app_id, for_upgrade, active_ports, dependency_snapshot = parse_cli(raw_argv)
    store = load_store()
    info = read_package_info()
    if command == "plan":
        return command_plan(store, info, dependency_snapshot)
    if command == "handoffs":
        return command_handoffs(store, info, app_id or "")
    if command == "intent":
        return command_intent(store, info, app_id or "", active_ports)
    if command == "commit":
        return command_commit(store, info, app_id or "", active_ports)
    if command == "preflight-remove":
        previous_dry = os.environ.get("AIRLOCK_DRY_RUN")
        os.environ["AIRLOCK_DRY_RUN"] = "1"
        try:
            return command_remove(store, info, app_id or "", for_upgrade, active_ports)
        finally:
            if previous_dry is None:
                os.environ.pop("AIRLOCK_DRY_RUN", None)
            else:
                os.environ["AIRLOCK_DRY_RUN"] = previous_dry
    if command == "remove":
        return command_remove(store, info, app_id or "", for_upgrade, active_ports)
    if command == "teardown":
        return command_teardown(store, info, app_id or "", active_ports)
    if command == "audit-lock-override":
        return command_audit_lock_override(store, info, app_id or "")
    return command_list(store)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except LedgerError as exc:
        die(str(exc))
