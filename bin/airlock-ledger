#!/usr/bin/env python3
"""airlock-ledger — apply, restore and remove one app from installed state.

Configuration is read by airlock-config; this module never parses TOML.
Usage: airlock-ledger {apply <id> [--source company|<abs-dir>]|remove <id>|project|list|plan}
"""
from __future__ import annotations

import copy
import glob
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path
from typing import Any, NoReturn


LEDGER_VERSION = 7
ARTIFACT_CLASSES = ("units", "fragments", "webroot", "files", "rooted", "serve_ports")
PATH_CLASSES = ("units", "fragments", "webroot", "files", "rooted")
_ID_RE = re.compile(r"^(?!\.{1,2}\Z)[^/\x00]+\Z")
_GIT_OID_RE = re.compile(r"^[0-9a-f]{40}\Z")


def die(message: str, code: int = 1) -> NoReturn:
    log(message)
    raise SystemExit(code)


class LedgerError(Exception):
    """An expected, user-facing ledger failure."""


def fail(message: str) -> NoReturn:
    raise LedgerError(message)


def log(message: str) -> None:
    sys.stderr.write(f"airlock-ledger: {message}\n")


def _expand_path(raw: str) -> str:
    return os.path.abspath(os.path.expanduser(raw))


def state_dir() -> Path:
    env = os.environ.get("AIRLOCK_STATE_DIR")
    if env:
        # The caller may use this path through a symlink; preserve the value
        # verbatim, so the store must too. Even abspath() would diverge: it
        # collapses `..` lexically, while the shell's open() resolves any
        # symlink first — same string, two directories.
        return Path(env)
    return Path(_expand_path("~/.local/state/airlock"))


def _real_root(raw: str) -> str:
    """Roots are canonicalised with realpath (matching airlock-config's claim
    space): a record must name the real directory, or an alias root would
    record paths a later run classifies differently."""
    return os.path.realpath(os.path.expanduser(raw))


def _canonical_artifact(path: str) -> str:
    """One path space for records and ownership comparison: the real parent
    directory plus the entry's own name. The leaf is never resolved — a
    recorded symlink is owned (and removed) as a link, not as its target.
    Trailing slashes are stripped first, or `/x/link/` would resolve the
    leaf while `/x/link` keeps it — two objects for one declaration."""
    path = os.path.expanduser(str(path))
    path = path.rstrip("/") or "/"
    parent = os.path.dirname(path) or "/"
    return os.path.join(os.path.realpath(parent), os.path.basename(path))


def _unit_dir(which: str) -> str:
    if which == "user":
        raw = os.environ.get("AIRLOCK_UNIT_DIR_USER") or "~/.config/systemd/user"
    else:
        raw = os.environ.get("AIRLOCK_UNIT_DIR_SYSTEM") or "/etc/systemd/system"
    return _real_root(raw)


def _conf_dir() -> str:
    return _real_root(os.environ.get("AIRLOCK_CONFD") or "/etc/airlock/nginx")


def _webroot() -> str:
    return _real_root(os.environ.get("AIRLOCK_WEBROOT") or "/opt/airlock/hub")


def _platform_dir(which: str) -> str:
    """The two static platform dirs a rooted pattern may anchor under.
    Env-overridable the same way every other root above is (the fixture
    seam _unit_dir/_conf_dir/_webroot already provide), so a test fixture
    never globs the real box's /etc/airlock or /opt/airlock — the
    equivalence harness measured exactly that host-dependence
    (install/test-equivalence.sh). Unset, these are the literal platform
    paths, byte-for-byte the pre-seam behaviour."""
    env = "AIRLOCK_PLATFORM_ETC" if which == "etc" else "AIRLOCK_PLATFORM_OPT"
    raw = (os.environ.get(env) or "").strip()
    if not raw:
        return "/etc/airlock" if which == "etc" else "/opt/airlock"
    return _real_root(raw)


def _rooted_substitute(pattern: str, webroot_parent: str) -> str:
    """Resolve a declared rooted pattern's anchor: the ${webroot_parent}
    token first, then the two static platform anchors, re-anchored onto
    _platform_dir's current value. THE one substitution — expansion,
    anchor recording (_pattern_anchor), record validation, and
    bin/airlock-config's manifest validation all call this, so no site can
    resolve a pattern into a different space than the allowlist admits
    (the hand-copied-drift hazard airlock-config's containment check
    already documents)."""
    s = pattern.replace("${webroot_parent}", webroot_parent)
    for literal, which in (("/etc/airlock", "etc"), ("/opt/airlock", "opt")):
        if s == literal or s.startswith(literal + "/"):
            return _platform_dir(which) + s[len(literal):]
    return s


def _current_roots() -> dict[str, str]:
    return {"unit_user": _unit_dir("user"), "unit_system": _unit_dir("system"),
            "confd": _conf_dir(), "webroot": _webroot(),
            "home": os.path.realpath(os.path.expanduser("~"))}


def _rooted_webroot_parent(roots: dict[str, str]) -> str:
    """RESOLUTION only: where a record's ${webroot_parent} token expands to —
    the record's OWN roots snapshot, since that is where the artifact was
    actually written on disk. This confers no authority by itself; see
    _rooted_authorization_allowlist for the (deliberately different)
    authorization boundary."""
    return str(Path(roots["webroot"]).parent)


# A denylist enumeration of FHS system roots is a losing game — round 3
# closed webroot_parent="/" (AIRLOCK_WEBROOT=/hub), but the same collapse one
# level narrower (AIRLOCK_WEBROOT=/opt/hub -> webroot_parent="/opt") was not
# on the list, and re-admitted /opt (authorizing sudo rm -rf of any top-level
# /opt entry) while /var/hub was refused only because /var happened to be
# enumerated. A RULE instead: the anchor must have at least two path
# components (/opt/airlock qualifies; /opt does not — no single top-level
# directory is ever a legitimate dynamic anchor, named or not).
_ROOTED_FORBIDDEN_DYNAMIC_ANCHORS = frozenset((
    "/", "/etc", "/usr", "/bin", "/sbin", "/lib", "/lib64", "/boot",
    "/sys", "/proc", "/dev", "/run", "/root", "/home", "/var",
))


def _rooted_dynamic_anchor_forbidden(anchor: str) -> bool:
    real = os.path.realpath(anchor)
    depth = len([part for part in real.split("/") if part])
    return depth < 2 or real in _ROOTED_FORBIDDEN_DYNAMIC_ANCHORS


def _rooted_authorization_allowlist() -> tuple[str, ...]:
    """The anchors a rooted path must sit under to be TOUCHED at all — the
    two static platform dirs, plus the CURRENT LIVE environment's webroot
    parent, ITSELF validated before it joins the set. Deliberately NEVER
    derived from a record's own roots snapshot: a hand-written record can
    claim any roots.webroot it likes (roots.webroot=/etc/attacker-hub makes
    /etc/passwd's parent "/etc" pass a record-derived allowlist), so trusting
    record data here would let a fabricated record authorize removing
    anything its author names."""
    dynamic = _rooted_webroot_parent(_current_roots())
    anchors = [_platform_dir("etc"), _platform_dir("opt")]
    if not _rooted_dynamic_anchor_forbidden(dynamic):
        anchors.append(dynamic)
    return tuple(anchors)


def _rooted_contains(path: str) -> bool:
    """Does `path`'s parent sit under one of the rooted AUTHORIZATION
    anchors, canonically? Checked against the live-environment allowlist,
    never a record's own roots."""
    parent = os.path.realpath(os.path.dirname(path.rstrip("/")) or "/")
    return any(parent == os.path.realpath(root)
               or parent.startswith(os.path.realpath(root).rstrip("/") + os.sep)
               for root in _rooted_authorization_allowlist())


def _validate_store(store: Any, path: Path, **_unused: Any) -> dict[str, Any]:
    """Validate only the v7 fields needed for one-time installed-state conversion."""
    if not isinstance(store, dict) or store.get("version") != LEDGER_VERSION:
        fail(f"{path}: conversion requires ledger version {LEDGER_VERSION}")
    entries = store.get("entries")
    if not isinstance(entries, dict):
        fail(f"{path}: legacy entries must be an object")
    for app_id, entry in entries.items():
        _require_app_id(app_id)
        if not isinstance(entry, dict):
            fail(f"{path}: {app_id}: legacy entry must be an object")
        record = entry.get("committed")
        if record is None:
            continue
        if not isinstance(record, dict):
            fail(f"{path}: {app_id}: committed record must be an object")
        repo = record.get("path")
        if not isinstance(repo, str) or not os.path.isabs(repo):
            fail(f"{path}: {app_id}: committed path must be absolute")
        artifacts = record.get("artifacts", {})
        if not isinstance(artifacts, dict):
            fail(f"{path}: {app_id}: artifacts must be an object")
        for name in ARTIFACT_CLASSES:
            items = artifacts.get(name, [])
            if not isinstance(items, list):
                fail(f"{path}: {app_id}: artifacts.{name} must be an array")
            for item in items:
                if name == "serve_ports":
                    if not isinstance(item, int) or isinstance(item, bool) or not 1 <= item <= 65535:
                        fail(f"{path}: {app_id}: invalid recorded port {item!r}")
                elif not isinstance(item, str) or not os.path.isabs(item):
                    fail(f"{path}: {app_id}: artifact paths must be absolute")
        mappings = record.get("serve_mappings", {})
        if not isinstance(mappings, dict):
            fail(f"{path}: {app_id}: serve_mappings must be an object")
        for mapping in mappings.values():
            if not isinstance(mapping, dict) or mapping.get("mode") not in SERVE_MODES:
                fail(f"{path}: {app_id}: invalid recorded serve mapping")
            for key in ("listen", "target"):
                value = mapping.get(key)
                if not isinstance(value, int) or isinstance(value, bool) or not 1 <= value <= 65535:
                    fail(f"{path}: {app_id}: invalid recorded serve mapping {key}")
    return store


def _ensure_state_dir() -> Path:
    directory = state_dir()
    try:
        directory.mkdir(parents=True, mode=0o700)
        os.chmod(directory, 0o700)
    except FileExistsError:
        if not directory.is_dir():
            fail(f"state path is not a directory: {directory}")
    except OSError as exc:
        fail(f"cannot create state directory {directory}: {exc}")
    return directory


def _current_config_env() -> dict[str, str]:
    env = os.environ.copy()
    for key in ("AIRLOCK_PKG_INFO", "AIRLOCK_PKG_INFO_FILE", "AIRLOCK_INSTALL_PKG_INFO_SHA256",
                "AIRLOCK_CONFIG_SNAPSHOT"):
        env.pop(key, None)
    return env


def read_package_info(selected: list[str] | None = None) -> dict[str, Any]:
    env = _current_config_env()
    result = subprocess.run([*_airlock_config_argv(), "package-info", *(selected or [])], env=env,
                            stdin=subprocess.DEVNULL, capture_output=True,
                            text=True, check=False)
    if result.returncode != 0:
        fail("cannot read app configuration: " + _last_line(result.stderr))
    raw = result.stdout
    try:
        info = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"invalid package-info JSON: {exc}")
    return info


def _normalise_package(app_id: str, raw: Any) -> dict[str, Any]:
    directory = raw.get("dir")
    raw_artifacts = raw.get("artifacts", {})
    artifacts: dict[str, list[str]] = {}
    for name in ARTIFACT_CLASSES:
        artifacts[name] = list(raw_artifacts.get(name, []))
    raw_containers = raw_artifacts.get("containers", [])

    raw_ports = raw.get("serve_port_values", {})
    port_values = {str(key): int(value) for key, value in raw_ports.items()}
    raw_mappings = raw.get("serve_mappings")
    if raw_mappings is None:
        raw_mappings = {k: {"listen": p, "mode": "http", "target": p}
                        for k, p in port_values.items()}
    mappings = copy.deepcopy(raw_mappings)
    raw_scopes = raw.get("unit_scopes", {n: "user" for n in artifacts["units"]})
    source_class = raw.get("source_class", "explicit")
    capabilities = raw.get("capabilities", [])
    deps = raw.get("deps", [])
    return {
        "dir": directory,
        "artifacts": artifacts,
        "containers": list(raw_containers),
        "serve_port_values": port_values,
        "serve_mappings": mappings,
        "unit_scopes": dict(raw_scopes),
        "source_class": source_class,
        "capabilities": list(capabilities),
        "deps": list(deps),
        "icon": raw.get("icon"),
    }


def _length_prefixed(hasher: "hashlib._Hash", field: bytes) -> None:
    hasher.update(len(field).to_bytes(8, "big"))
    hasher.update(field)


def digest_tree(root: str) -> str:
    """Hash every package entry in byte-sorted relative-path order."""
    entries: list[tuple[bytes, bytes, int, bytes]] = []

    def visit(directory: str, prefix: str) -> None:
        children = list(os.scandir(directory))
        for child in children:
            relative = child.name if not prefix else f"{prefix}/{child.name}"
            relative_bytes = os.fsencode(relative)
            child_stat = child.stat(follow_symlinks=False)
            mode = stat.S_IMODE(child_stat.st_mode)
            if stat.S_ISREG(child_stat.st_mode):
                with open(child.path, "rb") as fh:
                    content = fh.read()
                entries.append((relative_bytes, b"f", mode, content))
            elif stat.S_ISDIR(child_stat.st_mode):
                entries.append((relative_bytes, b"d", mode, b""))
                visit(child.path, relative)
            elif stat.S_ISLNK(child_stat.st_mode):
                target = os.fsencode(os.readlink(child.path))
                entries.append((relative_bytes, b"l", mode, target))
            # Special files (sockets, FIFOs, devices) are simply skipped.

    visit(root, "")
    entries.sort(key=lambda item: item[0])
    hasher = hashlib.sha256()
    for relative, kind, mode, content in entries:
        _length_prefixed(hasher, relative)
        _length_prefixed(hasher, kind)
        _length_prefixed(hasher, str(mode).encode("ascii"))
        _length_prefixed(hasher, content)
    return hasher.hexdigest()


def _sort_paths(paths: list[str] | set[str]) -> list[str]:
    return sorted(set(paths), key=os.fsencode)


def _pattern_anchor(cls: str, pattern: str, root: str, roots: dict[str, str]) -> str:
    """Where a declared pattern's fixed directory prefix RESOLVES TO right now.

    Recorded at intent time and compared at teardown. This is what tells a
    tree that was redirected AFTER the record (the hazard) from one that was
    always laid out that way (~/.local pointing into a dotfiles checkout is
    an ordinary box, and its artifacts must stay removable): the first
    changes the anchor, the second does not."""
    if cls in ("files", "rooted"):
        raw = pattern
        if cls == "rooted":
            raw = _rooted_substitute(raw, str(Path(roots["webroot"]).parent))
        if raw.startswith("~/"):
            raw = os.path.join(roots["home"], raw[2:].lstrip("/"))
        rooted = os.path.abspath(raw)
    else:
        rooted = os.path.join(root, os.path.expanduser(pattern))
    # `webroot = ["mydir/"]` and `["mydir"]` name ONE object (the same rule
    # _canonical_artifact states): without this the trailing-slash form would
    # anchor on the claimed directory itself, so the app's own symlink there
    # would look like a redirect and wedge its teardown.
    rooted = rooted.rstrip("/") or "/"
    head = rooted
    while head and any(ch in os.path.basename(head) for ch in "*?["):
        head = os.path.dirname(head)
    head = os.path.dirname(head) if head == rooted else head
    return os.path.realpath(head or "/")


def _rooted_artifact(path: str, root: str | tuple[str, ...], where: str) -> str | None:
    """Record only the matched resource that stays inside its platform root."""
    canonical = _canonical_artifact(path)
    roots = (root,) if isinstance(root, str) else root
    for candidate in roots:
        real = os.path.realpath(candidate)
        if canonical == real or canonical.startswith(real.rstrip("/") + os.sep):
            return canonical
    return None


def _redirected_ancestor(path: str) -> str | None:
    """The first ANCESTOR component of `path` that is a symlink today, or None.

    Every recorded path was canonicalised with a real parent chain, so a
    symlinked ancestor now means the tree was redirected after the record was
    written. Removing through it would delete whatever the link points at —
    the record becoming a weapon (the leaf itself may be a symlink: that is
    owned as a link and removed as one)."""
    parent = os.path.dirname(os.path.normpath(path))
    seen = set()
    while parent and parent not in ("/", ".") and parent not in seen:
        seen.add(parent)
        if os.path.islink(parent):
            return parent
        parent = os.path.dirname(parent)
    return None


def _check_anchor(anchors: dict[str, str] | None, cls: str, root: str,
                  patterns: list[Any], roots: dict[str, str], where: str) -> None:
    """Refuse to expand a declaration whose fixed prefix no longer resolves
    where it did when the record was written.

    That is the precise statement of the hazard: not "an ancestor is a
    symlink" (a box whose ~/.local points into a dotfiles checkout is
    ordinary, and its artifacts must stay removable), but "this declaration
    now names somewhere else than it did". Only teardown passes anchors;
    recording is permissive by design (D2 canonicalises an aliased claim into
    the one claim space). Records written before anchors existed carry an
    empty map and are simply not compared."""
    if not anchors:
        return
    for pattern in patterns:
        key = f"{cls}|{root}|{pattern}"
        recorded = anchors.get(key)
        if recorded is None:
            continue
        current = _pattern_anchor(cls, str(pattern), root, roots)
        if current != recorded and str(pattern).endswith("/"):
            # An intermediate build of this child anchored a trailing-slash
            # claim one level deeper (on the claimed directory itself). Accept
            # that older shape too, or a record written by it could never be
            # torn down — the wedge this whole mechanism exists to prevent.
            legacy = os.path.join(current, os.path.basename(
                str(pattern).rstrip("/")))
            if legacy == recorded:
                continue
        if current != recorded:
            fail(f"{where}: {pattern!r} resolved under {recorded} when the "
                 f"record was written and now resolves under {current} — the "
                 "declaration no longer names what it claimed, so nothing is "
                 "removed through it. Move the artifacts back to the recorded "
                 "location — re-creating an empty directory would drop the "
                 "record while the files it named live on elsewhere — or tear "
                 "the app down before moving them. The record is kept until "
                 "then.")


def _glob_matches(pattern: str) -> list[str]:
    # recursive=False: `**` is rejected by the declared grammar — a recursive
    # glob descends through symlinked directories, escaping the claim space.
    # include_hidden: a dotfile an installer writes under a `*` claim must be
    # recorded, or teardown would leave it orphaned (a stray .env is exactly
    # what must never survive with no record naming it).
    return _sort_paths([os.path.abspath(match)
                        for match in glob.glob(pattern, recursive=False, include_hidden=True)])


def _relative_pattern(root: str, pattern: str, where: str) -> str:
    expanded = os.path.expanduser(pattern)
    # Only the declared pattern globs; a root that happens to contain glob
    # characters is a literal directory name.
    return os.path.join(glob.escape(root), expanded)


def expand_declared(declared: dict[str, Any], port_values: dict[str, Any],
                    roots: dict[str, str] | None = None, *,
                    anchors: dict[str, str] | None = None,
                    unit_scopes: dict[str, str] | None = None,
                    capabilities: list[str] | None = None) -> dict[str, list[Any]]:
    """Expand each class against its root (the record's own roots snapshot
    when repairing an intent; the live env otherwise) without following
    matches."""
    if roots is None:
        roots = _current_roots()
    scopes = unit_scopes or {name: "both" for name in declared["units"]}
    expanded: dict[str, list[Any]] = {}
    for name, root in (("fragments", roots["confd"]), ("webroot", roots["webroot"])):
        matches: list[str] = []
        for pattern in declared[name]:
            rooted = _relative_pattern(root, pattern, f"artifacts_declared.{name}")
            matches.extend(_glob_matches(rooted))
        _check_anchor(anchors, name, root, declared[name], roots,
                      f"artifacts_declared.{name}")
        expanded[name] = _sort_paths(
            path for m in matches
            if (path := _rooted_artifact(m, root, f"artifacts_declared.{name}")) is not None)
    matches = []
    for pattern in declared["files"]:
        if pattern.startswith("~/"):
            # ~ means the HOME recorded in the roots snapshot, escaped so a
            # home path containing glob characters stays literal. The grammar
            # guarantees a non-empty remainder.
            rooted = os.path.join(glob.escape(roots["home"]), pattern[2:].lstrip("/"))
        else:
            rooted = os.path.abspath(pattern)
        matches.extend(_glob_matches(rooted))
    _check_anchor(anchors, "files", "", declared["files"], roots,
                  "artifacts_declared.files")
    expanded["files"] = _sort_paths(_canonical_artifact(m) for m in matches)
    matches = []
    for pattern in declared["rooted"]:
        rooted = _rooted_substitute(pattern, _rooted_webroot_parent(roots))
        matches.extend(_glob_matches(rooted))
    _check_anchor(anchors, "rooted", "", declared["rooted"], roots,
                  "artifacts_declared.rooted")
    rooted_canon = [_canonical_artifact(m) for m in matches]
    # A3: a glob's non-final segment can walk through a symlinked directory.
    expanded["rooted"] = _sort_paths(m for m in rooted_canon if _rooted_contains(m))
    expanded["serve_ports"] = sorted(set(int(value) for value in port_values.values()))

    matches = []
    unit_roots = (roots["unit_user"], roots["unit_system"])
    for pattern in declared["units"]:
        selected = unit_roots if scopes.get(pattern, "both") == "both" else (roots[f"unit_{scopes[pattern]}"],)
        for root in selected:
            rooted = _relative_pattern(root, pattern, "artifacts_declared.units")
            matches.extend(_glob_matches(rooted))
            _check_anchor(anchors, "units", root, [pattern], roots,
                          "artifacts_declared.units")
    expanded["units"] = _sort_paths(
        path for m in matches
        if (path := _rooted_artifact(m, unit_roots, "artifacts_declared.units")) is not None)
    return expanded


def _run_command(args: list[str], description: str) -> int | None:
    try:
        result = subprocess.run(args, check=False)
    except OSError as exc:
        log(f"{description} failed: {exc}")
        return None
    if result.returncode != 0:
        log(f"{description} failed with exit {result.returncode}")
    return result.returncode


def _is_under(path: str, root: str) -> bool:
    try:
        return os.path.commonpath((path, root)) == root
    except ValueError:
        return False


def _remove_plain_path(path: str, recursive: bool) -> bool:
    if os.path.islink(path) or not os.path.isdir(path):
        os.unlink(path)
        return True
    if recursive:
        shutil.rmtree(path)
    else:
        os.rmdir(path)
    return True


def _protected_state_path(path: str) -> bool:
    """The install record and state directory are never app artifacts;
    removing them through a record would erase the record of the removal.
    Compared canonically so a symlinked alias cannot slip past."""
    return _is_under(_canonical_artifact(path),
                     os.path.realpath(str(state_dir())))


def _plain_artifact_refusal(path: str) -> str | None:
    if _protected_state_path(path):
        return f"refusing to remove {path}: inside the platform state directory"
    redirected = _redirected_ancestor(path)
    if redirected is not None:
        return (f"refusing to remove {path}: {redirected} is now a symlink, so the "
                "recorded path no longer names what it named when it was recorded "
                "(repair the tree, then re-run)")
    return None


def _remove_artifact_path(path: str, dry: bool) -> bool:
    path = _expand_path(path)
    refusal = _plain_artifact_refusal(path)
    if refusal is not None:
        log(refusal)
        return False
    if not os.path.lexists(path):
        return True
    if dry:
        log(f"[dry] would remove {path}")
        return True
    try:
        _remove_plain_path(path, recursive=True)
    except OSError as exc:
        log(f"remove {path} failed: {exc}")
        return False
    log(f"removed {path}")
    return True


def _rooted_artifact_refusal(path: str) -> str | None:
    """Return a pure execution-time refusal, without touching the path.

    K6 (gate-zero revival, 2026-09-27,
    docs/reports/2026-09-27_installer-gate-zero-base-revival.md): removal
    follows only the recorded canonical absolute path, and refuses a
    redirected (symlinked) ancestor or the platform's own state directory.
    The capability-claim recheck and the current-environment rooted-allowlist
    recheck this used to also do here were dropped — both were re-checks of
    facts the record's own commit-time validation (_validate_capabilities /
    the rooted<->capability agreement check, and the record's own roots
    snapshot) already fixed; the package that owns this record can already
    run arbitrary commands as root through its own install/deactivate
    scripts, so re-deriving an allowlist from the CURRENT environment at
    removal time was not a security boundary — only a way to block a normal
    removal of an old record whose environment had since changed shape.
    """
    if _protected_state_path(path) or _redirected_ancestor(path) is not None:
        return f"refusing to remove rooted artifact {path}: redirected or protected path"
    return None


def _remove_rooted_artifact_path(path: str, dry: bool) -> bool:
    path = _expand_path(path)
    refusal = _rooted_artifact_refusal(path)
    if refusal is not None:
        log(refusal)
        return False
    if not os.path.lexists(path):
        return True
    if dry:
        log(f"[dry] would run sudo rm -rf -- {path}")
        return True
    return _run_command(["sudo", "rm", "-rf", "--", path], f"sudo rm -rf -- {path}") == 0


def _unit_scope(path: str) -> tuple[str, str]:
    """Return the expanded unit path and its current exact-parent scope."""
    path = _expand_path(path)
    parent = os.path.dirname(path)
    scope = "system" if parent == _unit_dir("system") else "user"
    return path, scope


def _unit_status(path: str, scope: str) -> dict[str, str] | None:
    """Unknown/failed queries are never evidence that a unit has stopped."""
    command = (["systemctl", "--user"] if scope == "user"
               else ["sudo", "systemctl"])
    command += ["show", os.path.basename(path),
                "--property=LoadState,ActiveState,MainPID,ControlPID,ControlGroup"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except OSError as exc:
        log(f"unit status query for {path} failed: {exc}")
        return None
    if result.returncode != 0:
        log(f"unit status query for {path} failed with exit {result.returncode}")
        return None
    state = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if (state.get("LoadState") not in {"loaded", "masked", "not-found"}
            or not state.get("ActiveState")
            or (path.endswith(".service")
                and not all(state.get(key) for key in ("MainPID", "ControlPID")))):
        log(f"unit status query for {path} returned incomplete or invalid state")
        return None
    return state


def _is_service_template(name: str) -> bool:
    return name.endswith("@.service")


def _unit_invocations(path: str, scope: str) -> list[str]:
    """Return concrete unit names that systemctl may safely invoke.

    A template fragment is an artifact, but ``foo@.service`` is not an
    invocable unit. Ask the manager for the concrete instances it currently
    knows and keep the wildcard inside one argv element (never shell-expand
    it). With --no-legend/--plain every non-empty output line begins with the
    full unit name.
    """
    name = os.path.basename(path)
    if not _is_service_template(name):
        return [name]
    pattern = name[:-len("@.service")] + "@*.service"
    command = (["systemctl", "--user"] if scope == "user"
               else ["sudo", "systemctl"])
    command += ["list-units", "--all", "--full", "--plain",
                "--no-legend", "--no-pager", pattern]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except OSError as exc:
        fail(f"cannot enumerate instances of template unit {name}: {exc}")
    if result.returncode != 0:
        fail(f"cannot enumerate instances of template unit {name} "
             f"(rc={result.returncode})")
    instances: list[str] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        candidate = line.split(None, 1)[0]
        if candidate not in instances:
            instances.append(candidate)
    return instances


def _unit_is_stopped(path: str, state: dict[str, str]) -> bool:
    service = path.endswith(".service")
    no_manager_process = (service and state["MainPID"] == "0"
                          and state["ControlPID"] == "0")
    stopped = ((state["ActiveState"] == "inactive"
                and (not service or no_manager_process))
               # A timed-out stop leaves a failed unit even after SIGKILL completed.
               # Accept that terminal state only with stronger evidence than the
               # inactive path: systemd must report no main/control PID and an
               # explicitly empty cgroup. Missing/unknown or residual cgroups remain
               # refusals, so a failed unit alone is never proof that teardown is safe.
               or (state["ActiveState"] == "failed" and no_manager_process
                   and state.get("ControlGroup") == ""))
    if not stopped:
        log(f"unit {path} is not proven stopped: ActiveState={state['ActiveState']} "
            f"MainPID={state.get('MainPID', '-')} ControlPID={state.get('ControlPID', '-')} "
            f"ControlGroup={state.get('ControlGroup', '<unknown>')!r}")
    return stopped


def _stop_units(units: list[tuple[str, str]], dry: bool) -> bool:
    # Stored order is not a dependency order: old records often put a service
    # before its timer. Stop every activation source (including targets) first.
    # No disable here: it can unlink linked fragments and implicitly reload.
    for path, scope in sorted(units, key=lambda unit: unit[0].endswith(".service")):
        if dry:
            log(f"[dry] would stop and verify inactive unit {path}")
            continue
        if not os.path.lexists(path):
            state = _unit_status(path, scope)
            if state is None:
                return False
            if state["LoadState"] == "not-found" and _unit_is_stopped(path, state):
                continue
        command = (["systemctl", "--user"] if scope == "user"
                   else ["sudo", "systemctl"]) + ["stop", os.path.basename(path)]
        if _run_command(command, " ".join(command)) != 0:
            return False
        state = _unit_status(path, scope)
        if state is None or not _unit_is_stopped(path, state):
            return False
    # Recheck the whole set immediately before the first destructive operation.
    # A later stop can have changed a unit we already checked.
    if not dry:
        for path, scope in units:
            state = _unit_status(path, scope)
            if state is None or not _unit_is_stopped(path, state):
                return False
    return True


def _teardown_unit(path: str, dry: bool, capabilities: list[str] | None,
                   *, preflight_scope: str | None = None,
                   unit_names: list[str] | None = None) -> tuple[bool, str]:
    """Deletion stage, called only after the batch stop barrier.

    Returns (ok, scope): scope is 'user'/'system' whenever the recorded
    path lies under that root (even if already absent — the batch reload in
    teardown_artifacts must still be retryable)."""
    path, scope = _unit_scope(path)
    template = _is_service_template(os.path.basename(path))
    if unit_names is None:
        unit_names = [] if template else [os.path.basename(path)]
    if not os.path.lexists(path) and not (template and unit_names):
        return True, scope
    if dry:
        log(f"[dry] would disable and remove unit {path}")
        return True, scope
    # The batch has already proved every unit stopped. Disable only now:
    # it may itself remove linked fragments. Suppress its implicit reload;
    # the caller reloads each scope once after all fragment removals.
    if scope == "user":
        for unit_name in unit_names:
            if _run_command(["systemctl", "--user", "disable", "--no-reload", unit_name],
                            f"systemctl --user disable --no-reload {unit_name}") != 0:
                log(f"disable failed for {path}; no explicit fragment removal attempted "
                    "(disable may already have removed links); record retained for retry")
                return False, scope
        if not os.path.lexists(path):
            return True, scope
        try:
            _remove_plain_path(path, recursive=False)
        except FileNotFoundError:
            # `systemctl --user disable` removes a SYMLINKED unit file itself,
            # so by the time we reach the unlink the path is legitimately gone.
            # The lexists() guard at the top of this function runs BEFORE the
            # disable and cannot see that. Counting it as a failure deadlocks
            # the record: the teardown never completes, the record is kept, and
            # every later run re-plans the same teardown and dies at the same
            # unlink. The system branch below never had this — `sudo rm -f`
            # tolerates absence. The postcondition is what matters, and it holds.
            log(f"{path} was already gone (its disable removed it)")
            return True, scope
        except OSError as exc:
            log(f"remove {path} failed: {exc}")
            return False, scope
    else:
        for unit_name in unit_names:
            if _run_command(["sudo", "systemctl", "disable", "--no-reload", unit_name],
                            f"sudo systemctl disable --no-reload {unit_name}") != 0:
                log(f"disable failed for {path}; no explicit fragment removal attempted "
                    "(disable may already have removed links); record retained for retry")
                return False, scope
        if not os.path.lexists(path):
            return True, scope
        if _run_command(["sudo", "rm", "-f", path], f"sudo rm {path}") != 0:
            return False, scope
    if os.path.lexists(path):
        log(f"unit fragment {path} still exists after removal; record retained for retry")
        return False, scope
    log(f"removed {path}")
    return True, scope


def _reload_units(scopes: set[str], dry: bool) -> bool:
    """One daemon-reload per touched scope, after the unit batch. Run (and
    retried) whenever units are recorded in the scope, even already-absent
    ones — a reload that failed after the file was removed would otherwise
    never run again."""
    ok = True
    if "user" in scopes:
        if dry:
            log("[dry] would run systemctl --user daemon-reload")
        elif _run_command(["systemctl", "--user", "daemon-reload"],
                          "systemctl --user daemon-reload") != 0:
            ok = False
    if "system" in scopes:
        if dry:
            log("[dry] would run sudo systemctl daemon-reload")
        elif _run_command(["sudo", "systemctl", "daemon-reload"],
                          "sudo systemctl daemon-reload") != 0:
            ok = False
    return ok




# ---------------------------------------------------------------------------
# Durable install transaction.  The ordinary ledger remains the ownership
# source of truth; this sidecar only preserves the last committed bytes and
# runtime state long enough to compensate one installer run.


def _safe_extract_archive(archive: Path, destination: Path) -> tuple[Path, list[tarfile.TarInfo]]:
    with tarfile.open(archive, "r") as bundle:
        members = bundle.getmembers()
        for member in sorted((m for m in members if m.isdir()), key=lambda m: len(Path(m.name).parts)):
            target = destination.joinpath(*Path(member.name).parts)
            target.mkdir(parents=True, exist_ok=True)
        for member in (m for m in members if m.isreg()):
            target = destination.joinpath(*Path(member.name).parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            source = bundle.extractfile(member)
            with source, target.open("xb") as output:
                shutil.copyfileobj(source, output)
            os.chmod(target, stat.S_IMODE(member.mode))
        for member in (m for m in members if m.issym()):
            target = destination.joinpath(*Path(member.name).parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            os.symlink(member.linkname, target)
        for member in sorted((m for m in members if m.isdir()),
                             key=lambda m: len(Path(m.name).parts), reverse=True):
            os.chmod(destination.joinpath(*Path(member.name).parts), stat.S_IMODE(member.mode))
    return destination / "payload", members


def nginx_site_path() -> str:
    return os.environ.get("AIRLOCK_NGINX_SITE") or "/etc/nginx/conf.d/airlock.conf"


def hub_manifest_path() -> str:
    return os.path.join(_webroot(), "__airlock.json")


# =========================== installed-apps engine ==========================
# The engine (P3_ENGINE). Three records, and this section is all of it:
#
#   ⑤ airlock.toml [site] company_repo — the default URL for a fresh or
#      explicitly selected Company source. An installed row keeps its own repo.
#      Supplied by airlock-config (no TOML here), never an operator's clone.
#   ③ ~/.local/state/airlock/installed-apps.json — the ONLY record of "what
#      is installed": {id: {repo, commit, artifacts[]}}. No digest, no
#      prev_commit, no lifecycle, no roots, no serve_mappings; nothing else
#      may write or interpret this shape.
#   ~/.local/share/airlock/sources/company.git — a bare mirror. `pin_main`
#      fetches into it and every read (apply, plan, store the UI shows) names
#      the SHA it read, so an operator's working tree is never the source.
#
# No lock (A1 was never proven), no journal, no checkpoint: A4 is "run the
# same apply once more against the (repo, commit) this app had when we
# started", and that is the whole restore story.
INSTALLED_FILENAME = "installed-apps.json"
INSTALL_RECORD_NAME = INSTALLED_FILENAME
LEGACY_LEDGER_FILENAME = "app-ledger.json"
LEGACY_LEDGER_ARCHIVE_FILENAME = "app-ledger.v7.json"
DATA_DIR_DEFAULT = "~/.local/share/airlock"
SERVE_MODES = ("http", "https")
FIXTURE_TOOLS = ("sudo", "systemctl", "nginx", "tailscale")
UNIT_SUFFIXES = (".service", ".socket", ".timer", ".target", ".path", ".mount",
                 ".slice", ".swap", ".scope", ".automount", ".device")
# Set by load_installed when it converted a v7 ledger IN MEMORY. The
# conversion lands on disk on the first write only, so a read-only consumer
# (the dev-monitor timer) never renames the operator's ledger.
_LEGACY_PENDING = False


class ApplyFailed(Exception):
    """An apply that got far enough to have effects, so it must be undone."""


def data_dir() -> Path:
    raw = (os.environ.get("AIRLOCK_DATA_DIR") or "").strip()
    return Path(_expand_path(raw or DATA_DIR_DEFAULT))


def company_mirror_path() -> Path:
    return data_dir() / "sources" / "company.git"


def engine_apps_root() -> Path:
    return data_dir() / "apps"


def installed_path() -> Path:
    return state_dir() / INSTALLED_FILENAME


def legacy_ledger_path() -> Path:
    return state_dir() / LEGACY_LEDGER_FILENAME


def legacy_archive_path() -> Path:
    return state_dir() / LEGACY_LEDGER_ARCHIVE_FILENAME


def _repo_root() -> str:
    return str(Path(__file__).resolve().parent.parent)


def _is_git_url(value: str) -> bool:
    """scp-like (git@host:path/repo.git) or any scheme URL. A local path is
    never one, which is the whole distinction: a URL row reads through the
    mirror, a path row reads in place."""
    if "://" in value:
        return True
    return bool(re.fullmatch(r"[^/\\:@]+@[^/\\:]+:.+", value))


def _serve_token(value: str) -> tuple[str, str] | None:
    """`<mode>:<listen>` — a tailscale serve mapping, or None for a path.
    Mode is part of the token because an https listener removed as http would
    leave the real one answering (the pikes lens' ingress-mode finding)."""
    mode, separator, listen = value.partition(":")
    if not separator or mode not in SERVE_MODES or not listen.isdigit():
        return None
    return mode, listen


def _require_app_id(app_id: str) -> str:
    if not app_id or not _ID_RE.match(app_id):
        fail(f"{app_id!r} is not a single app path component")
    return app_id


def _validate_installed(raw: Any, path: Path) -> dict[str, Any]:
    """Read the record without turning unrelated rows into execution gates."""
    if not isinstance(raw, dict):
        fail(f"{path}: installed apps must be a JSON object")
    return raw


def _recorded_artifacts(row: Any) -> list[str]:
    """Readable ownership facts for observation, without rewriting the row."""
    items = row.get("artifacts", []) if isinstance(row, dict) else []
    return [item for item in items if isinstance(item, str)] if isinstance(items, list) else []


def _recorded_repo(row: Any) -> str:
    repo = row.get("repo", "") if isinstance(row, dict) else ""
    return repo if isinstance(repo, str) else ""


def _git_head(path: str) -> str:
    """HEAD of a local source, or '' when it is not a git checkout. An empty
    commit is a fact, not an error: Personal app directories need not be git."""
    if not os.path.isdir(path):
        return ""
    try:
        result = subprocess.run(["git", "-C", path, "rev-parse", "HEAD"],
                                capture_output=True, text=True, check=False)
    except OSError:
        return ""
    sha = result.stdout.strip().splitlines()[0] if result.stdout.strip() else ""
    return sha if _GIT_OID_RE.match(sha) else ""


def _git(args: list[str], description: str) -> subprocess.CompletedProcess[str]:
    """git whose output is TEXT — a sha, a diff status, an error line."""
    try:
        return subprocess.run(["git", *args], capture_output=True, text=True,
                              check=False)
    except OSError as exc:
        fail(f"{description} failed: {exc}")


def _git_bytes(args: list[str], description: str) -> subprocess.CompletedProcess:
    """git whose output is left as BYTES.

    `git archive` writes a tar stream to stdout, and decoding that as text
    raises UnicodeDecodeError on the first non-UTF-8 byte. A tar HEADER is ASCII
    and NUL — both valid UTF-8 — so an all-text fixture decodes fine and only a
    real asset breaks; that is why this is a separate function and not a flag
    nobody sets."""
    try:
        return subprocess.run(["git", *args], capture_output=True, check=False)
    except OSError as exc:
        fail(f"{description} failed: {exc}")


def _legacy_plaintext_ports(directory: Path) -> dict[str, set[int]]:
    """Import the old orchestrator's committed HTTP ownership, read-only.

    The preserved update reader must work without a neighbouring config tool.
    Missing/unreadable optional history grants no additional removal authority.
    """
    try:
        raw = json.loads(_read_record_bytes(directory / "plaintext-retirement.json"))
    except (LedgerError, OSError, UnicodeError, json.JSONDecodeError):
        return {}
    if not isinstance(raw, dict) or raw.get("version") != 1:
        return {}
    entries = raw.get("entries")
    if not isinstance(entries, list):
        return {}
    ports: dict[str, set[int]] = {}
    for entry in entries:
        if not isinstance(entry, dict) or entry.get("state") != "committed":
            continue
        app_id, port = entry.get("package"), entry.get("listen")
        if (isinstance(app_id, str) and _ID_RE.fullmatch(app_id)
                and isinstance(port, int) and not isinstance(port, bool)
                and 1 <= port <= 65535):
            ports.setdefault(app_id, set()).add(port)
    return ports


def _legacy_row(record: dict[str, Any], plaintext_ports: set[int] | None = None) -> dict[str, Any]:
    """A v7 committed record as one ③ row. Everything that is a fact about
    INSTALLATION moves across (path, HEAD, the paths and the serve ports); the
    v7 bookkeeping (digest, lifecycle, roots, anchors, capabilities) does not,
    because the new engine has no use for it and a wrong value would be worse
    than none."""
    path = str(record.get("path") or "")
    declared = record.get("artifacts") or {}
    artifacts: set[str] = set()
    for name in PATH_CLASSES:
        for raw in declared.get(name, []) or []:
            artifacts.add(str(raw))
    # serve_mappings is where a port's MODE lives; serve_ports alone is blind to
    # it. No mapping means the app never declared one, and the v7 default for a
    # bare declared port was http (:1849).
    modes: dict[int, str] = {}
    for mapping in (record.get("serve_mappings") or {}).values():
        if not isinstance(mapping, dict):
            continue
        target, mode = mapping.get("listen"), mapping.get("mode")
        if isinstance(target, int) and not isinstance(target, bool) and mode in SERVE_MODES:
            modes[target] = mode
    for raw_port in declared.get("serve_ports", []) or []:
        try:
            port = int(raw_port)
        except (TypeError, ValueError):
            continue
        artifacts.add(f"{modes.get(port, 'http')}:{port}")
    artifacts.update(f"http:{port}" for port in plaintext_ports or ())
    return {"repo": path, "commit": _git_head(path), "artifacts": sorted(artifacts)}


def load_installed(state_directory: str | Path | None = None) -> dict[str, dict[str, Any]]:
    """Read installed state or convert v7 in memory; reads never mutate disk."""
    global _LEGACY_PENDING
    directory = Path(state_directory) if state_directory is not None else state_dir()
    path = directory / INSTALLED_FILENAME
    legacy = directory / LEGACY_LEDGER_FILENAME
    selected = path if os.path.lexists(path) else legacy
    if not os.path.lexists(selected):
        if state_directory is None:
            _LEGACY_PENDING = False
        return {}
    try:
        raw = json.loads(_read_record_bytes(selected))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(f"{selected}: cannot parse installed state: {exc}")
    if selected == path:
        if state_directory is None:
            _LEGACY_PENDING = False
        return _validate_installed(raw, path)
    _validate_store(raw, legacy)
    plaintext = _legacy_plaintext_ports(directory)
    converted = {app_id: _legacy_row(entry["committed"], plaintext.get(app_id))
                 for app_id, entry in raw["entries"].items()
                 if isinstance(entry.get("committed"), dict)}
    if state_directory is None:
        _LEGACY_PENDING = True
    return _validate_installed(converted, path)


def validate_installed_bytes(data: bytes) -> dict[str, dict[str, Any]]:
    """Interpret a snapshot through the same new/v7 read contract."""
    try:
        raw = json.loads(data)
    except (UnicodeError, json.JSONDecodeError) as exc:
        fail(f"installed snapshot: cannot parse JSON: {exc}")
    if isinstance(raw, dict) and "version" in raw and "entries" in raw:
        _validate_store(raw, Path("installed snapshot"))
        raw = {app_id: _legacy_row(entry["committed"])
               for app_id, entry in raw["entries"].items()
               if isinstance(entry.get("committed"), dict)}
    return _validate_installed(raw, Path("installed snapshot"))


def _read_record_bytes(path: Path) -> bytes:
    """Install records are regular files; a symlink never grants snapshot authority."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                fail(f"{path}: installed state must be a regular non-symlink file")
            return stream.read()
    except OSError as exc:
        fail(f"{path}: cannot read regular installed state: {exc}")


def read_installed_bytes(state_directory: str | Path | None = None) -> bytes | None:
    directory = Path(state_directory) if state_directory is not None else state_dir()
    for name in (INSTALLED_FILENAME, LEGACY_LEDGER_FILENAME):
        path = directory / name
        if os.path.lexists(path):
            data = _read_record_bytes(path)
            validate_installed_bytes(data)
            return data
    return None


def snapshot_installed(destination: str | Path,
                       state_directory: str | Path | None = None) -> bool:
    data = read_installed_bytes(state_directory)
    if data is None:
        return False
    target = Path(destination)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    return True


def restore_installed(snapshot: str | Path | None,
                      state_directory: str | Path | None = None) -> None:
    """Restore the snapshot's exact format, including checkpoints predating v7 conversion."""
    global _LEGACY_PENDING
    directory = Path(state_directory) if state_directory is not None else state_dir()
    for name in (INSTALLED_FILENAME, LEGACY_LEDGER_FILENAME):
        target = directory / name
        if os.path.lexists(target):
            _read_record_bytes(target)
    if snapshot is None:
        for name in (INSTALLED_FILENAME, LEGACY_LEDGER_FILENAME):
            (directory / name).unlink(missing_ok=True)
        _LEGACY_PENDING = False
        return
    data = _read_record_bytes(Path(snapshot))
    validate_installed_bytes(data)
    raw = json.loads(data)
    name = (LEGACY_LEDGER_FILENAME if "version" in raw and "entries" in raw
            else INSTALLED_FILENAME)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary: str | None = None
    try:
        descriptor, temporary = tempfile.mkstemp(prefix=".installed-restore.", dir=directory)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, directory / name)
        temporary = None
        other = INSTALLED_FILENAME if name == LEGACY_LEDGER_FILENAME else LEGACY_LEDGER_FILENAME
        (directory / other).unlink(missing_ok=True)
    finally:
        if temporary is not None:
            os.unlink(temporary)
    _LEGACY_PENDING = False


def recorded_active_ports(installed: dict[str, dict[str, Any]] | None = None,
                          skip_id: str = "", mode: str | None = None) -> set[int]:
    store = load_installed() if installed is None else installed
    return {int(token[1]) for app_id, row in store.items() if app_id != skip_id
            for item in _recorded_artifacts(row)
            if (token := _serve_token(item)) is not None and (mode is None or token[0] == mode)}


def installed_units(store: dict[str, dict[str, Any]] | None = None) -> list[tuple[str, str]]:
    installed = load_installed() if store is None else store
    return sorted({(os.path.basename(item), _unit_scope(item)[1])
                   for row in installed.values() for item in _recorded_artifacts(row)
                   if _is_unit_path(item)})


def teardown_installed(core_root: str | Path | None = None) -> int:
    store = load_installed()
    fixture_boundary(engine_boundary_paths())
    selected = {app_id for app_id, row in store.items()
                if isinstance(row, dict) and isinstance(row.get("artifacts"), list)
                and (core_root is None or (_ID_RE.fullmatch(app_id)
                    and _recorded_repo(row) and not _is_git_url(_recorded_repo(row))
                    and os.path.realpath(_recorded_repo(row)) == os.path.realpath(
                        Path(core_root) / "apps" / app_id)))}
    residue = _remove_paths([item for app_id in selected
                             for item in store[app_id]["artifacts"]],
                            protected_ingress=_other_ingress(store, selected))
    if residue:
        log("residue teardown: " + "; ".join(residue))
        return 1
    write_installed({app_id: row for app_id, row in store.items()
                     if app_id not in selected})
    return 0


def restore_apps(snapshot: bytes) -> int:
    """Reinstall missing archive apps from their sources, never their old artifacts.

    The full installer owns core apps. Fresh-box backup restoration then fills
    the remaining app set through the same apply flow. A resume skips apps whose
    successful apply has already committed a record.
    """
    archived = validate_installed_bytes(snapshot)
    current = load_installed()
    fixture_boundary(engine_boundary_paths())
    missing = {app_id: row for app_id, row in archived.items() if app_id not in current}
    source_rows = {app_id: row for app_id, row in missing.items()
                   if _ID_RE.fullmatch(app_id) and _recorded_repo(row)}
    metadata = {app_id: row for app_id, row in missing.items() if app_id not in source_rows}
    if metadata:
        write_installed(dict(metadata, **current))
    if not source_rows:
        return 0
    # Archive keys are sorted, not install order. Read the same manifest parser
    # as apply before replaying dependencies. Company inspection uses private
    # staging so it cannot replace an installed app directory.
    data_dir().mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="restore-apps-", dir=data_dir()) as temporary:
        pending = {}
        deps = {}
        failed = False
        for app_id, row in source_rows.items():
            try:
                source = _source_from_row(app_id, row)
                directory = source["dir"]
                if source["kind"] == "company":
                    _ensure_mirror_object(source)
                    directory = str(Path(temporary) / app_id)
                    _mirror_extract(Path(source["mirror"]), source["sha"], app_id, Path(directory))
                deps[app_id] = read_dir_package(app_id, directory)["deps"]
                pending[app_id] = source
            except (LedgerError, KeyError, TypeError, ValueError, OSError) as exc:
                log(f"restore {app_id} failed: {exc}")
                failed = True
        while pending:
            # Like config app_order, cycles fall back to the existing stable
            # order instead of inventing another installation refusal.
            app_id = next((app for app in pending
                           if not any(dep in pending for dep in deps[app])), next(iter(pending)))
            source = pending.pop(app_id)
            try:
                result = _apply_run(app_id, source, load_installed(), None, allow_restore=True)
            except LedgerError as exc:
                log(f"restore {app_id} failed: {exc}")
                result = 1
            if result != 0:
                failed = True
                continue
            restored = load_installed()
            restored[app_id] = dict(archived[app_id], **restored[app_id])
            write_installed(restored)
    return 1 if failed else 0


def _atomic_write_json(path: Path, value: Any) -> None:
    directory = path.parent
    temp_name: str | None = None
    try:
        fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp",
                                         dir=directory)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(value, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(temp_name, path)
        temp_name = None
    except (OSError, TypeError, ValueError) as exc:
        fail(f"cannot atomically write {path}: {exc}")
    finally:
        if temp_name is not None:
            try:
                os.unlink(temp_name)
            except OSError:
                pass


def write_installed(store: dict[str, dict[str, Any]]) -> None:
    """The only writer of ③. Same-directory atomic replace: two concurrent
    applies both land whole, and the later one wins — the row the loser wrote
    comes back the next time that app is applied (no lock; A1 was never
    proven)."""
    global _LEGACY_PENDING
    clean = _validate_installed(store, installed_path())
    _ensure_state_dir()
    # ③ FIRST, the v7 archive second. The other order has a window where the
    # box has neither: a crash between the rename and the write would leave an
    # installed-apps.json that does not exist and an app-ledger.json that is no
    # longer at its own name. In this order the worst case is a v7 ledger that
    # was never renamed — `load_installed` reads ③ the moment it exists, so the
    # stale file is inert.
    _atomic_write_json(installed_path(), clean)
    if _LEGACY_PENDING:
        legacy, archive = legacy_ledger_path(), legacy_archive_path()
        if os.path.lexists(legacy):
            try:
                os.replace(legacy, archive)
            except OSError as exc:
                fail(f"③ is written, but the v7 ledger could not be archived from "
                     f"{legacy} to {archive}: {exc}")
        _LEGACY_PENDING = False


def company_repo(info: dict[str, Any]) -> str:
    value = str(info.get("company_repo") or "").strip()
    if value and not _is_git_url(value):
        # Company always names a Git repository, including a local Git path.
        # Record the URL form so ③ readers do not mistake it for an app dir.
        return Path(_expand_path(os.path.expandvars(value))).resolve().as_uri()
    return value


def pin_main(info: dict[str, Any]) -> str:
    """The selected source URL -> one pinned SHA in this box's own bare mirror.
    Nothing reads the operator's clone: that is what made 'deploy and you are
    back in the past' possible."""
    url = company_repo(info)
    if not url:
        fail('no Company source on this box: set [site] company_repo = "<git URL>" '
             "in airlock.toml")
    mirror = company_mirror_path()
    try:
        mirror.mkdir(parents=True, exist_ok=True)
        if not os.path.lexists(mirror / "HEAD"):
            _git(["init", "--bare", "--quiet", str(mirror)],
                 f"create the Company mirror {mirror}")
    except OSError as exc:
        fail(f"cannot prepare the Company mirror {mirror}: {exc}")
    # Each fetch owns its ref: another source or a moving main must not
    # change the SHA this caller reads from the shared mirror.
    ref = "refs/airlock/company-pin/" + os.urandom(16).hex()
    try:
        result = _git(["-C", str(mirror), "fetch", "--quiet", url, f"refs/heads/main:{ref}"],
                      f"fetch Company main from {url}")
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().splitlines()
            fail(f"cannot fetch Company main from {url}: "
                 + (detail[-1] if detail else f"git exited {result.returncode}"))
        head = _git(["-C", str(mirror), "rev-parse", f"{ref}^{{commit}}"],
                    "resolve the fetched Company main")
        sha = head.stdout.strip()
        if not _GIT_OID_RE.match(sha):
            fail(f"Company main from {url} did not resolve to a commit")
        return sha
    finally:
        _git(["-C", str(mirror), "update-ref", "-d", ref], "release Company pin")


def _mirror_has_app(mirror: Path, sha: str, app_id: str) -> bool:
    return _git(["-C", str(mirror), "cat-file", "-e", f"{sha}:apps/{app_id}"],
                f"look up apps/{app_id}").returncode == 0


def _mirror_extract(mirror: Path, sha: str, app_id: str, destination: Path) -> None:
    """Unpack apps/<id> and its shared package runtime at <sha>.
    The mirror is a real object store, so
    a restore to an older SHA is the same code path as a fresh install."""
    paths = [f"apps/{app_id}"]
    runtime = "tools/package_runtime.py"
    if _git(["-C", str(mirror), "cat-file", "-e", f"{sha}:{runtime}"],
            "look up the shared package runtime").returncode == 0:
        paths.append(runtime)
    # Git's default tar umask permits group writes; detached package builders
    # consume source files with read-only group/other access (644/755).
    archive = _git_bytes(["-c", "tar.umask=0022", "-C", str(mirror), "archive", "--format=tar", sha,
                          *paths], f"archive apps/{app_id} at {sha}")
    if archive.returncode != 0:
        detail = (archive.stderr or b"").decode("utf-8", "replace").strip().splitlines()
        fail(f"cannot read apps/{app_id} at {sha} from the Company mirror: "
             + (detail[-1] if detail else f"git exited {archive.returncode}"))
    try:
        destination.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        fail(f"cannot create {destination.parent}: {exc}")
    staging = Path(tempfile.mkdtemp(prefix=f".{app_id}.", dir=str(destination.parent)))
    tar_path = staging / "source.tar"
    try:
        with open(tar_path, "wb") as fh:
            fh.write(archive.stdout)
        unpacked = staging / "unpacked"
        unpacked.mkdir()
        _safe_extract_archive(tar_path, unpacked)
        source = unpacked / "apps" / app_id
        if not source.is_dir():
            fail(f"apps/{app_id} at {sha} did not unpack to a directory")
        # Detached packages already look beside package.py for this module.
        # Keep an app-local runtime when the source ships one of its own.
        if len(paths) > 1 and not os.path.lexists(source / "package_runtime.py"):
            shutil.copy2(unpacked / runtime, source / "package_runtime.py")
        if os.path.lexists(destination):
            shutil.rmtree(destination)
        os.rename(source, destination)
    except (OSError, tarfile.TarError) as exc:
        fail(f"cannot unpack apps/{app_id} at {sha}: {exc}")
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def _airlock_config_argv() -> list[str]:
    return [sys.executable, str(Path(__file__).resolve().parent / "airlock-config")]


def read_dir_package(app_id: str, directory: str) -> dict[str, Any]:
    """The app's manifest, read by airlock-config's ONE parser. This file
    parses no TOML, and it does not grow a second manifest reader to become
    self-sufficient: two readers is the drift the package-info contract exists
    to prevent."""
    try:
        result = subprocess.run(
            [*_airlock_config_argv(), "dir-package-info", app_id, directory],
            env=_current_config_env(), stdin=subprocess.DEVNULL,
            capture_output=True, text=True, check=False)
    except OSError as exc:
        fail(f"cannot read the manifest of {app_id}: {exc}")
    if result.returncode != 0:
        for line in (result.stderr or "").splitlines():
            sys.stderr.write(line + "\n")
        fail(f"cannot use the manifest of {app_id} at {directory}")
    try:
        info = json.loads(result.stdout)
        return _normalise_package(app_id, info["packages"][app_id])
    except (ValueError, KeyError, TypeError) as exc:
        fail(f"airlock-config dir-package-info returned unusable output: {exc}")


def _declared_paths(package: dict[str, Any]) -> set[str]:
    """The paths this manifest claims, expanded against the live roots. Only
    what EXISTS comes back: a glob that matched nothing is nothing to record,
    and to remove later."""
    expanded = expand_declared(package["artifacts"], package["serve_port_values"],
                              _current_roots(),
                              unit_scopes=package["unit_scopes"])
    paths: set[str] = set()
    for name in PATH_CLASSES:
        paths.update(str(item) for item in expanded[name])
    icon = package.get("icon")
    if isinstance(icon, dict) and icon.get("dest"):
        destination = os.path.join(_webroot(), icon["dest"])
        if os.path.lexists(destination):
            paths.add(destination)
    return paths


def app_dirs(info: dict[str, Any]) -> dict[str, str]:
    """id -> recorded directory, including a source that has disappeared.
    ③ owns source identity; existence does not permit a candidate fallback.
    The applying process supplies the one source it explicitly chose."""
    dirs: dict[str, str] = {}
    for app_id, row in load_installed().items():
        repo = _recorded_repo(row)
        if not _ID_RE.fullmatch(app_id) or not repo:
            continue
        candidate = (str(engine_apps_root() / app_id) if _is_git_url(repo) else repo)
        dirs[app_id] = candidate
    env_id = os.environ.get("AIRLOCK_APP_ID") or ""
    env_dir = os.environ.get("AIRLOCK_APP_DIR") or ""
    if env_id and env_dir and _ID_RE.match(env_id):
        dirs[env_id] = _expand_path(env_dir)
    return dirs


def resolve_source(app_id: str, info: dict[str, Any], explicit: str) -> dict[str, Any]:
    """Use the explicit source or this app's installed source."""
    explicit = explicit or ""
    if explicit and explicit != "company":
        if not os.path.isabs(explicit):
            fail(f"--source {explicit}: expected 'company' or an absolute directory")
        directory = os.path.realpath(explicit)
        if not os.path.isdir(directory):
            fail(f"--source {explicit}: not a directory")
        return {"kind": "local", "repo": directory, "commit": _git_head(directory),
                "dir": directory}
    if explicit == "company":
        if not company_repo(info):
            fail('--source company: no [site] company_repo = "<git URL>" in airlock.toml')
        mirror = company_mirror_path()
        sha = pin_main(info)
        if not _mirror_has_app(mirror, sha, app_id):
            fail(f"--source company: apps/{app_id} is not in Company main")
        return {"kind": "company", "repo": company_repo(info), "commit": sha,
                "sha": sha, "mirror": str(mirror),
                "dir": str(engine_apps_root() / app_id)}
    row = load_installed().get(app_id)
    if row is not None:
        if _is_git_url(row["repo"]):
            sha = pin_main(dict(info, company_repo=row["repo"]))
            mirror = company_mirror_path()
            if not _mirror_has_app(mirror, sha, app_id):
                fail(f"recorded source {row['repo']}: apps/{app_id} is not in main")
            return {"kind": "company", "repo": row["repo"], "commit": sha,
                    "sha": sha, "mirror": str(mirror),
                    "dir": str(engine_apps_root() / app_id)}
        directory = os.path.realpath(row["repo"])
        if not os.path.isdir(directory):
            fail(f"recorded source for {app_id} is missing: {directory}")
        return {"kind": "local", "repo": directory,
                "commit": _git_head(directory), "dir": directory}
    fail(f"no installed source for {app_id}: new apps require --source")


def _source_from_row(app_id: str, row: dict[str, Any]) -> dict[str, Any]:
    """The source that reproduces a row exactly — which is what A4 restores."""
    _require_app_id(app_id)
    if _is_git_url(row["repo"]):
        return {"kind": "company", "repo": row["repo"], "commit": row["commit"],
                "sha": row["commit"], "mirror": str(company_mirror_path()),
                "dir": str(engine_apps_root() / app_id)}
    directory = os.path.realpath(row["repo"])
    return {"kind": "local", "repo": directory, "commit": _git_head(directory),
            "dir": directory}


def _ensure_mirror_object(source: dict[str, Any]) -> None:
    mirror = Path(source["mirror"])
    sha = source["sha"]
    if not (mirror / "HEAD").exists():
        mirror.mkdir(parents=True, exist_ok=True)
        if _git(["init", "--bare", "--quiet", str(mirror)],
                f"create the Company mirror {mirror}").returncode != 0:
            fail(f"cannot create the Company mirror {mirror}")
    if _git(["-C", str(mirror), "cat-file", "-e", f"{sha}^{{commit}}"],
            f"look up {sha}").returncode == 0:
        return
    # The mirror may have been pruned; ask the URL for that exact object once.
    result = _git(["-C", str(mirror), "fetch", "--quiet", source["repo"], sha],
                  f"fetch {sha} from {source['repo']}")
    if result.returncode != 0 or _git(
            ["-C", str(mirror), "cat-file", "-e", f"{sha}^{{commit}}"],
            f"look up {sha}").returncode != 0:
        fail(f"the Company mirror no longer has commit {sha}")


def fixture_boundary(paths: dict[str, str],
                     tools: tuple[str, ...] = FIXTURE_TOOLS) -> None:
    """A5, one implementation. AIRLOCK_FIXTURE_ROOT is executable test
    authority: every path this run may write and every command it may invoke
    that crosses into systemd, nginx or Tailscale must resolve below it.
    Fail-closed — an incomplete fixture never becomes a live install. A no-op
    with no fixture root, which is every real box."""
    root_raw = (os.environ.get("AIRLOCK_FIXTURE_ROOT") or "").strip()
    if not root_raw:
        return
    root = Path(root_raw)
    if not root.is_absolute():
        fail("fixture boundary: AIRLOCK_FIXTURE_ROOT must be absolute")

    def below(label: str, raw: str, *, resolved: Path) -> None:
        if resolved != root and root not in resolved.parents:
            fail(f"fixture boundary: {label} escapes AIRLOCK_FIXTURE_ROOT: {resolved}")

    for label, raw in sorted(paths.items()):
        if not raw:
            fail(f"fixture boundary: {label} must be explicit")
        candidate = Path(raw)
        if not candidate.is_absolute():
            fail(f"fixture boundary: {label} must be absolute")
        below(label, raw, resolved=candidate.resolve(strict=False))
    for name in tools:
        found = shutil.which(name)
        if not found:
            fail(f"fixture boundary: mutation command {name} is not on PATH; "
                 "a fixture run must not reach the real one")
        below("mutation command " + name, found,
              resolved=Path(os.path.realpath(found)))


def engine_boundary_paths() -> dict[str, str]:
    return {
        "HOME": os.environ.get("HOME") or "",
        "AIRLOCK_STATE_DIR": str(state_dir()),
        "AIRLOCK_DATA_DIR": str(data_dir()),
        "AIRLOCK_WEBROOT": _webroot(),
        "AIRLOCK_CONFD": _conf_dir(),
        "AIRLOCK_NGINX_SITE": nginx_site_path(),
    }


def _is_unit_path(path: str) -> bool:
    return (path.startswith(_unit_dir("user") + os.sep)
            or path.startswith(_unit_dir("system") + os.sep)) and path.endswith(UNIT_SUFFIXES)


def _remove_paths(items: list[str] | set[str], dry: bool = False,
                  protected_ingress: set[str] | None = None) -> list[str]:
    """A3 for the new record: recorded paths, recorded units, recorded serve
    mappings. Nothing else is touched, so an app's data directory outside its
    artifacts survives. Returns the residues; the caller decides the exit code.

    A recorded unit is recognised by where it lives (under a systemd unit root)
    AND that its name is a unit name — a stray file in the unit directory is
    removed as the plain file it is, never handed to systemctl."""
    if not isinstance(items, (list, set)):
        fail("artifacts must be a list")
    residue: list[str] = []
    units: list[tuple[str, str, list[str]]] = []
    tokens: list[str] = []
    plain: list[str] = []
    for item in sorted(items, key=str):
        if not isinstance(item, str) or not item:
            residue.append("every artifact must be a non-empty string")
            continue
        if _serve_token(item) is None and not os.path.isabs(item):
            residue.append(f"artifact {item!r} is neither an absolute path nor <mode>:<listen>")
            continue
        if _serve_token(item) is not None:
            if item in (protected_ingress or set()):
                continue
            tokens.append(item)
            continue
        path = _expand_path(item)
        if _is_unit_path(path):
            refusal = _plain_artifact_refusal(path)
            if refusal or re.search(r"[*?\[]", os.path.basename(path)):
                residue.append(refusal or f"recorded unit is not literal: {path}")
                continue
            path, scope = _unit_scope(path)
            try:
                names = [] if dry else _unit_invocations(path, scope)
            except LedgerError as exc:
                residue.append(str(exc))
                continue
            units.append((path, scope, names))
        else:
            plain.append(path)
    if units:
        invocations = [(os.path.join(os.path.dirname(path), name), scope)
                       for path, scope, names in units for name in names]
        if not _stop_units(invocations, dry):
            residue.append("could not prove every recorded unit stopped")
            return residue
        scopes: set[str] = set()
        for path, scope, names in units:
            ok, unit_scope = _teardown_unit(path, dry, None, unit_names=names)
            scopes.add(unit_scope)
            if not ok:
                residue.append(f"could not remove unit {path}")
        if scopes and not _reload_units(scopes, dry):
            residue.append("daemon-reload failed")
    for path in plain:
        remover = (_remove_rooted_artifact_path if _rooted_contains(path)
                   else _remove_artifact_path)
        if not remover(path, dry):
            residue.append(f"could not remove {path}")
    for token in tokens:
        mode, listen = _serve_token(token)  # type: ignore[misc]
        command = ["sudo", "tailscale", "serve", f"--{mode}={listen}", "off"]
        if dry:
            log("[dry] would run " + " ".join(command))
            continue
        if _run_command(command, " ".join(command)) != 0:
            residue.append(f"could not retire ingress {token}")
    return residue


def _last_line(raw: str | bytes | None) -> str:
    """The last line of a child's stderr, as a string. Concatenating a list
    onto a message is a TypeError, and it would fire exactly when a projection
    fails — the moment the operator most needs the real reason."""
    text = raw.decode("utf-8", "replace") if isinstance(raw, bytes) else (raw or "")
    lines = text.strip().splitlines()
    return lines[-1] if lines else "no diagnostic on stderr"


def _stage_icon(app_id: str, env: dict[str, str] | None = None) -> str:
    """This app's tile icon, and nothing else's. airlock-config prints the
    webroot-relative path it wrote; empty means the manifest declares none."""
    try:
        result = subprocess.run([*_airlock_config_argv(), "icon-stage", app_id],
                                capture_output=True, env=env, check=False)
    except OSError as exc:
        raise ApplyFailed(f"icon staging for {app_id} could not start: {exc}")
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip().splitlines()
        raise ApplyFailed(f"icon staging for {app_id} failed: "
                          + (detail[-1] if detail else "airlock-config icon-stage failed"))
    return result.stdout.decode("utf-8").removesuffix("\n")


def _apply_ingress(app_id: str, package: dict[str, Any],
                   tokens: list[str] | None = None) -> list[str]:
    # Keep earlier successful mappings visible to compensation if a later one fails.
    tokens = [] if tokens is None else tokens
    mappings = sorted(package["serve_mappings"].values(),
                      key=lambda m: (str(m.get("mode")), int(m.get("listen") or 0)))
    for mapping in mappings:
        mode, listen, target = (mapping.get("mode"), mapping.get("listen"),
                                mapping.get("target"))
        if mode not in SERVE_MODES:
            continue
        if not all(isinstance(v, int) and not isinstance(v, bool)
                   for v in (listen, target)):
            continue
        command = ["sudo", "tailscale", "serve", "--bg", f"--{mode}={listen}",
                   f"http://127.0.0.1:{target}"]
        if _run_command(command, " ".join(command)) != 0:
            raise ApplyFailed(f"ingress apply failed for {app_id} ({mode}:{listen})")
        tokens.append(f"{mode}:{listen}")
    return tokens


def project(app_ids: list[str], app_env: dict[str, str] | None = None,
            protected_ingress: set[str] | None = None) -> None:
    """The two WHOLE-store projections: the nginx site and the Hub manifest.
    Everything else an apply touches belongs to the one app it is applying.
    Every failure here is an apply failure (A4), not a warning."""
    env = _current_config_env() if app_env is None else app_env.copy()
    env["AIRLOCK_PROJECT_IDS"] = json.dumps(app_ids)
    try:
        render = subprocess.run(["bash", os.path.join(_repo_root(), "install", "render-nginx.sh")],
                                capture_output=True, text=True, env=env, check=False)
    except OSError as exc:
        raise ApplyFailed(f"cannot run install/render-nginx.sh: {exc}")
    if render.returncode != 0:
        raise ApplyFailed("install/render-nginx.sh failed: "
                          + _last_line(render.stderr))
    sys.stderr.write(render.stderr)
    try:
        webjson = subprocess.run([*_airlock_config_argv(), "webjson"],
                                 capture_output=True, text=True, env=env, check=False)
    except OSError as exc:
        raise ApplyFailed(f"cannot run airlock-config webjson: {exc}")
    if webjson.returncode != 0:
        raise ApplyFailed("airlock-config webjson failed: "
                          + _last_line(webjson.stderr))
    sys.stderr.write(webjson.stderr)
    if os.environ.get("AIRLOCK_DRY_RUN") == "1":
        log(f"[dry] would publish {nginx_site_path()} and {hub_manifest_path()} and reload nginx")
        return
    staging = Path(tempfile.mkdtemp(prefix=".airlock-project.", dir="/tmp"))
    try:
        for target, content in ((nginx_site_path(), render.stdout),
                                (hub_manifest_path(), webjson.stdout)):
            staged = staging / os.path.basename(target)
            with open(staged, "w", encoding="utf-8") as fh:
                fh.write(content)
            if _run_command(["sudo", "cp", str(staged), target],
                            f"sudo cp {staged} {target}") != 0:
                raise ApplyFailed(f"could not publish {target}")
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    if _run_command(["sudo", "nginx", "-t"], "sudo nginx -t") != 0:
        raise ApplyFailed("nginx configuration test failed")
    if _run_command(["sudo", "systemctl", "reload", "nginx"],
                    "sudo systemctl reload nginx") != 0:
        raise ApplyFailed("nginx reload failed")
    _project_hub_ingress(env, protected_ingress)


def _project_hub_ingress(env: dict[str, str],
                         protected_ingress: set[str] | None = None) -> set[int]:
    """The reserved Hub has no app hook; publish its entrances after nginx reload."""
    try:
        result = subprocess.run([*_airlock_config_argv(), "json", "hub"],
                                capture_output=True, text=True, env=env, check=False)
    except OSError as exc:
        raise ApplyFailed(f"cannot read Hub ingress configuration: {exc}")
    if result.returncode != 0:
        raise ApplyFailed("cannot read Hub ingress configuration: " + _last_line(result.stderr))
    try:
        hub = (json.loads(result.stdout).get("apps") or {}).get("hub")
    except (json.JSONDecodeError, AttributeError) as exc:
        raise ApplyFailed(f"cannot parse Hub ingress configuration: {exc}")
    if not hub:
        return set()
    mappings = []
    if hub.get("https_port") and hub.get("nginx_port"):
        mappings.append({"mode": "https", "listen": hub["https_port"],
                         "target": hub["nginx_port"]})
    if hub.get("http_port") and hub.get("redirect_port"):
        mappings.append({"mode": "http", "listen": hub["http_port"],
                         "target": hub["redirect_port"]})
    tokens = _apply_ingress("hub", {"serve_mappings": dict(enumerate(mappings))})
    active = {int(value[1]) for token in tokens
              if (value := _serve_token(token)) is not None and value[0] == "http"}
    # Hub is platform-owned rather than a ledger app. Preserve its existing
    # default-port retirement without sweeping any app or operator port.
    from importlib.machinery import SourceFileLoader
    prior = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        config = SourceFileLoader("hub_ingress_config", _airlock_config_argv()[-1]).load_module()
    finally:
        sys.dont_write_bytecode = prior
    default = config.APP_DEFAULTS["hub"].get("http_port")
    if (default and default not in active
            and f"http:{default}" not in (protected_ingress or set())
            and default not in recorded_active_ports(mode="http")):
        status = subprocess.run(["tailscale", "serve", "status", "--json"],
                                capture_output=True, text=True, check=False)
        if status.returncode == 0:
            try:
                listener = (json.loads(status.stdout).get("TCP") or {}).get(str(default))
            except (ValueError, AttributeError):
                listener = None
            if listener is not None and not listener.get("HTTPS"):
                if _run_command(["sudo", "tailscale", "serve", f"--http={default}", "off"],
                                "retire the prior Hub HTTP default") != 0:
                    raise ApplyFailed("prior Hub HTTP ingress retirement failed")
    return active


def _other_ingress(store: dict[str, dict[str, Any]], removed_ids: set[str]) -> set[str]:
    return {item for key, row in store.items() if key not in removed_ids
            for item in _recorded_artifacts(row) if _serve_token(item) is not None}


def _apply_run(app_id: str, source: dict[str, Any], store: dict[str, dict[str, Any]],
               start: dict[str, Any] | None, *, allow_restore: bool) -> int:
    """Steps 2-7 of apply, once, against one resolved source. `allow_restore`
    is False on the restore attempt itself: A4 runs the same apply ONCE more,
    never recursively, and a second failure is reported, not retried."""
    directory = source["dir"]
    unpacked = False
    if source["kind"] == "company":
        _ensure_mirror_object(source)
        _mirror_extract(Path(source["mirror"]), source["sha"], app_id, Path(directory))
        unpacked = True
    try:
        package = read_dir_package(app_id, directory)
    except LedgerError:
        # A manifest that will not parse is a refusal BEFORE any effect: undo
        # the unpack so a rejected first install leaves nothing behind.
        if unpacked and start is None:
            shutil.rmtree(directory, ignore_errors=True)
        raise
    hook = os.path.join(directory, "install.sh")
    before = _declared_paths(package)
    env = _current_config_env()
    env["AIRLOCK_CONFD"] = _conf_dir()
    env["AIRLOCK_ROOT"] = _repo_root()
    env["AIRLOCK_APP_DIR"] = directory
    env["AIRLOCK_APP_ID"] = app_id
    icon_dest = ""
    ingress: list[str] = []
    projection = tempfile.TemporaryDirectory(prefix=".package-info-", dir=_ensure_state_dir())
    try:
        info = subprocess.run([*_airlock_config_argv(), "package-info", app_id], env=env,
                              stdin=subprocess.DEVNULL, capture_output=True,
                              text=True, check=False)
        if info.returncode != 0:
            raise ApplyFailed("cannot read app configuration: " + _last_line(info.stderr))
        info_path = Path(projection.name) / "package-info.json"
        info_path.write_text(info.stdout, encoding="utf-8")
        env["AIRLOCK_PKG_INFO_FILE"] = str(info_path)
        try:
            result = subprocess.run(["bash", hook], cwd=directory, env=env,
                                    stdin=subprocess.DEVNULL, check=False)
        except OSError as exc:
            raise ApplyFailed(f"install hook for {app_id} could not start: {exc}")
        if result.returncode != 0:
            raise ApplyFailed(f"install hook for {app_id} exited {result.returncode}")
        icon_dest = _stage_icon(app_id, env)
        _apply_ingress(app_id, package, ingress)
        project(sorted(set(store) | {app_id}), env, set(ingress))
    except ApplyFailed as exc:
        # A4. One more apply against the (repo, commit) this app had when we
        # started — never recursively: a restore that fails too is reported,
        # not retried, and ③ is not touched on either path.
        if not allow_restore:
            log(f"residue {app_id}: {exc}")
            return 1
        log(f"{app_id}: {exc}")
        created = (_declared_paths(package) - before
                   | (set(ingress) - set(_recorded_artifacts(start))))
        residue = _remove_paths(created, protected_ingress=_other_ingress(store, {app_id}))
        if start is None:
            if source["kind"] == "company":
                shutil.rmtree(directory, ignore_errors=True)
            try:
                project(sorted(store))
            except ApplyFailed as projection_failure:
                residue.append(str(projection_failure))
            if residue:
                log(f"residue {app_id}: " + "; ".join(residue))
            else:
                log(f"rolled back the failed first install of {app_id}")
            return 1
        if not _is_git_url(start["repo"]):
            log(f"residue {app_id}: local source cannot reproduce recorded commit "
                f"{start.get('commit', '')}; failed apply was not retried")
            if residue:
                log(f"residue {app_id}: " + "; ".join(residue))
            return 1
        try:
            restore_rc = _apply_run(
                app_id, _source_from_row(app_id, start), load_installed(),
                start, allow_restore=False)
        except LedgerError as restore_failure:
            log(f"residue {app_id}: restore to {start.get('commit', '') or '(no commit)'} "
                f"failed: {restore_failure}")
            return 1
        if restore_rc != 0:
            # The restore ran and did NOT come back clean. It has already
            # printed its own `residue <id>: …` line; saying `restored` on top
            # of that would be the one false success this flow is allowed to
            # never print.
            log(f"residue {app_id}: restore to {start.get('commit', '') or '(no commit)'} "
                "did not complete")
            return 1
        if residue:
            restored = load_installed()
            restored[app_id]["artifacts"] = sorted(set(restored[app_id]["artifacts"]) | created)
            write_installed(restored)
            log(f"residue {app_id}: " + "; ".join(residue))
        log(f"restored {app_id} {start.get('commit', '')}")
        return 1
    finally:
        projection.cleanup()
    # EVERY declared path that exists now, not just the ones this run created:
    # ③ has to name every path removal may later take, and a path the operator
    # happened to have before the apply is still this app's declared artifact.
    # `before` exists for the opposite purpose — deciding what a FAILED first
    # install may delete (C11) — and must not narrow the record.
    artifacts = set(_declared_paths(package)) | set(ingress)
    if icon_dest:
        artifacts.add(os.path.join(_webroot(), icon_dest))
    if source["kind"] == "company":
        artifacts.add(directory)
    updated = dict(store)
    updated[app_id] = dict(start or {}, repo=source["repo"], commit=source["commit"],
                           artifacts=sorted(artifacts))
    stale = set(_recorded_artifacts(start)) - artifacts
    # A directory and a new claim on its contents still name the same owned
    # tree. Removing the old parent would erase the hook's successful result.
    stale = {old for old in stale if not old.startswith("/") or not any(
        new.startswith("/") and (new.startswith(old.rstrip("/") + "/")
                                 or old.startswith(new.rstrip("/") + "/"))
        for new in artifacts)}
    residue = _remove_paths(stale, protected_ingress=_other_ingress(store, {app_id}))
    if residue:
        # The new hook is running, but old owned resources still need retry.
        updated[app_id]["artifacts"] = sorted(artifacts | stale)
    write_installed(updated)
    if residue:
        log(f"residue {app_id}: " + "; ".join(residue))
        return 1
    return 0


def command_apply(app_id: str, info: dict[str, Any], explicit_source: str) -> int:
    _require_app_id(app_id)
    store = load_installed()
    if os.environ.get("AIRLOCK_DRY_RUN") == "1":
        log(f"[dry] would apply {app_id}")
        return 0
    fixture_boundary(engine_boundary_paths())
    start = store.get(app_id)
    source = resolve_source(app_id, info, explicit_source)
    return _apply_run(app_id, source, store, start, allow_restore=True)


def command_remove(app_id: str) -> int:
    _require_app_id(app_id)
    store = load_installed()
    row = store.get(app_id)
    if row is None:
        return 0
    dry = os.environ.get("AIRLOCK_DRY_RUN") == "1"
    if not dry:
        fixture_boundary(engine_boundary_paths())
    residue = _remove_paths(row.get("artifacts", []), dry, _other_ingress(store, {app_id}))
    if dry:
        return 1 if residue else 0
    if residue:
        log(f"residue {app_id}: " + "; ".join(residue))
        return 1
    remaining = {key: value for key, value in store.items() if key != app_id}
    try:
        project(sorted(remaining))
    except ApplyFailed as exc:
        residue.append(str(exc))
    if residue:
        log(f"residue {app_id}: " + "; ".join(residue))
        return 1
    write_installed(remaining)
    return 0


def _company_action(app_id: str, row: dict[str, Any], sha: str) -> str:
    mirror = company_mirror_path()
    commit = row.get("commit", "")
    if not isinstance(commit, str) or not commit:
        return "upgrade-diff"
    if _git(["-C", str(mirror), "cat-file", "-e", f"{commit}^{{commit}}"],
            "look up the recorded commit").returncode != 0:
        return "upgrade-diff"
    diff = _git(["-C", str(mirror), "diff", "--quiet", commit, sha,
                 "--", f"apps/{app_id}"], f"diff apps/{app_id}")
    return "reinstall" if diff.returncode == 0 else "upgrade-diff"


def command_plan_installed(info: dict[str, Any], json_output: bool = False) -> int:
    """Human `action<TAB>id`, or JSON pairs for machine consumers. The rule is
    the commit, not a tree digest: has apps/<id> changed between what we
    recorded and that row's source main right now."""
    store = load_installed()
    ids = sorted(set(store) | set(app_dirs(info)) | set(info.get("packages") or {}))
    plan = []
    for app_id in ids:
        row = store.get(app_id)
        if row is None:
            action = "fresh"
        elif _is_git_url(_recorded_repo(row)):
            sha = pin_main(dict(info, company_repo=row["repo"]))
            action = _company_action(app_id, row, sha)
        else:
            action = "reinstall"
        plan.append([action, app_id])
    if json_output:
        print(json.dumps(plan))
    else:
        for action, app_id in plan:
            print(f"{action}\t{app_id}")
    return 0


def command_list(json_output: bool = False) -> int:
    store = load_installed()
    if json_output:
        print(json.dumps(store, sort_keys=True))
        return 0
    for app_id, row in sorted(store.items()):
        commit = row.get("commit", "") if isinstance(row, dict) else ""
        print(f"{app_id}\trepo={_recorded_repo(row)}"
              f"\tcommit={commit or '-'}\tartifacts={len(_recorded_artifacts(row))}")
    return 0


def parse_cli(argv: list[str]) -> tuple[str, list[str], str, bool]:
    if not argv or argv[0] not in {"apply", "remove", "project", "list", "plan"}:
        fail("usage: airlock-ledger {apply|remove|project|list|plan} ...")
    command, positional, source = argv[0], [], ""
    json_output = False
    index = 1
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            positional.extend(argv[index + 1:])
            break
        elif argument == "--json" and command in {"list", "plan"}:
            json_output = True
        elif argument == "--source" or argument.startswith("--source="):
            if command != "apply" or source:
                fail("--source is accepted only once by apply")
            if argument == "--source":
                index += 1
                if index >= len(argv):
                    fail("--source requires one value")
                source = argv[index]
            else:
                source = argument.split("=", 1)[1]
            if not source:
                fail("--source requires one value")
        elif argument.startswith("-"):
            fail(f"unknown option: {argument}")
        else:
            positional.append(argument)
        index += 1
    expected = {"apply": 1, "remove": 1, "project": -1, "list": 0, "plan": 0}[command]
    if expected >= 0 and len(positional) != expected:
        fail(f"usage: airlock-ledger {command}" + (" <id>" if expected else ""))
    for app_id in positional:
        _require_app_id(app_id)
    return command, positional, source, json_output


def main(argv: list[str] | None = None) -> int:
    command, ids, source, json_output = parse_cli(list(sys.argv[1:] if argv is None else argv))
    if command == "remove":
        return command_remove(ids[0])
    if command == "list":
        return command_list(json_output)
    if command == "project":
        load_installed()
        if os.environ.get("AIRLOCK_DRY_RUN") != "1":
            fixture_boundary(engine_boundary_paths())
        project(ids or sorted(load_installed()))
        return 0
    info = read_package_info(ids if command == "apply" else None)
    if command == "apply":
        return command_apply(ids[0], info, source)
    return command_plan_installed(info, json_output)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (LedgerError, ApplyFailed) as exc:
        die(str(exc))
