#!/usr/bin/env bash
# airlock-teardown <app-id> — remove the artifacts recorded for one app.
# The ledger owns the installed-state grammar and removal behavior.
# Honours AIRLOCK_DRY_RUN=1 (prints the plan, changes nothing).
#
# `--platform-secret-timer` is deliberately separate from app teardown. Removing the
# platform sweep when one consumer is removed would violate the store TTL for every other
# consumer; this explicit mode is the symmetric exit for the platform-owned unit itself.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=/dev/null
. "$ROOT/install/lib.sh"

if [ "${1:-}" = --platform-secret-timer ]; then
  [ "$#" -eq 1 ] \
    || die "usage: airlock-teardown <app-id> | --platform-secret-timer"
  AIRLOCK_ROOT="$ROOT" bash "$ROOT/install/airlock-secret-timer.sh" uninstall
  log "teardown complete: platform secret timer"
  exit 0
fi

[ $# -eq 1 ] \
  || die "usage: airlock-teardown <app-id> | --platform-secret-timer"
require_cmd python3
python3 "$ROOT/bin/airlock-ledger" remove "$1"
log "teardown complete: '$1' (recorded artifacts removed)"
