#!/usr/bin/env bash
# bin/airlock-update — update an installed Airlock to the released tree, then re-run
# the installer over it.
#
#   bash bin/airlock-update              # update ~/workspace/airlock (or this checkout)
#   bash bin/airlock-update --dry-run    # show what would change; change nothing
#   bash bin/airlock-update --no-install # replace the files, skip the reinstall
#   bash bin/airlock-update --rollback   # restore the last failed update
#   bash bin/airlock-update --machine m  # name the Linux machine instead of detecting it
#   bash bin/airlock-update --from-unknown  # a box no published release can identify
#                                           # (installed before 2026-08-21): see below
#
# It also runs with no checkout in hand, which is how the FIRST update happens — the
# installed tree predates this file, so there is nothing to invoke locally:
#
#   curl -fsSL https://raw.githubusercontent.com/spacewalk-labs/airlock/main/bin/airlock-update | bash
#
# ---------------------------------------------------------------------------------
# Why this is not `git pull`.
#
# The documented install (and every box that followed it) does `git clone --depth=1`,
# then `rm -rf .git`, then `git init` — deliberately, so the operator owns their copy
# and can commit their own config. The consequence is that no installed box has a
# remote pointing here, and the history it does have shares no commit with ours. So
# `git pull` has nothing to pull, and `git merge --allow-unrelated-histories` resolves
# against an EMPTY merge base, which makes a conflict out of every file that changed
# on either side. Neither is an update path.
#
# What works is that a git tree is content-addressed independently of history:
# `git checkout <ref> -- .` writes a tree into the working copy and does not care
# whether the ref is an ancestor. So this fetches the release, writes it over the
# checkout, and commits the result to the operator's OWN repository — which is what
# records the applied release. Local edits are kept in a private tar archive,
# without adding an operator snapshot commit to this repository.
#
# The executable program is inside one outer function, called on the last line. A
# `curl | bash` that is cut off mid-transfer then runs NOTHING instead of running the
# first half: bash executes what it has read so far, and a truncated outer function is
# a syntax error, not a partial update. (Measured: an earlier draft, truncated,
# replaced every file and exited 0 without committing or re-running the installer.)
# ---------------------------------------------------------------------------------
set -uo pipefail

airlock_update_program() {
main() {
  # Internal state never comes from an ambient caller.
  unset AIRLOCK_UPDATE_KEEPER_PID
  local RELEASE_URL="${AIRLOCK_RELEASE_URL:-https://github.com/spacewalk-labs/airlock}"
  local RELEASE_REF="${AIRLOCK_RELEASE_REF:-main}"
  # A remote of our own, so we never touch `origin` — on an installed box that is the
  # operator's private repository and the only copy of their edits.
  local RELEASE_REMOTE=airlock-release
  # The install guide pins this location; it is the fallback when the script is piped
  # in from curl and has no checkout around it to infer from.
  local DEFAULT_DIR="${AIRLOCK_DIR:-$HOME/workspace/airlock}"
  # Present after every install, before and after the ledger existed (the webroot,
  # install/airlock-install.sh). Version-independent, which is the point: the boxes
  # this has to recognise were installed by code that no longer exists here.
  local MACHINE_MARKER=/opt/airlock/hub

  local -a original_argv=("$@")
  local dry=0 do_install=1 rollback=0 machine="" from_unknown=0 unknown_hint=0
  while [ $# -gt 0 ]; do
    case "$1" in
    --dry-run)    dry=1 ;;
    --json)       AIRLOCK_UPDATE_JSON=1 ;;
      --no-install) do_install=0 ;;
      --from-unknown) from_unknown=1 ;;
      --rollback)   rollback=1 ;;
      --machine)    shift; [ $# -gt 0 ] || die "--machine 뒤에 머신 이름이 필요합니다"; machine="$1" ;;
      --machine=*)  machine="${1#--machine=}" ;;
      -h|--help)    usage; return 0 ;;
      *)            die "모르는 옵션: $1" ;;
    esac
    shift
  done
  if [ "$rollback" = 1 ] && { [ "$dry" = 1 ] || [ "$do_install" = 0 ] || [ "$from_unknown" = 1 ]; }; then
    die "--rollback 은 --dry-run·--no-install·--from-unknown 과 함께 쓸 수 없습니다"
  fi
  if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ] && [ "$dry" != 1 ]; then
    die "--json 은 --dry-run 과 함께만 쓸 수 있습니다"
  fi
  local ROOT="" record_engine=""
  if [ -n "${AIRLOCK_DIR:-}" ]; then
    # An explicit path wins over everything: the operator is telling us where it is.
    is_checkout "$AIRLOCK_DIR" && ROOT="$AIRLOCK_DIR"
  else
    local _src="${BASH_SOURCE[0]:-}" _here _cand
    if [ -n "$_src" ] && [ -f "$_src" ]; then
      _here="$(cd "$(dirname "$_src")" && pwd)"
      _cand="$(cd "$_here/.." && pwd)"
      is_checkout "$_cand" && ROOT="$_cand"
    fi
    [ -n "$ROOT" ] || { is_checkout "$DEFAULT_DIR" && ROOT="$DEFAULT_DIR"; }
  fi

  if [ -z "$ROOT" ]; then
    die "Airlock 설치본을 찾지 못했습니다.
       찾은 곳: $DEFAULT_DIR
       다른 곳에 있으면 그 경로를 알려 주세요:  AIRLOCK_DIR=/경로 bash bin/airlock-update"
  fi

  # AIRLOCK_FIXTURE_BOUNDARY_CALL — the regression fixture mutates this exact call.
  fixture_boundary "$ROOT" "$dry" "$machine" \
    || die "unsafe fixture execution refused before live effects"

  command -v git >/dev/null 2>&1 \
    || die "git 이 없습니다. 맥이면 터미널에서 'xcode-select --install' 을 한 번 실행하세요."

  if [ "$dry" != 1 ]; then
    # If this run is hosted inside the very unit it is about to stop (an agent
    # session under airlock-paseo.service is the everyday case), move out of
    # that cgroup first so it survives the restart it is about to ask for. The
    # installer this update calls at the end (step 7) takes its own ledger
    # lock (A1) once it starts; nothing to acquire here beforehand.
    airlock_escape_selfkill_cgroup "$0" "${original_argv[@]}"
  fi

  cd "$ROOT" || die "$ROOT 로 들어가지 못했습니다"
  ROOT="$(pwd -P)"
  trap release_update_mutex EXIT
  say "대상: $ROOT"

  if [ "$rollback" = 1 ]; then
    [ -d .git ] || die "되돌릴 업데이트 기록이 없습니다 (.git 없음)"
    rollback_update "$ROOT" "$machine" "$MACHINE_MARKER"
    return $?
  fi

  # ---------------------------------------------------------------- 1) 저장소
  #
  # Scratch isolates preview metadata and frozen installer inputs.
  local scratch scratch_created
  scratch_created="$(mktemp -d)" \
    || die "업데이트용 비공개 임시 디렉터리를 만들지 못했습니다"
  scratch="$(canonical_private_scratch "$scratch_created")" || {
    rmdir -- "$scratch_created" 2>/dev/null || true
    die "업데이트용 임시 디렉터리를 안전한 절대 경로로 고정하지 못했습니다"
  }
  # shellcheck disable=SC2064   # $scratch must expand now, not at trap time
  trap "release_update_mutex; rm -rf '$scratch'" EXIT
  if [ "$dry" = 1 ] && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    local source_git_dir="" source_common_dir="" preview_git_dir="$scratch/preview.git"
    source_git_dir="$(git -C "$ROOT" rev-parse --path-format=absolute --git-dir 2>/dev/null)" \
      || die "미리보기에서 원본 Git 메타데이터 경로를 읽지 못했습니다"
    source_common_dir="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
      || die "미리보기에서 공통 Git 메타데이터 경로를 읽지 못했습니다"
    acquire_update_mutex "$source_common_dir"
    mkdir -p "$preview_git_dir" \
      || die "미리보기용 임시 Git 메타데이터 디렉터리를 만들지 못했습니다"
    if ! tar -C "$source_common_dir" --exclude=objects -cf - . \
      | tar -C "$preview_git_dir" -xf -; then
      die "미리보기용 임시 Git 메타데이터를 복제하지 못했습니다"
    fi
    if [ "$source_git_dir" != "$source_common_dir" ]; then
      cp -- "$source_git_dir/HEAD" "$preview_git_dir/HEAD" \
        || die "미리보기용 worktree HEAD 를 고정하지 못했습니다"
      if [ -f "$source_git_dir/index" ]; then
        cp -- "$source_git_dir/index" "$preview_git_dir/index" \
          || die "미리보기용 worktree index 를 고정하지 못했습니다"
      else
        rm -f -- "$preview_git_dir/index"
      fi
      if [ -f "$source_git_dir/config.worktree" ]; then
        cp -- "$source_git_dir/config.worktree" "$preview_git_dir/config.worktree" \
          || die "미리보기용 worktree config 를 고정하지 못했습니다"
      fi
      rm -f -- "$preview_git_dir/commondir"
    fi
    mkdir -p "$preview_git_dir/objects" \
      || die "미리보기용 임시 Git 메타데이터를 복제하지 못했습니다"
    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_common_dir/objects"
    export GIT_DIR="$preview_git_dir" GIT_WORK_TREE="$ROOT"
  fi
  if [ ! -d .git ]; then
    if [ "$dry" = 1 ]; then
      # A preview must not create a repository in someone's directory, but every
      # comparison below is a git operation. So the preview gets a THROWAWAY git
      # directory pointed at their files: the index and objects land in $scratch and
      # their tree is never written to. An earlier draft just skipped `git init` here
      # and then ran `git remote add` in a non-repository, so --dry-run died on
      # exactly the boxes it existed for — and three tests passed anyway, because the
      # failure and the intended behaviour look identical from outside (nothing
      # changed).
      say "[미리보기] 이 폴더는 아직 git 저장소가 아닙니다 — 임시 저장소로 비교만 합니다."
      export GIT_DIR="$scratch/preview.git" GIT_WORK_TREE="$ROOT"
      git init -q 2>/dev/null || git init -q --bare 2>/dev/null \
        || die "미리보기용 임시 Git 저장소를 만들지 못했습니다"
      git add -A 2>/dev/null || die "미리보기에서 현재 파일 상태를 읽지 못했습니다"
    else
      say "이 폴더는 아직 git 저장소가 아닙니다 — 배포본 기록용으로 만듭니다."
      git init -q -b main 2>/dev/null || git init -q
    fi
  fi

  local git_dir git_common_dir recovery_dir
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)" \
    || die "git 메타데이터 경로를 읽지 못했습니다"
  git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "공통 git 메타데이터 경로를 읽지 못했습니다"
  local installed_head=""
  git rev-parse --verify -q HEAD >/dev/null 2>&1 \
    && installed_head="$(git rev-parse HEAD)"
  if [ -z "${AIRLOCK_UPDATE_KEEPER_PID:-}" ]; then
    acquire_update_mutex "$git_common_dir"
  fi
  recovery_dir="$git_dir/airlock-update-rollback"
  if [ "$dry" != 1 ] && [ -e "$recovery_dir" ]; then
    die "끝나지 않은 업데이트 복구 기록이 있습니다.
       먼저 되돌리십시오:  AIRLOCK_DIR=\"$ROOT\" bash \"$recovery_dir/airlock-update\" --rollback"
  fi
  if [ "$dry" != 1 ] && git show-ref --verify -q refs/airlock-update/rollback; then
    die "다른 linked worktree의 끝나지 않은 업데이트 복구 ref가 있습니다.
       해당 worktree의 airlock-update --rollback 을 먼저 완료하십시오"
  fi

  # ---------------------------------------------------------------- 2) 배포본 받기
  #
  # Deliberately NOT `--depth=1`. A shallow fetch writes .git/shallow and marks the
  # OPERATOR's repository shallow permanently, changing how their own clones, gc and
  # later fetches behave — a lasting side effect on their property in exchange for
  # nothing, since the release repository is a squashed mirror only a few commits deep.
  say "최신 배포본을 받는 중… ($RELEASE_URL, $RELEASE_REF)"
  if git remote get-url "$RELEASE_REMOTE" >/dev/null 2>&1; then
    git remote set-url "$RELEASE_REMOTE" "$RELEASE_URL" || die "remote 를 고치지 못했습니다"
  else
    git remote add "$RELEASE_REMOTE" "$RELEASE_URL" || die "remote 를 추가하지 못했습니다"
  fi
  git fetch -q "$RELEASE_REMOTE" "$RELEASE_REF" \
    || die "배포본을 받지 못했습니다 — 인터넷 연결을 확인해 주세요. (레포는 공개라 로그인은 필요 없습니다)"
  local new; new="$(git rev-parse --verify 'FETCH_HEAD^{commit}')" \
    || die "받은 내용을 commit 으로 읽지 못했습니다"
  local direction direction_rc
  direction="$(release_direction "$new" "$installed_head" "$RELEASE_REF" "$RELEASE_URL" "$scratch/installed-release")"
  direction_rc=$?
  case "$direction" in
    rollback)
      say "받은 배포본은 현재 설치본보다 뒤입니다 — 업데이트 감지에는 표시하지 않습니다."
      if [ "$dry" = 1 ]; then
        [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
          || emit_update_json 0 0 "$new" \
          || die "업데이트 감지 JSON을 만들지 못했습니다"
        return 0
      fi
      ;;
    ambiguous)
      say "받은 배포본이 현재 설치본보다 앞서는지 확인하지 못했습니다."
      if [ "$dry" = 1 ]; then
        # A semantic ambiguity (for example a release naming another source) is a
        # measured non-update. Missing provenance is not: the daily collector must
        # keep its last complete value and old checkedAt instead of replacing it with
        # a fresh-looking zero.
        if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ] && [ "$direction_rc" -ne 0 ]; then
          die "배포본 방향을 재는 로컬 Git 증거가 없어 이전 감지값을 유지합니다."
        fi
        [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
          || emit_update_json 0 0 "$new" \
          || die "업데이트 감지 JSON을 만들지 못했습니다"
        return 0
      fi
      ;;
    unknown)
      # The public history starts at 2026-08-21; a box installed from an earlier tree
      # matches no release that exists now, so no evidence can say forward or back.
      # A person who has seen the preview can say it; the daily detector cannot.
      if [ "$from_unknown" = 1 ]; then
        say "--from-unknown: 어느 배포본에서 설치했는지 모르는 박스를 운영자 확인으로 갱신합니다."
      else
        say "이 설치본은 지금 공개된 어떤 배포본과도 파일이 일치하지 않아, 받은 배포본이 더 새것인지 확인할 수 없습니다."
        say "공개 이력이 시작된 2026-08-21 이전에 설치한 박스라면 정상입니다."
        if [ "$dry" = 1 ]; then
          if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
            emit_update_json 0 0 "$new" || die "업데이트 감지 JSON을 만들지 못했습니다"
            return 0
          fi
          unknown_hint=1

        fi
      fi ;;
    same|forward) ;;
    *) say "배포본 방향 판정값: $direction" ;;
  esac

  # ---------------------------------------------------------------- 3) 무엇이 바뀌나
  #
  # `-c core.quotePath=false` on every listing: without it git renders non-ASCII names
  # as octal escapes, and the one message that names the OPERATOR's OWN files is
  # exactly where that is least acceptable.
  local release_paths diff_paths tracked_paths changed_list changed stale retired="" installed_release=""
  release_paths="$(git -c core.quotePath=false ls-tree -r --name-only "$new" | sort)" \
    || die "받은 배포본의 파일 목록을 읽지 못했습니다"
  # Restricted to paths the RELEASE carries. Without that intersection the operator's
  # own tracked files read as differences and the script could never report an
  # up-to-date box — it would claim work to do forever.
  diff_paths="$(git -c core.quotePath=false diff --name-only "$new" -- . 2>/dev/null | sort)" \
    || die "현재 파일과 받은 배포본의 차이를 재지 못했습니다"
  changed_list="$(comm -12 <(printf '%s\n' "$diff_paths") \
    <(printf '%s\n' "$release_paths"))" \
    || die "바뀔 파일 목록을 계산하지 못했습니다"
  changed="$(awk 'NF { count++ } END { print count + 0 }' <<<"$changed_list")" \
    || die "바뀔 파일 수를 계산하지 못했습니다"
  # Only the identified previous release establishes source ownership. Operator
  # paths absent from both releases remain theirs; retired public source must leave
  # the checkout, otherwise catalogue discovery resurrects removed apps.
  installed_release="$(cat "$scratch/installed-release")"
  if [ -n "$installed_release" ]; then
    retired="$(comm -23 <(git -c core.quotePath=false ls-tree -r --name-only "$installed_release" | sort) \
                         <(printf '%s\n' "$release_paths"))" \
      || die "이전 배포본에서 사라진 파일 목록을 계산하지 못했습니다"
  fi
  tracked_paths="$(git -c core.quotePath=false ls-files | sort)" \
    || die "현재 checkout의 파일 목록을 읽지 못했습니다"
  stale="$(comm -23 <(printf '%s\n' "$tracked_paths") \
                    <(printf '%s\n' "$release_paths") 2>/dev/null)" \
    || die "배포본에 없는 기존 파일 목록을 계산하지 못했습니다"
  stale="$(comm -23 <(printf '%s\n' "$stale") <(printf '%s\n' "$retired"))"
  changed_list="$(printf '%s\n%s\n' "$changed_list" "$retired" | sort -u)"
  changed="$(awk 'NF { count++ } END { print count + 0 }' <<<"$changed_list")"

  # An older .gitignore can hide a file the release will overwrite. Include
  # these paths in the private file archive alongside uncommitted edits.
  local at_risk=""
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || continue
    git ls-files --error-unmatch -- "$p" >/dev/null 2>&1 && continue
    at_risk="$at_risk$p"$'\n'
  done <<EOF
$release_paths
EOF

  if [ "$direction" = same ]; then
    say "이미 같은 배포본입니다 — 새 업데이트가 아닙니다."
    [ "$dry" != 1 ] || {
      [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
        || emit_update_json 0 0 "$new" \
        || die "업데이트 감지 JSON을 만들지 못했습니다"
      return 0
    }
  fi

  if [ "$changed" = 0 ]; then
    say "이미 최신입니다 — 바뀔 파일이 없습니다."
    [ "$do_install" = 1 ] || return 0
  else
    say "바뀔 파일 $changed 개:"
    report_list "$changed_list"
  fi
  if [ -n "$stale" ]; then
    say "배포본에 없는 파일 $(printf '%s' "$stale" | grep -c .) 개 — 지우지 않고 그대로 둡니다:"
    report_list "$stale"
  fi
  if [ -n "$retired" ]; then
    say "이전 공개 배포본에서 사라진 파일은 보관 뒤 제거합니다:"
    report_list "$retired"
  fi
  if [ -n "$at_risk" ]; then
    say "이 폴더의 .gitignore 가 가려 두었지만 배포본이 덮어쓸 파일 $(printf '%s' "$at_risk" | grep -c .) 개 — 되돌릴 수 있도록 먼저 기록합니다:"
    report_list "$at_risk"
  fi

  # ---------------------------------------------------------------- 3b) 설정 사전 검사
  #
  # The installer validates airlock.toml with the NEW release's rules — after the files
  # are already overwritten. A key the release retired (markwand became fileview on
  # 2026-08-23) then stops it with the new tree on disk and the old services running,
  # and a box old enough to hit that has no bin/airlock-status, so no rollback is armed.
  # Ask the same validator the same question first. Linux only: on a Mac the installer
  # runs inside the machine, with its own Python and its own copy of the config. No
  # changed file, no mixed box: a reinstall over the same tree needs no preflight.
  if [ "$(platform)" != Darwin ] && [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
     && [ "$changed" != 0 ] && { [ "$dry" = 1 ] || [ "$do_install" = 1 ]; }; then
    local preflight="$scratch/preflight" config_check="" config_rc=0
    mkdir -p "$preflight" && git archive "$new" | tar -x -C "$preflight" \
      || die "새 배포본의 설정 검사기를 꺼내지 못했습니다"
    config_check="$(cd "$ROOT" && python3 "$preflight/bin/airlock-config" validate 2>&1)" \
      || config_rc=$?
    if [ "$config_rc" != 0 ]; then
      say "airlock.toml 이 새 배포본의 설정 검사를 통과하지 못합니다 — 설치기가 여기서 멈춥니다:"
      printf '%s\n' "$config_check" | sed 's/^/         /'
      if [ "$dry" != 1 ]; then
        die "설정을 먼저 고친 뒤 다시 실행하세요. 아무것도 바꾸지 않았습니다.
       (airlock.toml.example 이 새 형식입니다. 파일만 먼저 바꾸려면 --no-install)"
      fi
    fi
  fi

  if [ "$dry" = 1 ]; then
    if [ "$unknown_hint" = 1 ]; then
      say "위 내용이 맞으면 --from-unknown 을 붙여 실행하세요:  bash bin/airlock-update --from-unknown"
      say "  (curl 로 받았다면:  curl -fsSL https://raw.githubusercontent.com/spacewalk-labs/airlock/main/bin/airlock-update | bash -s -- --from-unknown)"
    fi
    say "[미리보기] 여기까지입니다. 아무것도 바꾸지 않았습니다."
    if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
      emit_update_json "$([ "$changed" -gt 0 ] && printf 1 || printf 0)" \
        "$changed" "$new" || die "업데이트 감지 JSON을 만들지 못했습니다"
    fi
    return 0
  fi

  # ---------------------------------------------------------------- 4) 머신 확인
  #
  # BEFORE anything is written. Detection can fail (no machine, two machines, orb not
  # running), and failing after the overwrite leaves the worst state of all: a new
  # checkout against an old install, which is neither the version they had nor the one
  # they asked for.
  if [ "$do_install" = 1 ] && [ "$(platform)" = Darwin ]; then
    machine="$(resolve_machine "$machine" "$MACHINE_MARKER")" || return 1
  fi

  # ---------------------------------------------------------------- 5) 로컬 파일 보관
  # Preserve overwritten local bytes outside Git history. A snapshot commit used
  # to turn every update into an unpublished operator commit (and git pull then
  # advanced from those commits). Only the release commit below belongs on HEAD.
  local files_backup=""
  if [ -n "$(git status --porcelain 2>/dev/null)" ] || [ -n "$at_risk" ] || [ -n "$retired" ]; then
    files_backup="$(mktemp -d "$git_dir/airlock-update-files.XXXXXX")" \
      || die "로컬 파일 보관 디렉터리를 만들지 못했습니다"
    local_files save "$ROOT" "$files_backup" "$new" "$installed_release" \
      || die "로컬 파일을 보관하지 못했습니다"
    # Save the same restoration function for manual checkout recovery after an
    # update replaces this script. No second implementation or snapshot commit.
    { printf '#!/usr/bin/env bash\n'; declare -f local_files;
      printf 'local_files restore "$1" "$(dirname "$0")"\n';
    } >"$files_backup/restore.sh" || die "파일 복원 명령을 보존하지 못했습니다"
    chmod 0600 "$files_backup/restore.sh" || die "파일 복원 명령 권한을 좁히지 못했습니다"
    say "로컬 파일 보관: $files_backup/files.tar"
    local restore_files
    printf -v restore_files 'bash %q %q' "$files_backup/restore.sh" "$ROOT"
    say "checkout 을 되돌린 뒤 로컬 편집 복원: $restore_files"
  fi

  local before=""
  git rev-parse --verify -q HEAD >/dev/null 2>&1 && before="$(git rev-parse HEAD)"

  # ---------------------------------------------------------------- 5b) 복구 기준점
  #
  # A tree revision alone is not a healthy-box snapshot.  The previous version did
  # print one, but reset + a failing old installer merely trades one mixed box for a
  # different mixed box.  Arm rollback only from a status run that inspected every
  # check (rc 0, never rc 3), and freeze the exact config + installed-state records
  # that the old installer will converge from.
  local rollback_ready=0 config_receipt="" config_path="" rollback_state_dir="" status_rc=0 runtime_root="$ROOT"
  if [ "$do_install" = 1 ] && [ -f bin/airlock-status ]; then
    say "업데이트 전 상태를 확인하는 중…"
    # 🔴 The CALLER creates this file. `airlock-config install-snapshot` opens it with
    # O_WRONLY|O_TRUNC|O_NOFOLLOW and deliberately WITHOUT O_CREAT, so that it can never
    # become a general write primitive — it freezes bytes into a file you already own and
    # refuses everything else. Its two other callers honour that (install/airlock-install.sh
    # uses `mktemp`, bin/airlock-backup uses `touch(mode=0o600)`); this one passed a path
    # inside a `mktemp -d` directory that nothing had ever created, so `os.open` raised
    # ENOENT and EVERY real update died here, fail-closed, before changing anything.
    # Only real ones: --dry-run returns above this block and --no-install never enters it,
    # which is the whole reason it reached a release (measured 2026-09-01, reproduced 100%).
    #
    # `set -C` is the point of the subshell, not tidiness: it opens with O_EXCL, so a path
    # that already exists as ANYTHING — including a symlink someone raced into place — fails
    # here instead of being followed. That is the same refusal O_NOFOLLOW makes on the callee
    # side, kept on this side too rather than assumed from the 0700 mktemp directory.
    # `umask 077` gives it 0600 from birth instead of widening then narrowing.
    ( umask 077; set -C; : >"$scratch/config.snapshot" ) \
      || die "업데이트 전 설정을 담을 파일을 만들지 못했습니다: $scratch/config.snapshot"
    config_receipt="$(python3 bin/airlock-config install-snapshot "$scratch/config.snapshot")" \
      || die "업데이트 전 설정을 고정하지 못했습니다"
    config_path="$(printf '%s' "$config_receipt" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["config_path"])')" \
      || die "고정한 설정 경로를 읽지 못했습니다"
    case "$config_path" in *$'\n'*|*$'\r'*) die "설정 경로에 줄바꿈이 있어 안전하게 기록할 수 없습니다" ;; esac
    # Preserve the release's state reader before replacing the target checkout.
    # An older target has no snapshot API; rollback must keep this reader after
    # resetting that checkout to its old bytes as well.
    record_engine="$scratch/airlock-ledger"
    git show "$new:bin/airlock-ledger" >"$record_engine" \
      || die "설치 기록을 읽는 배포본 모듈을 보존하지 못했습니다"
    chmod 0600 "$record_engine" || die "설치 기록 모듈을 보호하지 못했습니다"
    snapshot_box_state "$ROOT" "$machine" "$scratch" \
      || die "업데이트 전 설치 상태를 보존하지 못했습니다"
    rollback_state_dir="$(cat "$scratch/state-dir")" \
      || die "고정한 설치 상태 경로를 읽지 못했습니다"
    if [ "$(platform)" != Darwin ]; then
      local previous_root
      previous_root="$(systemctl --user show airlock-update-detect.service -p WorkingDirectory --value 2>/dev/null || true)"
      # The operator checkout can lag the checkout its installed units run.
      # Measure and restore that actual installation, not an unused old reader.
      runtime_root="$(installed_record "$record_engine" runtime-root "$scratch/install-record.json" "$previous_root" "$ROOT")" \
        || die "업데이트 전 실행 경로를 읽지 못했습니다"
    fi
    box_status "$runtime_root" "$machine" "$rollback_state_dir" "$config_path" \
      >"$scratch/status-before.json"; status_rc=$?
    [ "$status_rc" = 0 ] \
      || die "업데이트 전 상태가 완전히 확인되지 않아 설치를 시작하지 않습니다 (airlock-status rc=$status_rc).
       rc=3 도 정상으로 보지 않습니다. 위 상태 출력을 해결한 뒤 다시 실행하세요."
    box_state_matches "$ROOT" "$machine" "$scratch" \
      || die "업데이트 전 상태 확인 중 설치 기록이 달라져 시작하지 않습니다 — 다른 Airlock 실행이 끝난 뒤 다시 시도하세요."
    if [ -f "${BASH_SOURCE[0]:-}" ]; then
      cp "${BASH_SOURCE[0]}" "$scratch/airlock-update" \
        || die "복구 명령을 보존하지 못했습니다"
    else
      git show "$new:bin/airlock-update" >"$scratch/airlock-update" \
        || die "복구 명령을 배포본에서 보존하지 못했습니다"
    fi
    chmod 0600 "$scratch/airlock-update" || die "복구 명령을 보호하지 못했습니다"
    rollback_ready=1
  elif [ "$do_install" = 1 ]; then
    say "주의: 이 설치본에는 bin/airlock-status 가 없어 자동 롤백 기준점을 만들 수 없습니다."
  fi

  if [ "$rollback_ready" = 1 ] && [ -z "$before" ]; then
    rollback_ready=0
    say "기존 Git revision 이 없어 자동 롤백은 제공하지 않습니다. 로컬 파일 보관본은 남겨 둡니다."
  fi

  # Put the recovery record in place BEFORE changing the checkout.  Until the new
  # revision is known its phase is deliberately not auto-runnable: an interruption
  # leaves an explicit, inspectable record and a pinned before commit instead of a
  # mixed checkout with no explanation of how it got there.
  if [ "$rollback_ready" = 1 ]; then
    arm_recovery "$recovery_dir" "$scratch" "$before" \
      "$config_path" "$(platform)" "$machine" "$files_backup" "$runtime_root"
  fi

  # ---------------------------------------------------------------- 6) 덮어쓰기
  #
  # `-- .` writes every path the release carries and touches nothing else, so files the
  # operator added stay. `airlock.toml` at the root is in .gitignore on BOTH sides and
  # in no tree, so it is never a candidate — but note that is a statement about that
  # one path, not about the name: the release does carry
  # examples/app-package/airlock.toml, which is why the at-risk pass above exists.
  local undo_command
  undo_command="$(checkout_undo_command "$ROOT" "$before" "$files_backup")"
  say "파일을 배포본으로 맞추는 중… (checkout 복원: $undo_command)"
  git checkout "$new" -- . || die "파일을 바꾸지 못했습니다 (아무것도 안 바뀌었을 수 있습니다)"
  if [ -n "$retired" ]; then
    # Use the same node-aware file implementation as recovery. It never follows
    # an operator's replacement parent link or recursively deletes their directory.
    local_files retire "$ROOT" "$files_backup" "$installed_release" "$new" \
      || die "사라진 공개 소스를 제거하지 못했습니다 (복원: $undo_command)"
  fi
  # A path this box tracks, the release no longer carries, AND the release's own
  # .gitignore now declares ignored: that combination is the release saying "this is
  # box state, not source". Drop it from the index and KEEP THE FILE — `git add -A`
  # below would otherwise leave it tracked forever (a newly ignored path that is
  # already tracked stays tracked), and the box's checkout stays permanently dirty.
  # That is how airlock.lock, a machine-written per-box approval record, kept every
  # installed clone dirty after it rode in with a box commit (#659): the hourly
  # canonical-clone sweep skips dirty clones, so those clones went quietly stale.
  # These paths have no previous-public ownership; keep their operator bytes.
  if [ -n "$stale" ]; then
    local _untrack_path
    while IFS= read -r _untrack_path; do
      [ -n "$_untrack_path" ] || continue
      # --no-index: `git check-ignore` refuses to call a TRACKED path ignored, and
      # every path here is tracked by definition. Without it the loop never fires.
      git check-ignore -q --no-index -- "$_untrack_path" || continue
      git rm --cached --quiet -- "$_untrack_path" \
        || die "배포본이 박스 상태로 선언한 $_untrack_path 을(를) 추적에서 빼지 못했습니다"
      say "박스 상태로 선언된 $_untrack_path — 파일은 그대로 두고 추적에서만 뺍니다"
    done <<<"$stale"
  fi
  git add -A || die "배포본 파일을 기록 대상으로 올리지 못했습니다"
  commit_release_or_die "airlock-update: 배포본 ${new:0:12} 으로 갱신" "$before" "$ROOT" "$files_backup"
  local after="" update_rc=0
  after="$(git rev-parse HEAD)" || die "갱신 뒤 revision 을 읽지 못했습니다"
  if [ "$rollback_ready" = 1 ]; then
    activate_recovery "$recovery_dir" "$after"
  fi
  say "갱신했습니다."
  [ -n "$before" ] && say "되돌리려면:  $undo_command"

  [ "$do_install" = 1 ] || { say "설치기는 건너뜁니다 (--no-install)."; return 0; }

  # ---------------------------------------------------------------- 7) 설치기 재실행
  #
  # Note what `reset --hard` does and does not undo: it restores THIS CHECKOUT. It does
  # not roll back what the installer did inside the Linux machine — /opt/airlock, the
  # user units, the rendered nginx config, the package versions. Undoing the files and
  # re-running the installer is what returns the box, and the message above is worded
  # for the checkout because that is what it actually restores.
  if [ "$(platform)" != Darwin ]; then
    say "설치기를 다시 돌립니다…"
    AIRLOCK_CONFIG="$config_path" bash install/airlock-install.sh || update_rc=$?
  else
    say "설치기를 다시 돌립니다 (머신: $machine)…"
    say "설치 중 경고가 여러 줄 나올 수 있습니다 — 마지막의 Entrance 주소가 나오면 성공입니다."
    # The host checkout and Orb VM are distinct live boxes.
    AIRLOCK_MACHINE="$machine" bash docker/orbstack-machine-setup.sh || update_rc=$?
  fi

  if [ "$rollback_ready" != 1 ]; then
    return "$update_rc"
  fi

  if [ "$update_rc" != 0 ]; then
    if capture_failed_state "$ROOT" "$machine" "$recovery_dir"; then
      printf '%s\n' failed >"$recovery_dir/phase"
    else
      printf '%s\n' failed-unbound >"$recovery_dir/phase"
    fi
    box_status "$ROOT" "$machine" "$rollback_state_dir" "$config_path" \
      >"$recovery_dir/status-after-failure.json" 2>/dev/null || true
    record_update_event "$git_dir" update-failed "$before" "$after" "$update_rc"
    say "설치가 실패했습니다 (rc=$update_rc). 이전 상태는 보존돼 있습니다."
    say "되돌리기:  AIRLOCK_DIR=\"$ROOT\" bash \"$recovery_dir/airlock-update\" --rollback"
    return "$update_rc"
  fi

  box_status "$ROOT" "$machine" "$rollback_state_dir" "$config_path" \
    >"$recovery_dir/status-after.json"; status_rc=$?
  if [ "$status_rc" != 0 ]; then
    if capture_failed_state "$ROOT" "$machine" "$recovery_dir"; then
      printf '%s\n' failed >"$recovery_dir/phase"
    else
      printf '%s\n' failed-unbound >"$recovery_dir/phase"
    fi
    record_update_event "$git_dir" update-status-failed "$before" "$after" "$status_rc"
    say "설치는 끝났지만 상태 검증이 통과하지 못했습니다 (airlock-status rc=$status_rc)."
    say "rc=3 은 확인하지 못한 항목이 있으므로 성공이 아닙니다."
    say "되돌리기:  AIRLOCK_DIR=\"$ROOT\" bash \"$recovery_dir/airlock-update\" --rollback"
    return "$status_rc"
  fi

  record_update_event "$git_dir" update-ok "$before" "$after" 0
  git update-ref -d refs/airlock-update/rollback "$before" \
    || die "성공한 업데이트의 복구용 Git ref 를 정리하지 못했습니다"
  rm -rf -- "$recovery_dir"
  say "업데이트 뒤 상태도 정상입니다 (airlock-status rc=0)."
  return 0
}

say()  {
  if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
    printf '[airlock-update] %s\n' "$*" >&2
  else
    printf '\033[1;36m[airlock-update]\033[0m %s\n' "$*"
  fi
}
die()  { printf '\033[1;31m[airlock-update] 중단:\033[0m %s\n' "$*" >&2; exit 1; }

fixture_boundary() { # <checkout-root> <dry> <machine>
  local checkout="$1" dry="$2" machine="$3" orb_path=""
  [ -n "${AIRLOCK_FIXTURE_ROOT:-}" ] || return 0
  [ -z "$machine" ] || orb_path="$(command -v orb 2>/dev/null || true)"
  python3 - "$AIRLOCK_FIXTURE_ROOT" "$checkout" "$dry" "$machine" "${HOME:-}" \
    "${AIRLOCK_STATE_DIR:-}" "$orb_path" <<'PY'
import pathlib
import sys

root_raw, checkout_raw, dry, machine, home, state, orb_path = sys.argv[1:]
root = pathlib.Path(root_raw)
if not root.is_absolute():
    raise SystemExit("fixture boundary: AIRLOCK_FIXTURE_ROOT must be absolute")

def below(label, raw, required):
    if not raw:
        if required:
            raise SystemExit(f"fixture boundary: {label} must be explicit")
        return
    path = pathlib.Path(raw)
    if not path.is_absolute():
        raise SystemExit(f"fixture boundary: {label} must be absolute")
    resolved = path.resolve(strict=False)
    if resolved != root and root not in resolved.parents:
        raise SystemExit(f"fixture boundary: {label} escapes AIRLOCK_FIXTURE_ROOT: {resolved}")

below("checkout", checkout_raw, True)
below("HOME", home, True)
below("AIRLOCK_STATE_DIR", state, dry != "1")
if machine:
    below("orb mutation command", orb_path, True)
PY
}

# airlock_escape_selfkill_cgroup SCRIPT [ARGS...] — survive stopping our own host.
#
# Copied in from install/lib.sh (not sourced): a streamed `curl | bash` run has no
# checkout to fetch it from, and the installer already carries the canonical copy
# for its own use. See that copy's comment for the full incident history — the
# short version is that an install/update run hosted inside the very
# airlock-*.service unit it is about to stop dies mid-way (units left stopped,
# disabled, and unit files reclaimed) unless it first moves itself out of that
# cgroup into its own transient scope/service.
#
# This does NOT refuse the run; it warns and continues in place if it cannot escape.
airlock_escape_selfkill_cgroup() {
  [ "${AIRLOCK_DRY_RUN:-0}" = 1 ] && return 0
  [ -n "${AIRLOCK_SELFKILL_ESCAPED:-}" ] && return 0
  local cgroup_file="${AIRLOCK_SELFKILL_CGROUP_FILE:-/proc/self/cgroup}"
  [ -r "$cgroup_file" ] || return 0

  local cgroup path unit
  cgroup="$(cat "$cgroup_file" 2>/dev/null || true)"
  path="$(printf '%s\n' "$cgroup" | sed -n 's|^0::||p' | head -n1)"
  [ -n "$path" ] || return 0
  unit="${path##*/}"

  case "$path" in */user@*.service/*) ;; *) return 0 ;; esac
  case "$unit" in airlock-*.service) ;; *) return 0 ;; esac

  say "this run is inside ${unit} — the same unit the update stops and restarts"
  say "  measured cgroup: ${cgroup}"
  say "  stopping ${unit} from in here would kill this run mid-update, so moving out"
  say "  to its own scope"

  local runner="${AIRLOCK_SELFKILL_SYSTEMD_RUN:-systemd-run}"
  if ! command -v "$runner" >/dev/null 2>&1; then
    say "WARNING: ${runner} not found — continuing INSIDE ${unit}. If the update"
    say "  stops that unit this run dies mid-way. Re-run detached instead:"
    say "    systemd-run --user --scope --collect bash $*"
    return 0
  fi
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    say "  no systemd --user manager reachable — nothing here stops that unit,"
    say "  so continuing in place"
    return 0
  fi

  local esc_unit
  esc_unit="airlock-update-$$-$(date +%s)"
  say "  moving to: ${runner} --user --unit=${esc_unit} -- bash $*"
  say "  live output: journalctl --user -u ${esc_unit} -f"

  local -a esc_env=()
  local _n
  for _n in $(compgen -e 2>/dev/null | grep '^AIRLOCK_' || true); do
    [ "$_n" = AIRLOCK_SELFKILL_ESCAPED ] && continue
    esc_env+=("--setenv=${_n}")
  done
  esc_env+=("--setenv=PATH")

  local _manager_env _manager_rc=0
  _manager_env="$(systemctl --user show-environment 2>/dev/null)" || _manager_rc=$?
  if [ "$_manager_rc" -ne 0 ]; then
    say "  WARNING: could not read the user manager's environment (rc=${_manager_rc});"
    say "    a stale AIRLOCK_* it holds could reach the escaped run"
    _manager_env=""
  else
    _manager_env="$(printf '%s\n' "$_manager_env" \
      | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p')"
  fi
  for _n in $(printf '%s\n' "$_manager_env" | grep '^AIRLOCK_' || true); do
    [ "$_n" = AIRLOCK_SELFKILL_ESCAPED ] && continue
    [ -n "${!_n+x}" ] || esc_env+=("--setenv=${_n}=")
  done

  local rc=0
  "$runner" --user --unit="$esc_unit" --service-type=exec --collect --quiet --wait \
    --same-dir \
    --setenv=AIRLOCK_SELFKILL_ESCAPED=1 \
    "${esc_env[@]}" \
    -- bash "$@" || rc=$?
  if [ "$rc" -eq 0 ]; then
    say "  escaped run finished (unit ${esc_unit})"
    exit 0
  fi
  if [ "$rc" -eq 127 ] || [ "$rc" -eq 126 ]; then
    say "WARNING: could not move out of ${unit} (${runner} rc=${rc}) — continuing in"
    say "  place. If this run dies at a 'Stopping ${unit}' line, that is why."
    return 0
  fi
  say "  escaped run failed (unit ${esc_unit}, rc=${rc}) — its log:"
  say "    journalctl --user -u ${esc_unit}"
  exit "$rc"
}

usage() { printf '%s\n' \
  "airlock-update — 이미 깔린 Airlock 을 최신 배포본으로 갱신합니다." \
  "  bash bin/airlock-update              # 갱신하고 설치기까지 다시 돌립니다" \
  "  bash bin/airlock-update --dry-run    # 무엇이 바뀌는지만 보여 줍니다" \
  "  bash bin/airlock-update --dry-run --json # 감지기용 JSON 요약만 출력" \
  "  bash bin/airlock-update --no-install # 파일만 갱신하고 설치기는 건너뜁니다" \
  "  bash bin/airlock-update --rollback   # 마지막으로 실패한 갱신을 되돌립니다" \
  "  bash bin/airlock-update --machine m  # 리눅스 머신 이름을 직접 지정합니다" \
  "  bash bin/airlock-update --from-unknown # 어느 배포본인지 모르는 옛 설치본(2026-08-21 이전)을 확인 후 갱신" \
  "  AIRLOCK_DIR=/경로 를 앞에 붙이면 그 폴더를 갱신합니다."; }

# The test seam for the macOS branch: a Linux CI cannot reach it, and it is the branch
# that can install into the wrong machine. install/test-update.sh sets this and puts a
# stub `orb` on PATH. Nothing else reads it.
platform() { printf '%s' "${AIRLOCK_UPDATE_UNAME:-$(uname -s)}"; }

is_checkout() {
  [ -f "$1/bin/airlock-config" ] \
    && [ -f "$1/install/airlock-install.sh" ] \
    && [ -f "$1/docker/orbstack-machine-setup.sh" ]
}

emit_update_json() { # <available:0|1> <changed-count> <release-ref>
  local output=""
  output="$(python3 - "$@" <<'PY'
import json
import sys

available, changed, ref = sys.argv[1:]
print(json.dumps({"available": available == "1", "changedCount": int(changed),
                  "ref": ref}, separators=(",", ":")))
PY
)" || return 1
  printf '%s\n' "$output"
}

local_files() { # <save|restore|matches> <checkout> <private-bundle> [release]
  python3 - "$@" <<'FILES'
import base64
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile

action, root_raw, bundle_raw, *extra = sys.argv[1:]
root, bundle = Path(root_raw), Path(bundle_raw)

def git(*args):
    return subprocess.check_output(["git", "-C", str(root), *args])

def names(raw):
    return sorted(set(os.fsdecode(p) for p in raw.split(b"\0") if p))

def working_diff():
    if subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "-q", "HEAD"],
                      stdout=subprocess.DEVNULL).returncode:
        return b""
    return git("diff", "--binary", "--no-ext-diff", "--no-textconv", "HEAD", "--", ".")

def digest(data):
    return hashlib.sha256(data).hexdigest()

def index_path():
    path = Path(os.fsdecode(git("rev-parse", "--git-path", "index")).rstrip("\n"))
    return path if path.is_absolute() else root / path

def staged_blobs():
    # Gitlinks name commits in another repository, not blobs in this one.
    return sorted({entry.split(b"\t", 1)[0].split()[1]
                   for entry in git("ls-files", "--stage", "-z").split(b"\0")
                   if entry and not entry.startswith(b"160000 ")})

def readable_staging():
    for oid in staged_blobs():
        subprocess.run(["git", "-C", str(root), "cat-file", "blob", os.fsdecode(oid)],
                       stdout=subprocess.DEVNULL, check=True)

def parents(relative):
    return [p for p in reversed(Path(relative).parents) if str(p) != "."]

def blocking_parent(relative):
    for parent in parents(relative):
        path = root / parent
        if os.path.lexists(path) and (path.is_symlink() or not path.is_dir()):
            return parent
    return None

def discard(path):
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    elif os.path.lexists(path):
        path.unlink()

if action == "save":
    tracked = git("ls-files", "-z", "--cached", "--others", "--exclude-standard")
    released = git("ls-tree", "-r", "-z", "--name-only", extra[0])
    if len(extra) > 1 and extra[1]:
        released += git("ls-tree", "-r", "-z", "--name-only", extra[1])
    has_head = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "-q", "HEAD"],
                              stdout=subprocess.DEVNULL).returncode == 0
    previous = git("ls-tree", "-r", "-z", "--name-only", "HEAD") if has_head else b""
    absent, covered = [], set()
    with open(bundle / "files.tar", "xb") as output, tarfile.open(fileobj=output, mode="w", dereference=False) as saved:
        os.chmod(bundle / "files.tar", 0o600)
        for candidate in names(tracked + released + previous):
            relative = str(blocking_parent(candidate) or candidate)
            if relative in covered or any(str(parent) in covered for parent in parents(relative)):
                continue
            path = root / relative
            if os.path.lexists(path):
                # A directory replacing a Git file owns its whole original tree.
                # Tarfile includes empty directories and never follows its links.
                saved.add(path, arcname=relative)
                covered.add(relative)
            else:
                absent.append(relative)
    metadata = {"absent": absent,
                "index_stage_sha256": digest(git("ls-files", "--stage", "-z")),
                "diff_sha256": digest(working_diff()),
                "untracked": names(git("ls-files", "-z", "--others", "--exclude-standard")),
                "archive_sha256": digest((bundle / "files.tar").read_bytes())}
    if has_head:
        index = index_path()
        metadata["index"] = None
        if index.exists():
            # Expand a split index in a private copy; leave the operator's index
            # untouched and avoid depending on an expiring sharedindex.* file.
            with tempfile.NamedTemporaryFile(dir=index.parent) as portable:
                portable.write(index.read_bytes())
                portable.flush()
                subprocess.run(["git", "-C", str(root), "update-index", "--no-split-index"],
                               env={**os.environ, "GIT_INDEX_FILE": portable.name}, check=True)
                metadata["index"] = base64.b64encode(Path(portable.name).read_bytes()).decode()
        blobs = b"".join(oid + b"\n" for oid in staged_blobs())
        # An index alone does not root its blobs against object expiry. Store a
        # native pack outside Git history, alongside the working-tree archive.
        packed = subprocess.check_output(["git", "-C", str(root), "pack-objects", "--stdout"],
                                         input=blobs)
        metadata["staged_blobs"] = base64.b64encode(packed).decode()
    with open(bundle / "files.json", "x") as output:
        os.chmod(bundle / "files.json", 0o600)
        json.dump(metadata, output, sort_keys=True)
    raise SystemExit(0)

if action == "retire":
    previous = set(names(git("ls-tree", "-r", "-z", "--name-only", extra[0])))
    released = set(names(git("ls-tree", "-r", "-z", "--name-only", extra[1])))
    for relative in sorted(previous - released):
        ignored = subprocess.run(["git", "-C", str(root), "check-ignore", "-q", "--no-index", "--", relative]).returncode == 0
        if not ignored and blocking_parent(relative) is None:
            path = root / relative
            if path.is_symlink() or (os.path.lexists(path) and not path.is_dir()):
                path.unlink()
        # A newly ignored path is box state; replacement directories/parent links
        # belong to the operator. Keep them, but retire the old source index entry.
        subprocess.run(["git", "-C", str(root), "update-index", "--force-remove", "--", relative], check=True)
    raise SystemExit(0)

metadata = json.loads((bundle / "files.json").read_bytes())
if digest((bundle / "files.tar").read_bytes()) != metadata["archive_sha256"]:
    raise SystemExit("local file archive changed")
with tarfile.open(bundle / "files.tar", errorlevel=2) as saved:
    members = saved.getmembers()

    def files_match():
        for relative in metadata["absent"]:
            if blocking_parent(relative) is not None or os.path.lexists(root / relative):
                return False
        for member in members:
            if blocking_parent(member.name) is not None:
                return False
            path = root / member.name
            if not os.path.lexists(path) or stat.S_IMODE(path.lstat().st_mode) != member.mode:
                return False
            if member.issym():
                if not path.is_symlink() or os.readlink(path) != member.linkname:
                    return False
            elif member.isdir():
                if path.is_symlink() or not path.is_dir():
                    return False
            elif member.isfile() or member.islnk():
                if path.is_symlink() or not path.is_file():
                    return False
                if digest(path.read_bytes()) != digest(saved.extractfile(member).read()):
                    return False
        return True

    if action == "restore":
        # Prepare real parents and resolve type collisions before native tarfile
        # extraction, which defers directory permissions until children are done.
        for member in sorted(members, key=lambda m: len(Path(m.name).parts)):
            for parent in parents(member.name):
                path = root / parent
                if path.is_symlink() or (os.path.lexists(path) and not path.is_dir()):
                    discard(path)
                path.mkdir(exist_ok=True)
            path = root / member.name
            if member.isdir():
                if path.is_symlink() or (os.path.lexists(path) and not path.is_dir()):
                    discard(path)
                path.mkdir(exist_ok=True)
            else:
                discard(path)
        # These are the operator's own captured nodes, protected alongside the
        # recovery metadata. Python 3.11.0 has no later filter keyword argument.
        saved.extraction_filter = lambda member, path: member
        saved.extractall(root)
        for relative in metadata["absent"]:
            if blocking_parent(relative) is not None:
                raise SystemExit("local file parent changed")
            discard(root / relative)
        if "index" in metadata:
            subprocess.run(["git", "-C", str(root), "unpack-objects", "-q"],
                           input=base64.b64decode(metadata["staged_blobs"]), check=True)
            index = index_path()
            if metadata["index"] is None:
                index.unlink(missing_ok=True)
            else:
                with tempfile.NamedTemporaryFile(dir=index.parent, delete=False) as restored:
                    restored.write(base64.b64decode(metadata["index"]))
                os.replace(restored.name, index)
            if digest(git("ls-files", "--stage", "-z")) != metadata["index_stage_sha256"]:
                raise SystemExit("local staging restoration incomplete")
            readable_staging()
        if not files_match():
            raise SystemExit("local file restoration incomplete")
    elif action == "matches":
        # Compare blob/mode/stage, not the index's mutable stat cache. A staged
        # edit can differ while both HEAD-to-worktree diff and file bytes match.
        if digest(git("ls-files", "--stage", "-z")) != metadata["index_stage_sha256"]:
            raise SystemExit(1)
        if digest(working_diff()) != metadata["diff_sha256"]:
            raise SystemExit(1)
        if names(git("ls-files", "-z", "--others", "--exclude-standard")) != metadata["untracked"]:
            raise SystemExit(1)
        if not files_match():
            raise SystemExit(1)
    else:
        raise SystemExit("unknown local-files action")
FILES
}

canonical_private_scratch() { # <fresh-mktemp-directory>
  python3 - "$1" <<'PY'
import os
import pathlib
import stat
import sys

source = pathlib.Path(sys.argv[1])
try:
    source_info = source.lstat()
    resolved = source.resolve(strict=True)
    resolved_info = resolved.lstat()
except OSError as exc:
    print(f"airlock-update scratch: {exc}", file=sys.stderr)
    raise SystemExit(2)
if (source.is_symlink() or resolved.is_symlink()
        or not resolved.is_absolute()
        or not stat.S_ISDIR(source_info.st_mode)
        or not stat.S_ISDIR(resolved_info.st_mode)
        or (source_info.st_dev, source_info.st_ino) != (resolved_info.st_dev, resolved_info.st_ino)
        or (resolved_info.st_uid, resolved_info.st_gid) != (os.geteuid(), os.getegid())
        or stat.S_IMODE(resolved_info.st_mode) != 0o700
        or any(ord(character) < 32 for character in str(resolved))):
    print("airlock-update scratch: generated directory is not canonical owner-private storage",
          file=sys.stderr)
    raise SystemExit(2)
print(resolved)
PY
}

release_tree_matches_state() { # <public-release-commit> <local-commit-or-empty-for-worktree>
  local ref="$1" local_commit="$2" paths diff_names changed
  paths="$(git -c core.quotePath=false ls-tree -r --name-only "$ref" | sort)" || return 2
  if [ -n "$local_commit" ]; then
    diff_names="$(git -c core.quotePath=false diff --name-only "$ref" "$local_commit" \
      2>/dev/null)" || return 2
  else
    diff_names="$(git -c core.quotePath=false diff --name-only "$ref" -- . \
      2>/dev/null)" || return 2
  fi
  changed="$(printf '%s\n' "$diff_names" | sort \
    | comm -12 - <(printf '%s\n' "$paths"))" || return 2
  [ -z "$changed" ]
}

repository_name_from_url() { # <repository-url-or-path>
  local url="${1%/}"
  url="${url%.git}"
  printf '%s' "${url##*/}"
}

resolve_object_prefix() { # <hex-object-prefix>
  local prefix="$1" objects="" object="" resolved="" type="" count=0
  objects="$(git rev-parse --disambiguate="$prefix" 2>/dev/null)" || return 2
  while IFS= read -r object; do
    [ -n "$object" ] || continue
    count=$((count + 1))
    [ "$count" -le 1 ] || return 2
    resolved="$object"
  done <<<"$objects"
  [ "$count" = 1 ] || return 1
  type="$(git cat-file -t "$resolved" 2>/dev/null)" || return 2
  [ "$type" = commit ] || return 2
  printf '%s\n' "$resolved"
}

release_direction() { # <candidate-public-commit> <installed-head-or-empty> <requested-ref> <release-url> [provenance-receipt]
  # Dynamic scope lets the existing classifier share the provenance it already
  # resolved, without a second installed-history scan or a new version marker.
  local installed_release="" installed_source="" result_rc=0
  release_direction_value "$@" || result_rc=$?
  if [ -n "${5:-}" ]; then
    if [ -z "$installed_release" ] && [ -n "$installed_source" ]; then
      local history ref subject label token resolved
      label="$(repository_name_from_url "$4")-work"
      history="$(git log --format='%H%x09%s' "$1" 2>/dev/null)" || history=""
      while IFS=$'\t' read -r ref subject; do
        if [[ "$subject" =~ ^release[[:space:]]from[[:space:]]([[:alnum:]_.-]+)[[:space:]]@[[:space:]]([0-9a-f]{7,40})$ ]] \
           && [ "${BASH_REMATCH[1]}" = "$label" ]; then
          token="${BASH_REMATCH[2]}"
          resolved="$(resolve_object_prefix "$token")" || continue
          [ "$resolved" = "$installed_source" ] || continue
          installed_release="$ref"
          break
        fi
      done <<<"$history"
    fi
    printf '%s' "$installed_release" >"$5" || return 2
  fi
  return "$result_rc"
}

release_direction_value() {
  local candidate="$1" installed_head="$2" requested_ref="$3" release_url="$4"
  local origin_url="" release_name="" private_name="" subject="" subject_label=""
  local source_token="" source_commit="" private_tip=""
  local history_subject="" history_label="" history_token=""
  local history_source="" token="" ref="" first_parent_graph="" parent_line=""
  local marker_history="" marker_subject=""
  local first_parent="" side_parent="" candidate_history="" graph_rc=0 ancestor_rc=0
  local source_rc=0 reverse_rc=0 origin_rc=0
  local -a parents=()

  # A developer checkout has the private graph locally. Public release commits name
  # their source repository and SHA, so compare those commits rather than pretending
  # the unrelated public and private histories share ancestry. Build the source name
  # from the public repository identity instead of publishing a private name here.
  # Read the configured identity, not `remote get-url`: Git rewrites the latter via
  # url.*.insteadOf, which is transport routing and must not redefine repository
  # identity.  The tests use that distinction to route this canonical URL locally.
  origin_url="$(git config --get remote.origin.url 2>/dev/null)"
  origin_rc=$?
  if [ "$origin_rc" != 0 ] && [ "$origin_rc" != 1 ]; then
    printf '%s' ambiguous
    return 2
  fi
  origin_url="${origin_url%/}"
  origin_url="${origin_url%.git}"
  release_name="$(repository_name_from_url "$release_url")"
  private_name="${release_name}-work"
  case "$origin_url" in
    "https://github.com/spacewalk-labs/$private_name"|"git@github.com:spacewalk-labs/$private_name"|"ssh://git@github.com/spacewalk-labs/$private_name")
      # Deployment checkouts can have a local merge commit around the deployed
      # private source point. Comparing the public source directly with HEAD would
      # call the current release a rollback. The clone already records the private
      # main tip used by that deployment, so use that local evidence; fetching origin
      # here made one detector run contact two repositories. If the ref is absent or
      # too old to decide, return ambiguous with a measurement-failure status so the
      # collector retains its last successful snapshot and original checkedAt.
      private_tip="$(git rev-parse --verify -q "refs/remotes/origin/main^{commit}" 2>/dev/null)"
      source_rc=$?
      if [ "$source_rc" != 0 ] && [ "$source_rc" != 1 ]; then
        printf '%s' ambiguous
        return 2
      fi
      subject="$(git log -1 --format=%s "$candidate" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      if [[ "$subject" =~ ^release[[:space:]]from[[:space:]]([[:alnum:]_.-]+)[[:space:]]@[[:space:]]([0-9a-f]{7,40})$ ]]; then
        subject_label="${BASH_REMATCH[1]}"
        source_token="${BASH_REMATCH[2]}"
      fi
      if [ -z "$subject_label" ] || [ -z "$source_token" ]; then
        printf '%s' ambiguous
        return 2
      fi
      if [ "$subject_label" != "$private_name" ]; then
        printf '%s' ambiguous
        return 0
      fi
      if [ -n "$installed_head" ] && [ -n "$private_tip" ]; then
        source_commit="$(resolve_object_prefix "$source_token")"
        source_rc=$?
        if [ "$source_rc" = 2 ]; then
          printf '%s' ambiguous
          return 2
        fi

        # Deployment is a first-parent sequence of private states, with the public
        # release as a side parent of each deployment merge.  That topology records
        # which release was installed last even when public histories diverge or
        # commit timestamps are skewed.  A whole-graph log has neither property.
        first_parent_graph="$(git rev-list --first-parent --parents "$installed_head" 2>/dev/null)"
        graph_rc=$?
        if [ "$graph_rc" != 0 ]; then
          printf '%s' ambiguous
          return 2
        fi
        while IFS= read -r parent_line; do
          read -r -a parents <<<"$parent_line"
          [ "${#parents[@]}" -gt 2 ] || continue
          first_parent="${parents[1]}"
          for side_parent in "${parents[@]:2}"; do
            history_subject="$(git log -1 --format=%s "$side_parent" 2>/dev/null)"
            graph_rc=$?
            if [ "$graph_rc" != 0 ]; then
              printf '%s' ambiguous
              return 2
            fi
            history_label=""; history_token=""; history_source=""
            if [[ "$history_subject" =~ ^release[[:space:]]from[[:space:]]([[:alnum:]_.-]+)[[:space:]]@[[:space:]]([0-9a-f]{7,40})$ ]]; then
              history_label="${BASH_REMATCH[1]}"
              history_token="${BASH_REMATCH[2]}"
            fi
            [ "$history_label" = "$private_name" ] || continue
            history_source="$(resolve_object_prefix "$history_token")"
            source_rc=$?
            if [ "$source_rc" != 0 ] || [ -z "$history_source" ]; then
              printf '%s' ambiguous
              return 2
            fi
            git merge-base --is-ancestor "$history_source" "$first_parent" 2>/dev/null
            ancestor_rc=$?
            if [ "$ancestor_rc" = 0 ]; then
              installed_release="$side_parent"
              installed_source="$history_source"
              break 2
            fi
            [ "$ancestor_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          done
        done <<<"$first_parent_graph"

        if [ -z "$installed_source" ]; then
          installed_source="$(git merge-base "$installed_head" "$private_tip" 2>/dev/null)"
          graph_rc=$?
          if [ "$graph_rc" != 0 ] || [ -z "$installed_source" ]; then
            printf '%s' ambiguous
            return 2
          fi
          # With no deployment marker, a tracking tip strictly behind HEAD cannot
          # distinguish private source progress from operator commits. Refuse to
          # turn that stale evidence into a successful direction measurement.
          git merge-base --is-ancestor "$private_tip" "$installed_head" 2>/dev/null
          ancestor_rc=$?
          if [ "$ancestor_rc" = 0 ] && [ "$private_tip" != "$installed_head" ]; then
            printf '%s' ambiguous
            return 2
          fi
          [ "$ancestor_rc" = 0 ] || [ "$ancestor_rc" = 1 ] \
            || { printf '%s' ambiguous; return 2; }
        fi

        if [ -n "$source_commit" ] && [ -n "$installed_source" ]; then
          git merge-base --is-ancestor "$source_commit" "$private_tip" 2>/dev/null
          ancestor_rc=$?
        else
          ancestor_rc=1
        fi
        if [ "$ancestor_rc" = 0 ]; then
          [ "$source_commit" = "$installed_source" ] && { printf '%s' same; return 0; }
          git merge-base --is-ancestor "$source_commit" "$installed_source" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' rollback; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          git merge-base --is-ancestor "$installed_source" "$source_commit" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' forward; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          printf '%s' ambiguous
          return 0
        fi
        [ "$ancestor_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
        # Both commits exist and diverge, so this is a measured off-main release,
        # not a failed observation. A reverse ancestor means origin/main is merely
        # stale, so public release ancestry remains the available ordering evidence.
        if [ -n "$source_commit" ] && [ -n "$installed_source" ]; then
          git merge-base --is-ancestor "$private_tip" "$source_commit" 2>/dev/null
          reverse_rc=$?
          if [ "$reverse_rc" = 1 ]; then
            printf '%s' ambiguous
            return 0
          fi
          [ "$reverse_rc" = 0 ] || { printf '%s' ambiguous; return 2; }
        fi

        # A quiet deployment does not fetch its private remote merely to detect an
        # update. The source object for a later release can therefore be absent (or
        # newer than the locally recorded private tip). Public releases already form
        # a fetched ancestry and name their source digest. Find the release that names
        # this checkout's deployed source, then compare public release ancestry. This
        # keeps forward detection live without a second network fetch or a new version
        # identifier. The divergent-object case above is deliberately excluded: when
        # Git can prove a source is off private main, public ordering must not bless it.
        candidate_history="$(git log --format='%H%x09%s' "$candidate" 2>/dev/null)"
        graph_rc=$?
        if [ "$graph_rc" != 0 ]; then
          printf '%s' ambiguous
          return 2
        fi
        while IFS=$'\t' read -r ref history_subject; do
          history_label=""; history_token=""; history_source=""
          if [[ "$history_subject" =~ ^release[[:space:]]from[[:space:]]([[:alnum:]_.-]+)[[:space:]]@[[:space:]]([0-9a-f]{7,40})$ ]]; then
            history_label="${BASH_REMATCH[1]}"
            history_token="${BASH_REMATCH[2]}"
          fi
          [ "$history_label" = "$private_name" ] || continue
          history_source="$(resolve_object_prefix "$history_token")"
          source_rc=$?
          [ "$source_rc" != 1 ] || continue
          if [ "$source_rc" != 0 ] || [ -z "$history_source" ]; then
            printf '%s' ambiguous
            return 2
          fi
          if [ "$history_source" = "$installed_source" ]; then
            installed_release="$ref"
            break
          fi
        done <<<"$candidate_history"
        if [ -n "$installed_release" ]; then
          [ "$installed_release" = "$candidate" ] && { printf '%s' same; return 0; }
          git merge-base --is-ancestor "$installed_release" "$candidate" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' forward; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          git merge-base --is-ancestor "$candidate" "$installed_release" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' rollback; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
        fi
      fi
      printf '%s' ambiguous
      return 2
      ;;
  esac

  # A box updated by this command has an unrelated local safety history, but its
  # commit subject records the public release SHA.  Resolve the newest such marker
  # against the public objects retained by the airlock-release remote.
  if [ -n "$installed_head" ]; then
    # Read subjects without a truncating pipeline. With pipefail, `head -1`
    # eventually turned a healthy git log into SIGPIPE on long-lived boxes. Git's
    # --grep is not a substitute: it also searches commit bodies, so an operator note
    # quoting marker text could hide the newest real marker.
    marker_history="$(git log --format=%s "$installed_head" 2>/dev/null)"
    graph_rc=$?
    if [ "$graph_rc" != 0 ]; then
      printf '%s' ambiguous
      return 2
    fi
    while IFS= read -r marker_subject; do
      if [[ "$marker_subject" =~ ^airlock-update:[[:space:]]배포본[[:space:]]([0-9a-f]{12,40})[[:space:]]으로[[:space:]]갱신$ ]]; then
        token="${BASH_REMATCH[1]}"
        break
      fi
    done <<<"$marker_history"
    if [ -n "$token" ]; then
      installed_release="$(resolve_object_prefix "$token")"
      source_rc=$?
      if [ "$source_rc" != 0 ] || [ -z "$installed_release" ]; then
        printf '%s' ambiguous
        return 2
      fi
    fi
  fi

  # Legacy first installs have no marker.  For the normal moving `main` ref, recover
  # provenance by finding the newest public ancestor whose complete public path set
  # matches any local commit.  Looking only at HEAD would reject a valid old install
  # after its operator committed an edit to a release-owned file.  Do not apply this
  # to an explicitly pinned old ref: files added by a later release would otherwise
  # be mistaken for operator files.
  if [ -z "$installed_release" ] && [ "$requested_ref" = main ]; then
    if [ -n "$installed_head" ]; then
      local local_ref match_rc lookup_failed=0 local_history="" release_history=""
      local_history="$(git rev-list "$installed_head" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      release_history="$(git rev-list "$candidate" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      while IFS= read -r ref; do
        while IFS= read -r local_ref; do
          if release_tree_matches_state "$ref" "$local_ref"; then
            installed_release="$ref"
            break
          else
            match_rc=$?
            [ "$match_rc" = 1 ] || { lookup_failed=1; break; }
          fi
        done <<<"$local_history"
        if [ "$lookup_failed" != 0 ] || [ -n "$installed_release" ]; then
          break
        fi
      done <<<"$release_history"
      [ "$lookup_failed" = 0 ] || { printf '%s' ambiguous; return 2; }
    else
      local match_rc release_history=""
      release_history="$(git rev-list "$candidate" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      while IFS= read -r ref; do
        if release_tree_matches_state "$ref" ""; then
          installed_release="$ref"
          break
        else
          match_rc=$?
          [ "$match_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
        fi
      done <<<"$release_history"
    fi
  fi

  # Nothing to disagree with, only nothing to go on: no marker, and on `main` no local
  # state matches any published tree. A pinned ref stays ambiguous — tree matching was
  # never applied to it, so "no match" there is not a measurement.
  if [ -z "$installed_release" ]; then
    [ "$requested_ref" = main ] && { printf '%s' unknown; return 0; }
    printf '%s' ambiguous
    return 0
  fi
  [ "$installed_release" = "$candidate" ] && { printf '%s' same; return 0; }
  git merge-base --is-ancestor "$installed_release" "$candidate" 2>/dev/null
  graph_rc=$?
  [ "$graph_rc" = 0 ] && { printf '%s' forward; return 0; }
  [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
  git merge-base --is-ancestor "$candidate" "$installed_release" 2>/dev/null
  graph_rc=$?
  [ "$graph_rc" = 0 ] && { printf '%s' rollback; return 0; }
  [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
  printf '%s' ambiguous
}

# Serialize the whole updater without a host `flock` dependency (macOS does not ship
# util-linux flock) and without an inherited lock fd that a lifecycle background
# process could keep forever.  The keeper locks the existing git directory itself,
# so even --dry-run shares the mutex without creating a file in the checkout or .git.
acquire_update_mutex() { # <absolute-git-dir>
  local git_dir="$1" ready keeper status="" spins=0
  ready="$(mktemp)" || die "업데이트 잠금 응답 파일을 만들지 못했습니다"
  rm -f -- "$ready"
  python3 - "$git_dir" "$ready" "$$" <<'PY' >/dev/null 2>&1 &
import fcntl, os, pathlib, sys, time

git_dir, ready, parent_raw = sys.argv[1:]
parent = int(parent_raw)
try:
    descriptor = os.open(git_dir, os.O_RDONLY)
    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    pathlib.Path(ready).write_text("busy", encoding="ascii")
    raise SystemExit(0)
except Exception as exc:
    pathlib.Path(ready).write_text(f"error:{exc}", encoding="utf-8")
    raise SystemExit(0)
pathlib.Path(ready).write_text("ok", encoding="ascii")
while os.getppid() == parent:
    try:
        os.kill(parent, 0)
    except ProcessLookupError:
        break
    time.sleep(0.1)
PY
  keeper=$!
  while [ ! -s "$ready" ] && kill -0 "$keeper" 2>/dev/null; do
    spins=$((spins + 1))
    [ "$spins" -lt 1000 ] || break
    sleep 0.01
  done
  [ ! -s "$ready" ] || status="$(cat "$ready")"
  rm -f -- "$ready"
  case "$status" in
    ok) AIRLOCK_UPDATE_KEEPER_PID="$keeper"; return 0 ;;
    busy) wait "$keeper" 2>/dev/null || true
      die "다른 airlock-update 또는 rollback 이 진행 중입니다 — 끝난 뒤 다시 시도하세요" ;;
    *) kill "$keeper" 2>/dev/null || true
      wait "$keeper" 2>/dev/null || true
      die "업데이트 실행 잠금을 잡지 못했습니다${status:+ ($status)}" ;;
  esac
}

release_update_mutex() {
  local keeper="${AIRLOCK_UPDATE_KEEPER_PID:-}"
  [ -n "$keeper" ] || return 0
  AIRLOCK_UPDATE_KEEPER_PID=""
  kill "$keeper" 2>/dev/null || true
  wait "$keeper" 2>/dev/null || true
}

# Run the status surface against the box that the installer actually changes.  On a
# Mac the checkout is shared into OrbStack, but the services/state live inside the
# machine; asking macOS would be a clean answer about the wrong computer.
box_status() { # box_status <checkout> <machine> [state-dir config-path]
  local root="$1" machine="$2" state_dir="${3-}" config_path="${4-}"
  if [ "$(platform)" != Darwin ]; then
    if [ $# -ge 4 ]; then
      (cd "$root" && AIRLOCK_STATE_DIR="$state_dir" AIRLOCK_CONFIG="$config_path" \
        python3 bin/airlock-status --json)
    else
      (cd "$root" && python3 bin/airlock-status --json)
    fi
    return $?
  fi
  # shellcheck disable=SC2016 # $1 expands inside the remote bash, not here.
  if [ $# -ge 4 ]; then
    orb -m "$machine" env "AIRLOCK_STATE_DIR=$state_dir" \
      "AIRLOCK_CONFIG=/mnt/mac$config_path" \
      bash -c 'cd "$1" && python3 bin/airlock-status --json' \
      airlock-status "/mnt/mac$root"
  else
    orb -m "$machine" bash -c 'cd "$1" && python3 bin/airlock-status --json' \
      airlock-status "/mnt/mac$root"
  fi
}

snapshot_regular() { # snapshot_regular <source> <snapshot-dir> <name>
  local source="$1" out="$2" name="$3"
  if [ -L "$source" ] || { [ -e "$source" ] && [ ! -f "$source" ]; }; then
    die "복구 기준 파일이 일반 파일이 아닙니다: $source"
  fi
  if [ -f "$source" ]; then
    cp -- "$source" "$out/$name" || die "복구 기준 파일을 복사하지 못했습니다: $source"
    chmod 0600 "$out/$name" || die "복구 기준 파일을 보호하지 못했습니다: $name"
    printf '%s\n' present >"$out/$name.state"
  else
    printf '%s\n' absent >"$out/$name.state"
  fi
}

installed_record() { # <preserved-ledger> <action> [paths]
  local engine="$1" action="$2"
  shift 2
  python3 - "$engine" "$action" "$@" <<'PY_RECORD'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import sys
sys.dont_write_bytecode = True
ledger = SourceFileLoader("_airlock_update_ledger", sys.argv[1]).load_module()
action, paths = sys.argv[2], sys.argv[3:]
if action == "snapshot":
    present = ledger.snapshot_installed(Path(paths[0]))
    Path(paths[0] + ".state").write_text("present\n" if present else "absent\n")
elif action == "restore":
    ledger.restore_installed(Path(paths[0]) if Path(paths[0] + ".state").read_text().strip() == "present" else None)
elif action == "matches":
    expected = Path(paths[0]).read_bytes() if Path(paths[0] + ".state").read_text().strip() == "present" else None
    raise SystemExit(0 if ledger.read_installed_bytes() == expected else 1)
elif action == "validate":
    ledger.validate_installed_bytes(Path(paths[0]).read_bytes())
elif action == "teardown":
    raise SystemExit(ledger.teardown_installed(core_root=Path(paths[0])))
elif action == "runtime-root":
    snapshot, previous, fallback = paths
    rows = ledger.validate_installed_bytes(Path(snapshot).read_bytes()) if Path(snapshot).is_file() else {}
    root = Path(previous)
    if (root.is_absolute() and (root / "bin/airlock-status").is_file()
            and isinstance(rows, dict)
            and any(Path(row["repo"]).resolve() == root.resolve() / "apps" / app
                    for app, row in rows.items())):
        print(root)
    else:
        print(fallback)
PY_RECORD
}

snapshot_remote_state() { # <preserved-ledger> <machine> <state-dir> <out>
  local engine="$1" machine="$2" state_dir="$3" out="$4"
  # The host's mktemp directory need not be mounted inside OrbStack. Send the
  # preserved reader with this script and import it from a machine-local file.
  orb -m "$machine" env "AIRLOCK_STATE_DIR=$state_dir" bash -s -- \
    "$state_dir" <<SNAPSHOT_REMOTE \
    | tar -C "$out" -xf - || die "OrbStack 머신의 설치 상태를 보존하지 못했습니다"
$(declare -f installed_record)
$(declare -f snapshot_regular)
set -euo pipefail
state_dir=\$1
umask 077
tmp=\$(mktemp -d)
trap 'rm -rf -- "\$tmp"' EXIT
cat >"\$tmp/airlock-ledger" <<'AIRLOCK_SNAPSHOT_LEDGER'
$(cat -- "$engine")
AIRLOCK_SNAPSHOT_LEDGER
installed_record "\$tmp/airlock-ledger" snapshot "\$tmp/install-record.json"
snapshot_regular "\$state_dir/plaintext-retirement.json" "\$tmp" plaintext-retirement.json
rm -f -- "\$tmp/airlock-ledger"
tar -C "\$tmp" -cf - .
SNAPSHOT_REMOTE
}

snapshot_box_state() { # snapshot_box_state <root> <machine> <out> [state-dir]
  local root="$1" machine="$2" out="$3" state_dir
  if [ "$(platform)" = Darwin ]; then
    if [ $# -ge 4 ]; then
      state_dir="$4"
    else
      # shellcheck disable=SC2016 # HOME/AIRLOCK_STATE_DIR belong to the machine.
      state_dir="$(orb -m "$machine" sh -c 'printf %s "${AIRLOCK_STATE_DIR:-$HOME/.local/state/airlock}"')" \
        || die "OrbStack 머신의 Airlock 상태 경로를 읽지 못했습니다"
    fi
    [ -n "$state_dir" ] || die "OrbStack 머신의 Airlock 상태 경로가 비었습니다"
    case "$state_dir" in /*) ;; *) die "OrbStack 머신의 Airlock 상태 경로가 절대 경로가 아닙니다: $state_dir" ;; esac
    case "$state_dir" in *$'\n'*|*$'\r'*) die "Airlock 상태 경로에 줄바꿈이 있어 안전하게 기록할 수 없습니다" ;; esac
    printf '%s' "$state_dir" >"$out/state-dir"
    snapshot_remote_state "$record_engine" "$machine" "$state_dir" "$out" || return 1
  else
    state_dir="${4-${AIRLOCK_STATE_DIR:-$HOME/.local/state/airlock}}"
    case "$state_dir" in /*) ;; *) die "Airlock 상태 경로가 절대 경로가 아닙니다: $state_dir" ;; esac
    case "$state_dir" in *$'\n'*|*$'\r'*) die "Airlock 상태 경로에 줄바꿈이 있어 안전하게 기록할 수 없습니다" ;; esac
    printf '%s' "$state_dir" >"$out/state-dir"
    AIRLOCK_STATE_DIR="$state_dir" installed_record "$record_engine" snapshot "$out/install-record.json" || return 1
    snapshot_regular "$state_dir/plaintext-retirement.json" "$out" plaintext-retirement.json || return 1
  fi
}

snapshot_hash() { git hash-object --stdin <"$1"; }

capture_failed_state() { # <root> <machine> <recovery-dir>
  local root="$1" machine="$2" dir="$3" state_dir name
  local failed="$dir/failed"
  state_dir="$(cat "$dir/state-dir")" || return 1
  mkdir -m 0700 "$failed" || return 1
  if ! (snapshot_box_state "$root" "$machine" "$failed" "$state_dir"); then
    return 1
  fi
  for name in install-record.json plaintext-retirement.json; do
    if [ "$(cat "$failed/$name.state")" = present ]; then
      snapshot_hash "$failed/$name" >"$failed/$name.sha256" || return 1
    fi
  done
  chmod 0600 "$failed"/* || return 1
}

box_state_matches() { # <root> <machine> <expected-dir>
  local root="$1" machine="$2" expected="$3" current name state state_dir
  current="$(mktemp -d)" || return 1
  state_dir="$(cat "$expected/state-dir")" || { rm -rf -- "$current"; return 1; }
  if ! (snapshot_box_state "$root" "$machine" "$current" "$state_dir"); then
    rm -rf -- "$current"
    return 1
  fi
  if ! cmp -s "$expected/state-dir" "$current/state-dir"; then
    rm -rf -- "$current"
    return 1
  fi
  for name in install-record.json plaintext-retirement.json; do
    if ! cmp -s "$expected/$name.state" "$current/$name.state"; then
      rm -rf -- "$current"
      return 1
    fi
    state="$(cat "$expected/$name.state")"
    if [ "$state" = present ] && ! cmp -s "$expected/$name" "$current/$name"; then
      rm -rf -- "$current"
      return 1
    fi
  done
  rm -rf -- "$current"
}

arm_recovery() { # <dir> <scratch> <before> <config-path> <platform> <machine>
  local dir="$1" scratch="$2" before="$3" config="$4" os="$5" machine="$6" files="${7:-}" runtime_root="${8:-$ROOT}" name staged
  staged="$(mktemp -d "$dir.prepare.XXXXXX")" \
    || die "복구 기록 준비 디렉터리를 만들지 못했습니다: $dir"
  for name in status-before.json config.snapshot state-dir \
              install-record.json.state plaintext-retirement.json.state \
              airlock-update airlock-ledger; do
    cp -- "$scratch/$name" "$staged/$name" || die "복구 기록을 보존하지 못했습니다: $name"
  done
  for name in install-record.json plaintext-retirement.json; do
    if [ "$(cat "$scratch/$name.state")" = present ]; then
      cp -- "$scratch/$name" "$staged/$name" || die "복구 기준을 보존하지 못했습니다: $name"
      snapshot_hash "$staged/$name" >"$staged/$name.sha256"
    fi
  done
  printf '%s' "$before" >"$staged/before"
  : >"$staged/after"
  printf '%s' "$config" >"$staged/config-path"
  printf '%s' "$os" >"$staged/platform"
  printf '%s' "$machine" >"$staged/machine"
  printf '%s' "$runtime_root" >"$staged/runtime-root"
  printf '%s' "$$" >"$staged/pid"
  snapshot_hash "$staged/config.snapshot" >"$staged/config.snapshot.sha256"
  for name in before config-path platform machine state-dir runtime-root; do
    snapshot_hash "$staged/$name" >"$staged/$name.sha256"
  done
  printf '%s\n' checkout-pending >"$staged/phase"
  chmod 0600 "$staged"/* || die "복구 기록 권한을 좁히지 못했습니다"
  if [ -n "$files" ]; then
    cp -a -- "$files" "$staged/local-files" || die "업데이트 전 파일 복구 자료를 보존하지 못했습니다"
    for name in files.tar files.json restore.sh; do
      snapshot_hash "$staged/local-files/$name" >"$staged/local-files/$name.sha256" \
        || die "파일 복구 자료 해시를 고정하지 못했습니다: $name"
      chmod 0600 "$staged/local-files/$name.sha256"
    done
  fi
  git update-ref refs/airlock-update/rollback "$before" \
    || die "업데이트 전 Git 객체를 복구용으로 고정하지 못했습니다"
  if ! mv -- "$staged" "$dir"; then
    git update-ref -d refs/airlock-update/rollback "$before" >/dev/null 2>&1 || true
    die "완성한 복구 기록을 제자리에 두지 못했습니다: $dir"
  fi
}

activate_recovery() { # <dir> <after>
  local dir="$1" after="$2" tmp
  tmp="$dir/after.tmp.$$"
  printf '%s' "$after" >"$tmp" || die "실패 업데이트 revision 을 복구 기록에 쓰지 못했습니다"
  chmod 0600 "$tmp" || die "실패 업데이트 revision 기록 권한을 좁히지 못했습니다"
  mv -f -- "$tmp" "$dir/after" || die "실패 업데이트 revision 을 원자적으로 고정하지 못했습니다"
  snapshot_hash "$dir/after" >"$dir/after.sha256" \
    || die "실패 업데이트 revision 해시를 고정하지 못했습니다"
  chmod 0600 "$dir/after.sha256" || die "실패 업데이트 revision 해시 권한을 좁히지 못했습니다"
  tmp="$dir/phase.tmp.$$"
  printf '%s\n' installing >"$tmp" || die "복구 기록 단계를 쓰지 못했습니다"
  chmod 0600 "$tmp" || die "복구 기록 단계 권한을 좁히지 못했습니다"
  mv -f -- "$tmp" "$dir/phase" || die "복구 기록 단계를 원자적으로 바꾸지 못했습니다"
}

record_update_event() { # <git-dir> <event> <before> <after> <rc>
  local git_dir="$1" event="$2" before="$3" after="$4" rc="$5"
  printf '%s\t%s\tbefore=%s\tafter=%s\trc=%s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$event" "$before" "$after" "$rc" \
    >>"$git_dir/airlock-update.log"
}

validate_snapshot() { # <dir> <name>
  local dir="$1" name="$2" state expected actual
  if [ ! -f "$dir/$name.state" ] || [ -L "$dir/$name.state" ]; then
    die "복구 기록이 불완전합니다: $name.state"
  fi
  state="$(cat "$dir/$name.state")"
  case "$state" in
    absent) [ ! -e "$dir/$name" ] || die "없어야 할 복구 기준 파일이 생겼습니다: $name" ;;
    present)
      if [ ! -f "$dir/$name" ] || [ -L "$dir/$name" ] || [ ! -f "$dir/$name.sha256" ]; then
        die "복구 기준 파일이 불완전합니다: $name"
      fi
      expected="$(cat "$dir/$name.sha256")"; actual="$(snapshot_hash "$dir/$name")"
      [ "$actual" = "$expected" ] || die "복구 기준 파일 해시가 달라졌습니다: $name" ;;
    *) die "복구 기준 파일 상태가 잘못됐습니다: $name ($state)" ;;
  esac
}

validate_target_shape() { # <path>
  local path="$1"
  [ ! -L "$path" ] || die "되돌릴 대상이 symlink 로 바뀌었습니다: $path"
  { [ ! -e "$path" ] || [ -f "$path" ]; } \
    || die "되돌릴 대상이 일반 파일이 아닙니다: $path"
}

# Remove current recorded artifacts, then restore the preserved app record.
teardown_and_restore_box_state() { # <root> <machine> <state-dir> <snapshot-dir> <failed-dir>
  local root="$1" machine="$2" state_dir="$3" snapshot_dir="$4" failed_dir="$5"
  local box_root="$root"
  [ "$(platform)" != Darwin ] || box_root="/mnt/mac$root"
  local script
  script="$(
    declare -f installed_record
    declare -f validate_target_shape
    cat <<'ROLLBACK_BODY'
set -euo pipefail
root=$1; state_dir=$2; snapshot_dir=$3; failed_dir=$4; engine=$5
[ "$(cat "$failed_dir/state-dir")" = "$state_dir" ] || exit 43
installed_record "$engine" matches "$failed_dir/install-record.json" || exit 44
retirement="$state_dir/plaintext-retirement.json"
validate_target_shape "$retirement"
if [ "$(cat "$failed_dir/plaintext-retirement.json.state")" = present ]; then
  cmp -s "$failed_dir/plaintext-retirement.json" "$retirement" || exit 44
else
  [ ! -e "$retirement" ] || exit 44
fi
installed_record "$engine" teardown "$root"
installed_record "$engine" restore "$snapshot_dir/install-record.json"
if [ "$(cat "$snapshot_dir/plaintext-retirement.json.state")" = absent ]; then
  rm -f -- "$retirement"
else
  tmp="$retirement.airlock-rollback.$$"
  cp -- "$snapshot_dir/plaintext-retirement.json" "$tmp"
  chmod 0600 "$tmp"
  mv -f -- "$tmp" "$retirement"
fi
ROLLBACK_BODY
  )"
  if [ "$(platform)" = Darwin ]; then
    orb -m "$machine" env "AIRLOCK_STATE_DIR=$state_dir" bash -s -- \
      "$box_root" "$state_dir" "/mnt/mac$snapshot_dir" "/mnt/mac$failed_dir" "/mnt/mac$record_engine" <<<"$script"
  else
    (cd "$root" && AIRLOCK_STATE_DIR="$state_dir" bash -s -- \
      "$box_root" "$state_dir" "$snapshot_dir" "$failed_dir" "$record_engine" <<<"$script")
  fi
}

rollback_update() { # <root> <machine-option> <machine-marker>
  local root="$1" requested_machine="$2" marker="$3" git_dir git_common_dir dir phase before after
  local saved_platform saved_machine machine head parent dirty config_path state_dir runtime_root="$root" rc=0
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)" \
    || die "git 메타데이터 경로를 읽지 못했습니다"
  git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "공통 git 메타데이터 경로를 읽지 못했습니다"
  acquire_update_mutex "$git_common_dir"
  dir="$git_dir/airlock-update-rollback"
  if [ ! -d "$dir" ] || [ -L "$dir" ]; then
    die "되돌릴 실패 업데이트 기록이 없습니다"
  fi
  for f in phase before before.sha256 after after.sha256 config-path config-path.sha256 \
           config.snapshot config.snapshot.sha256 platform platform.sha256 machine machine.sha256 \
           state-dir state-dir.sha256 \
           airlock-update airlock-ledger status-before.json; do
    if [ ! -f "$dir/$f" ] || [ -L "$dir/$f" ]; then
      die "복구 기록이 불완전합니다: $f"
    fi
  done
  record_engine="$dir/airlock-ledger"
  phase="$(cat "$dir/phase")"; before="$(cat "$dir/before")"; after="$(cat "$dir/after")"
  saved_platform="$(cat "$dir/platform")"; saved_machine="$(cat "$dir/machine")"
  config_path="$(cat "$dir/config-path")"; state_dir="$(cat "$dir/state-dir")"
  for f in before after config-path platform machine state-dir; do
    [ "$(snapshot_hash "$dir/$f")" = "$(cat "$dir/$f.sha256")" ] \
      || die "복구 기록의 metadata가 달라졌습니다: $f"
  done
  if [ -f "$dir/runtime-root" ]; then
    [ "$(snapshot_hash "$dir/runtime-root")" = "$(cat "$dir/runtime-root.sha256")" ] \
      || die "복구 기록의 metadata가 달라졌습니다: runtime-root"
    runtime_root="$(cat "$dir/runtime-root")"
  fi
  case "$state_dir" in /*) ;; *) die "복구 기록의 설치 상태 경로가 절대 경로가 아닙니다: $state_dir" ;; esac
  case "$phase" in
    failed|rollback-failed) ;;
    failed-unbound) die "실패 직후 설치 상태를 고정하지 못해 자동 롤백하지 않습니다" ;;
    installing) die "업데이트가 설치 중 끊겼지만 실패 직후 상태를 고정하지 못해 자동 롤백하지 않습니다" ;;
    *) die "롤백 자체가 '$phase' 단계에서 끊겨 자동 재개하지 않습니다 — 기록을 보존한 채 수동 점검이 필요합니다" ;;
  esac
  [ "$(platform)" = "$saved_platform" ] \
    || die "업데이트한 플랫폼($saved_platform)과 지금 플랫폼($(platform))이 다릅니다"
  machine="$saved_machine"
  if [ "$saved_platform" = Darwin ]; then
    [ -z "$requested_machine" ] || [ "$requested_machine" = "$saved_machine" ] \
      || die "업데이트 기록의 머신은 '$saved_machine' 입니다. '$requested_machine' 으로 바꿔 되돌리지 않습니다"
    machine="$(resolve_machine "$saved_machine" "$marker")" || return 1
  elif [ -n "$requested_machine" ]; then
    die "리눅스에서 기록하지 않은 --machine 을 붙여 되돌리지 않습니다"
  fi
  case "$before:$after" in
    *[!0-9a-f:]*|:*|*:) die "복구 기록의 Git revision 이 잘못됐습니다" ;;
  esac
  git cat-file -e "$before^{commit}" 2>/dev/null || die "업데이트 전 Git 객체가 없습니다: $before"
  git cat-file -e "$after^{commit}" 2>/dev/null || die "실패 업데이트 Git 객체가 없습니다: $after"
  if [ "$before" != "$after" ]; then
    parent="$(git rev-parse "$after^")" || die "실패 업데이트의 부모 revision 을 읽지 못했습니다"
    [ "$parent" = "$before" ] || die "실패 업데이트가 기록된 이전 revision 바로 위에 있지 않습니다"
  fi
  head="$(git rev-parse HEAD)" || die "현재 revision 을 읽지 못했습니다"
  case "$phase:$head" in
    failed:"$after"|rollback-failed:"$before") ;;
    *) die "현재 HEAD($head)가 복구 기록의 안전한 지점과 다릅니다" ;;
  esac
  dirty="$(git status --porcelain --untracked-files=all)" \
    || die "작업트리 변경 여부를 확인하지 못했습니다"
  if [ -d "$dir/local-files" ]; then
    for f in files.tar files.json restore.sh; do
      [ -f "$dir/local-files/$f" ] && [ ! -L "$dir/local-files/$f" ] \
        && [ -f "$dir/local-files/$f.sha256" ] && [ ! -L "$dir/local-files/$f.sha256" ] \
        && [ "$(snapshot_hash "$dir/local-files/$f")" = "$(cat "$dir/local-files/$f.sha256")" ] \
        || die "파일 복구 자료가 달라졌습니다: $f"
    done
  fi
  if [ "$phase" = rollback-failed ] && [ -d "$dir/local-files" ]; then
    local_files matches "$root" "$dir/local-files" \
      || die "롤백 뒤 로컬 파일이 원래 보관본과 달라져 덮어쓰지 않습니다"
  else
    [ -z "$dirty" ] || die "업데이트 뒤 별도 작업트리 변경이 있어 자동으로 지우지 않습니다:
$dirty"
  fi
  validate_snapshot "$dir" install-record.json
  validate_snapshot "$dir" plaintext-retirement.json
  [ "$(snapshot_hash "$dir/config.snapshot")" = "$(cat "$dir/config.snapshot.sha256")" ] \
    || die "보존한 airlock.toml 기준점의 해시가 달라졌습니다"
  if [ ! -f "$config_path" ] || [ -L "$config_path" ]; then
    die "업데이트 전 설정 경로가 일반 파일이 아니어서 되돌리지 않습니다: $config_path"
  fi
  cmp -s "$config_path" "$dir/config.snapshot" \
    || die "airlock.toml 의 정확한 bytes 가 업데이트 전과 달라져 자동으로 되돌리지 않습니다"

  if [ "$phase" = failed ]; then
    if [ ! -d "$dir/failed" ] || [ -L "$dir/failed" ]; then
      die "실패 직후 설치 상태 기록이 없습니다"
    fi
    if [ ! -f "$dir/failed/state-dir" ] || [ -L "$dir/failed/state-dir" ] \
       || ! cmp -s "$dir/state-dir" "$dir/failed/state-dir"; then
      die "실패 직후 설치 상태 경로 기록이 기준점과 다릅니다"
    fi
    validate_snapshot "$dir/failed" install-record.json
    validate_snapshot "$dir/failed" plaintext-retirement.json
    printf '%s\n' tearing-down >"$dir/phase"
    teardown_and_restore_box_state "$root" "$machine" "$state_dir" "$dir" "$dir/failed" \
      || die "실패 직후 상태가 달라졌거나 현재 설치 흔적 정리·이전 상태 복원을 끝내지 못했습니다"
    printf '%s\n' resetting-checkout >"$dir/phase"
    GIT_REFLOG_ACTION="airlock-update rollback $after -> $before" git reset --hard "$before" \
      || die "업데이트 전 checkout 으로 돌아가지 못했습니다"
  fi

  if [ -d "$dir/local-files" ]; then
    local_files restore "$root" "$dir/local-files" \
      || die "업데이트 전 로컬 파일 상태를 복원하지 못했습니다"
  fi

  printf '%s' "$$" >"$dir/pid"
  printf '%s\n' rollback-installing >"$dir/phase"
  say "이전 설치기를 다시 적용하는 중…"
  if [ "$saved_platform" = Darwin ]; then
    orb -m "$machine" env "AIRLOCK_CONFIG=/mnt/mac$config_path" "AIRLOCK_STATE_DIR=$state_dir" \
      bash "/mnt/mac$root/install/airlock-install.sh" || rc=$?
  else
    (cd "$runtime_root" && AIRLOCK_CONFIG="$config_path" AIRLOCK_STATE_DIR="$state_dir" \
      bash install/airlock-install.sh) || rc=$?
  fi
  if [ "$rc" != 0 ]; then
    printf '%s\n' rollback-failed >"$dir/phase"
    record_update_event "$git_dir" rollback-install-failed "$before" "$after" "$rc"
    say "checkout 과 상태 기록은 이전 것으로 돌렸지만 이전 설치기 재적용이 실패했습니다 (rc=$rc)."
    say "다시 시도:  AIRLOCK_DIR=\"$root\" bash \"$dir/airlock-update\" --rollback"
    return "$rc"
  fi
  box_status "$runtime_root" "$machine" "$state_dir" "$config_path" \
    >"$dir/status-after-rollback.json"; rc=$?
  if [ "$rc" != 0 ]; then
    printf '%s\n' rollback-failed >"$dir/phase"
    record_update_event "$git_dir" rollback-status-failed "$before" "$after" "$rc"
    say "이전 설치기는 적용됐지만 복구 상태 검증은 통과하지 못했습니다 (airlock-status rc=$rc)."
    [ "$rc" != 3 ] || say "rc=3 은 실패가 없더라도 확인 못 한 항목이 있어 성공이 아닙니다."
    return "$rc"
  fi
  record_update_event "$git_dir" rollback-ok "$before" "$after" 0
  git update-ref -d refs/airlock-update/rollback "$before" \
    || die "복구용 Git ref 를 정리하지 못했습니다"
  rm -rf -- "$dir"
  say "업데이트 전 checkout 과 Airlock 관리 상태로 되돌렸고, 상태 검증도 통과했습니다 (airlock-status rc=0)."
  say "범위: 앱 데이터·OS 패키지·OrbStack 머신 자체는 박스 백업 대상이며 이 롤백이 되감지 않습니다."
  return 0
}

# Record the applied release so a failed reinstall can identify its checkout.
# This is an operational record, not a contribution: authoring hooks and commit
# signing cannot block it. A real Git write failure still stops before installation;
# local edits remain available in the owner-private archive printed above.
checkout_undo_command() { # <root> <before-revision> <local-files-bundle>
  local root="$1" before="$2" bundle="$3" command="" restore=""
  if [ -n "$before" ]; then
    printf -v command 'git -C %q reset --hard %q' "$root" "$before"
  fi
  if [ -n "$bundle" ]; then
    printf -v restore 'bash %q %q' "$bundle/restore.sh" "$root"
    [ -z "$command" ] || command+=" && "
    command+="$restore"
  fi
  printf '%s' "$command"
}

commit_release_or_die() {
  local message="$1" before="$2" root="$3" bundle="$4" out
  if ! out="$(git -c user.name=airlock -c user.email=airlock@localhost \
                  -c commit.gpgsign=false \
                  commit -q --no-verify -m "$message" 2>&1)"; then
    case "$out" in *"nothing to commit"*|*"nothing added"*) return 0 ;; esac
    die "배포본 checkout 을 Git revision 으로 기록하지 못해 설치기를 실행하지 않습니다.
       이 revision 이 없으면 자동 롤백의 현재 지점을 증명할 수 없습니다.
       checkout 복원: $(checkout_undo_command "$root" "$before" "$bundle")
       git 이 한 말: ${out}"
  fi
}

# Names, not just a count: "바뀔 파일 3 개" is not something an operator can check.
report_list() {
  printf '%s' "$1" | grep -c . >/dev/null || return 0
  local total shown
  total="$(printf '%s' "$1" | grep -c .)"
  shown=12
  if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
    awk -v shown="$shown" 'length($0) > 0 { print "         " $0; if (++count >= shown) exit }' \
      <<<"$1" >&2
    [ "$total" -gt "$shown" ] && printf '         … 그리고 %s 개 더\n' "$((total - shown))" >&2
  else
    awk -v shown="$shown" 'length($0) > 0 { print "         " $0; if (++count >= shown) exit }' \
      <<<"$1"
    [ "$total" -gt "$shown" ] && printf '         … 그리고 %s 개 더\n' "$((total - shown))"
  fi
  return 0
}

# On a Mac the install lives in an OrbStack Linux machine, and its NAME is
# per-operator: docker/orbstack-machine-setup.sh falls back to `airlock`, but the
# install guide has people pass their own. Running the setup script without one would
# not update their machine — it would CREATE A SECOND ONE and install into it, which
# looks like a successful update and leaves the box they actually use untouched.
resolve_machine() {
  local given="$1" marker="$2" listing rc name found="" count
  command -v orb >/dev/null 2>&1 \
    || die "orb 을 찾지 못했습니다. OrbStack 을 한 번 실행한 뒤 다시 시도해 주세요."

  if [ -n "$given" ]; then
    # An explicit name gets the SAME check as a detected one. It is the documented
    # escape from every detection failure, so leaving it unchecked would put the
    # "second machine" outcome one typo away — and the setup script creates a machine
    # whose name it does not recognise rather than refusing.
    if orb run -m "$given" test -d "$marker" >/dev/null 2>&1; then
      printf '%s' "$given"; return 0
    fi
    die "'$given' 에서 Airlock 설치를 찾지 못했습니다.
       이름이 정확한지 봐 주세요 — 없는 이름을 주면 설치기가 그 이름으로 새 머신을 만듭니다.
       목록: $(orb list 2>/dev/null | sed 's/[[:cntrl:]]\[[0-9;]*m//g' | awk 'NR>0 && $1!="NAME" {printf "%s ", $1}')"
  fi

  say "Airlock 이 설치된 리눅스 머신을 찾는 중…" >&2
  # `orb list` failing is a different problem from "no machine has Airlock", and
  # reporting the second when it is the first sends the operator to --machine, which
  # is the one path that can build a machine they did not ask for.
  listing="$(orb list 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    die "OrbStack 에 머신 목록을 물어보지 못했습니다 (orb list 가 실패). OrbStack 이 켜져 있는지 봐 주세요."
  fi
  # Only machines that are ALREADY RUNNING are probed. `orb run` starts a stopped
  # machine, so probing everything would boot every OrbStack machine the operator has —
  # including ones that have nothing to do with Airlock — as a side effect of asking a
  # question. Stopped ones are named at the end instead, so a stopped Airlock machine is
  # still findable, by --machine, which starts exactly the one they chose.
  #
  # Strip ANSI: orb prints no colour into a pipe today (measured on the Mac mini), but a
  # coloured name would silently match nothing and end up at --machine.
  local skipped=""
  while IFS=$'\t' read -r name state; do
    [ -n "$name" ] || continue
    case "$name" in NAME) continue ;; esac
    if [ -n "$state" ] && [ "$state" != running ]; then
      skipped="$skipped$name ($state)"$'\n'
      continue
    fi
    if orb run -m "$name" test -d "$marker" >/dev/null 2>&1; then
      found="$found$name"$'\n'
    fi
  done <<EOF
$(printf '%s\n' "$listing" | sed 's/[[:cntrl:]]\[[0-9;]*m//g' | awk '{printf "%s\t%s\n", $1, $2}')
EOF
  count="$(awk 'NF { count++ } END { print count + 0 }' <<<"$found")"
  case "$count" in
    1) name="$(awk 'NF { print; exit }' <<<"$found")"
       say "찾았습니다: $name" >&2; printf '%s' "$name"; return 0 ;;
    0) die "돌고 있는 머신 중에 Airlock 이 설치된 것을 찾지 못했습니다.$(
         [ -n "$skipped" ] && printf '\n       %s' "멈춰 있어 확인하지 않은 머신: $(printf '%s' "$skipped" | tr '\n' ' ')"
       )
       머신 이름을 아시면 이렇게 알려 주세요:  bash bin/airlock-update --machine <이름>
       (설치할 때 쓰신 이름입니다. 'orb list' 로 목록을 볼 수 있습니다)" ;;
    *) die "Airlock 이 설치된 머신이 여러 개입니다:
$(printf '%s' "$found" | grep . | sed 's/^/         /')
       어느 것을 갱신할지 골라 주세요:  bash bin/airlock-update --machine <이름>" ;;
  esac
}

main "$@"
}
airlock_update_program "$@"
