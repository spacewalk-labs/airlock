#!/usr/bin/env bash
# Fetch a release, preserve operator history/edits, then run its installer.
# One outer function makes a truncated curl | bash transfer a syntax error.
set -uo pipefail
airlock_update_program() {
say() { printf '[airlock-update] %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }
airlock_escape_selfkill_cgroup() {
  [ "${AIRLOCK_DRY_RUN:-0}" = 1 ] && return 0
  [ -n "${AIRLOCK_SELFKILL_ESCAPED:-}" ] && return 0
  local cgroup_file="${AIRLOCK_SELFKILL_CGROUP_FILE:-/proc/self/cgroup}"
  [ -r "$cgroup_file" ] || return 0

  local cgroup path unit
  cgroup="$(cat "$cgroup_file" 2>/dev/null || true)"
  path="$(printf '%s\n' "$cgroup" | sed -n 's|^0::||p' | head -n1)"
  [ -n "$path" ] || return 0
  unit="${path##*/}"

  case "$path" in */user@*.service/*) ;; *) return 0 ;; esac
  case "$unit" in airlock-*.service) ;; *) return 0 ;; esac

  say "this run is inside ${unit} — the same unit the update stops and restarts"
  say "  measured cgroup: ${cgroup}"
  say "  stopping ${unit} from in here would kill this run mid-update, so moving out"
  say "  to its own scope"

  local runner="${AIRLOCK_SELFKILL_SYSTEMD_RUN:-systemd-run}"
  if ! command -v "$runner" >/dev/null 2>&1; then
    say "WARNING: ${runner} not found — continuing INSIDE ${unit}. If the update"
    say "  stops that unit this run dies mid-way. Re-run detached instead:"
    say "    systemd-run --user --scope --collect bash $*"
    return 0
  fi
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    say "  no systemd --user manager reachable — nothing here stops that unit,"
    say "  so continuing in place"
    return 0
  fi

  local esc_unit
  esc_unit="airlock-update-$$-$(date +%s)"
  say "  moving to: ${runner} --user --unit=${esc_unit} -- bash $*"
  say "  live output: journalctl --user -u ${esc_unit} -f"

  local -a esc_env=()
  local _n
  for _n in $(compgen -e 2>/dev/null | grep '^AIRLOCK_' || true); do
    [ "$_n" = AIRLOCK_SELFKILL_ESCAPED ] && continue
    esc_env+=("--setenv=${_n}")
  done
  esc_env+=("--setenv=PATH")

  local _manager_env _manager_rc=0
  _manager_env="$(systemctl --user show-environment 2>/dev/null)" || _manager_rc=$?
  if [ "$_manager_rc" -ne 0 ]; then
    say "  WARNING: could not read the user manager's environment (rc=${_manager_rc});"
    say "    a stale AIRLOCK_* it holds could reach the escaped run"
    _manager_env=""
  else
    _manager_env="$(printf '%s\n' "$_manager_env" \
      | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p')"
  fi
  for _n in $(printf '%s\n' "$_manager_env" | grep '^AIRLOCK_' || true); do
    [ "$_n" = AIRLOCK_SELFKILL_ESCAPED ] && continue
    [ -n "${!_n+x}" ] || esc_env+=("--setenv=${_n}=")
  done

  local rc=0
  "$runner" --user --unit="$esc_unit" --service-type=exec --collect --quiet --wait \
    --same-dir \
    --setenv=AIRLOCK_SELFKILL_ESCAPED=1 \
    "${esc_env[@]}" \
    -- bash "$@" || rc=$?
  if [ "$rc" -eq 0 ]; then
    say "  escaped run finished (unit ${esc_unit})"
    exit 0
  fi
  if [ "$rc" -eq 127 ] || [ "$rc" -eq 126 ]; then
    say "WARNING: could not move out of ${unit} (${runner} rc=${rc}) — continuing in"
    say "  place. If this run dies at a 'Stopping ${unit}' line, that is why."
    return 0
  fi
  say "  escaped run failed (unit ${esc_unit}, rc=${rc}) — its log:"
  say "    journalctl --user -u ${esc_unit}"
  exit "$rc"
}

main() {
  local dry=0 json=0 install=1 machine="${AIRLOCK_MACHINE:-}"
  local url="${AIRLOCK_RELEASE_URL:-https://github.com/spacewalk-labs/airlock}"
  local ref="${AIRLOCK_RELEASE_REF:-main}" root="${AIRLOCK_DIR:-}"
  local -a original=("$@")
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1 ;;
      --json) json=1 ;;
      --no-install) install=0 ;;
      --machine) shift; machine="${1:?--machine requires a name}" ;;
      --machine=*) machine="${1#*=}" ;;
      --help|-h)
        printf '%s\n' 'airlock-update [--dry-run [--json]] [--no-install] [--machine NAME]' \
          'AIRLOCK_DIR, AIRLOCK_RELEASE_URL and AIRLOCK_RELEASE_REF select checkout/release.'
        return 0 ;;
      *) die "Unknown option: $1" ;;
    esac
    shift
  done
  if [ -z "$root" ]; then
    local source="${BASH_SOURCE[0]:-}"
    if [ -f "$source" ]; then root="$(cd "$(dirname "$source")/.." && pwd)"; fi
    root="${root:-$HOME/workspace/airlock}"
  fi
  cd "$root" || return 1
  root="$(pwd -P)"
  if [ "$dry" = 0 ]; then airlock_escape_selfkill_cgroup "$0" "${original[@]}"; fi
  python3 - "$root" "$url" "$ref" "$dry" "$json" <<'PYTHON'
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile

root, url, ref, dry, output_json = sys.argv[1:]
root = Path(root)
dry = dry == '1'

def git(*args, env=None, check=True, data=None):
    result = subprocess.run(['git', '-C', str(root), *args], input=data,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            env=env, check=False)
    if check and result.returncode:
        raise RuntimeError(result.stderr.decode(errors='replace').strip())
    return result.stdout

def tree(revision):
    if not revision:
        return {}
    result = {}
    for row in git('ls-tree', '-rz', revision).split(b'\0'):
        if row:
            header, name = row.split(b'\t', 1)
            mode, kind, oid = header.decode().split()
            result[os.fsdecode(name)] = (mode, oid)
    return result

def blob(entry):
    return git('cat-file', 'blob', entry[1])

def node(path):
    # lstat each ancestor: an operator link must never lead writes outside checkout.
    for parent in reversed(path.parents):
        if parent == root or root not in parent.parents:
            continue
        if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
            return None
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(mode):
        return ('link', os.readlink(path), stat.S_IMODE(mode))
    if stat.S_ISREG(mode):
        return ('file', path.read_bytes(), stat.S_IMODE(mode))
    if stat.S_ISDIR(mode):
        return ('dir', {p.name: node(p) for p in path.iterdir()}, stat.S_IMODE(mode))
    return None

def matches(value, entry):
    if entry is None:
        return value is None
    if value is None:
        return False
    mode, _ = entry
    if mode == '120000':
        return value[0] == 'link' and os.fsencode(value[1]) == blob(entry)
    return (value[0] == 'file' and value[1] == blob(entry)
            and bool(value[2] & 0o111) == (mode == '100755'))

def matches_path(value, name, entries):
    if value is None or value[0] != 'dir':
        return matches(value, entries.get(name))
    children = {key[len(name) + 1:].split('/')[0] for key in entries
                if key.startswith(name + '/')}
    return (set(value[1]) == children and
            all(matches_path(child, name + '/' + key, entries)
                for key, child in value[1].items()))

def remove(path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)

def write(path, value):
    # Prepare each release leaf before replacing its old bytes. A failed write
    # leaves the previous leaf available for the next ordinary update.
    path.parent.mkdir(parents=True, exist_ok=True)
    kind, content, mode = value
    with tempfile.TemporaryDirectory(prefix='.airlock-write-', dir=path.parent) as temporary:
        staged = Path(temporary) / 'leaf'
        if kind == 'link':
            staged.symlink_to(content)
        else:
            staged.write_bytes(content)
            staged.chmod(mode)
        if path.is_dir() and not path.is_symlink():
            remove(path)
        os.replace(staged, path)

def restore(path, value):
    remove(path)
    if value is None:
        return
    if value[0] == 'dir':
        path.mkdir(parents=True, exist_ok=True)
        for name, child in value[1].items():
            restore(path / name, child)
        path.chmod(value[2])
    else:
        write(path, value)

try:
    with tempfile.TemporaryDirectory(prefix='airlock-update-') as temporary:
        temp = Path(temporary)
        # All preview fetch/index writes belong to a disposable repository.
        env = os.environ.copy()
        if dry:
            git('init', '--bare', '-q', str(temp / 'preview.git'))
            original = git('rev-parse', '--git-common-dir', check=False).decode().strip()
            if original:
                common = (root / original).resolve()
                env['GIT_ALTERNATE_OBJECT_DIRECTORIES'] = str(common / 'objects')
            env.update(GIT_DIR=str(temp / 'preview.git'), GIT_WORK_TREE=str(root))
        elif not (root / '.git').exists():
            git('init', '-q')
        head = git('rev-parse', '--verify', 'HEAD', check=False).decode().strip()
        previous_release = git('rev-parse', '--verify',
                               'refs/remotes/airlock-release/main^{commit}',
                               check=False).decode().strip()
        if not dry:
            # URL fetches replaced this product-owned remote; keep its source ref.
            git('config', '--remove-section', 'remote.airlock-release', check=False)
        print('[airlock-update] Fetching %s %s' % (url, ref), file=sys.stderr)
        git('fetch', '-q', url, ref, env=env)
        release = git('rev-parse', 'FETCH_HEAD^{commit}', env=env).decode().strip()
        # Explicit prior update receipt, solely for ownership/edit comparison.
        # Release direction never decides whether this update may run.
        prior = ''
        if head:
            subjects = git('log', '--first-parent', '--format=%s',
                           '--grep=^airlock-update: 배포본 ', '-1').decode()
            match = re.search(r'airlock-update: 배포본 ([0-9a-f]+)', subjects)
            if match:
                prior = git('rev-parse', '--verify', match[1] + '^{commit}',
                            env=env, check=False).decode().strip()
        # ls-tree/blob reads above and below share fetched preview objects.
        if dry:
            os.environ.update({k: env[k] for k in ('GIT_DIR', 'GIT_WORK_TREE')})
            if 'GIT_ALTERNATE_OBJECT_DIRECTORIES' in env:
                os.environ['GIT_ALTERNATE_OBJECT_DIRECTORIES'] = env['GIT_ALTERNATE_OBJECT_DIRECTORIES']
        old_head = tree(head)
        indexed = {}
        for row in git('ls-files', '--stage', '-z', check=False).split(b'\0'):
            if row:
                header, name = row.split(b'\t', 1)
                mode, oid, stage = header.decode().split()
                if stage == '0':
                    indexed[os.fsdecode(name)] = (mode, oid)
        # A normal clone shares its installed release with the fetched tree.
        # An operator-created repository starts at its initial install commit.
        installed = prior
        release_baseline = bool(prior)
        if not installed and head:
            # A clone's upstream records the release it was installed from,
            # even when the requested release is older than that checkout.
            upstream = git('rev-parse', '--verify', '@{upstream}^{commit}',
                           check=False).decode().strip()
            shared = git('merge-base', upstream, release, env=env,
                         check=False).decode().strip() if upstream else ''
            installed = git('merge-base', head, upstream if shared else release,
                            env=env, check=False).decode().strip()
            release_baseline = bool(installed)
            if not installed:
                installed = git('rev-list', '--first-parent', '--max-parents=0',
                                head).decode().splitlines()[0]
        baseline = tree(installed)
        if installed and not release_baseline:
            # An operator's initial commit may mix shipped source and private
            # files. Only the same path/mode/blob in a released Git tree is a
            # source baseline; initial membership alone establishes no ownership.
            unmatched = dict(baseline)
            baseline = {}
            for revision in git('rev-list', release).decode().splitlines():
                released = tree(revision)
                for name, entry in list(unmatched.items()):
                    if released.get(name) == entry:
                        baseline[name] = unmatched.pop(name)
                if not unmatched:
                    break
        previous_source = tree(previous_release)
        incoming = tree(release)
        owned_paths = set(baseline) | set(previous_source)
        retired = owned_paths - set(incoming)
        def release_owned(value, name):
            return matches_path(value, name, baseline) or (previous_release
                    and matches_path(value, name, previous_source))
        preserve = set()
        for name in set(incoming) | retired:
            path = root / name
            # Capture a changed parent as one node (including dangling symlinks).
            for parent in reversed(path.parents):
                if parent == root or root not in parent.parents:
                    continue
                if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
                    parent_name = str(parent.relative_to(root))
                    if not release_owned(node(parent), parent_name):
                        preserve.add(parent_name)
                    break
            else:
                value = node(path)
                if head and not release_owned(value, name):
                    preserve.add(name)
                elif not head and value is not None:
                    # Without history existing conflicting bytes have no baseline.
                    preserve.add(name)
        def operator_path(name):
            return any(name == saved or name.startswith(saved + '/')
                       or saved.startswith(name + '/') for saved in preserve)
        if dry:
            changed = [name for name in sorted(set(incoming) | retired)
                       if not operator_path(name)
                       and not matches(node(root / name), incoming.get(name))]
            if output_json == '1':
                print(json.dumps({'available': bool(changed), 'changedCount': len(changed),
                                  'ref': release}, separators=(',', ':')))
            else:
                print('[airlock-update] 바뀔 파일 %d 개:' % len(changed))
                print('\n'.join(changed))
            sys.exit(0)
        stage_delta = {name: indexed.get(name) for name in set(indexed) | set(old_head)
                       if indexed.get(name) != old_head.get(name)}
        next_tree = dict(old_head)
        next_tree.update(incoming)
        for name in retired:
            next_tree.pop(name, None)
        # Remove file/directory collisions from the release index overlay.
        for name in incoming:
            for other in list(next_tree):
                if other != name and (name.startswith(other + '/') or other.startswith(name + '/')):
                    if other not in incoming:
                        del next_tree[other]
        index_env = os.environ.copy()
        index_env['GIT_INDEX_FILE'] = str(temp / 'index')
        git('read-tree', '--empty', env=index_env)
        def set_entries(entries, index_env):
            records = b''.join((('%s %s\t' % (entry[0], entry[1])).encode() + os.fsencode(name) + b'\0')
                               if entry else b'0 ' + b'0'*40 + b'\t' + os.fsencode(name) + b'\0'
                               for name, entry in entries.items())
            git('update-index', '-z', '--index-info', env=index_env, data=records)
        set_entries(next_tree, index_env)
        new_tree = git('write-tree', env=index_env).decode().strip()
        staging = dict(next_tree)
        for name, entry in stage_delta.items():
            if entry:
                for other in list(staging):
                    if other != name and (name.startswith(other + '/') or other.startswith(name + '/')):
                        del staging[other]
                staging[name] = entry
            else:
                staging.pop(name, None)
        identity = os.environ.copy()
        identity.setdefault('GIT_AUTHOR_NAME', 'Airlock')
        identity.setdefault('GIT_AUTHOR_EMAIL', 'airlock@localhost')
        identity.setdefault('GIT_COMMITTER_NAME', 'Airlock')
        identity.setdefault('GIT_COMMITTER_EMAIL', 'airlock@localhost')
        # This existing Git source ref records only source leaves actually
        # applied. Failed writes never claim bytes; later targets apply directly.
        ownership = dict(baseline)
        ownership.update(previous_source)
        owned_env = os.environ.copy()
        owned_env['GIT_INDEX_FILE'] = str(temp / 'source-index')
        git('read-tree', '--empty', env=owned_env)
        set_entries(ownership, owned_env)
        source_parents = ['-p', release]
        if prior and prior != release:
            source_parents.extend(['-p', prior])
        def record_source():
            owned_tree = git('write-tree', env=owned_env).decode().strip()
            source_commit = git('commit-tree', owned_tree, *source_parents,
                                env=identity, data=b'airlock-update: source bytes\n').decode().strip()
            git('update-ref', 'refs/remotes/airlock-release/main', source_commit)
        def remember(name, entry):
            changes = {}
            if entry:
                for other in list(ownership):
                    if other != name and (name.startswith(other + '/') or other.startswith(name + '/')):
                        ownership.pop(other)
                        changes[other] = None
                ownership[name] = entry
            else:
                ownership.pop(name, None)
            changes[name] = entry
            set_entries(changes, owned_env)
            record_source()
        def change_leaf(name, entry, value):
            path = root / name
            before = node(path)
            try:
                if value is None:
                    remove(path)
                else:
                    write(path, value)
                remember(name, entry)
            except (OSError, RuntimeError):
                # A leaf is owned only once its source ref records it. Undo this
                # one mutation immediately if either write fails.
                restore(path, before)
                raise
        # Retire only recorded release paths, keeping operator nodes in place.
        for name in sorted(retired, key=lambda name: name.count('/'), reverse=True):
            if operator_path(name):
                continue
            path = root / name
            if node(path) is not None and (path.is_symlink() or not path.is_dir()):
                change_leaf(name, None, None)
            else:
                remember(name, None)
        for name, entry in sorted(incoming.items()):
            if operator_path(name):
                continue
            path = root / name
            for parent in reversed(path.parents):
                if parent == root or root not in parent.parents:
                    continue
                if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
                    change_leaf(str(parent.relative_to(root)), None, None)
            mode, _ = entry
            value = ('link', os.fsdecode(blob(entry)), 0o777) if mode == '120000' else (
                'file', blob(entry), 0o755 if mode == '100755' else 0o644)
            if not matches(node(path), entry):
                change_leaf(name, entry, value)
        record_source()
        # Record the completed release only after its disk writes succeed.
        git('read-tree', '--empty', env=index_env)
        set_entries(staging, index_env)
        staging_tree = git('write-tree', env=index_env).decode().strip()
        if (head and release == prior
                and new_tree == git('rev-parse', head + '^{tree}').decode().strip()):
            commit = head
        else:
            parents = ['-p', head] if head else []
            commit = git('commit-tree', new_tree, *parents, env=identity,
                         data=('airlock-update: 배포본 %s 으로 갱신\n' % release).encode()).decode().strip()
            git('update-ref', 'HEAD', commit, *([head] if head else []))
        # A failed HEAD write must not turn updater bytes into operator staging.
        # Publish the prepared index with one native atomic write after HEAD.
        git('read-tree', staging_tree)
        print('[airlock-update] 갱신했습니다. 운영자 편집 %d 개를 유지했습니다.' % len(preserve))

except (OSError, RuntimeError) as exc:
    print('[airlock-update] %s' % exc, file=sys.stderr)
    sys.exit(1)
PYTHON
  local rc=$?
  [ "$rc" = 0 ] || return "$rc"
  [ "$dry" = 0 ] && [ "$install" = 1 ] || return 0
  if [ "${AIRLOCK_UPDATE_UNAME:-$(uname -s)}" = Darwin ]; then
    AIRLOCK_MACHINE="$machine" bash docker/orbstack-machine-setup.sh
  else
    bash install/airlock-install.sh
  fi
}
main "$@"
}
airlock_update_program "$@"
