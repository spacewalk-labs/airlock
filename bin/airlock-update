#!/usr/bin/env bash
# bin/airlock-update — update an installed Airlock to the released tree, then re-run
# the installer over it.
#
#   bash bin/airlock-update              # update ~/workspace/airlock (or this checkout)
#   bash bin/airlock-update --dry-run    # show what would change; change nothing
#   bash bin/airlock-update --no-install # replace the files, skip the reinstall
#   bash bin/airlock-update --rollback   # restore the last failed update
#   bash bin/airlock-update --machine m  # name the Linux machine instead of detecting it
#   bash bin/airlock-update --from-unknown  # a box no published release can identify
#                                           # (installed before 2026-08-21): see below
#
# It also runs with no checkout in hand, which is how the FIRST update happens — the
# installed tree predates this file, so there is nothing to invoke locally:
#
#   curl -fsSL https://raw.githubusercontent.com/spacewalk-labs/airlock/main/bin/airlock-update | bash
#
# ---------------------------------------------------------------------------------
# Why this is not `git pull`.
#
# The documented install (and every box that followed it) does `git clone --depth=1`,
# then `rm -rf .git`, then `git init` — deliberately, so the operator owns their copy
# and can commit their own config. The consequence is that no installed box has a
# remote pointing here, and the history it does have shares no commit with ours. So
# `git pull` has nothing to pull, and `git merge --allow-unrelated-histories` resolves
# against an EMPTY merge base, which makes a conflict out of every file that changed
# on either side. Neither is an update path.
#
# What works is that a git tree is content-addressed independently of history:
# `git checkout <ref> -- .` writes a tree into the working copy and does not care
# whether the ref is an ancestor. So this fetches the release, writes it over the
# checkout, and commits the result to the operator's OWN repository — which is what
# makes the update reversible without us having to build a backup mechanism.
#
# The executable program is inside one outer function, called on the last line. A
# `curl | bash` that is cut off mid-transfer then runs NOTHING instead of running the
# first half: bash executes what it has read so far, and a truncated outer function is
# a syntax error, not a partial update. (Measured: an earlier draft, truncated,
# replaced every file and exited 0 without committing or re-running the installer.)
# ---------------------------------------------------------------------------------
set -uo pipefail

airlock_update_program() {
main() {
  # Internal state never comes from an ambient caller.  The capsule wrapper writes
  # its fixed root after the function definition; an ordinary file invocation
  # scrubs AIRLOCK_UPDATE_CAPSULE_ROOT immediately before calling this function.
  unset AIRLOCK_UPDATE_KEEPER_PID
  trap cleanup_update_capsule EXIT
  # Managed authority is never inherited from a caller.  U1 derives it only from
  # the fixed root-owned anchor; scrub both the established consumer/projector
  # variables and future update-channel lookalikes before any mode decision.
  local _managed_name
  while IFS='=' read -r _managed_name _; do
    case "$_managed_name" in
      AIRLOCK_MANAGED_*|AIRLOCK_UPDATE_CHANNEL_*) unset "$_managed_name" ;;
    esac
  done < <(env)

  local RELEASE_URL="${AIRLOCK_RELEASE_URL:-https://github.com/spacewalk-labs/airlock}"
  local RELEASE_REF="${AIRLOCK_RELEASE_REF:-main}"
  # A remote of our own, so we never touch `origin` — on an installed box that is the
  # operator's private repository and the only copy of their edits.
  local RELEASE_REMOTE=airlock-release
  # The install guide pins this location; it is the fallback when the script is piped
  # in from curl and has no checkout around it to infer from.
  local DEFAULT_DIR="${AIRLOCK_DIR:-$HOME/workspace/airlock}"
  # Present after every install, before and after the ledger existed (the webroot,
  # install/airlock-install.sh). Version-independent, which is the point: the boxes
  # this has to recognise were installed by code that no longer exists here.
  local MACHINE_MARKER=/opt/airlock/hub

  local -a original_argv=("$@")
  local dry=0 do_install=1 rollback=0 machine="" from_unknown=0 unknown_hint=0
  local managed_release_source="" managed_snapshot_digest=""
  local managed_refresh_source="" managed_status=0
  while [ $# -gt 0 ]; do
    case "$1" in
    --dry-run)    dry=1 ;;
    --json)       AIRLOCK_UPDATE_JSON=1 ;;
      --no-install) do_install=0 ;;
      --from-unknown) from_unknown=1 ;;
      --rollback)   rollback=1 ;;
      --machine)    shift; [ $# -gt 0 ] || die "--machine 뒤에 머신 이름이 필요합니다"; machine="$1" ;;
      --machine=*)  machine="${1#--machine=}" ;;
      --managed-release-source=*)
        [ -z "$managed_release_source" ] \
          || die "--managed-release-source 는 한 번만 지정할 수 있습니다"
        managed_release_source="${1#--managed-release-source=}"
        [ -n "$managed_release_source" ] \
          || die "--managed-release-source 에 완성된 local release 디렉터리가 필요합니다" ;;
      --managed-snapshot-digest=*)
        [ -z "$managed_snapshot_digest" ] \
          || die "--managed-snapshot-digest 는 한 번만 지정할 수 있습니다"
        managed_snapshot_digest="${1#--managed-snapshot-digest=}"
        [[ "$managed_snapshot_digest" =~ ^sha256:[0-9a-f]{64}$ ]] \
          || die "--managed-snapshot-digest 는 sha256:<64 lowercase hex> 여야 합니다" ;;
      --managed-refresh=*)
        [ -z "$managed_refresh_source" ] \
          || die "--managed-refresh 는 한 번만 지정할 수 있습니다"
        managed_refresh_source="${1#--managed-refresh=}"
        [ -n "$managed_refresh_source" ] \
          || die "--managed-refresh 에 완성된 서명 release 디렉터리가 필요합니다" ;;
      --managed-status) managed_status=1 ;;
      --managed-release-source|--managed-snapshot-digest|--managed-refresh)
        die "$1 는 =<값> 형식으로 지정해야 합니다" ;;
      -h|--help)    usage; return 0 ;;
      *)            die "모르는 옵션: $1" ;;
    esac
    shift
  done
  if [ "$rollback" = 1 ] && { [ "$dry" = 1 ] || [ "$do_install" = 0 ] || [ "$from_unknown" = 1 ]; }; then
    die "--rollback 은 --dry-run·--no-install·--from-unknown 과 함께 쓸 수 없습니다"
  fi
  if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ] && [ "$dry" != 1 ]; then
    die "--json 은 --dry-run 과 함께만 쓸 수 있습니다"
  fi
  if { [ -n "$managed_refresh_source" ] || [ "$managed_status" = 1 ]; } \
     && { [ "$dry" = 1 ] || [ "$do_install" != 1 ] || [ "$rollback" = 1 ] \
          || [ "$from_unknown" = 1 ] || [ -n "$managed_snapshot_digest" ] \
          || [ -n "$managed_release_source" ] || [ -n "$machine" ] \
          || [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; }; then
    die "--managed-refresh·--managed-status 는 다른 옵션과 함께 쓸 수 없습니다"
  fi
  # The store modes answer in JSON on stdout; every sentence from here on is stderr.
  if [ -n "$managed_refresh_source" ] || [ "$managed_status" = 1 ]; then
    AIRLOCK_UPDATE_JSON=1
  fi
  if [ -n "$managed_release_source" ] && [ -z "$managed_snapshot_digest" ]; then
    die "--managed-release-source 는 exact --managed-snapshot-digest 와 함께 지정해야 합니다"
  fi
  if [ -n "$managed_snapshot_digest" ] \
     && { [ "$dry" = 1 ] || [ "$do_install" != 1 ] || [ "$rollback" = 1 ]; }; then
    die "managed release 입력은 실제 install update 에서만 사용할 수 있습니다"
  fi

  local ROOT=""
  if [ -n "${AIRLOCK_DIR:-}" ]; then
    # An explicit path wins over everything: the operator is telling us where it is.
    is_checkout "$AIRLOCK_DIR" && ROOT="$AIRLOCK_DIR"
  else
    local _src="${BASH_SOURCE[0]:-}" _here _cand
    if [ -n "$_src" ] && [ -f "$_src" ]; then
      _here="$(cd "$(dirname "$_src")" && pwd)"
      _cand="$(cd "$_here/.." && pwd)"
      is_checkout "$_cand" && ROOT="$_cand"
    fi
    [ -n "$ROOT" ] || { is_checkout "$DEFAULT_DIR" && ROOT="$DEFAULT_DIR"; }
  fi

  if [ -z "$ROOT" ]; then
    die "Airlock 설치본을 찾지 못했습니다.
       찾은 곳: $DEFAULT_DIR
       다른 곳에 있으면 그 경로를 알려 주세요:  AIRLOCK_DIR=/경로 bash bin/airlock-update"
  fi

  # AIRLOCK_FIXTURE_BOUNDARY_CALL — the regression fixture mutates this exact call.
  fixture_boundary "$ROOT" "$dry" "$machine" \
    || die "unsafe fixture execution refused before live effects"

  command -v git >/dev/null 2>&1 \
    || die "git 이 없습니다. 맥이면 터미널에서 'xcode-select --install' 을 한 번 실행하세요."

  if [ "$dry" != 1 ] && [ "$managed_status" != 1 ]; then
    local lease_reason=update
    [ "$rollback" != 1 ] || lease_reason=rollback
    [ -z "$managed_refresh_source" ] || lease_reason=managed-refresh
    # AIRLOCK_UPDATE_LIVE_BOX_LEASE_CALL — the regression fixture mutates this boundary.
    enter_update_live_box_lease \
      "$ROOT" "$lease_reason" "$RELEASE_URL" "$RELEASE_REF" "${original_argv[@]}"
  fi

  cd "$ROOT" || die "$ROOT 로 들어가지 못했습니다"
  trap 'release_update_mutex; cleanup_update_capsule' EXIT
  say "대상: $ROOT"

  if [ "$rollback" = 1 ]; then
    [ -d .git ] || die "되돌릴 업데이트 기록이 없습니다 (.git 없음)"
    rollback_update "$ROOT" "$machine" "$MACHINE_MARKER"
    return $?
  fi

  # ---------------------------------------------------------------- 1) 저장소
  #
  # Everything below rewrites files in place, so the state before it must be
  # recoverable. The operator's own repository IS the backup: one commit before, one
  # after, and the update is `git reset --hard` away from being undone. A box that
  # never ran `git init` gets one here rather than a second, hand-rolled backup path
  # to keep correct.
  local scratch scratch_created
  scratch_created="$(mktemp -d)" \
    || die "업데이트용 비공개 임시 디렉터리를 만들지 못했습니다"
  scratch="$(canonical_private_scratch "$scratch_created")" || {
    rmdir -- "$scratch_created" 2>/dev/null || true
    die "업데이트용 임시 디렉터리를 안전한 절대 경로로 고정하지 못했습니다"
  }
  # shellcheck disable=SC2064   # $scratch must expand now, not at trap time
  trap "release_update_mutex; rm -rf '$scratch'; cleanup_update_capsule" EXIT
  if [ "$dry" = 1 ] && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    local source_git_dir="" source_common_dir="" preview_git_dir="$scratch/preview.git"
    source_git_dir="$(git -C "$ROOT" rev-parse --path-format=absolute --git-dir 2>/dev/null)" \
      || die "미리보기에서 원본 Git 메타데이터 경로를 읽지 못했습니다"
    source_common_dir="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
      || die "미리보기에서 공통 Git 메타데이터 경로를 읽지 못했습니다"
    acquire_update_mutex "$source_common_dir"
    mkdir -p "$preview_git_dir" \
      || die "미리보기용 임시 Git 메타데이터 디렉터리를 만들지 못했습니다"
    if ! tar -C "$source_common_dir" --exclude=objects -cf - . \
      | tar -C "$preview_git_dir" -xf -; then
      die "미리보기용 임시 Git 메타데이터를 복제하지 못했습니다"
    fi
    if [ "$source_git_dir" != "$source_common_dir" ]; then
      cp -- "$source_git_dir/HEAD" "$preview_git_dir/HEAD" \
        || die "미리보기용 worktree HEAD 를 고정하지 못했습니다"
      if [ -f "$source_git_dir/index" ]; then
        cp -- "$source_git_dir/index" "$preview_git_dir/index" \
          || die "미리보기용 worktree index 를 고정하지 못했습니다"
      else
        rm -f -- "$preview_git_dir/index"
      fi
      if [ -f "$source_git_dir/config.worktree" ]; then
        cp -- "$source_git_dir/config.worktree" "$preview_git_dir/config.worktree" \
          || die "미리보기용 worktree config 를 고정하지 못했습니다"
      fi
      rm -f -- "$preview_git_dir/commondir"
    fi
    mkdir -p "$preview_git_dir/objects" \
      || die "미리보기용 임시 Git 메타데이터를 복제하지 못했습니다"
    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_common_dir/objects"
    export GIT_DIR="$preview_git_dir" GIT_WORK_TREE="$ROOT"
  fi
  if [ -n "$managed_refresh_source" ] || [ "$managed_status" = 1 ]; then
    # A catalog refresh is not an install.  These two modes read or replace only the
    # verified local managed snapshot and print the store view; they never fetch the
    # public core, touch the checkout, arm a recovery or start the installer.
    [ "$(platform)" != Darwin ] || die "managed store 는 Linux 설치본에만 연결되어 있습니다"
    { [ -e /etc/airlock/managed-channel.json ] || [ -L /etc/airlock/managed-channel.json ]; } \
      || die "managed store 에는 고정된 /etc/airlock/managed-channel.json 등록이 필요합니다"
    prepare_managed_update_context "$scratch" "$scratch/managed-context.json" \
      || die "고정된 managed channel 등록과 trusted measurer 를 검증하지 못했습니다"
    if [ -n "$managed_refresh_source" ]; then
      [ -d .git ] || die "managed refresh 는 Git 설치본에서만 실행합니다"
      managed_refresh_admitted_or_die "$scratch" "$ROOT"
      acquire_update_mutex "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
      managed_refresh_installed "$scratch" "$managed_refresh_source" \
        || die "reason=refresh-refused 서명 release 를 managed cache 에 반영하지 못했습니다 — 이전 snapshot 을 그대로 둡니다"
    fi
    managed_store_status "$scratch" "$ROOT" \
      || die "managed store 상태를 검증된 cache 에서 만들지 못했습니다"
    return 0
  fi
  local managed_context=""
  if [ "$dry" != 1 ] && [ "$do_install" = 1 ] && [ "$(platform)" != Darwin ] \
     && { [ -e /etc/airlock/managed-channel.json ] \
          || [ -L /etc/airlock/managed-channel.json ]; }; then
    managed_context="$scratch/managed-context.json"
    prepare_managed_update_context "$scratch" "$managed_context" \
      || die "고정된 managed channel 등록과 trusted measurer 를 검증하지 못했습니다"
  fi
  if [ ! -d .git ]; then
    if [ "$dry" = 1 ]; then
      # A preview must not create a repository in someone's directory, but every
      # comparison below is a git operation. So the preview gets a THROWAWAY git
      # directory pointed at their files: the index and objects land in $scratch and
      # their tree is never written to. An earlier draft just skipped `git init` here
      # and then ran `git remote add` in a non-repository, so --dry-run died on
      # exactly the boxes it existed for — and three tests passed anyway, because the
      # failure and the intended behaviour look identical from outside (nothing
      # changed).
      say "[미리보기] 이 폴더는 아직 git 저장소가 아닙니다 — 임시 저장소로 비교만 합니다."
      export GIT_DIR="$scratch/preview.git" GIT_WORK_TREE="$ROOT"
      git init -q 2>/dev/null || git init -q --bare 2>/dev/null \
        || die "미리보기용 임시 Git 저장소를 만들지 못했습니다"
      git add -A 2>/dev/null || die "미리보기에서 현재 파일 상태를 읽지 못했습니다"
    else
      say "이 폴더는 아직 git 저장소가 아닙니다 — 되돌릴 수 있도록 지금 만듭니다."
      git init -q -b main 2>/dev/null || git init -q
      git add -A || die "현재 상태를 기록하지 못했습니다"
      commit_or_die "airlock-update: 업데이트 전 상태"
    fi
  fi

  local git_dir git_common_dir recovery_dir
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)" \
    || die "git 메타데이터 경로를 읽지 못했습니다"
  git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "공통 git 메타데이터 경로를 읽지 못했습니다"
  local installed_head=""
  git rev-parse --verify -q HEAD >/dev/null 2>&1 \
    && installed_head="$(git rev-parse HEAD)"
  if [ -z "${AIRLOCK_UPDATE_KEEPER_PID:-}" ]; then
    acquire_update_mutex "$git_common_dir"
  fi
  recovery_dir="$git_dir/airlock-update-rollback"
  if [ "$dry" != 1 ] && [ -e "$recovery_dir" ]; then
    die "끝나지 않은 업데이트 복구 기록이 있습니다.
       먼저 되돌리십시오:  AIRLOCK_DIR=\"$ROOT\" bash \"$recovery_dir/airlock-update\" --rollback"
  fi
  if [ "$dry" != 1 ] && git show-ref --verify -q refs/airlock-update/rollback; then
    die "다른 linked worktree의 끝나지 않은 업데이트 복구 ref가 있습니다.
       해당 worktree의 airlock-update --rollback 을 먼저 완료하십시오"
  fi

  # A transport supplies bytes, never authority.  Before touching the public
  # checkout or invoking the installer, bind those bytes to the fixed enrollment,
  # verify host/policy/lifecycle compatibility, let the accepted state primitive
  # promote them, and resolve the exact digest back out of the installed cache.
  if [ -n "$managed_snapshot_digest" ]; then
    managed_utc_now "$scratch/managed-request-at" \
      || die "managed release 검증 시각을 고정하지 못했습니다"
    local managed_request_at
    IFS= read -r managed_request_at <"$scratch/managed-request-at" \
      || die "managed release 검증 시각을 읽지 못했습니다"
    if [ -n "$managed_release_source" ]; then
      # Importing a new organisation snapshot is exactly what a subscription lapse or
      # an unenrollment stops.  Say so with the measured status before anything runs;
      # already-accepted cached releases below stay available either way.
      managed_refresh_admitted_or_die "$scratch" "$ROOT"
      managed_capture "$scratch/managed-candidate-verify.json" \
        python3 "$scratch/frozen-airlock-managed-release" verify \
          --stage "$managed_release_source" --signed \
          --authority "$(managed_context_field "$managed_context" authority_path)" \
          --at "$managed_request_at" \
        || die "managed local candidate 서명 검증에 실패했습니다"
      managed_release_preflight \
        "$managed_context" "$managed_release_source" "$managed_snapshot_digest" \
        "$(platform)" "$(uname -m)" \
        || die "managed local candidate host/policy preflight 에 실패했습니다"
      managed_capture "$scratch/managed-refresh.json" \
        python3 "$ROOT/bin/airlock-managed-state" refresh-installed \
          --source "$managed_release_source" --at "$managed_request_at" \
        || die "managed local candidate 를 고정된 installed channel 에 반영하지 못했습니다"
      managed_refresh_matches_request \
        "$scratch/managed-refresh.json" "$managed_snapshot_digest" \
        || die "managed refresh 결과가 요청한 exact snapshot 과 다릅니다"
    fi
    managed_cached_release_present \
      "$managed_context" "$managed_snapshot_digest" \
      || die "reason=bundle-not-cached 요청한 managed bundle 이 이 박스에 캐시되어 있지 않습니다 — 먼저 --managed-refresh 로 받아야 합니다"
    managed_capture "$scratch/managed-cached.json" \
      python3 "$ROOT/bin/airlock-managed-state" resolve-installed-cached \
        --snapshot-digest "$managed_snapshot_digest" --at "$managed_request_at" \
      || die "요청한 managed snapshot 을 installed cache 에서 해석하지 못했습니다"
    managed_cached_release_path \
      "$managed_context" "$scratch/managed-cached.json" \
      "$managed_snapshot_digest" "$scratch/managed-requested-release-path" \
      || die "managed cached release 결과의 identity/path/role 이 올바르지 않습니다"
    managed_release_preflight \
      "$managed_context" "$(managed_file_line "$scratch/managed-requested-release-path")" \
      "$managed_snapshot_digest" "$(platform)" "$(uname -m)" \
      || die "managed cached release host/policy preflight 에 실패했습니다"
  fi

  # ---------------------------------------------------------------- 2) 배포본 받기
  #
  # Deliberately NOT `--depth=1`. A shallow fetch writes .git/shallow and marks the
  # OPERATOR's repository shallow permanently, changing how their own clones, gc and
  # later fetches behave — a lasting side effect on their property in exchange for
  # nothing, since the release repository is a squashed mirror only a few commits deep.
  say "최신 배포본을 받는 중… ($RELEASE_URL, $RELEASE_REF)"
  if git remote get-url "$RELEASE_REMOTE" >/dev/null 2>&1; then
    git remote set-url "$RELEASE_REMOTE" "$RELEASE_URL" || die "remote 를 고치지 못했습니다"
  else
    git remote add "$RELEASE_REMOTE" "$RELEASE_URL" || die "remote 를 추가하지 못했습니다"
  fi
  git fetch -q "$RELEASE_REMOTE" "$RELEASE_REF" \
    || die "배포본을 받지 못했습니다 — 인터넷 연결을 확인해 주세요. (레포는 공개라 로그인은 필요 없습니다)"
  local new; new="$(git rev-parse --verify 'FETCH_HEAD^{commit}')" \
    || die "받은 내용을 commit 으로 읽지 못했습니다"
  if [ -n "$managed_context" ]; then
    managed_capture "$scratch/core-measurement.json" \
      python3 "$scratch/frozen-airlock-managed-release" measure-public-core \
        --repository "$ROOT" --revision "$new" \
      || die "설치된 trusted measurer 로 받은 public core 를 측정하지 못했습니다"
    managed_utc_now "$scratch/current-at" \
      || die "managed current 검증 시각을 고정하지 못했습니다"
    local managed_at
    IFS= read -r managed_at <"$scratch/current-at" \
      || die "managed current 검증 시각을 읽지 못했습니다"
    managed_capture "$scratch/current-release-before.json" \
      python3 "$scratch/frozen-airlock-managed-release" resolve-current \
        --store "$(managed_context_field "$managed_context" store_path)" \
        --channel "$(managed_context_field "$managed_context" channel_id)" \
        --authority "$(managed_context_field "$managed_context" authority_path)" \
        --at "$managed_at" \
      || die "고정된 managed channel 의 current release 를 검증하지 못했습니다"
    validate_managed_precheckout \
      "$managed_context" "$scratch/core-measurement.json" \
      "$scratch/current-release-before.json" "$new" "$ROOT" \
      "$scratch/current-release-path" \
      || die "managed release 와 받은 public core 의 결속이 맞지 않습니다"
    if [ -n "$managed_snapshot_digest" ]; then
      managed_requested_current_matches \
        "$scratch/managed-cached.json" "$scratch/current-release-before.json" \
        "$scratch/managed-requested-release-path" "$managed_snapshot_digest" \
        || die "요청한 managed cached release 가 fetched core 의 current release 와 다릅니다"
    fi
    # The authoritative policy decision is the one against the release the installer
    # will really consume: the channel's current release, bound to the fetched core and
    # BEFORE the checkout.  A managed run with no digest input used to reach the
    # installer handoff with no policy decision at all, and failed only after the
    # checkout commit had already armed a recovery.
    local managed_current_digest
    managed_current_digest="$(managed_current_snapshot_digest \
      "$scratch/current-release-before.json")" \
      || die "managed current release 의 snapshot digest 를 읽지 못했습니다"
    managed_release_preflight \
      "$managed_context" "$(managed_file_line "$scratch/current-release-path")" \
      "$managed_current_digest" "$(platform)" "$(uname -m)" \
      "$scratch/preflight-selected" \
      || die "managed current release 의 host/policy/lifecycle preflight 에 실패했습니다 — 파일을 바꾸지 않았습니다"
  fi
  local direction direction_rc
  direction="$(release_direction "$new" "$installed_head" "$RELEASE_REF" "$RELEASE_URL")"
  direction_rc=$?
  case "$direction" in
    rollback)
      say "받은 배포본은 현재 설치본보다 뒤입니다 — 업데이트로 보이지 않고 실행도 거부합니다."
      if [ "$dry" = 1 ]; then
        [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
          || emit_update_json 0 0 "$new" \
          || die "업데이트 감지 JSON을 만들지 못했습니다"
        return 0
      fi
      die "뒤진 배포본으로는 갱신할 수 없습니다. 이전 버전으로 돌아가려면 별도 롤백 절차를 사용하세요." ;;
    ambiguous)
      say "받은 배포본이 현재 설치본보다 앞서는지 확인하지 못했습니다."
      if [ "$dry" = 1 ]; then
        # A semantic ambiguity (for example a release naming another source) is a
        # measured non-update. Missing provenance is not: the daily collector must
        # keep its last complete value and old checkedAt instead of replacing it with
        # a fresh-looking zero.
        if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ] && [ "$direction_rc" -ne 0 ]; then
          die "배포본 방향을 재는 로컬 Git 증거가 없어 이전 감지값을 유지합니다."
        fi
        [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
          || emit_update_json 0 0 "$new" \
          || die "업데이트 감지 JSON을 만들지 못했습니다"
        return 0
      fi
      die "배포본 방향이 모호해 파일을 바꾸지 않습니다." ;;
    unknown)
      # The public history starts at 2026-08-21; a box installed from an earlier tree
      # matches no release that exists now, so no evidence can say forward or back.
      # A person who has seen the preview can say it; the daily detector cannot.
      if [ "$from_unknown" = 1 ]; then
        say "--from-unknown: 어느 배포본에서 설치했는지 모르는 박스를 운영자 확인으로 갱신합니다."
      else
        say "이 설치본은 지금 공개된 어떤 배포본과도 파일이 일치하지 않아, 받은 배포본이 더 새것인지 확인할 수 없습니다."
        say "공개 이력이 시작된 2026-08-21 이전에 설치한 박스라면 정상입니다."
        if [ "$dry" = 1 ]; then
          if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
            emit_update_json 0 0 "$new" || die "업데이트 감지 JSON을 만들지 못했습니다"
            return 0
          fi
          unknown_hint=1
        else
          die "어느 배포본에서 설치했는지 몰라 파일을 바꾸지 않습니다.
       먼저 --dry-run 으로 바뀔 파일을 확인한 뒤, 맞으면 --from-unknown 을 붙여 다시 실행하세요:
         bash bin/airlock-update --from-unknown
         curl -fsSL https://raw.githubusercontent.com/spacewalk-labs/airlock/main/bin/airlock-update | bash -s -- --from-unknown"
        fi
      fi ;;
    same|forward) ;;
    *) die "배포본 방향 판정값이 잘못됐습니다: $direction" ;;
  esac

  # ---------------------------------------------------------------- 3) 무엇이 바뀌나
  #
  # `-c core.quotePath=false` on every listing: without it git renders non-ASCII names
  # as octal escapes, and the one message that names the OPERATOR's OWN files is
  # exactly where that is least acceptable.
  local release_paths diff_paths tracked_paths changed_list changed stale
  release_paths="$(git -c core.quotePath=false ls-tree -r --name-only "$new" | sort)" \
    || die "받은 배포본의 파일 목록을 읽지 못했습니다"
  # Restricted to paths the RELEASE carries. Without that intersection the operator's
  # own tracked files read as differences and the script could never report an
  # up-to-date box — it would claim work to do forever.
  diff_paths="$(git -c core.quotePath=false diff --name-only "$new" -- . 2>/dev/null | sort)" \
    || die "현재 파일과 받은 배포본의 차이를 재지 못했습니다"
  changed_list="$(comm -12 <(printf '%s\n' "$diff_paths") \
    <(printf '%s\n' "$release_paths"))" \
    || die "바뀔 파일 목록을 계산하지 못했습니다"
  changed="$(awk 'NF { count++ } END { print count + 0 }' <<<"$changed_list")" \
    || die "바뀔 파일 수를 계산하지 못했습니다"
  # Tracked here but absent from the release. NOT removed — a file we do not recognise
  # is at least as likely to be the operator's as it is to be ours, and deleting
  # someone else's work to tidy a directory listing is not a trade this script makes.
  tracked_paths="$(git -c core.quotePath=false ls-files | sort)" \
    || die "현재 checkout의 파일 목록을 읽지 못했습니다"
  stale="$(comm -23 <(printf '%s\n' "$tracked_paths") \
                    <(printf '%s\n' "$release_paths") 2>/dev/null)" \
    || die "배포본에 없는 기존 파일 목록을 계산하지 못했습니다"

  # THE ONE THAT IS NOT OBVIOUS, AND THE ONE THAT ACTUALLY LOSES DATA.
  #
  # The safety commit is `git add -A`, which obeys the box's OWN .gitignore. The
  # overwrite is `git checkout <new> -- .`, which obeys nothing. Any release path that
  # the box's older .gitignore happens to ignore therefore falls in the gap: it is
  # written over with NO backup, and because the checkout stages it, the later
  # `git reset --hard` DELETES it — silently, and not in the "kept" report either.
  #
  # This is not hypothetical for the boxes this script is for. `.gitignore` gained
  # `!examples/app-package/airlock.toml` on 2026-08-08; a box installed before that
  # ignores `examples/app-package/airlock.toml` while the release tracks it. Measured
  # against a 2026-08-01 tree: that path is ignored, so it was in the gap.
  #
  # Closing it: force these into the safety commit, so `reset --hard` restores them.
  local at_risk=""
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || continue
    git ls-files --error-unmatch -- "$p" >/dev/null 2>&1 && continue
    at_risk="$at_risk$p"$'\n'
  done <<EOF
$release_paths
EOF

  if [ "$direction" = same ]; then
    say "이미 같은 배포본입니다 — 새 업데이트가 아닙니다."
    [ "$dry" != 1 ] || {
      [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
        || emit_update_json 0 0 "$new" \
        || die "업데이트 감지 JSON을 만들지 못했습니다"
      return 0
    }
  fi

  if [ "$changed" = 0 ]; then
    say "이미 최신입니다 — 바뀔 파일이 없습니다."
    [ "$do_install" = 1 ] || return 0
  else
    say "바뀔 파일 $changed 개:"
    report_list "$changed_list"
  fi
  if [ -n "$stale" ]; then
    say "배포본에 없는 파일 $(printf '%s' "$stale" | grep -c .) 개 — 지우지 않고 그대로 둡니다:"
    report_list "$stale"
  fi
  if [ -n "$at_risk" ]; then
    say "이 폴더의 .gitignore 가 가려 두었지만 배포본이 덮어쓸 파일 $(printf '%s' "$at_risk" | grep -c .) 개 — 되돌릴 수 있도록 먼저 기록합니다:"
    report_list "$at_risk"
  fi

  # ---------------------------------------------------------------- 3b) 설정 사전 검사
  #
  # The installer validates airlock.toml with the NEW release's rules — after the files
  # are already overwritten. A key the release retired (markwand became fileview on
  # 2026-08-23) then stops it with the new tree on disk and the old services running,
  # and a box old enough to hit that has no bin/airlock-status, so no rollback is armed.
  # Ask the same validator the same question first. Linux only: on a Mac the installer
  # runs inside the machine, with its own Python and its own copy of the config. No
  # changed file, no mixed box: a reinstall over the same tree needs no preflight.
  if [ "$(platform)" != Darwin ] && [ "${AIRLOCK_UPDATE_JSON:-0}" != 1 ] \
     && [ "$changed" != 0 ] && { [ "$dry" = 1 ] || [ "$do_install" = 1 ]; }; then
    local preflight="$scratch/preflight" config_check="" config_rc=0
    mkdir -p "$preflight" && git archive "$new" | tar -x -C "$preflight" \
      || die "새 배포본의 설정 검사기를 꺼내지 못했습니다"
    config_check="$(cd "$ROOT" && python3 "$preflight/bin/airlock-config" validate 2>&1)" \
      || config_rc=$?
    if [ "$config_rc" != 0 ]; then
      say "airlock.toml 이 새 배포본의 설정 검사를 통과하지 못합니다 — 설치기가 여기서 멈춥니다:"
      printf '%s\n' "$config_check" | sed 's/^/         /'
      if [ "$dry" != 1 ]; then
        die "설정을 먼저 고친 뒤 다시 실행하세요. 아무것도 바꾸지 않았습니다.
       (airlock.toml.example 이 새 형식입니다. 파일만 먼저 바꾸려면 --no-install)"
      fi
    fi
  fi

  if [ "$dry" = 1 ]; then
    if [ "$unknown_hint" = 1 ]; then
      say "위 내용이 맞으면 --from-unknown 을 붙여 실행하세요:  bash bin/airlock-update --from-unknown"
      say "  (curl 로 받았다면:  curl -fsSL https://raw.githubusercontent.com/spacewalk-labs/airlock/main/bin/airlock-update | bash -s -- --from-unknown)"
    fi
    say "[미리보기] 여기까지입니다. 아무것도 바꾸지 않았습니다."
    if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
      emit_update_json "$([ "$changed" -gt 0 ] && printf 1 || printf 0)" \
        "$changed" "$new" || die "업데이트 감지 JSON을 만들지 못했습니다"
    fi
    return 0
  fi

  # ---------------------------------------------------------------- 4) 머신 확인
  #
  # BEFORE anything is written. Detection can fail (no machine, two machines, orb not
  # running), and failing after the overwrite leaves the worst state of all: a new
  # checkout against an old install, which is neither the version they had nor the one
  # they asked for.
  if [ "$do_install" = 1 ] && [ "$(platform)" = Darwin ]; then
    machine="$(resolve_machine "$machine" "$MACHINE_MARKER")" || return 1
  fi

  # ---------------------------------------------------------------- 5) 안전망
  if [ -n "$(git status --porcelain 2>/dev/null)" ] || [ -n "$at_risk" ]; then
    say "지금 상태를 먼저 기록합니다 (업데이트를 되돌릴 수 있게)."
    git add -A || die "변경을 기록하지 못했습니다"
    if [ -n "$at_risk" ]; then
      # -f: these are ignored by the box's .gitignore, which is the entire reason they
      # need forcing. Without it `add` skips them without saying so.
      # A pipe makes this a subshell, which is fine: `git add` writes the index on
      # disk, so the effect outlives the subshell even though shell variables would not.
      printf '%s' "$at_risk" | while IFS= read -r p; do
        [ -n "$p" ] || continue
        git add -f -- "$p" 2>/dev/null || say "기록하지 못한 파일: $p"
      done
    fi
    commit_or_die "airlock-update: 업데이트 전 자동 저장"
  fi

  local before=""
  git rev-parse --verify -q HEAD >/dev/null 2>&1 && before="$(git rev-parse HEAD)"

  # ---------------------------------------------------------------- 5b) 복구 기준점
  #
  # A tree revision alone is not a healthy-box snapshot.  The previous version did
  # print one, but reset + a failing old installer merely trades one mixed box for a
  # different mixed box.  Arm rollback only from a status run that inspected every
  # check (rc 0, never rc 3), and freeze the exact config + installed-state records
  # that the old installer will converge from.
  local rollback_ready=0 config_receipt="" config_path="" rollback_state_dir="" status_rc=0
  if [ "$do_install" = 1 ] && [ -f bin/airlock-status ]; then
    say "업데이트 전 상태를 확인하는 중…"
    # 🔴 The CALLER creates this file. `airlock-config install-snapshot` opens it with
    # O_WRONLY|O_TRUNC|O_NOFOLLOW and deliberately WITHOUT O_CREAT, so that it can never
    # become a general write primitive — it freezes bytes into a file you already own and
    # refuses everything else. Its two other callers honour that (install/airlock-install.sh
    # uses `mktemp`, bin/airlock-backup uses `touch(mode=0o600)`); this one passed a path
    # inside a `mktemp -d` directory that nothing had ever created, so `os.open` raised
    # ENOENT and EVERY real update died here, fail-closed, before changing anything.
    # Only real ones: --dry-run returns above this block and --no-install never enters it,
    # which is the whole reason it reached a release (measured 2026-09-01, reproduced 100%).
    #
    # `set -C` is the point of the subshell, not tidiness: it opens with O_EXCL, so a path
    # that already exists as ANYTHING — including a symlink someone raced into place — fails
    # here instead of being followed. That is the same refusal O_NOFOLLOW makes on the callee
    # side, kept on this side too rather than assumed from the 0700 mktemp directory.
    # `umask 077` gives it 0600 from birth instead of widening then narrowing.
    ( umask 077; set -C; : >"$scratch/config.snapshot" ) \
      || die "업데이트 전 설정을 담을 파일을 만들지 못했습니다: $scratch/config.snapshot"
    config_receipt="$(python3 bin/airlock-config install-snapshot "$scratch/config.snapshot")" \
      || die "업데이트 전 설정을 고정하지 못했습니다"
    config_path="$(printf '%s' "$config_receipt" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["config_path"])')" \
      || die "고정한 설정 경로를 읽지 못했습니다"
    case "$config_path" in *$'\n'*|*$'\r'*) die "설정 경로에 줄바꿈이 있어 안전하게 기록할 수 없습니다" ;; esac
    snapshot_box_state "$ROOT" "$machine" "$scratch" \
      || die "업데이트 전 설치 상태를 보존하지 못했습니다"
    rollback_state_dir="$(cat "$scratch/state-dir")" \
      || die "고정한 설치 상태 경로를 읽지 못했습니다"
    box_status "$ROOT" "$machine" "$rollback_state_dir" "$config_path" \
      >"$scratch/status-before.json"; status_rc=$?
    [ "$status_rc" = 0 ] \
      || die "업데이트 전 상태가 완전히 확인되지 않아 설치를 시작하지 않습니다 (airlock-status rc=$status_rc).
       rc=3 도 정상으로 보지 않습니다. 위 상태 출력을 해결한 뒤 다시 실행하세요."
    box_state_matches "$ROOT" "$machine" "$scratch" \
      || die "업데이트 전 상태 확인 중 설치 기록이 달라져 시작하지 않습니다 — 다른 Airlock 실행이 끝난 뒤 다시 시도하세요."
    if [ -f "${BASH_SOURCE[0]:-}" ]; then
      cp "${BASH_SOURCE[0]}" "$scratch/airlock-update" \
        || die "복구 명령을 보존하지 못했습니다"
    else
      git show "$new:bin/airlock-update" >"$scratch/airlock-update" \
        || die "복구 명령을 배포본에서 보존하지 못했습니다"
    fi
    chmod 0600 "$scratch/airlock-update" || die "복구 명령을 보호하지 못했습니다"
    rollback_ready=1
  elif [ "$do_install" = 1 ]; then
    say "주의: 이 설치본에는 bin/airlock-status 가 없어 자동 롤백 기준점을 만들 수 없습니다."
  fi

  # Put the recovery record in place BEFORE changing the checkout.  Until the new
  # revision is known its phase is deliberately not auto-runnable: an interruption
  # leaves an explicit, inspectable record and a pinned before commit instead of a
  # mixed checkout with no explanation of how it got there.
  if [ "$rollback_ready" = 1 ]; then
    arm_recovery "$recovery_dir" "$scratch" "$before" \
      "$config_path" "$(platform)" "$machine"
  fi
  if [ -n "$managed_context" ] && [ "$rollback_ready" != 1 ]; then
    die "managed update 는 검증된 업데이트 전 config/status 기준점 없이는 시작하지 않습니다"
  fi

  # ---------------------------------------------------------------- 6) 덮어쓰기
  #
  # `-- .` writes every path the release carries and touches nothing else, so files the
  # operator added stay. `airlock.toml` at the root is in .gitignore on BOTH sides and
  # in no tree, so it is never a candidate — but note that is a statement about that
  # one path, not about the name: the release does carry
  # examples/app-package/airlock.toml, which is why the at-risk pass above exists.
  say "파일을 배포본으로 맞추는 중… (중간에 멈추면 git reset --hard HEAD 로 되돌립니다)"
  git checkout "$new" -- . || die "파일을 바꾸지 못했습니다 (아무것도 안 바뀌었을 수 있습니다)"
  git add -A || die "배포본 파일을 기록 대상으로 올리지 못했습니다"
  commit_release_or_die "airlock-update: 배포본 ${new:0:12} 으로 갱신" "$before" "$ROOT"
  local after="" update_rc=0
  after="$(git rev-parse HEAD)" || die "갱신 뒤 revision 을 읽지 못했습니다"
  if [ "$rollback_ready" = 1 ]; then
    activate_recovery "$recovery_dir" "$after"
  fi
  say "갱신했습니다."
  [ -n "$before" ] && say "되돌리려면:  git -C \"$ROOT\" reset --hard $before"

  [ "$do_install" = 1 ] || { say "설치기는 건너뜁니다 (--no-install)."; return 0; }

  # ---------------------------------------------------------------- 7) 설치기 재실행
  #
  # Note what `reset --hard` does and does not undo: it restores THIS CHECKOUT. It does
  # not roll back what the installer did inside the Linux machine — /opt/airlock, the
  # user units, the rendered nginx config, the package versions. Undoing the files and
  # re-running the installer is what returns the box, and the message above is worded
  # for the checkout because that is what it actually restores.
  if [ "$(platform)" != Darwin ] && [ -n "$managed_context" ]; then
    say "고정된 managed channel handoff 를 만드는 중…"
    run_managed_installer "$managed_context" "$scratch" "$ROOT" "$new" "$config_path" \
      || update_rc=$?
  elif [ "$(platform)" != Darwin ]; then
    say "설치기를 다시 돌립니다…"
    AIRLOCK_CONFIG="$config_path" bash install/airlock-install.sh || update_rc=$?
  else
    say "설치기를 다시 돌립니다 (머신: $machine)…"
    say "설치 중 경고가 여러 줄 나올 수 있습니다 — 마지막의 Entrance 주소가 나오면 성공입니다."
    # The host checkout and Orb VM are distinct live boxes: an open host flock fd
    # cannot cross the VM boundary.  Prevent Orb from mistaking the host identity for
    # an inherited VM lease; the VM installer acquires its own canonical lease.
    env -u AIRLOCK_LIVE_BOX_LEASE_ID -u AIRLOCK_LIVE_BOX_LEASE_FD \
      -u AIRLOCK_LIVE_BOX_LEASE_GUARD_FD -u AIRLOCK_LIVE_BOX_LEASE_RECORD \
      -u AIRLOCK_SELFKILL_ESCAPED \
      AIRLOCK_MACHINE="$machine" bash docker/orbstack-machine-setup.sh || update_rc=$?
  fi

  if [ "$rollback_ready" != 1 ]; then
    return "$update_rc"
  fi

  if [ "$update_rc" != 0 ]; then
    if capture_failed_state "$ROOT" "$machine" "$recovery_dir"; then
      printf '%s\n' failed >"$recovery_dir/phase"
    else
      printf '%s\n' failed-unbound >"$recovery_dir/phase"
    fi
    box_status "$ROOT" "$machine" "$rollback_state_dir" "$config_path" \
      >"$recovery_dir/status-after-failure.json" 2>/dev/null || true
    record_update_event "$git_dir" update-failed "$before" "$after" "$update_rc"
    say "설치가 실패했습니다 (rc=$update_rc). 이전 상태는 보존돼 있습니다."
    # A managed failure is not left for a human to finish.  The app-scoped executor
    # has already compensated its own resources when it reports `rolled_back`, so the
    # remaining work — the checkout, the pre-update ledger/config baseline and the
    # status verification — is run here and verified before anything is called
    # recovered.  Any other transaction phase is NOT auto-resumed: the ledger owns
    # that judgment, and a degraded or still-rolling transaction needs its record.
    local managed_phase="" recovery_rc=0
    if [ -n "$managed_context" ]; then
      managed_phase="$(managed_transaction_phase "$rollback_state_dir")" || managed_phase=""
    fi
    if [ "$managed_phase" = rolled_back ]; then
      say "managed 실행기가 앱 자원을 되돌렸습니다 (transaction=rolled_back) — 이전 상태로 복구하고 검증합니다…"
      release_update_mutex
      rollback_update "$ROOT" "$machine" "$MACHINE_MARKER" || recovery_rc=$?
      if [ "$recovery_rc" = 0 ]; then
        write_update_channel_receipt "$rollback_state_dir" recovered "$managed_context" \
          "$scratch" "$before" "$after" "$update_rc" "$managed_phase" \
          || say "복구는 끝났지만 managed update 영수증을 남기지 못했습니다"
        say "이전 관리판으로 복구하고 상태 검증까지 통과했습니다 (설치 실패 rc=$update_rc)."
        return "$update_rc"
      fi
      write_update_channel_receipt "$rollback_state_dir" recovery-failed "$managed_context" \
        "$scratch" "$before" "$after" "$update_rc" "$managed_phase" \
        || say "복구 실패 영수증을 남기지 못했습니다"
      say "자동 복구가 끝나지 못했습니다 (rc=$recovery_rc) — 기록을 보존했습니다."
      say "다시 시도:  AIRLOCK_DIR=\"$ROOT\" bash \"$recovery_dir/airlock-update\" --rollback"
      return "$recovery_rc"
    fi
    if [ -n "$managed_context" ]; then
      write_update_channel_receipt "$rollback_state_dir" recovery-required "$managed_context" \
        "$scratch" "$before" "$after" "$update_rc" "$managed_phase" \
        || say "복구 필요 영수증을 남기지 못했습니다"
    fi
    say "되돌리기:  AIRLOCK_DIR=\"$ROOT\" bash \"$recovery_dir/airlock-update\" --rollback"
    return "$update_rc"
  fi

  box_status "$ROOT" "$machine" "$rollback_state_dir" "$config_path" \
    >"$recovery_dir/status-after.json"; status_rc=$?
  if [ "$status_rc" != 0 ]; then
    if capture_failed_state "$ROOT" "$machine" "$recovery_dir"; then
      printf '%s\n' failed >"$recovery_dir/phase"
    else
      printf '%s\n' failed-unbound >"$recovery_dir/phase"
    fi
    record_update_event "$git_dir" update-status-failed "$before" "$after" "$status_rc"
    say "설치는 끝났지만 상태 검증이 통과하지 못했습니다 (airlock-status rc=$status_rc)."
    say "rc=3 은 확인하지 못한 항목이 있으므로 성공이 아닙니다."
    say "되돌리기:  AIRLOCK_DIR=\"$ROOT\" bash \"$recovery_dir/airlock-update\" --rollback"
    return "$status_rc"
  fi

  if [ -n "$managed_context" ]; then
    write_update_channel_receipt "$rollback_state_dir" installed "$managed_context" \
      "$scratch" "$before" "$after" 0 \
      "$(managed_transaction_phase "$rollback_state_dir" || printf unknown)" \
      || die "managed update 영수증을 남기지 못해 성공으로 보고하지 않습니다"
  fi
  record_update_event "$git_dir" update-ok "$before" "$after" 0
  git update-ref -d refs/airlock-update/rollback "$before" \
    || die "성공한 업데이트의 복구용 Git ref 를 정리하지 못했습니다"
  rm -rf -- "$recovery_dir"
  say "업데이트 뒤 상태도 정상입니다 (airlock-status rc=0)."
  return 0
}

say()  {
  if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
    printf '[airlock-update] %s\n' "$*" >&2
  else
    printf '\033[1;36m[airlock-update]\033[0m %s\n' "$*"
  fi
}
die()  { printf '\033[1;31m[airlock-update] 중단:\033[0m %s\n' "$*" >&2; exit 1; }

fixture_boundary() { # <checkout-root> <dry> <machine>
  local checkout="$1" dry="$2" machine="$3" fixture_signal=0 name orb_path=""
  while IFS= read -r name; do
    case "$name" in AIRLOCK_FIXTURE_*) fixture_signal=1; break ;; esac
  done < <(compgen -A variable)
  [ "$fixture_signal" = 1 ] || return 0
  [ -z "$machine" ] || orb_path="$(command -v orb 2>/dev/null || true)"
  python3 - "$checkout" "$dry" "$machine" \
    "${AIRLOCK_FIXTURE_LIVE_BOX_LEASE_DIR:-}" "${HOME:-}" \
    "${AIRLOCK_STATE_DIR:-}" "$orb_path" \
    "${AIRLOCK_FIXTURE_UPDATE_TOOLS_ROOT:-}" <<'PY'
import os
import pathlib
import stat
import sys

checkout_raw, dry, machine, lease_raw, home, state, orb_path, update_tools = sys.argv[1:]
lease = pathlib.Path(lease_raw)
if not lease.is_absolute() or lease.name != "airlock-live-box":
    raise SystemExit("fixture boundary: lease path must be absolute and end in /airlock-live-box")
try:
    root = lease.parent.resolve(strict=True)
    root_info = root.lstat()
    marker = root / ".airlock-live-box-fixture-v1"
    marker_info = marker.lstat()
    marker_value = marker.read_text(encoding="ascii")
except (OSError, UnicodeError) as exc:
    raise SystemExit(f"fixture boundary: missing fixture root or marker: {exc}")
if (lease.parent != root or root.is_symlink() or not root.is_dir()
        or root_info.st_uid != os.getuid() or stat.S_IMODE(root_info.st_mode) != 0o700
        or marker.is_symlink() or not marker.is_file()
        or marker_info.st_uid != os.getuid() or stat.S_IMODE(marker_info.st_mode) != 0o600
        or marker_value != "airlock.live-box-fixture/v1\n"):
    raise SystemExit("fixture boundary: root must be canonical, owner-private, and explicitly marked")
def below(label, raw, required):
    if not raw:
        if required:
            raise SystemExit(f"fixture boundary: {label} must be explicit")
        return
    path = pathlib.Path(raw)
    if not path.is_absolute():
        raise SystemExit(f"fixture boundary: {label} must be absolute")
    resolved = path.resolve(strict=False)
    if resolved != root and root not in resolved.parents:
        raise SystemExit(f"fixture boundary: {label} escapes fixture root: {resolved}")

below("checkout", checkout_raw, True)
below("HOME", home, True)
below("AIRLOCK_STATE_DIR", state, dry != "1")
if machine:
    below("orb mutation command", orb_path, True)
below("update tools", update_tools, False)
PY
}

update_lease_tools_valid() { # <tools-root>
  local tools="$1"
  [ ! -L "$tools" ] && [ -d "$tools" ] \
    && [ ! -L "$tools/bin" ] && [ -d "$tools/bin" ] \
    && [ ! -L "$tools/install" ] && [ -d "$tools/install" ] \
    && [ ! -L "$tools/bin/airlock-ledger" ] && [ -x "$tools/bin/airlock-ledger" ] \
    && [ ! -L "$tools/install/lib.sh" ] && [ -f "$tools/install/lib.sh" ] \
    && [ ! -L "$tools/install/preflight.sh" ] && [ -f "$tools/install/preflight.sh" ] \
    && grep -q 'live-box-lease-require' "$tools/bin/airlock-ledger"
}

bootstrap_update_lease_tools() { # <release-url> <release-ref> <private-parent>
  local release_url="$1" release_ref="$2" parent="$3" bootstrap=""
  case "$release_url:$release_ref" in
    https://github.com/spacewalk-labs/airlock:main|https://github.com/spacewalk-labs/airlock.git:main) ;;
    *) return 1 ;;
  esac
  bootstrap="$(mktemp -d "$parent/airlock-update-tools.XXXXXX")" || return 1
  chmod 0700 "$bootstrap" || { rm -rf -- "$bootstrap"; return 1; }
  if ! git init -q --bare "$bootstrap/repository" \
     || ! git -C "$bootstrap/repository" fetch -q --depth=1 "$release_url" "$release_ref" \
     || ! mkdir -p "$bootstrap/tools"; then
    rm -rf -- "$bootstrap"
    return 1
  fi
  if ! git -C "$bootstrap/repository" archive FETCH_HEAD -- \
         bin/airlock-ledger install/lib.sh install/preflight.sh \
       | tar -C "$bootstrap/tools" -xf - \
     || [ "$(sha256_file "$bootstrap/tools/bin/airlock-ledger")" != \
            2d8abccd6074c4c4c0d9dacd9820ca56efc17b88e603227ff8e661616c22bd7c ] \
     || [ "$(sha256_file "$bootstrap/tools/install/lib.sh")" != \
            70493cdfd6a2411155d8021d7038a9f5a648e2855320b19ad72e9f13776cda7b ] \
     || [ "$(sha256_file "$bootstrap/tools/install/preflight.sh")" != \
            dcff752abe254921e6a788f8b27fd0151071c359185864dc6c19779625abdb35 ] \
     || ! chmod 0500 "$bootstrap/tools/bin/airlock-ledger"; then
    rm -rf -- "$bootstrap"
    return 1
  fi
  rm -rf -- "$bootstrap/repository"
  printf '%s\n' "$bootstrap"
}

preserved_update_lease_tools_valid() { # <lease-tools-root>
  local tools="$1" relative="" expected="" actual=""
  update_lease_tools_valid "$tools" || return 1
  for relative in bin/airlock-ledger install/lib.sh install/preflight.sh; do
    [ ! -L "$tools/$relative.sha256" ] && [ -f "$tools/$relative.sha256" ] \
      || return 1
    IFS= read -r expected <"$tools/$relative.sha256" || return 1
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || return 1
    actual="$(sha256_file "$tools/$relative")" || return 1
    [ "$actual" = "$expected" ] || return 1
  done
}

build_update_capsule() { # <tools-root> <private-parent>
  local tools="$1" parent="$2" capsule=""
  capsule="$(mktemp -d "$parent/airlock-update-capsule.XXXXXX")" || return 1
  chmod 0700 "$capsule" || { rm -rf -- "$capsule"; return 1; }
  if ! mkdir -p "$capsule/bin" "$capsule/install" \
     || ! cp -- "$tools/bin/airlock-ledger" "$capsule/bin/airlock-ledger" \
     || ! cp -- "$tools/install/lib.sh" "$capsule/install/lib.sh" \
     || ! cp -- "$tools/install/preflight.sh" "$capsule/install/preflight.sh" \
     || ! declare -f airlock_update_program >"$capsule/bin/airlock-update"; then
    rm -rf -- "$capsule"
    return 1
  fi
  {
    printf '%s\n' 'set -uo pipefail'
    printf 'AIRLOCK_UPDATE_CAPSULE_ROOT=%q\n' "$capsule"
    printf '%s\n' 'airlock_update_program "$@"'
  } >>"$capsule/bin/airlock-update" || { rm -rf -- "$capsule"; return 1; }
  printf 'airlock.update-capsule/v1\n' >"$capsule/.airlock-update-capsule-v1" \
    || { rm -rf -- "$capsule"; return 1; }
  chmod 0500 "$capsule/bin/airlock-update" "$capsule/bin/airlock-ledger" \
    || { rm -rf -- "$capsule"; return 1; }
  printf '%s\n' "$capsule"
}

cleanup_update_capsule() {
  local capsule="${AIRLOCK_UPDATE_CAPSULE_ROOT:-}"
  [ -n "$capsule" ] && [ ! -L "$capsule" ] && [ -d "$capsule" ] \
    && [ -f "$capsule/.airlock-update-capsule-v1" ] \
    && [ "$(cat "$capsule/.airlock-update-capsule-v1" 2>/dev/null)" = \
           airlock.update-capsule/v1 ] \
    || return 0
  case "$capsule" in
    /tmp/airlock-update-capsule.*|*/airlock-update-capsule.*) rm -rf -- "$capsule" ;;
  esac
}

escape_update_selfkill_cgroup() { # <tools-root> <reexec-path> [argv]
  local tools="$1" reexec="$2" saved_die saved_root_set saved_root
  shift 2
  saved_die="$(declare -f die)"
  saved_root_set="${AIRLOCK_ROOT+x}"
  saved_root="${AIRLOCK_ROOT:-}"
  # shellcheck source=/dev/null
  . "$tools/install/lib.sh"
  airlock_escape_selfkill_cgroup "$reexec" "$@"
  eval "$saved_die"
  unset -f log
  if [ -n "$saved_root_set" ]; then AIRLOCK_ROOT="$saved_root"; else unset AIRLOCK_ROOT; fi
}

update_selfkill_escape_needed() {
  [ -z "${AIRLOCK_SELFKILL_ESCAPED:-}" ] || return 1
  local cgroup_file="${AIRLOCK_SELFKILL_CGROUP_FILE:-/proc/self/cgroup}" cgroup path unit
  [ -r "$cgroup_file" ] || return 1
  cgroup="$(cat "$cgroup_file" 2>/dev/null || true)"
  path="$(printf '%s\n' "$cgroup" | sed -n 's|^0::||p' | head -n1)"
  [ -n "$path" ] || return 1
  unit="${path##*/}"
  case "$path" in */user@*.service/*) ;; *) return 1 ;; esac
  case "$unit" in airlock-*.service) ;; *) return 1 ;; esac
  systemctl --user show-environment >/dev/null 2>&1 || return 1
  return 0
}

enter_update_live_box_lease() { # <checkout-root> <reason> <release-url> <release-ref> [argv]
  local checkout="$1" reason="$2" release_url="$3" release_ref="$4"
  local source="${BASH_SOURCE[0]:-}" source_dir="" source_path="" tools="" bootstrap=""
  local capsule="" private_parent=/tmp rc=0
  shift 4
  if [ -n "$source" ] && [ -f "$source" ]; then
    source_dir="$(cd "$(dirname "$source")" && pwd -P)"
    source_path="$source_dir/$(basename "$source")"
    if preserved_update_lease_tools_valid "$source_dir/lease-tools"; then
      tools="$source_dir/lease-tools"
    elif update_lease_tools_valid "$source_dir/.."; then
      tools="$(cd "$source_dir/.." && pwd -P)"
    fi
  fi
  if [ -z "$tools" ] && [ -n "${AIRLOCK_FIXTURE_UPDATE_TOOLS_ROOT:-}" ] \
     && update_lease_tools_valid "$AIRLOCK_FIXTURE_UPDATE_TOOLS_ROOT"; then
    tools="$(cd "$AIRLOCK_FIXTURE_UPDATE_TOOLS_ROOT" && pwd -P)"
  fi
  [ -z "${AIRLOCK_FIXTURE_LIVE_BOX_LEASE_DIR:-}" ] \
    || private_parent="$(dirname "$AIRLOCK_FIXTURE_LIVE_BOX_LEASE_DIR")"
  if [ -z "$tools" ]; then
    bootstrap="$(bootstrap_update_lease_tools "$release_url" "$release_ref" "$private_parent")" \
      || die "공통 live-box lease 도구를 찾지 못해 변경을 시작하지 않습니다"
    tools="$bootstrap/tools"
  fi
  if [ -z "$source_path" ] || [ -n "$bootstrap" ]; then
    capsule="$(build_update_capsule "$tools" "$private_parent")" \
      || { [ -z "$bootstrap" ] || rm -rf -- "$bootstrap"; \
           die "updater 실행 캡슐을 만들지 못해 변경을 시작하지 않습니다"; }
    source_path="$capsule/bin/airlock-update"
    tools="$capsule"
    [ -z "$bootstrap" ] || rm -rf -- "$bootstrap"
  fi
  export AIRLOCK_UPDATE_ACTIVE_LEASE_TOOLS_ROOT="$tools"

  local inherited_lease=0
  if [ -n "${AIRLOCK_LIVE_BOX_LEASE_ID:-}${AIRLOCK_LIVE_BOX_LEASE_FD:-}${AIRLOCK_LIVE_BOX_LEASE_RECORD:-}${AIRLOCK_LIVE_BOX_LEASE_GUARD_FD:-}" ]; then
    "$tools/bin/airlock-ledger" live-box-lease-require \
      || die "live-box lease identity is stale, forged, or no longer held"
    inherited_lease=1
    update_selfkill_escape_needed \
      && die "an inherited live-box lease cannot cross the self-kill escape boundary"
  fi
  # Escaping after admission loses the inherited flock at the systemd manager
  # boundary.  The persistent updater path enters a safe transient service first;
  # that same process then acquires and carries the lease into the installer.
  [ "$inherited_lease" = 1 ] || escape_update_selfkill_cgroup "$tools" "$source_path" "$@"
  [ "$inherited_lease" != 1 ] || return 0
  "$tools/bin/airlock-ledger" live-box-lease-run \
    --agent-id="${PASEO_AGENT_ID:-operator:$(id -u)}" \
    --card="${AIRLOCK_LIVE_BOX_CARD:-manual/live-box}" \
    --reason="$reason" --ttl-seconds="${AIRLOCK_LIVE_BOX_TTL_SECONDS:-3600}" \
    -- bash "$source_path" "$@" || rc=$?
  [ -z "$capsule" ] || { AIRLOCK_UPDATE_CAPSULE_ROOT="$capsule"; cleanup_update_capsule; }
  exit "$rc"
}

usage() { printf '%s\n' \
  "airlock-update — 이미 깔린 Airlock 을 최신 배포본으로 갱신합니다." \
  "  bash bin/airlock-update              # 갱신하고 설치기까지 다시 돌립니다" \
  "  bash bin/airlock-update --dry-run    # 무엇이 바뀌는지만 보여 줍니다" \
  "  bash bin/airlock-update --dry-run --json # 감지기용 JSON 요약만 출력" \
  "  bash bin/airlock-update --no-install # 파일만 갱신하고 설치기는 건너뜁니다" \
  "  bash bin/airlock-update --rollback   # 마지막으로 실패한 갱신을 되돌립니다" \
  "  bash bin/airlock-update --machine m  # 리눅스 머신 이름을 직접 지정합니다" \
  "  bash bin/airlock-update --managed-snapshot-digest=sha256:... [--managed-release-source=/완성된/서명본]" \
  "  bash bin/airlock-update --managed-refresh=/완성된/서명본 # 설치 없이 검증된 managed cache 만 갱신" \
  "  bash bin/airlock-update --managed-status   # managed store 상태 JSON (cache 나이·후보판·버튼)" \
  "  bash bin/airlock-update --from-unknown # 어느 배포본인지 모르는 옛 설치본(2026-08-21 이전)을 확인 후 갱신" \
  "  AIRLOCK_DIR=/경로 를 앞에 붙이면 그 폴더를 갱신합니다."; }

# The test seam for the macOS branch: a Linux CI cannot reach it, and it is the branch
# that can install into the wrong machine. install/test-update.sh sets this and puts a
# stub `orb` on PATH. Nothing else reads it.
platform() { printf '%s' "${AIRLOCK_UPDATE_UNAME:-$(uname -s)}"; }

is_checkout() {
  [ -f "$1/bin/airlock-config" ] \
    && [ -f "$1/install/airlock-install.sh" ] \
    && [ -f "$1/docker/orbstack-machine-setup.sh" ]
}

emit_update_json() { # <available:0|1> <changed-count> <release-ref>
  local output=""
  output="$(python3 - "$@" <<'PY'
import json
import sys

available, changed, ref = sys.argv[1:]
print(json.dumps({"available": available == "1", "changedCount": int(changed),
                  "ref": ref}, separators=(",", ":")))
PY
)" || return 1
  printf '%s\n' "$output"
}

managed_private_target() { # <new-private-file>
  local target="$1"
  ( umask 077; set -C; : >"$target" ) || return 1
  [ -f "$target" ] && [ ! -L "$target" ] \
    && [ "$(stat -c '%a:%u:%g' "$target" 2>/dev/null)" = "600:$(id -u):$(id -g)" ]
}

canonical_private_scratch() { # <fresh-mktemp-directory>
  python3 - "$1" <<'PY'
import os
import pathlib
import stat
import sys

source = pathlib.Path(sys.argv[1])
try:
    source_info = source.lstat()
    resolved = source.resolve(strict=True)
    resolved_info = resolved.lstat()
except OSError as exc:
    print(f"airlock-update scratch: {exc}", file=sys.stderr)
    raise SystemExit(2)
if (source.is_symlink() or resolved.is_symlink()
        or not resolved.is_absolute()
        or not stat.S_ISDIR(source_info.st_mode)
        or not stat.S_ISDIR(resolved_info.st_mode)
        or (source_info.st_dev, source_info.st_ino) != (resolved_info.st_dev, resolved_info.st_ino)
        or (resolved_info.st_uid, resolved_info.st_gid) != (os.geteuid(), os.getegid())
        or stat.S_IMODE(resolved_info.st_mode) != 0o700
        or any(ord(character) < 32 for character in str(resolved))):
    print("airlock-update scratch: generated directory is not canonical owner-private storage",
          file=sys.stderr)
    raise SystemExit(2)
print(resolved)
PY
}

managed_capture() { # <new-private-file> <command...>
  local target="$1"; shift
  managed_private_target "$target" || return 1
  "$@" >"$target"
}

managed_utc_now() { # <new-private-file>
  local target="$1"
  managed_private_target "$target" || return 1
  python3 - "$target" <<'PY'
import datetime
import os
import sys

path = sys.argv[1]
value = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
raw = value.isoformat().replace("+00:00", "Z") + "\n"
fd = os.open(path, os.O_WRONLY | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0))
with os.fdopen(fd, "w", encoding="ascii", newline="") as handle:
    handle.write(raw)
    handle.flush()
    os.fsync(handle.fileno())
PY
}

managed_file_line() { # <private-one-line-file>
  python3 - "$1" <<'PY'
import pathlib
import sys

raw = pathlib.Path(sys.argv[1]).read_bytes()
if not raw.endswith(b"\n") or raw.count(b"\n") != 1 or b"\r" in raw:
    raise SystemExit(2)
value = raw[:-1].decode("utf-8")
if not value or "\x00" in value:
    raise SystemExit(2)
print(value)
PY
}

managed_refresh_matches_request() { # <refresh-json> <expected-snapshot-digest>
  python3 - "$1" "$2" <<'PY'
import json
import pathlib
import sys

path, expected = pathlib.Path(sys.argv[1]), sys.argv[2]
raw = path.read_bytes()
value = json.loads(raw)
canonical = (json.dumps(value, ensure_ascii=False, separators=(",", ":"),
                        sort_keys=True) + "\n").encode()
if raw != canonical or value.get("snapshot_digest") != expected:
    raise SystemExit(2)
if value.get("access_status") != "active":
    raise SystemExit(2)
PY
}

managed_cached_release_path() { # <context> <cached-json> <expected-digest> <new-path-file>
  python3 - "$@" <<'PY'
import json
import os
import pathlib
import re
import sys

context_path, cached_path, expected, output_path = sys.argv[1:]
context_path, cached_path, output_path = map(
    pathlib.Path, (context_path, cached_path, output_path),
)
sha256 = re.compile(r"sha256:[0-9a-f]{64}\Z")

def load(path):
    raw = path.read_bytes()
    value = json.loads(raw)
    canonical = (json.dumps(value, ensure_ascii=False, separators=(",", ":"),
                            sort_keys=True) + "\n").encode()
    if raw != canonical:
        raise SystemExit(2)
    return value

context = load(context_path)
cached = load(cached_path)
required = {
    "access_status", "bundle_digest", "cached", "catalog_digest", "channel_id",
    "promoted_at", "release_path", "role", "schema", "snapshot_digest",
    "verified_at",
}
if (set(cached) != required
        or cached.get("schema") != "airlock.managed.cached-release/v1"
        or cached.get("cached") is not True
        or cached.get("role") != "current"
        or cached.get("snapshot_digest") != expected
        or cached.get("channel_id") != context.get("channel_id")
        or sha256.fullmatch(expected) is None):
    raise SystemExit(2)
release = pathlib.Path(str(cached.get("release_path")))
wanted = pathlib.Path(context["store_path"]) / "releases" / expected.removeprefix("sha256:")
if release != wanted or not release.is_dir() or release.is_symlink():
    raise SystemExit(2)
fd = os.open(
    output_path,
    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    | getattr(os, "O_NOFOLLOW", 0),
    0o600,
)
with os.fdopen(fd, "wb") as handle:
    handle.write((str(release) + "\n").encode())
    handle.flush()
    os.fsync(handle.fileno())
PY
}

managed_requested_current_matches() { # <cached> <current> <release-path-file> <digest>
  python3 - "$@" <<'PY'
import json
import pathlib
import sys

cached_path, current_path, release_path_file, digest = map(pathlib.Path, sys.argv[1:])
digest = str(digest)
cached = json.loads(cached_path.read_bytes())
current = json.loads(current_path.read_bytes())
release_raw = release_path_file.read_bytes()
if (not release_raw.endswith(b"\n") or release_raw.count(b"\n") != 1
        or cached.get("snapshot_digest") != digest
        or current.get("snapshot_digest") != digest
        or cached.get("release_path") != current.get("release_path")
        or release_raw[:-1].decode() != current.get("release_path")):
    raise SystemExit(2)
PY
}

managed_release_preflight() { # <context> <signed-release> <snapshot-digest> <os> <arch> [selected-apps-out]
  python3 - "$@" <<'PY'
import hashlib
import json
import os
import pathlib
import re
import stat
import sys

context_path, release_path, expected_digest, host_os, host_arch = sys.argv[1:6]
selected_output = pathlib.Path(sys.argv[6]) if len(sys.argv) > 6 else None
context_path, release_path = pathlib.Path(context_path), pathlib.Path(release_path)
digest_re = re.compile(r"sha256:[0-9a-f]{64}\Z")
app_re = re.compile(r"[a-z0-9][a-z0-9-]{0,31}\Z")
grantable = {"rooted-artifact", "system-unit"}

# A refusal is also a product answer another surface has to render, so every one of
# them carries a stable machine-readable reason next to its sentence.
def fail(message, reason="release-input-invalid"):
    print(f"airlock-update managed package preflight: reason={reason} {message}",
          file=sys.stderr)
    raise SystemExit(2)

def pairs(rows):
    result = {}
    for key, value in rows:
        if key in result:
            fail(f"duplicate JSON key {key!r}")
        result[key] = value
    return result

def load(path, label, canonical=True):
    try:
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=pairs)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"cannot read {label}: {exc}")
    encoded = (json.dumps(value, ensure_ascii=False, separators=(",", ":"),
                          sort_keys=True) + "\n").encode()
    if canonical and raw != encoded:
        fail(f"{label} is not canonical JSON")
    return value, raw

def exact(value, keys, label):
    if not isinstance(value, dict) or set(value) != set(keys):
        fail(f"{label} has an unsupported closed shape")
    return value

def executable(relative, label):
    raw = pathlib.PurePosixPath(relative)
    if raw.is_absolute() or ".." in raw.parts or str(raw) in {"", "."}:
        fail(f"{label} is not a confined relative path")
    path = release_path / package["path"] / raw
    try:
        info = path.lstat()
    except OSError as exc:
        fail(f"{label} is unavailable: {exc}", "lifecycle-incomplete")
    if (not stat.S_ISREG(info.st_mode) or path.is_symlink()
            or stat.S_IMODE(info.st_mode) & 0o111 == 0):
        fail(f"{label} must be a regular executable", "lifecycle-incomplete")

context, _ = load(context_path, "managed context")
snapshot, snapshot_raw = load(release_path / "snapshot.json", "snapshot")
catalog, _ = load(release_path / "catalog.json", "catalog")
lock, _ = load(release_path / "release.lock", "release lock")
state, _ = load(pathlib.Path(context["state_path"]), "managed state")
if "sha256:" + hashlib.sha256(snapshot_raw).hexdigest() != expected_digest:
    fail("snapshot bytes differ from the requested digest")
if not release_path.is_dir() or release_path.is_symlink():
    fail("release path must be a real directory")
if (snapshot.get("organization_id") != context.get("organization_id")
        or snapshot.get("channel_id") != context.get("channel_id")
        or lock.get("organization_id") != context.get("organization_id")
        or lock.get("channel_id") != context.get("channel_id")):
    fail("release identity differs from the fixed enrollment")
host_os = host_os.lower()
host_arch = host_arch.lower()
arch_aliases = {"amd64": "x86_64", "arm64": "aarch64"}
host_arch = arch_aliases.get(host_arch, host_arch)
if (not re.fullmatch(r"[a-z0-9_]+", host_os)
        or not re.fullmatch(r"[a-z0-9_]+", host_arch)):
    fail("host platform facts are unknown or ambiguous", "host-facts-unknown")
host_profile = f"{host_os}-{host_arch}"
if snapshot.get("target_profile") != host_profile or lock.get("target_profile") != host_profile:
    fail(f"release target profile does not match measured host {host_profile}",
         "host-profile-mismatch")

catalog_rows = catalog.get("apps")
lock_rows = lock.get("packages")
if not isinstance(catalog_rows, list) or not isinstance(lock_rows, list):
    fail("catalog/lock app arrays are unavailable")
catalog_by_id = {row.get("id"): row for row in catalog_rows if isinstance(row, dict)}
lock_by_id = {row.get("id"): row for row in lock_rows if isinstance(row, dict)}
if (len(catalog_by_id) != len(catalog_rows)
        or len(lock_by_id) != len(lock_rows)
        or any(app_re.fullmatch(str(app_id)) is None for app_id in catalog_by_id | lock_by_id)):
    fail("catalog/lock app ids are not exact sorted identities")
selection = state.get("owner_selection")
if (not isinstance(selection, dict)
        or selection.get("snapshot_digest") != expected_digest
        or state.get("snapshot", {}).get("snapshot_digest") != expected_digest):
    fail("owner-selected state does not name the requested snapshot")
choices = {
    row.get("id"): row.get("source") for row in selection.get("selections", [])
    if isinstance(row, dict)
}
selected = set()
for app_id, row in catalog_by_id.items():
    policy = row.get("policy")
    choice = choices.get(app_id)
    if policy == "blocked":
        if choice is not None:
            fail(f"blocked app {app_id!r} is selected", "policy-blocked-selected")
        continue
    if policy == "required":
        if choice not in {None, "managed"}:
            fail(f"required app {app_id!r} bypasses managed source",
                 "policy-required-bypassed")
        selected.add(app_id)
    elif policy == "available":
        if choice == "managed":
            selected.add(app_id)
    else:
        fail(f"catalog app {app_id!r} has unknown policy")

ceilings = state.get("capability_ceilings")
if not isinstance(ceilings, dict):
    fail("managed state capability ceilings are unavailable")
for app_id in sorted(selected):
    row = catalog_by_id[app_id]
    compatibility = exact(row.get("compatibility"), {"platforms", "profiles"},
                          f"catalog app {app_id} compatibility")
    if host_os not in compatibility["platforms"] or host_profile not in compatibility["profiles"]:
        fail(f"managed app {app_id!r} is incompatible with measured host facts",
             "app-host-incompatible")
    package = lock_by_id.get(app_id)
    if not isinstance(package, dict):
        fail(f"selected managed app {app_id!r} is absent from release.lock")
    capabilities = package.get("capabilities")
    ceiling = ceilings.get(app_id)
    if (not isinstance(capabilities, list) or capabilities != sorted(set(capabilities))
            or not set(capabilities) <= grantable):
        fail(f"managed app {app_id!r} requests an ungrantable capability",
             "capability-ungrantable")
    # An absent ceiling is the empty set, exactly as the accepted selection state
    # reads it: an app that requests no capability needs no enrollment entry, while
    # one that requests any is refused until the owner admits it.
    if ceiling is None:
        ceiling = []
    if not isinstance(ceiling, list) or not set(capabilities) <= set(ceiling):
        fail(f"managed app {app_id!r} exceeds its enrolled capability ceiling",
             "capability-over-ceiling")
    classification = package.get("data_compatibility")
    if classification not in {
        "backward-compatible-data", "maintenance-required", "stateless",
    }:
        fail(f"managed app {app_id!r} has unknown data compatibility",
             "data-class-unknown")
    for lifecycle in ("install.sh", "smoke.sh", package.get("deactivator")):
        if not isinstance(lifecycle, str):
            fail(f"managed app {app_id!r} lifecycle is incomplete",
                 "lifecycle-incomplete")
        executable(lifecycle, f"managed app {app_id!r} lifecycle {lifecycle}")

ledger_root = pathlib.Path(os.environ.get(
    "AIRLOCK_STATE_DIR", pathlib.Path.home() / ".local/state/airlock",
))
ledger_path = ledger_root / "app-ledger.json"
if ledger_path.exists() or ledger_path.is_symlink():
    ledger, _ = load(ledger_path, "installed ledger", canonical=False)
    if ledger.get("version") != 7 or not isinstance(ledger.get("entries"), dict):
        fail("installed ledger is not the current closed store")
    for app_id, entry in ledger["entries"].items():
        committed = entry.get("committed") if isinstance(entry, dict) else None
        if not isinstance(committed, dict) or committed.get("source_class") != "managed":
            continue
        if app_id not in selected:
            # An installed managed app the current desired state no longer selects is a
            # removal request.  Two refusals, in this order, because they are different
            # facts: a package with no recorded deactivator can never be removed safely
            # (design: report non-compliance, never escalate to explicit teardown), and
            # even a compliant one is not removed by this updater — per-app teardown
            # belongs to the app-scoped executor, so the honest answer is to refuse
            # before the checkout rather than to leave the app silently behind.
            lifecycle = committed.get("lifecycle")
            if not isinstance(lifecycle, dict) or not lifecycle.get("deactivate"):
                fail(f"managed removal for {app_id!r} has no recorded deactivator",
                     "removal-no-deactivator")
            policy = (catalog_by_id.get(app_id) or {}).get("policy")
            reason = {
                "blocked": "removal-blocked-policy",
                "available": "removal-deselected",
            }.get(policy, "removal-app-absent")
            fail(f"managed removal for {app_id!r} is not executed by the updater "
                 f"(catalog policy {policy!r})", reason)
        old_authority = committed.get("managed_authority")
        package = lock_by_id[app_id]
        if (not isinstance(old_authority, dict)
                or not digest_re.fullmatch(str(old_authority.get("package_digest")))):
            fail(f"installed managed identity for {app_id!r} is ambiguous",
                 "installed-identity-ambiguous")
        if (old_authority["package_digest"] != package.get("digest")
                and package.get("data_compatibility") == "maintenance-required"):
            fail(f"managed app {app_id!r} requires an operator-owned maintenance procedure",
                 "upgrade-maintenance-required")

if selected_output is not None:
    fd = os.open(
        selected_output,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    with os.fdopen(fd, "wb") as handle:
        handle.write(("".join(app_id + "\n" for app_id in sorted(selected))).encode())
        handle.flush()
        os.fsync(handle.fileno())
PY
}

# Importing a new organisation snapshot is exactly what a subscription lapse or an
# unenrollment stops, on every path that imports one.  Already-accepted cached releases
# are never gated here.
managed_refresh_admitted_or_die() { # <scratch> <checkout>
  managed_access_status "$1" "$2" "$1/access-before-refresh.json" \
    || die "reason=organization-access-unknown 고정된 managed access 상태를 읽지 못했습니다"
  managed_access_admits_refresh "$1/access-before-refresh.json" \
    || die "reason=organization-access-$(managed_access_field "$1/access-before-refresh.json" status) 조직 snapshot 갱신이 허용되지 않는 상태입니다 — 파일을 바꾸지 않았습니다"
}

managed_access_status() { # <scratch> <checkout> <new-private-file>
  managed_capture "$3" python3 "$2/bin/airlock-managed-state" inspect-installed-access
}

managed_access_field() { # <access-json> <status|organization_snapshots_allowed>
  python3 - "$1" "$2" <<'PY'
import json
import pathlib
import re
import sys

value = json.loads(pathlib.Path(sys.argv[1]).read_bytes())[sys.argv[2]]
if isinstance(value, bool):
    print("true" if value else "false")
    raise SystemExit(0)
if not isinstance(value, str) or re.fullmatch(r"[a-z-]{1,32}", value) is None:
    raise SystemExit(2)
print(value)
PY
}

managed_access_admits_refresh() { # <access-json>
  python3 - "$1" <<'PY'
import json
import pathlib
import sys

value = json.loads(pathlib.Path(sys.argv[1]).read_bytes())
if (value.get("status") != "active"
        or value.get("organization_snapshots_allowed") is not True):
    raise SystemExit(2)
PY
}

# A digest this box never accepted has no directory in the fixed store.  Saying that
# plainly is what a locked Install button needs; the verified resolve still decides
# whether a present directory is usable.
managed_cached_release_present() { # <context> <snapshot-digest>
  python3 - "$1" "$2" <<'PY'
import json
import pathlib
import re
import sys

context = json.loads(pathlib.Path(sys.argv[1]).read_bytes())
digest = sys.argv[2]
if re.fullmatch(r"sha256:[0-9a-f]{64}", digest) is None:
    raise SystemExit(2)
release = pathlib.Path(context["store_path"]) / "releases" / digest.removeprefix("sha256:")
if not release.is_dir() or release.is_symlink():
    raise SystemExit(2)
PY
}

managed_refresh_installed() { # <scratch> <complete-signed-release-dir>
  local scratch="$1" source="$2" at
  managed_utc_now "$scratch/refresh-at" || return 2
  IFS= read -r at <"$scratch/refresh-at" || return 2
  managed_capture "$scratch/refresh-verify.json" \
    python3 "$scratch/frozen-airlock-managed-release" verify --stage "$source" --signed \
      --authority "$(managed_context_field "$scratch/managed-context.json" authority_path)" \
      --at "$at" || return 2
  managed_capture "$scratch/refresh-installed.json" \
    python3 bin/airlock-managed-state refresh-installed --source "$source" --at "$at" \
    || return 2
  python3 - "$scratch/refresh-verify.json" "$scratch/refresh-installed.json" <<'PY'
import json
import pathlib
import sys

verified = json.loads(pathlib.Path(sys.argv[1]).read_bytes())
refreshed = json.loads(pathlib.Path(sys.argv[2]).read_bytes())
if (refreshed.get("snapshot_digest") != verified.get("snapshot_digest")
        or refreshed.get("access_status") != "active"):
    raise SystemExit(2)
PY
}

# The store view the Apps & updates surface renders.  Every row is derived from the
# verified cache and the ledger, never from a catalog read alone: the candidate is the
# channel's current release, the installed identity is what the ledger committed, and
# the action is what the updater would actually run for it.  An app on the release it
# already runs offers nothing.
managed_store_status() { # <scratch> <checkout>
  local scratch="$1" root="$2" context="$1/managed-context.json" at predecessor=""
  managed_utc_now "$scratch/status-at" || return 2
  IFS= read -r at <"$scratch/status-at" || return 2
  managed_capture "$scratch/status-current.json" \
    python3 "$scratch/frozen-airlock-managed-release" resolve-current \
      --store "$(managed_context_field "$context" store_path)" \
      --channel "$(managed_context_field "$context" channel_id)" \
      --authority "$(managed_context_field "$context" authority_path)" --at "$at" || return 2
  managed_capture "$scratch/status-current-cached.json" \
    python3 "$root/bin/airlock-managed-state" resolve-installed-cached \
      --snapshot-digest "$(managed_current_snapshot_digest "$scratch/status-current.json")" \
      --at "$at" || return 2
  managed_capture "$scratch/status-access.json" \
    python3 "$root/bin/airlock-managed-state" inspect-installed-access || return 2
  predecessor="$(python3 - "$scratch/status-current.json" <<'PY'
import hashlib
import json
import pathlib
import sys

current = json.loads(pathlib.Path(sys.argv[1]).read_bytes())
raw = pathlib.Path(current["promotion_receipt_path"]).read_bytes()
if "sha256:" + hashlib.sha256(raw).hexdigest() != current["promotion_receipt_digest"]:
    raise SystemExit(2)
print(json.loads(raw).get("previous_snapshot_digest") or "")
PY
)" || return 2
  : >"$scratch/status-predecessor.json"
  if [ -n "$predecessor" ]; then
    python3 "$root/bin/airlock-managed-state" resolve-installed-cached \
      --snapshot-digest "$predecessor" --at "$at" >"$scratch/status-predecessor.json" \
      2>/dev/null || : >"$scratch/status-predecessor.json"
  fi
  python3 - "$context" "$scratch/status-current.json" "$scratch/status-current-cached.json" \
    "$scratch/status-predecessor.json" "$scratch/status-access.json" "$at" \
    "$(platform)" "$(uname -m)" <<'PY'
import datetime
import json
import os
import pathlib
import sys

(context_path, current_path, cached_path, predecessor_path, access_path, at,
 host_os, host_arch) = sys.argv[1:]

def load(path):
    return json.loads(pathlib.Path(path).read_bytes())

def moment(value):
    return datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))

context, current, cached, access = (load(context_path), load(current_path),
                                    load(cached_path), load(access_path))
predecessor_raw = pathlib.Path(predecessor_path).read_bytes()
predecessor = json.loads(predecessor_raw) if predecessor_raw.strip() else None
release = pathlib.Path(current["release_path"])
catalog = json.loads((release / "catalog.json").read_bytes())
lock = json.loads((release / "release.lock").read_bytes())
state = load(context["state_path"])
host_os = host_os.lower()
host_arch = {"amd64": "x86_64", "arm64": "aarch64"}.get(host_arch.lower(), host_arch.lower())
host_profile = f"{host_os}-{host_arch}"

ledger_path = pathlib.Path(os.environ.get(
    "AIRLOCK_STATE_DIR", pathlib.Path.home() / ".local/state/airlock")) / "app-ledger.json"
entries = json.loads(ledger_path.read_bytes()).get("entries", {}) if ledger_path.is_file() else {}
ceilings = state.get("capability_ceilings") or {}
packages = {row["id"]: row for row in lock.get("packages", [])}

apps = []
for row in catalog.get("apps", []):
    app_id, policy = row["id"], row["policy"]
    package = packages.get(app_id)
    committed = ((entries.get(app_id) or {}).get("committed") or {})
    authority = committed.get("managed_authority") or {} if committed.get("source_class") == "managed" else {}
    installed_digest = authority.get("package_digest")
    candidate_digest = package["digest"] if package else None
    bundle_cached = bool(package) and (release / package["path"]).is_dir()
    action, locked = "none", None
    if policy == "blocked":
        locked = "removal-blocked-policy" if installed_digest else "policy-blocked"
    elif host_os not in row["compatibility"]["platforms"] or host_profile not in row["compatibility"]["profiles"]:
        locked = "app-host-incompatible"
    elif not bundle_cached:
        locked = "bundle-not-cached"
    elif not set(package["capabilities"]) <= set(ceilings.get(app_id) or []):
        locked = "capability-over-ceiling"
    elif installed_digest is None:
        action = "install"
    elif installed_digest != candidate_digest:
        if package["data_compatibility"] == "maintenance-required":
            locked = "upgrade-maintenance-required"
        else:
            action = "update"
    apps.append({
        "action": action if locked is None else "none",
        "bundle_cached": bundle_cached,
        "candidate_digest": candidate_digest,
        "id": app_id,
        "installed_digest": installed_digest,
        "installed_snapshot_digest": authority.get("snapshot_digest"),
        "locked_reason": locked,
        "name": (row.get("metadata") or {}).get("name"),
        "policy": policy,
        "source_label": row.get("source_label"),
        "version": (row.get("metadata") or {}).get("version"),
    })

refreshed_at = cached["promoted_at"]
view = {
    "access": access,
    "apps": apps,
    "channel_id": current["channel_id"],
    "current": {
        "cache_age_seconds": int((moment(at) - moment(refreshed_at)).total_seconds()),
        "epoch": current["epoch"],
        "publisher_id": current["publisher_id"],
        "refreshed_at": refreshed_at,
        "sequence": current["sequence"],
        "snapshot_digest": current["snapshot_digest"],
    },
    "measured_at": at,
    "organization_id": current["organization_id"],
    "recovery_predecessor": None if predecessor is None else {
        "cached": bool(predecessor.get("cached")),
        "refreshed_at": predecessor.get("promoted_at"),
        "snapshot_digest": predecessor.get("snapshot_digest"),
    },
    "schema": "airlock.update-channel.status/v1",
}
sys.stdout.write(json.dumps(view, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n")
PY
}

managed_transaction_phase() { # <installed-state-dir>
  python3 - "$1" <<'PY'
import json
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1]) / "install-transaction.json"
if path.is_symlink() or not path.is_file():
    raise SystemExit(2)
value = json.loads(path.read_bytes())
phase = value.get("phase")
if not isinstance(phase, str) or re.fullmatch(r"[a-z_]{1,32}", phase) is None:
    raise SystemExit(2)
print(phase)
PY
}

# The ledger's transaction record is the app-scoped executor's own receipt, and it is
# overwritten by the next install.  A managed run therefore freezes its outcome next to
# the installed state: which release was requested, which publisher authorized it, what
# was installed before and after, and the executor's per-app receipts exactly as the
# ledger wrote them.  This is the record a fleet or store surface reads; it is not a
# second source of truth and it never re-derives what the ledger already decided.
write_update_channel_receipt() { # <state-dir> <outcome> <context> <scratch> <before> <after> <update-rc> <phase>
  python3 - "$@" <<'PY'
import datetime
import hashlib
import json
import os
import pathlib
import re
import sys

(state_dir, outcome, context_path, scratch, before, after, update_rc, phase) = sys.argv[1:]
state_dir, scratch = pathlib.Path(state_dir), pathlib.Path(scratch)
context_path = pathlib.Path(context_path)

def fail(message):
    print(f"airlock-update managed receipt: {message}", file=sys.stderr)
    raise SystemExit(2)

def canonical(value):
    return (json.dumps(value, ensure_ascii=False, separators=(",", ":"),
                       sort_keys=True) + "\n").encode()

def load(path, label):
    try:
        return json.loads(path.read_bytes())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"cannot read {label}: {exc}")

def managed_identities(ledger):
    """Every managed app the ledger has committed, and the release it came from."""
    rows = {}
    for app_id, entry in sorted((ledger.get("entries") or {}).items()):
        committed = (entry or {}).get("committed") or {}
        if committed.get("source_class") != "managed":
            continue
        authority = committed.get("managed_authority") or {}
        rows[app_id] = {
            "package_digest": authority.get("package_digest"),
            "snapshot_digest": authority.get("snapshot_digest"),
        }
    return rows

if outcome not in {"installed", "recovered", "recovery-failed", "recovery-required"}:
    fail(f"unsupported outcome {outcome!r}")
if re.fullmatch(r"[0-9a-f]{0,40}", before) is None or re.fullmatch(r"[0-9a-f]{0,40}", after) is None:
    fail("checkout revisions are not lowercase Git object names")
context = load(context_path, "managed context")
current = load(scratch / "current-release-before.json", "requested current release")
requested = {key: current.get(key) for key in (
    "epoch", "promotion_receipt_digest", "publisher_id", "publisher_key_id",
    "sequence", "snapshot_digest", "target_profile",
)}
if not isinstance(requested["snapshot_digest"], str):
    fail("requested release has no snapshot digest")

previous_state = (scratch / "app-ledger.json.state").read_text().strip()
previous = (managed_identities(load(scratch / "app-ledger.json", "pre-update ledger"))
            if previous_state == "present" else {})
installed_path = state_dir / "app-ledger.json"
installed = (managed_identities(load(installed_path, "installed ledger"))
             if installed_path.is_file() and not installed_path.is_symlink() else {})

transaction_path = state_dir / "install-transaction.json"
transaction = {"phase": phase, "present": False}
if transaction_path.is_file() and not transaction_path.is_symlink():
    raw = transaction_path.read_bytes()
    value = json.loads(raw)
    transaction = {
        "app_receipts": value.get("app_receipts"),
        "managed_authorities": value.get("managed_authorities"),
        "managed_authority_sha256": value.get("managed_authority_sha256"),
        "phase": value.get("phase"),
        "present": True,
        "record_sha256": hashlib.sha256(raw).hexdigest(),
    }
    if transaction["phase"] != phase:
        fail(f"transaction phase changed under the receipt: {transaction['phase']} != {phase}")

receipt = {
    "actor": {
        "channel_actor": "update-channel",
        "gid": os.getegid(),
        "role": "box-owner",
        "uid": os.geteuid(),
    },
    "at": datetime.datetime.now(datetime.timezone.utc).replace(
        microsecond=0).isoformat().replace("+00:00", "Z"),
    "channel_id": context.get("channel_id"),
    "checkout": {"after": after, "before": before},
    "enrollment_digest": context.get("enrollment_digest"),
    "installed_managed": installed,
    "organization_id": context.get("organization_id"),
    "outcome": outcome,
    "previous_managed": previous,
    "requested_release": requested,
    "root_key_id": context.get("root_key_id"),
    "schema": "airlock.update-channel.receipt/v1",
    "transaction": transaction,
    "update_rc": int(update_rc),
}
receipt["receipt_digest"] = hashlib.sha256(canonical(receipt)).hexdigest()
raw = canonical(receipt)

directory = state_dir / "update-channel-receipts"
try:
    # The installer normally created the state directory already; a first managed
    # run on a box whose installer never wrote state still owns a private record.
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory.mkdir(mode=0o700, exist_ok=True)
except OSError as exc:
    fail(f"cannot create the receipt directory: {exc}")
stamp = receipt["at"].replace(":", "").replace("-", "")
name = f"{stamp}-{requested['snapshot_digest'].removeprefix('sha256:')[:12]}-{outcome}.json"
target = directory / name
for attempt in range(1, 100):
    candidate = target if attempt == 1 else target.with_name(f"{target.stem}.{attempt}.json")
    try:
        fd = os.open(
            candidate,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
    except FileExistsError:
        continue
    except OSError as exc:
        fail(f"cannot create the receipt: {exc}")
    with os.fdopen(fd, "wb") as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())
    print(str(candidate))
    raise SystemExit(0)
fail("cannot find a free receipt name")
PY
}

managed_current_snapshot_digest() { # <current-release-json>
  python3 - "$1" <<'PY'
import json
import pathlib
import re
import sys

value = json.loads(pathlib.Path(sys.argv[1]).read_bytes()).get("snapshot_digest")
if not isinstance(value, str) or re.fullmatch(r"sha256:[0-9a-f]{64}", value) is None:
    raise SystemExit(2)
print(value)
PY
}

managed_context_field() { # <context> <closed-field>
  python3 - "$1" "$2" <<'PY'
import json
import pathlib
import sys

path, field = sys.argv[1:]
allowed = {"authority_path", "channel_id", "state_path", "store_path"}
if field not in allowed:
    raise SystemExit(2)
value = json.loads(pathlib.Path(path).read_bytes())[field]
if not isinstance(value, str) or not value or any(ord(ch) < 32 for ch in value):
    raise SystemExit(2)
print(value)
PY
}

prepare_managed_update_context() { # <private-scratch> <new-context-file>
  python3 - "$1" "$2" <<'PY'
import hashlib
import json
import os
import pathlib
import re
import stat
import sys

scratch = pathlib.Path(sys.argv[1])
context_path = pathlib.Path(sys.argv[2])
anchor_path = pathlib.Path("/etc/airlock/managed-channel.json")
measurer_path = pathlib.Path("/opt/airlock/libexec/airlock-managed-release")
frozen_path = scratch / "frozen-airlock-managed-release"
uid, gid = os.geteuid(), os.getegid()
sha = re.compile(r"sha256:[0-9a-f]{64}\Z")
ident = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}\Z")

def fail(message):
    print(f"airlock-update managed preflight: {message}", file=sys.stderr)
    raise SystemExit(2)

def canonical(value):
    return (json.dumps(value, ensure_ascii=False, separators=(",", ":"),
                       sort_keys=True) + "\n").encode()

def object_pairs(rows):
    value = {}
    for key, item in rows:
        if key in value:
            fail(f"duplicate JSON key {key!r}")
        value[key] = item
    return value

def read_json(path, label):
    try:
        flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path, flags)
        with os.fdopen(fd, "rb") as handle:
            info = os.fstat(handle.fileno())
            if not stat.S_ISREG(info.st_mode):
                fail(f"{label} is not regular")
            raw = handle.read()
    except OSError as exc:
        fail(f"cannot open {label}: {exc}")
    try:
        value = json.loads(raw, object_pairs_hook=object_pairs)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"{label} is invalid JSON: {exc}")
    if canonical(value) != raw:
        fail(f"{label} is not canonical JSON")
    return value, raw, info

def directory(path, owner, group, mode, label):
    try:
        info = path.lstat()
    except OSError as exc:
        fail(f"cannot stat {label}: {exc}")
    if (not stat.S_ISDIR(info.st_mode) or path.is_symlink()
            or info.st_uid != owner or info.st_gid != group
            or stat.S_IMODE(info.st_mode) != mode):
        fail(f"{label} owner/mode/type is invalid")

def protected_directory(path, label):
    try:
        info = path.lstat()
    except OSError as exc:
        fail(f"cannot stat {label}: {exc}")
    if (not stat.S_ISDIR(info.st_mode) or path.is_symlink()
            or info.st_uid != 0 or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) & 0o022):
        fail(f"{label} is not a protected root directory "
             f"(uid={info.st_uid} gid={info.st_gid} mode={stat.S_IMODE(info.st_mode):04o})")

def private_file(path, owner, group, label):
    try:
        info = path.lstat()
    except OSError as exc:
        fail(f"cannot stat {label}: {exc}")
    if (not stat.S_ISREG(info.st_mode) or path.is_symlink()
            or info.st_uid != owner or info.st_gid != group
            or stat.S_IMODE(info.st_mode) != 0o600):
        fail(f"{label} owner/mode/type is invalid")

directory(scratch, uid, gid, 0o700, "private scratch")
for path in (pathlib.Path("/"), pathlib.Path("/etc"), pathlib.Path("/etc/airlock")):
    protected_directory(path, str(path))
anchor, anchor_raw, anchor_info = read_json(anchor_path, "managed anchor")
if (anchor_info.st_uid, anchor_info.st_gid, stat.S_IMODE(anchor_info.st_mode)) != (0, 0, 0o644):
    fail("managed anchor must be root:root 0644")
expected = {
    "authority_path", "channel_id", "enrollment_digest", "organization_id",
    "root_key_id", "schema", "state_path", "store_path", "writer_gid", "writer_uid",
}
if set(anchor) != expected or anchor.get("schema") != "airlock.managed.install-anchor/v1":
    fail("managed anchor has an unsupported closed shape")
if (type(anchor.get("writer_uid")) is not int
        or type(anchor.get("writer_gid")) is not int
        or anchor["writer_uid"] != uid or anchor["writer_gid"] != gid):
    fail("managed anchor writer does not match updater euid/egid")
for key in ("organization_id", "channel_id"):
    if not isinstance(anchor.get(key), str) or ident.fullmatch(anchor[key]) is None:
        fail(f"managed anchor {key} is invalid")
for key in ("root_key_id", "enrollment_digest"):
    if not isinstance(anchor.get(key), str) or sha.fullmatch(anchor[key]) is None:
        fail(f"managed anchor {key} is invalid")

namespace = pathlib.Path(f"/var/lib/airlock/managed/{uid}")
expected_paths = {
    "state_path": namespace / "managed-state.json",
    "authority_path": namespace / "authority",
    "store_path": namespace / "store",
}
for key, expected_path in expected_paths.items():
    raw = anchor.get(key)
    if not isinstance(raw, str) or pathlib.Path(raw) != expected_path or str(expected_path) != raw:
        fail(f"managed anchor {key} is not its fixed canonical child")
for path in (
    pathlib.Path("/var"), pathlib.Path("/var/lib"), pathlib.Path("/var/lib/airlock"),
    pathlib.Path("/var/lib/airlock/managed"),
):
    protected_directory(path, str(path))
directory(namespace, uid, gid, 0o700, "delegated managed root")
directory(expected_paths["authority_path"], uid, gid, 0o700, "managed authority")
directory(expected_paths["store_path"], uid, gid, 0o700, "managed store")
directory(expected_paths["store_path"] / "releases", uid, gid, 0o700, "managed releases")
for path, label in (
    (expected_paths["state_path"], "managed state"),
    (expected_paths["state_path"].with_name("managed-state.json.lock"), "managed state lock"),
    (expected_paths["authority_path"] / "root-public.der", "authority root"),
    (expected_paths["authority_path"] / "current-membership.json", "authority membership"),
    (expected_paths["store_path"] / ".promotion.lock", "promotion lock"),
    (expected_paths["store_path"] / "release-state.json", "release state"),
):
    private_file(path, uid, gid, label)
state, _state_raw, _state_info = read_json(expected_paths["state_path"], "managed state")
snapshot = state.get("snapshot")
if (state.get("schema") != "airlock.managed.box-state/v1"
        or state.get("organization_id") != anchor["organization_id"]
        or state.get("root_key_id") != anchor["root_key_id"]
        or state.get("enrollment_digest") != anchor["enrollment_digest"]
        or not isinstance(snapshot, dict)
        or snapshot.get("channel_id") != anchor["channel_id"]):
    fail("managed state does not match the root anchor")
root_raw = (expected_paths["authority_path"] / "root-public.der").read_bytes()
if "sha256:" + hashlib.sha256(root_raw).hexdigest() != anchor["root_key_id"]:
    fail("authority root bytes do not match the anchor")

for path in (
    pathlib.Path("/opt"), pathlib.Path("/opt/airlock"),
    pathlib.Path("/opt/airlock/libexec"),
):
    protected_directory(path, str(path))
try:
    flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    source_fd = os.open(measurer_path, flags)
    source_info = os.fstat(source_fd)
except OSError as exc:
    fail(f"cannot open installed trusted measurer: {exc}")
if (not stat.S_ISREG(source_info.st_mode) or source_info.st_uid != 0
        or source_info.st_gid != 0 or stat.S_IMODE(source_info.st_mode) != 0o555):
    os.close(source_fd)
    fail("installed trusted measurer must be root:root regular 0555")
source_hash = hashlib.sha256()
try:
    target_fd = os.open(
        frozen_path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
        | getattr(os, "O_NOFOLLOW", 0),
        0o500,
    )
    with os.fdopen(source_fd, "rb") as source, os.fdopen(target_fd, "wb") as target:
        while True:
            chunk = source.read(1024 * 1024)
            if not chunk:
                break
            source_hash.update(chunk)
            target.write(chunk)
        target.flush()
        os.fsync(target.fileno())
except OSError as exc:
    fail(f"cannot freeze installed trusted measurer: {exc}")
frozen_raw = frozen_path.read_bytes()
installed_sha = source_hash.hexdigest()
if hashlib.sha256(frozen_raw).hexdigest() != installed_sha:
    fail("frozen trusted measurer digest differs from opened installed bytes")
frozen_info = frozen_path.lstat()
if (frozen_info.st_uid, frozen_info.st_gid, stat.S_IMODE(frozen_info.st_mode)) != (uid, gid, 0o500):
    fail("frozen trusted measurer owner/mode changed")

context = dict(anchor)
context.update({
    "anchor_path": str(anchor_path),
    "anchor_sha256": hashlib.sha256(anchor_raw).hexdigest(),
    "installed_measurer_sha256": installed_sha,
    "schema": "airlock.update-channel.internal-context/v1",
})
raw = canonical(context)
try:
    fd = os.open(
        context_path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
        | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    with os.fdopen(fd, "wb") as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())
except OSError as exc:
    fail(f"cannot freeze managed context: {exc}")
PY
}

validate_managed_precheckout() { # <context> <measurement> <current> <new> <repo> <new-release-path-file>
  python3 - "$@" <<'PY'
import hashlib
import json
import os
import pathlib
import re
import stat
import subprocess
import sys

context_path, measurement_path, current_path, revision, repository, output_path = map(pathlib.Path, sys.argv[1:])
revision = str(revision)
sha40 = re.compile(r"[0-9a-f]{40}\Z")
sha256 = re.compile(r"sha256:[0-9a-f]{64}\Z")

def fail(message):
    print(f"airlock-update managed binding: {message}", file=sys.stderr)
    raise SystemExit(2)

def pairs(rows):
    value = {}
    for key, item in rows:
        if key in value:
            fail(f"duplicate JSON key {key!r}")
        value[key] = item
    return value

def canonical(value):
    return (json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n").encode()

def load(path, label):
    raw = path.read_bytes()
    value = json.loads(raw, object_pairs_hook=pairs)
    if canonical(value) != raw:
        fail(f"{label} is not canonical JSON")
    return value, raw

def root_anchor_raw(path):
    for parent in (pathlib.Path("/"), pathlib.Path("/etc"), pathlib.Path("/etc/airlock")):
        info = parent.lstat()
        if (not stat.S_ISDIR(info.st_mode) or parent.is_symlink()
                or info.st_uid != 0 or info.st_gid != 0
                or stat.S_IMODE(info.st_mode) & 0o022):
            fail(f"root anchor parent is not protected: {parent}")
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "rb") as handle:
        info = os.fstat(handle.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
                or stat.S_IMODE(info.st_mode) != 0o644):
            fail("root anchor owner/mode/type changed")
        return handle.read()

context, _ = load(context_path, "managed context")
measurement, _ = load(measurement_path, "core measurement")
current, _ = load(current_path, "current release")
if set(measurement) != {"digest", "public_revision", "public_tree", "schema", "source_revision"}:
    fail("core measurement shape is not closed")
if measurement.get("schema") != "airlock.core-public-measurement/v1":
    fail("core measurement schema is unsupported")
current_keys = {
    "authority_membership_digest", "authority_sequence", "bundle_digest",
    "catalog_digest", "channel_id", "core_digest", "core_revision", "epoch",
    "lock_digest", "organization_id", "promotion_membership_digest",
    "promotion_receipt_digest", "promotion_receipt_path", "publisher_id",
    "publisher_key_id", "receipt_id", "release_path", "requested_capabilities",
    "root_key_id", "schema", "sequence", "snapshot_digest", "target_profile",
    "verified_at",
}
if set(current) != current_keys or current.get("schema") != "airlock.managed.current-release/v1":
    fail("current release shape is not closed")
if sha40.fullmatch(revision) is None or measurement.get("public_revision") != revision:
    fail("measurement does not name the exact fetched public commit")
if (measurement.get("source_revision") != current.get("core_revision")
        or measurement.get("digest") != current.get("core_digest")):
    fail("private source revision or public core digest is not triple-bound")
tree = subprocess.run(
    ["git", "--no-replace-objects", "-C", str(repository), "rev-parse", "--verify", f"{revision}^{{tree}}"],
    stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
)
if tree.returncode != 0 or tree.stdout != (str(measurement.get("public_tree")) + "\n").encode():
    fail("public tree differs from the independent Git object identity")
for key in ("digest",):
    if not isinstance(measurement.get(key), str) or sha256.fullmatch(measurement[key]) is None:
        fail(f"core measurement {key} is invalid")
for key in ("public_revision", "public_tree", "source_revision"):
    if not isinstance(measurement.get(key), str) or sha40.fullmatch(measurement[key]) is None:
        fail(f"core measurement {key} is invalid")
if (current.get("channel_id") != context.get("channel_id")
        or current.get("organization_id") != context.get("organization_id")
        or current.get("root_key_id") != context.get("root_key_id")):
    fail("current release identity differs from the root anchor")
release = pathlib.Path(str(current.get("release_path")))
expected_release = pathlib.Path(context["store_path"]) / "releases" / str(current["snapshot_digest"]).removeprefix("sha256:")
if release != expected_release or not release.is_dir() or release.is_symlink():
    fail("current release is not the exact fixed-store snapshot path")
state, _ = load(pathlib.Path(context["state_path"]), "managed state")
snapshot = state.get("snapshot")
if (state.get("organization_id") != context.get("organization_id")
        or state.get("root_key_id") != context.get("root_key_id")
        or state.get("enrollment_digest") != context.get("enrollment_digest")
        or not isinstance(snapshot, dict)
        or snapshot.get("channel_id") != context.get("channel_id")
        or snapshot.get("snapshot_digest") != current.get("snapshot_digest")):
    fail("managed state is not bound to anchor and current release")
anchor_raw = root_anchor_raw(pathlib.Path(context["anchor_path"]))
if hashlib.sha256(anchor_raw).hexdigest() != context.get("anchor_sha256"):
    fail("root anchor changed before checkout")
fd = os.open(
    output_path,
    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
    0o600,
)
with os.fdopen(fd, "wb") as handle:
    handle.write((str(release) + "\n").encode())
PY
}

freeze_managed_next_measurer() { # <repository> <revision> <candidate-source> <new-inert-runfile>
  python3 - "$1" "$2" "$3" "$4" <<'PY'
import os
import pathlib
import stat
import subprocess
import sys

repository = pathlib.Path(sys.argv[1])
revision = sys.argv[2]
source = pathlib.Path(sys.argv[3])
target = pathlib.Path(sys.argv[4])
try:
    source_fd = os.open(source, os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
    info = os.fstat(source_fd)
    if not stat.S_ISREG(info.st_mode):
        raise OSError("candidate measurer is not regular")
    tree = subprocess.run(
        ["git", "--no-replace-objects", "-C", str(repository), "ls-tree", revision,
         "--", "bin/airlock-managed-release"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
    )
    fields = tree.stdout.rstrip(b"\n").split(None, 3)
    if (tree.returncode != 0 or len(fields) != 4 or fields[0] != b"100644"
            or fields[1] != b"blob" or fields[3] != b"bin/airlock-managed-release"):
        raise OSError("fetched tree does not carry the expected inert measurer source")
    expected = subprocess.run(
        ["git", "--no-replace-objects", "-C", str(repository), "cat-file", "blob",
         f"{revision}:bin/airlock-managed-release"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
    )
    if expected.returncode != 0:
        raise OSError("cannot read candidate measurer from the fetched Git object")
    incoming_raw = os.read(source_fd, info.st_size + 1)
    if incoming_raw != expected.stdout:
        raise OSError("checked-out candidate measurer differs from the fetched Git object")
    os.lseek(source_fd, 0, os.SEEK_SET)
    target_fd = os.open(
        target,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    with os.fdopen(source_fd, "rb") as incoming, os.fdopen(target_fd, "wb") as outgoing:
        while True:
            chunk = incoming.read(1024 * 1024)
            if not chunk:
                break
            outgoing.write(chunk)
        outgoing.flush()
        os.fsync(outgoing.fileno())
except OSError as exc:
    print(f"airlock-update managed next measurer: {exc}", file=sys.stderr)
    raise SystemExit(2)
PY
}

run_managed_installer() { # <context> <scratch> <repository> <revision> <config-path>
  local managed_context="$1" scratch="$2" repository="$3" revision="$4" config_path="$5"
  local managed_receipt_at="" managed_handoff_sha="" managed_app=""
  local -a managed_installer_args=()

  freeze_managed_next_measurer \
    "$repository" "$revision" "$repository/bin/airlock-managed-release" \
    "$scratch/next-airlock-managed-release" \
    || { say "후속 trusted measurer 후보 bytes 를 안전하게 고정하지 못했습니다"; return 2; }
  managed_private_target "$scratch/effective.toml" \
    || { say "managed effective config runfile 을 만들지 못했습니다"; return 2; }
  managed_capture "$scratch/config-receipt.json" \
    env AIRLOCK_CONFIG="$config_path" python3 "$repository/bin/airlock-config" \
      managed-config-snapshot \
      --state "$(managed_context_field "$managed_context" state_path)" \
      --release "$(managed_file_line "$scratch/current-release-path")" \
      --authority "$(managed_context_field "$managed_context" authority_path)" \
      --promoted-current "$scratch/effective.toml" \
    || { say "managed config producer 가 canonical receipt 를 완성하지 못했습니다"; return 2; }
  managed_receipt_time "$scratch/config-receipt.json" "$scratch/receipt-at" \
    || { say "managed config receipt 의 검증 시각이 유효하지 않습니다"; return 2; }
  IFS= read -r managed_receipt_at <"$scratch/receipt-at" \
    || { say "managed config receipt 의 검증 시각을 읽지 못했습니다"; return 2; }
  managed_capture "$scratch/current-release.json" \
    python3 "$scratch/frozen-airlock-managed-release" resolve-current \
      --store "$(managed_context_field "$managed_context" store_path)" \
      --channel "$(managed_context_field "$managed_context" channel_id)" \
      --authority "$(managed_context_field "$managed_context" authority_path)" \
      --at "$managed_receipt_at" \
    || { say "producer 종료 뒤 managed current release 재검증에 실패했습니다"; return 2; }
  build_managed_handoff \
    "$managed_context" "$scratch/core-measurement.json" \
    "$scratch/current-release-before.json" "$scratch/current-release.json" \
    "$scratch/effective.toml" "$scratch/config-receipt.json" \
    "$scratch/next-airlock-managed-release" "$revision" \
    "$scratch/update-channel-handoff.json" "$scratch/selected-apps" \
    "$scratch/update-channel-handoff.sha256" "$scratch/preflight-selected" \
    || { say "managed UPDATE_CHANNEL handoff 결속을 완성하지 못했습니다"; return 2; }
  IFS= read -r managed_handoff_sha <"$scratch/update-channel-handoff.sha256" \
    || { say "managed handoff digest 를 읽지 못했습니다"; return 2; }
  managed_installer_args=(
    "--update-channel-handoff=$scratch/update-channel-handoff.json"
    "--update-channel-handoff-sha256=$managed_handoff_sha"
  )
  while IFS= read -r managed_app; do
    [ -n "$managed_app" ] || continue
    managed_installer_args+=("--select-app=$managed_app")
  done <"$scratch/selected-apps"
  [ "${#managed_installer_args[@]}" -gt 2 ] \
    || { say "managed handoff 에 설치할 managed app 이 없습니다"; return 2; }
  say "설치기를 다시 돌립니다 (managed channel)…"
  AIRLOCK_CONFIG="$config_path" bash "$repository/install/airlock-install.sh" \
    "${managed_installer_args[@]}"
}

managed_receipt_time() { # <canonical-receipt> <new-private-time-file>
  python3 - "$1" "$2" <<'PY'
import datetime
import json
import os
import pathlib
import sys

source, target = map(pathlib.Path, sys.argv[1:])
raw = source.read_bytes()
value = json.loads(raw)
canonical = (json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n").encode()
if raw != canonical or not isinstance(value.get("verified_at"), str):
    raise SystemExit(2)
parsed = datetime.datetime.fromisoformat(value["verified_at"].replace("Z", "+00:00"))
if parsed.tzinfo is None:
    raise SystemExit(2)
fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
with os.fdopen(fd, "w", encoding="ascii", newline="") as handle:
    handle.write(value["verified_at"] + "\n")
PY
}

build_managed_handoff() { # context measurement current-before current config receipt next revision handoff apps digest preflight
  python3 - "$@" <<'PY'
import hashlib
import json
import os
import pathlib
import re
import stat
import sys

(context_path, measurement_path, before_path, current_path, config_path,
 receipt_path, next_path, revision, handoff_path, apps_path,
 handoff_digest_path, preflight_selected_path) = sys.argv[1:]
paths = [pathlib.Path(value) for value in (
    context_path, measurement_path, before_path, current_path, config_path,
    receipt_path, next_path, handoff_path, apps_path, handoff_digest_path,
)]
(context_path, measurement_path, before_path, current_path, config_path,
 receipt_path, next_path, handoff_path, apps_path,
 handoff_digest_path) = paths
sha40 = re.compile(r"[0-9a-f]{40}\Z")
shahex = re.compile(r"[0-9a-f]{64}\Z")
appid = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}\Z")

def fail(message):
    print(f"airlock-update managed handoff: {message}", file=sys.stderr)
    raise SystemExit(2)

def pairs(rows):
    value = {}
    for key, item in rows:
        if key in value:
            fail(f"duplicate JSON key {key!r}")
        value[key] = item
    return value

def canonical(value):
    return (json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n").encode()

def load(path, label):
    try:
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=pairs)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"cannot read {label}: {exc}")
    if canonical(value) != raw:
        fail(f"{label} is not canonical JSON")
    return value, raw

def root_anchor_raw(path):
    for parent in (pathlib.Path("/"), pathlib.Path("/etc"), pathlib.Path("/etc/airlock")):
        info = parent.lstat()
        if (not stat.S_ISDIR(info.st_mode) or parent.is_symlink()
                or info.st_uid != 0 or info.st_gid != 0
                or stat.S_IMODE(info.st_mode) & 0o022):
            fail(f"root anchor parent is not protected: {parent}")
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "rb") as handle:
        info = os.fstat(handle.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
                or stat.S_IMODE(info.st_mode) != 0o644):
            fail("root anchor owner/mode/type changed")
        return handle.read()

def raw_hash(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def private(path, owner, group, mode=0o600):
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or path.is_symlink()
            or info.st_uid != owner or info.st_gid != group
            or stat.S_IMODE(info.st_mode) != mode):
        fail(f"private runfile is not regular owner-bound {mode:04o}: {path}")

context, _context_raw = load(context_path, "managed context")
measurement, measurement_raw = load(measurement_path, "core measurement")
before, _before_raw = load(before_path, "initial current release")
current, current_raw = load(current_path, "final current release")
receipt, receipt_raw = load(receipt_path, "config receipt")
uid, gid = context.get("writer_uid"), context.get("writer_gid")
if type(uid) is not int or type(gid) is not int or (uid, gid) != (os.geteuid(), os.getegid()):
    fail("managed context writer changed")
scratch = context_path.parent
info = scratch.lstat()
if (not stat.S_ISDIR(info.st_mode) or scratch.is_symlink()
        or (info.st_uid, info.st_gid, stat.S_IMODE(info.st_mode)) != (uid, gid, 0o700)):
    fail("managed scratch owner/mode/type changed")
for path in (measurement_path, before_path, current_path, config_path, receipt_path, next_path):
    if path.parent != scratch:
        fail("managed payload escaped the single private run directory")
    private(path, uid, gid)
if hashlib.sha256(root_anchor_raw(pathlib.Path(context["anchor_path"]))).hexdigest() != context.get("anchor_sha256"):
    fail("root anchor changed before installer handoff")
identity_keys = set(before) - {"verified_at"}
if set(current) - {"verified_at"} != identity_keys or any(before[key] != current[key] for key in identity_keys):
    fail("managed current identity changed across the producer")
if current.get("verified_at") != receipt.get("verified_at"):
    fail("final current verification did not use the receipt instant")
if (measurement.get("public_revision") != revision
        or measurement.get("source_revision") != current.get("core_revision")
        or measurement.get("digest") != current.get("core_digest")):
    fail("core measurement lost its public/private/signed triple binding")
if sha40.fullmatch(revision) is None:
    fail("fetched public revision is not full lowercase SHA")
receipt_keys = {
    "authority_membership_digest", "authority_path", "authority_sequence",
    "catalog_digest", "channel_id", "config_digest", "config_origin",
    "config_path", "config_sha256", "epoch", "local_config_digest",
    "lock_digest", "managed_packages", "organization_id", "projection_digest",
    "release_mode", "release_path", "root_key_id", "schema", "selection_digest",
    "selection_sequence", "sequence", "snapshot_digest", "state_digest",
    "state_path", "target_profile", "verified_at", "verified_state",
}
if set(receipt) != receipt_keys or receipt.get("schema") != "airlock.managed.config-receipt/v1":
    fail("config receipt shape is not closed")
expected = {
    "authority_membership_digest": current.get("authority_membership_digest"),
    "authority_sequence": current.get("authority_sequence"),
    "catalog_digest": current.get("catalog_digest"),
    "channel_id": context.get("channel_id"),
    "epoch": current.get("epoch"),
    "lock_digest": current.get("lock_digest"),
    "organization_id": context.get("organization_id"),
    "release_mode": "promoted-current",
    "release_path": current.get("release_path"),
    "root_key_id": context.get("root_key_id"),
    "sequence": current.get("sequence"),
    "snapshot_digest": current.get("snapshot_digest"),
    "state_path": context.get("state_path"),
    "target_profile": current.get("target_profile"),
}
for key, value in expected.items():
    if receipt.get(key) != value:
        fail(f"config receipt {key} lost its anchor/current binding")
if receipt.get("authority_path") != context.get("authority_path"):
    fail("config receipt authority path is not anchor-derived")
if receipt.get("config_path") != str(config_path):
    fail("config receipt does not name the frozen effective config")
config_sha = raw_hash(config_path)
if receipt.get("config_sha256") != config_sha or receipt.get("config_digest") != "sha256:" + config_sha:
    fail("effective config bytes differ from the receipt")
verified_state = receipt.get("verified_state")
if (not isinstance(verified_state, dict)
        or verified_state.get("organization_id") != context.get("organization_id")
        or verified_state.get("root_key_id") != context.get("root_key_id")
        or verified_state.get("enrollment_digest") != context.get("enrollment_digest")):
    fail("receipt frozen state is not enrolled by the root anchor")
packages = receipt.get("managed_packages")
if not isinstance(packages, list) or not packages:
    fail("config receipt contains no managed packages")
selected = []
for row in packages:
    if (not isinstance(row, dict) or set(row) != {
            "capabilities", "id", "package_digest", "path", "policy", "source_class"
        } or row.get("source_class") != "managed"
            or not isinstance(row.get("id"), str) or appid.fullmatch(row["id"]) is None):
        fail("config receipt managed package row is invalid")
    selected.append(row["id"])
if selected != sorted(set(selected)):
    fail("managed selected app ids are not sorted and unique")
# The policy decision and the installer input are two derivations of one desired state.
# Bind them: a config receipt naming apps the preflight never judged is a refusal.
if pathlib.Path(preflight_selected_path).read_text().split() != selected:
    fail("config receipt apps differ from the preflight decision")

next_sha = raw_hash(next_path)
handoff = {
    "actor": "update-channel",
    "anchor_path": context["anchor_path"],
    "anchor_sha256": context["anchor_sha256"],
    "config_path": str(config_path),
    "config_sha256": config_sha,
    "core_measurement_path": str(measurement_path),
    "core_measurement_sha256": hashlib.sha256(measurement_raw).hexdigest(),
    "current_release_path": str(current_path),
    "current_release_sha256": hashlib.sha256(current_raw).hexdigest(),
    "fetched_public_revision": revision,
    "installed_measurer_sha256": context["installed_measurer_sha256"],
    "next_measurer_path": str(next_path),
    "next_measurer_sha256": next_sha,
    "receipt_path": str(receipt_path),
    "receipt_sha256": hashlib.sha256(receipt_raw).hexdigest(),
    "schema": "airlock.update-channel.install-handoff/v1",
    "selected_apps": selected,
}
handoff_raw = canonical(handoff)
for path, raw in (
    (handoff_path, handoff_raw),
    (apps_path, ("\n".join(selected) + "\n").encode()),
    (handoff_digest_path, (hashlib.sha256(handoff_raw).hexdigest() + "\n").encode()),
):
    fd = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    with os.fdopen(fd, "wb") as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())
    private(path, uid, gid)
PY
}

release_tree_matches_state() { # <public-release-commit> <local-commit-or-empty-for-worktree>
  local ref="$1" local_commit="$2" paths diff_names changed
  paths="$(git -c core.quotePath=false ls-tree -r --name-only "$ref" | sort)" || return 2
  if [ -n "$local_commit" ]; then
    diff_names="$(git -c core.quotePath=false diff --name-only "$ref" "$local_commit" \
      2>/dev/null)" || return 2
  else
    diff_names="$(git -c core.quotePath=false diff --name-only "$ref" -- . \
      2>/dev/null)" || return 2
  fi
  changed="$(printf '%s\n' "$diff_names" | sort \
    | comm -12 - <(printf '%s\n' "$paths"))" || return 2
  [ -z "$changed" ]
}

repository_name_from_url() { # <repository-url-or-path>
  local url="${1%/}"
  url="${url%.git}"
  printf '%s' "${url##*/}"
}

resolve_object_prefix() { # <hex-object-prefix>
  local prefix="$1" objects="" object="" resolved="" type="" count=0
  objects="$(git rev-parse --disambiguate="$prefix" 2>/dev/null)" || return 2
  while IFS= read -r object; do
    [ -n "$object" ] || continue
    count=$((count + 1))
    [ "$count" -le 1 ] || return 2
    resolved="$object"
  done <<<"$objects"
  [ "$count" = 1 ] || return 1
  type="$(git cat-file -t "$resolved" 2>/dev/null)" || return 2
  [ "$type" = commit ] || return 2
  printf '%s\n' "$resolved"
}

release_direction() { # <candidate-public-commit> <installed-head-or-empty> <requested-ref> <release-url>
  local candidate="$1" installed_head="$2" requested_ref="$3" release_url="$4"
  local origin_url="" release_name="" private_name="" subject="" subject_label=""
  local source_token="" source_commit="" private_tip="" installed_source=""
  local installed_release="" history_subject="" history_label="" history_token=""
  local history_source="" token="" ref="" first_parent_graph="" parent_line=""
  local marker_history="" marker_subject=""
  local first_parent="" side_parent="" candidate_history="" graph_rc=0 ancestor_rc=0
  local source_rc=0 reverse_rc=0 origin_rc=0
  local -a parents=()

  # A developer checkout has the private graph locally. Public release commits name
  # their source repository and SHA, so compare those commits rather than pretending
  # the unrelated public and private histories share ancestry. Build the source name
  # from the public repository identity instead of publishing a private name here.
  # Read the configured identity, not `remote get-url`: Git rewrites the latter via
  # url.*.insteadOf, which is transport routing and must not redefine repository
  # identity.  The tests use that distinction to route this canonical URL locally.
  origin_url="$(git config --get remote.origin.url 2>/dev/null)"
  origin_rc=$?
  if [ "$origin_rc" != 0 ] && [ "$origin_rc" != 1 ]; then
    printf '%s' ambiguous
    return 2
  fi
  origin_url="${origin_url%/}"
  origin_url="${origin_url%.git}"
  release_name="$(repository_name_from_url "$release_url")"
  private_name="${release_name}-work"
  case "$origin_url" in
    "https://github.com/spacewalk-labs/$private_name"|"git@github.com:spacewalk-labs/$private_name"|"ssh://git@github.com/spacewalk-labs/$private_name")
      # Deployment checkouts can have a local merge commit around the deployed
      # private source point. Comparing the public source directly with HEAD would
      # call the current release a rollback. The clone already records the private
      # main tip used by that deployment, so use that local evidence; fetching origin
      # here made one detector run contact two repositories. If the ref is absent or
      # too old to decide, return ambiguous with a measurement-failure status so the
      # collector retains its last successful snapshot and original checkedAt.
      private_tip="$(git rev-parse --verify -q "refs/remotes/origin/main^{commit}" 2>/dev/null)"
      source_rc=$?
      if [ "$source_rc" != 0 ] && [ "$source_rc" != 1 ]; then
        printf '%s' ambiguous
        return 2
      fi
      subject="$(git log -1 --format=%s "$candidate" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      if [[ "$subject" =~ ^release[[:space:]]from[[:space:]]([[:alnum:]_.-]+)[[:space:]]@[[:space:]]([0-9a-f]{7,40})$ ]]; then
        subject_label="${BASH_REMATCH[1]}"
        source_token="${BASH_REMATCH[2]}"
      fi
      if [ -z "$subject_label" ] || [ -z "$source_token" ]; then
        printf '%s' ambiguous
        return 2
      fi
      if [ "$subject_label" != "$private_name" ]; then
        printf '%s' ambiguous
        return 0
      fi
      if [ -n "$installed_head" ] && [ -n "$private_tip" ]; then
        source_commit="$(resolve_object_prefix "$source_token")"
        source_rc=$?
        if [ "$source_rc" = 2 ]; then
          printf '%s' ambiguous
          return 2
        fi

        # Deployment is a first-parent sequence of private states, with the public
        # release as a side parent of each deployment merge.  That topology records
        # which release was installed last even when public histories diverge or
        # commit timestamps are skewed.  A whole-graph log has neither property.
        first_parent_graph="$(git rev-list --first-parent --parents "$installed_head" 2>/dev/null)"
        graph_rc=$?
        if [ "$graph_rc" != 0 ]; then
          printf '%s' ambiguous
          return 2
        fi
        while IFS= read -r parent_line; do
          read -r -a parents <<<"$parent_line"
          [ "${#parents[@]}" -gt 2 ] || continue
          first_parent="${parents[1]}"
          for side_parent in "${parents[@]:2}"; do
            history_subject="$(git log -1 --format=%s "$side_parent" 2>/dev/null)"
            graph_rc=$?
            if [ "$graph_rc" != 0 ]; then
              printf '%s' ambiguous
              return 2
            fi
            history_label=""; history_token=""; history_source=""
            if [[ "$history_subject" =~ ^release[[:space:]]from[[:space:]]([[:alnum:]_.-]+)[[:space:]]@[[:space:]]([0-9a-f]{7,40})$ ]]; then
              history_label="${BASH_REMATCH[1]}"
              history_token="${BASH_REMATCH[2]}"
            fi
            [ "$history_label" = "$private_name" ] || continue
            history_source="$(resolve_object_prefix "$history_token")"
            source_rc=$?
            if [ "$source_rc" != 0 ] || [ -z "$history_source" ]; then
              printf '%s' ambiguous
              return 2
            fi
            git merge-base --is-ancestor "$history_source" "$first_parent" 2>/dev/null
            ancestor_rc=$?
            if [ "$ancestor_rc" = 0 ]; then
              installed_release="$side_parent"
              installed_source="$history_source"
              break 2
            fi
            [ "$ancestor_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          done
        done <<<"$first_parent_graph"

        if [ -z "$installed_source" ]; then
          installed_source="$(git merge-base "$installed_head" "$private_tip" 2>/dev/null)"
          graph_rc=$?
          if [ "$graph_rc" != 0 ] || [ -z "$installed_source" ]; then
            printf '%s' ambiguous
            return 2
          fi
          # With no deployment marker, a tracking tip strictly behind HEAD cannot
          # distinguish private source progress from operator commits. Refuse to
          # turn that stale evidence into a successful direction measurement.
          git merge-base --is-ancestor "$private_tip" "$installed_head" 2>/dev/null
          ancestor_rc=$?
          if [ "$ancestor_rc" = 0 ] && [ "$private_tip" != "$installed_head" ]; then
            printf '%s' ambiguous
            return 2
          fi
          [ "$ancestor_rc" = 0 ] || [ "$ancestor_rc" = 1 ] \
            || { printf '%s' ambiguous; return 2; }
        fi

        if [ -n "$source_commit" ] && [ -n "$installed_source" ]; then
          git merge-base --is-ancestor "$source_commit" "$private_tip" 2>/dev/null
          ancestor_rc=$?
        else
          ancestor_rc=1
        fi
        if [ "$ancestor_rc" = 0 ]; then
          [ "$source_commit" = "$installed_source" ] && { printf '%s' same; return 0; }
          git merge-base --is-ancestor "$source_commit" "$installed_source" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' rollback; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          git merge-base --is-ancestor "$installed_source" "$source_commit" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' forward; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          printf '%s' ambiguous
          return 0
        fi
        [ "$ancestor_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
        # Both commits exist and diverge, so this is a measured off-main release,
        # not a failed observation. A reverse ancestor means origin/main is merely
        # stale, so public release ancestry remains the available ordering evidence.
        if [ -n "$source_commit" ] && [ -n "$installed_source" ]; then
          git merge-base --is-ancestor "$private_tip" "$source_commit" 2>/dev/null
          reverse_rc=$?
          if [ "$reverse_rc" = 1 ]; then
            printf '%s' ambiguous
            return 0
          fi
          [ "$reverse_rc" = 0 ] || { printf '%s' ambiguous; return 2; }
        fi

        # A quiet deployment does not fetch its private remote merely to detect an
        # update. The source object for a later release can therefore be absent (or
        # newer than the locally recorded private tip). Public releases already form
        # a fetched ancestry and name their source digest. Find the release that names
        # this checkout's deployed source, then compare public release ancestry. This
        # keeps forward detection live without a second network fetch or a new version
        # identifier. The divergent-object case above is deliberately excluded: when
        # Git can prove a source is off private main, public ordering must not bless it.
        candidate_history="$(git log --format='%H%x09%s' "$candidate" 2>/dev/null)"
        graph_rc=$?
        if [ "$graph_rc" != 0 ]; then
          printf '%s' ambiguous
          return 2
        fi
        while IFS=$'\t' read -r ref history_subject; do
          history_label=""; history_token=""; history_source=""
          if [[ "$history_subject" =~ ^release[[:space:]]from[[:space:]]([[:alnum:]_.-]+)[[:space:]]@[[:space:]]([0-9a-f]{7,40})$ ]]; then
            history_label="${BASH_REMATCH[1]}"
            history_token="${BASH_REMATCH[2]}"
          fi
          [ "$history_label" = "$private_name" ] || continue
          history_source="$(resolve_object_prefix "$history_token")"
          source_rc=$?
          [ "$source_rc" != 1 ] || continue
          if [ "$source_rc" != 0 ] || [ -z "$history_source" ]; then
            printf '%s' ambiguous
            return 2
          fi
          if [ "$history_source" = "$installed_source" ]; then
            installed_release="$ref"
            break
          fi
        done <<<"$candidate_history"
        if [ -n "$installed_release" ]; then
          [ "$installed_release" = "$candidate" ] && { printf '%s' same; return 0; }
          git merge-base --is-ancestor "$installed_release" "$candidate" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' forward; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
          git merge-base --is-ancestor "$candidate" "$installed_release" 2>/dev/null
          graph_rc=$?
          [ "$graph_rc" = 0 ] && { printf '%s' rollback; return 0; }
          [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
        fi
      fi
      printf '%s' ambiguous
      return 2
      ;;
  esac

  # A box updated by this command has an unrelated local safety history, but its
  # commit subject records the public release SHA.  Resolve the newest such marker
  # against the public objects retained by the airlock-release remote.
  if [ -n "$installed_head" ]; then
    # Read subjects without a truncating pipeline. With pipefail, `head -1`
    # eventually turned a healthy git log into SIGPIPE on long-lived boxes. Git's
    # --grep is not a substitute: it also searches commit bodies, so an operator note
    # quoting marker text could hide the newest real marker.
    marker_history="$(git log --format=%s "$installed_head" 2>/dev/null)"
    graph_rc=$?
    if [ "$graph_rc" != 0 ]; then
      printf '%s' ambiguous
      return 2
    fi
    while IFS= read -r marker_subject; do
      if [[ "$marker_subject" =~ ^airlock-update:[[:space:]]배포본[[:space:]]([0-9a-f]{12,40})[[:space:]]으로[[:space:]]갱신$ ]]; then
        token="${BASH_REMATCH[1]}"
        break
      fi
    done <<<"$marker_history"
    if [ -n "$token" ]; then
      installed_release="$(resolve_object_prefix "$token")"
      source_rc=$?
      if [ "$source_rc" != 0 ] || [ -z "$installed_release" ]; then
        printf '%s' ambiguous
        return 2
      fi
    fi
  fi

  # Legacy first installs have no marker.  For the normal moving `main` ref, recover
  # provenance by finding the newest public ancestor whose complete public path set
  # matches any local commit.  Looking only at HEAD would reject a valid old install
  # after its operator committed an edit to a release-owned file.  Do not apply this
  # to an explicitly pinned old ref: files added by a later release would otherwise
  # be mistaken for operator files.
  if [ -z "$installed_release" ] && [ "$requested_ref" = main ]; then
    if [ -n "$installed_head" ]; then
      local local_ref match_rc lookup_failed=0 local_history="" release_history=""
      local_history="$(git rev-list "$installed_head" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      release_history="$(git rev-list "$candidate" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      while IFS= read -r ref; do
        while IFS= read -r local_ref; do
          if release_tree_matches_state "$ref" "$local_ref"; then
            installed_release="$ref"
            break
          else
            match_rc=$?
            [ "$match_rc" = 1 ] || { lookup_failed=1; break; }
          fi
        done <<<"$local_history"
        if [ "$lookup_failed" != 0 ] || [ -n "$installed_release" ]; then
          break
        fi
      done <<<"$release_history"
      [ "$lookup_failed" = 0 ] || { printf '%s' ambiguous; return 2; }
    else
      local match_rc release_history=""
      release_history="$(git rev-list "$candidate" 2>/dev/null)"
      graph_rc=$?
      if [ "$graph_rc" != 0 ]; then
        printf '%s' ambiguous
        return 2
      fi
      while IFS= read -r ref; do
        if release_tree_matches_state "$ref" ""; then
          installed_release="$ref"
          break
        else
          match_rc=$?
          [ "$match_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
        fi
      done <<<"$release_history"
    fi
  fi

  # Nothing to disagree with, only nothing to go on: no marker, and on `main` no local
  # state matches any published tree. A pinned ref stays ambiguous — tree matching was
  # never applied to it, so "no match" there is not a measurement.
  if [ -z "$installed_release" ]; then
    [ "$requested_ref" = main ] && { printf '%s' unknown; return 0; }
    printf '%s' ambiguous
    return 0
  fi
  [ "$installed_release" = "$candidate" ] && { printf '%s' same; return 0; }
  git merge-base --is-ancestor "$installed_release" "$candidate" 2>/dev/null
  graph_rc=$?
  [ "$graph_rc" = 0 ] && { printf '%s' forward; return 0; }
  [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
  git merge-base --is-ancestor "$candidate" "$installed_release" 2>/dev/null
  graph_rc=$?
  [ "$graph_rc" = 0 ] && { printf '%s' rollback; return 0; }
  [ "$graph_rc" = 1 ] || { printf '%s' ambiguous; return 2; }
  printf '%s' ambiguous
}

# Serialize the whole updater without a host `flock` dependency (macOS does not ship
# util-linux flock) and without an inherited lock fd that a lifecycle background
# process could keep forever.  The keeper locks the existing git directory itself,
# so even --dry-run shares the mutex without creating a file in the checkout or .git.
acquire_update_mutex() { # <absolute-git-dir>
  local git_dir="$1" ready keeper status="" spins=0
  ready="$(mktemp)" || die "업데이트 잠금 응답 파일을 만들지 못했습니다"
  rm -f -- "$ready"
  python3 - "$git_dir" "$ready" "$$" <<'PY' >/dev/null 2>&1 &
import fcntl, os, pathlib, sys, time

git_dir, ready, parent_raw = sys.argv[1:]
parent = int(parent_raw)
try:
    descriptor = os.open(git_dir, os.O_RDONLY)
    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    pathlib.Path(ready).write_text("busy", encoding="ascii")
    raise SystemExit(0)
except Exception as exc:
    pathlib.Path(ready).write_text(f"error:{exc}", encoding="utf-8")
    raise SystemExit(0)
pathlib.Path(ready).write_text("ok", encoding="ascii")
while os.getppid() == parent:
    try:
        os.kill(parent, 0)
    except ProcessLookupError:
        break
    time.sleep(0.1)
PY
  keeper=$!
  while [ ! -f "$ready" ] && kill -0 "$keeper" 2>/dev/null; do
    spins=$((spins + 1))
    [ "$spins" -lt 1000 ] || break
    sleep 0.01
  done
  [ ! -f "$ready" ] || status="$(cat "$ready")"
  rm -f -- "$ready"
  case "$status" in
    ok) AIRLOCK_UPDATE_KEEPER_PID="$keeper"; return 0 ;;
    busy) wait "$keeper" 2>/dev/null || true
      die "다른 airlock-update 또는 rollback 이 진행 중입니다 — 끝난 뒤 다시 시도하세요" ;;
    *) kill "$keeper" 2>/dev/null || true
      wait "$keeper" 2>/dev/null || true
      die "업데이트 실행 잠금을 잡지 못했습니다${status:+ ($status)}" ;;
  esac
}

release_update_mutex() {
  local keeper="${AIRLOCK_UPDATE_KEEPER_PID:-}"
  [ -n "$keeper" ] || return 0
  AIRLOCK_UPDATE_KEEPER_PID=""
  kill "$keeper" 2>/dev/null || true
  wait "$keeper" 2>/dev/null || true
}

# Run the status surface against the box that the installer actually changes.  On a
# Mac the checkout is shared into OrbStack, but the services/state live inside the
# machine; asking macOS would be a clean answer about the wrong computer.
box_status() { # box_status <checkout> <machine> [state-dir config-path]
  local root="$1" machine="$2" state_dir="${3-}" config_path="${4-}"
  if [ "$(platform)" != Darwin ]; then
    if [ $# -ge 4 ]; then
      (cd "$root" && AIRLOCK_STATE_DIR="$state_dir" AIRLOCK_CONFIG="$config_path" \
        python3 bin/airlock-status --json)
    else
      (cd "$root" && python3 bin/airlock-status --json)
    fi
    return $?
  fi
  # shellcheck disable=SC2016 # $1 expands inside the remote bash, not here.
  if [ $# -ge 4 ]; then
    orb -m "$machine" env "AIRLOCK_STATE_DIR=$state_dir" \
      "AIRLOCK_CONFIG=/mnt/mac$config_path" \
      bash -c 'cd "$1" && python3 bin/airlock-status --json' \
      airlock-status "/mnt/mac$root"
  else
    orb -m "$machine" bash -c 'cd "$1" && python3 bin/airlock-status --json' \
      airlock-status "/mnt/mac$root"
  fi
}

snapshot_regular() { # snapshot_regular <source> <snapshot-dir> <name>
  local source="$1" out="$2" name="$3"
  if [ -L "$source" ] || { [ -e "$source" ] && [ ! -f "$source" ]; }; then
    die "복구 기준 파일이 일반 파일이 아닙니다: $source"
  fi
  if [ -f "$source" ]; then
    cp -- "$source" "$out/$name" || die "복구 기준 파일을 복사하지 못했습니다: $source"
    chmod 0600 "$out/$name" || die "복구 기준 파일을 보호하지 못했습니다: $name"
    printf '%s\n' present >"$out/$name.state"
  else
    printf '%s\n' absent >"$out/$name.state"
  fi
}

snapshot_remote_state() { # snapshot_remote_state <machine> <state-dir> <out>
  local machine="$1" state_dir="$2" out="$3"
  # One remote process holds the writer lock while it copies BOTH records.  A tar
  # stream brings the private snapshot back without assuming the host's mktemp path
  # is mounted into the machine.
  orb -m "$machine" env "AIRLOCK_STATE_DIR=$state_dir" bash -s -- "$state_dir" <<'SNAPSHOT_REMOTE' \
    | tar -C "$out" -xf - || die "OrbStack 머신의 설치 상태를 일관되게 보존하지 못했습니다"
set -euo pipefail
state_dir=$1
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
snapshot_one() {
  source=$1; name=$2
  [ ! -L "$source" ] && { [ ! -e "$source" ] || [ -f "$source" ]; } || exit 41
  if [ -f "$source" ]; then
    cp -- "$source" "$tmp/$name"
    chmod 0600 "$tmp/$name"
    printf '%s\n' present >"$tmp/$name.state"
  else
    printf '%s\n' absent >"$tmp/$name.state"
  fi
}
if [ -d "$state_dir" ]; then
  lock="$state_dir/app-ledger.lock"
  [ ! -L "$lock" ] && { [ ! -e "$lock" ] || [ -f "$lock" ]; } || exit 41
  exec 9>>"$lock"
  flock -n 9 || exit 42
fi
snapshot_one "$state_dir/app-ledger.json" app-ledger.json
snapshot_one "$state_dir/plaintext-retirement.json" plaintext-retirement.json
tar -C "$tmp" -cf - .
SNAPSHOT_REMOTE
}

snapshot_box_state() { # snapshot_box_state <root> <machine> <out> [state-dir]
  local root="$1" machine="$2" out="$3" state_dir
  if [ "$(platform)" = Darwin ]; then
    if [ $# -ge 4 ]; then
      state_dir="$4"
    else
      # shellcheck disable=SC2016 # HOME/AIRLOCK_STATE_DIR belong to the machine.
      state_dir="$(orb -m "$machine" sh -c 'printf %s "${AIRLOCK_STATE_DIR:-$HOME/.local/state/airlock}"')" \
        || die "OrbStack 머신의 Airlock 상태 경로를 읽지 못했습니다"
    fi
    [ -n "$state_dir" ] || die "OrbStack 머신의 Airlock 상태 경로가 비었습니다"
    case "$state_dir" in /*) ;; *) die "OrbStack 머신의 Airlock 상태 경로가 절대 경로가 아닙니다: $state_dir" ;; esac
    case "$state_dir" in *$'\n'*|*$'\r'*) die "Airlock 상태 경로에 줄바꿈이 있어 안전하게 기록할 수 없습니다" ;; esac
    printf '%s' "$state_dir" >"$out/state-dir"
    snapshot_remote_state "$machine" "$state_dir" "$out" || return 1
  else
    state_dir="${4-${AIRLOCK_STATE_DIR:-$HOME/.local/state/airlock}}"
    case "$state_dir" in /*) ;; *) die "Airlock 상태 경로가 절대 경로가 아닙니다: $state_dir" ;; esac
    case "$state_dir" in *$'\n'*|*$'\r'*) die "Airlock 상태 경로에 줄바꿈이 있어 안전하게 기록할 수 없습니다" ;; esac
    printf '%s' "$state_dir" >"$out/state-dir"
    if [ -d "$state_dir" ]; then
      # The installer and ledger tool use this same lock.  One lock spans both
      # records so a snapshot cannot pair a ledger from one install with a
      # retirement record from another.
      (cd "$root" && \
        validate_target_shape "$state_dir/app-ledger.lock" && \
        exec 9>>"$state_dir/app-ledger.lock" && \
        flock -n 9 && \
        snapshot_regular "$state_dir/app-ledger.json" "$out" app-ledger.json && \
        snapshot_regular "$state_dir/plaintext-retirement.json" "$out" plaintext-retirement.json) \
        || return 1
    else
      snapshot_regular "$state_dir/app-ledger.json" "$out" app-ledger.json || return 1
      snapshot_regular "$state_dir/plaintext-retirement.json" "$out" plaintext-retirement.json || return 1
    fi
  fi
  snapshot_regular "$root/airlock.lock" "$out" airlock.lock || return 1
}

snapshot_hash() { git hash-object --stdin <"$1"; }

sha256_file() {
  python3 - "$1" <<'PY'
import hashlib
import pathlib
import sys

digest = hashlib.sha256()
with pathlib.Path(sys.argv[1]).open("rb") as handle:
    for block in iter(lambda: handle.read(1024 * 1024), b""):
        digest.update(block)
print(digest.hexdigest())
PY
}

capture_failed_state() { # <root> <machine> <recovery-dir>
  local root="$1" machine="$2" dir="$3" state_dir name
  local failed="$dir/failed"
  state_dir="$(cat "$dir/state-dir")" || return 1
  mkdir -m 0700 "$failed" || return 1
  if ! (snapshot_box_state "$root" "$machine" "$failed" "$state_dir"); then
    return 1
  fi
  for name in app-ledger.json plaintext-retirement.json airlock.lock; do
    if [ "$(cat "$failed/$name.state")" = present ]; then
      snapshot_hash "$failed/$name" >"$failed/$name.sha256" || return 1
    fi
  done
  chmod 0600 "$failed"/* || return 1
}

box_state_matches() { # <root> <machine> <expected-dir>
  local root="$1" machine="$2" expected="$3" current name state state_dir
  current="$(mktemp -d)" || return 1
  state_dir="$(cat "$expected/state-dir")" || { rm -rf -- "$current"; return 1; }
  if ! (snapshot_box_state "$root" "$machine" "$current" "$state_dir"); then
    rm -rf -- "$current"
    return 1
  fi
  if ! cmp -s "$expected/state-dir" "$current/state-dir"; then
    rm -rf -- "$current"
    return 1
  fi
  for name in app-ledger.json plaintext-retirement.json airlock.lock; do
    if ! cmp -s "$expected/$name.state" "$current/$name.state"; then
      rm -rf -- "$current"
      return 1
    fi
    state="$(cat "$expected/$name.state")"
    if [ "$state" = present ] && ! cmp -s "$expected/$name" "$current/$name"; then
      rm -rf -- "$current"
      return 1
    fi
  done
  rm -rf -- "$current"
}

arm_recovery() { # <dir> <scratch> <before> <config-path> <platform> <machine>
  local dir="$1" scratch="$2" before="$3" config="$4" os="$5" machine="$6" name staged
  staged="$(mktemp -d "$dir.prepare.XXXXXX")" \
    || die "복구 기록 준비 디렉터리를 만들지 못했습니다: $dir"
  for name in status-before.json config.snapshot state-dir \
              app-ledger.json.state plaintext-retirement.json.state airlock.lock.state \
              airlock-update; do
    cp -- "$scratch/$name" "$staged/$name" || die "복구 기록을 보존하지 못했습니다: $name"
  done
  mkdir -p "$staged/lease-tools/bin" "$staged/lease-tools/install" \
    || die "복구용 live-box lease 도구 디렉터리를 만들지 못했습니다"
  local relative
  for relative in bin/airlock-ledger install/lib.sh install/preflight.sh; do
    cp -- "$AIRLOCK_UPDATE_ACTIVE_LEASE_TOOLS_ROOT/$relative" \
      "$staged/lease-tools/$relative" \
      || die "복구용 live-box lease 도구를 보존하지 못했습니다: $relative"
    sha256_file "$staged/lease-tools/$relative" \
      >"$staged/lease-tools/$relative.sha256" \
      || die "복구용 live-box lease 도구 해시를 보존하지 못했습니다: $relative"
  done
  for name in app-ledger.json plaintext-retirement.json airlock.lock; do
    if [ "$(cat "$scratch/$name.state")" = present ]; then
      cp -- "$scratch/$name" "$staged/$name" || die "복구 기준을 보존하지 못했습니다: $name"
      snapshot_hash "$staged/$name" >"$staged/$name.sha256"
    fi
  done
  printf '%s' "$before" >"$staged/before"
  : >"$staged/after"
  printf '%s' "$config" >"$staged/config-path"
  printf '%s' "$os" >"$staged/platform"
  printf '%s' "$machine" >"$staged/machine"
  printf '%s' "$$" >"$staged/pid"
  snapshot_hash "$staged/config.snapshot" >"$staged/config.snapshot.sha256"
  for name in before config-path platform machine state-dir; do
    snapshot_hash "$staged/$name" >"$staged/$name.sha256"
  done
  printf '%s\n' checkout-pending >"$staged/phase"
  chmod 0600 "$staged"/* || die "복구 기록 권한을 좁히지 못했습니다"
  chmod 0700 "$staged/lease-tools" "$staged/lease-tools/bin" "$staged/lease-tools/install" \
    || die "복구용 live-box lease 디렉터리 권한을 좁히지 못했습니다"
  chmod 0500 "$staged/lease-tools/bin/airlock-ledger" \
    || die "복구용 live-box lease ledger 권한을 좁히지 못했습니다"
  chmod 0400 "$staged/lease-tools/bin/airlock-ledger.sha256" \
    "$staged/lease-tools/install/lib.sh.sha256" \
    "$staged/lease-tools/install/preflight.sh.sha256" \
    || die "복구용 live-box lease 도구 해시 권한을 좁히지 못했습니다"
  git update-ref refs/airlock-update/rollback "$before" \
    || die "업데이트 전 Git 객체를 복구용으로 고정하지 못했습니다"
  if ! mv -- "$staged" "$dir"; then
    git update-ref -d refs/airlock-update/rollback "$before" >/dev/null 2>&1 || true
    die "완성한 복구 기록을 제자리에 두지 못했습니다: $dir"
  fi
}

activate_recovery() { # <dir> <after>
  local dir="$1" after="$2" tmp
  tmp="$dir/after.tmp.$$"
  printf '%s' "$after" >"$tmp" || die "실패 업데이트 revision 을 복구 기록에 쓰지 못했습니다"
  chmod 0600 "$tmp" || die "실패 업데이트 revision 기록 권한을 좁히지 못했습니다"
  mv -f -- "$tmp" "$dir/after" || die "실패 업데이트 revision 을 원자적으로 고정하지 못했습니다"
  snapshot_hash "$dir/after" >"$dir/after.sha256" \
    || die "실패 업데이트 revision 해시를 고정하지 못했습니다"
  chmod 0600 "$dir/after.sha256" || die "실패 업데이트 revision 해시 권한을 좁히지 못했습니다"
  tmp="$dir/phase.tmp.$$"
  printf '%s\n' installing >"$tmp" || die "복구 기록 단계를 쓰지 못했습니다"
  chmod 0600 "$tmp" || die "복구 기록 단계 권한을 좁히지 못했습니다"
  mv -f -- "$tmp" "$dir/phase" || die "복구 기록 단계를 원자적으로 바꾸지 못했습니다"
}

record_update_event() { # <git-dir> <event> <before> <after> <rc>
  local git_dir="$1" event="$2" before="$3" after="$4" rc="$5"
  printf '%s\t%s\tbefore=%s\tafter=%s\trc=%s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$event" "$before" "$after" "$rc" \
    >>"$git_dir/airlock-update.log"
}

validate_snapshot() { # <dir> <name>
  local dir="$1" name="$2" state expected actual
  if [ ! -f "$dir/$name.state" ] || [ -L "$dir/$name.state" ]; then
    die "복구 기록이 불완전합니다: $name.state"
  fi
  state="$(cat "$dir/$name.state")"
  case "$state" in
    absent) [ ! -e "$dir/$name" ] || die "없어야 할 복구 기준 파일이 생겼습니다: $name" ;;
    present)
      if [ ! -f "$dir/$name" ] || [ -L "$dir/$name" ] || [ ! -f "$dir/$name.sha256" ]; then
        die "복구 기준 파일이 불완전합니다: $name"
      fi
      expected="$(cat "$dir/$name.sha256")"; actual="$(snapshot_hash "$dir/$name")"
      [ "$actual" = "$expected" ] || die "복구 기준 파일 해시가 달라졌습니다: $name" ;;
    *) die "복구 기준 파일 상태가 잘못됐습니다: $name ($state)" ;;
  esac
}

validate_target_shape() { # <path>
  local path="$1"
  [ ! -L "$path" ] || die "되돌릴 대상이 symlink 로 바뀌었습니다: $path"
  { [ ! -e "$path" ] || [ -f "$path" ]; } \
    || die "되돌릴 대상이 일반 파일이 아닙니다: $path"
}

# Remove every artifact the CURRENT ledger knows before restoring the old ledger.
# The order comes from the ledger's own dependency graph; alphabetical teardown can
# remove a dependency while its consumer is still live.  One flock covers teardown
# AND both old-state restores; releasing it between those operations lets another
# installer write a legitimate new ledger that rollback would then overwrite.
teardown_and_restore_box_state() { # <root> <machine> <state-dir> <snapshot-dir> <failed-dir>
  local root="$1" machine="$2" state_dir="$3" snapshot_dir="$4" failed_dir="$5"
  local box_root="$root"
  [ "$(platform)" != Darwin ] || box_root="/mnt/mac$root"
  if [ "$(platform)" = Darwin ]; then
    orb -m "$machine" env "AIRLOCK_STATE_DIR=$state_dir" bash -s -- \
      "$box_root" "$state_dir" "/mnt/mac$snapshot_dir" "/mnt/mac$failed_dir" <<'ROLLBACK_TEARDOWN'
set -euo pipefail
root=$1; state_dir=$2; snapshot_dir=$3; failed_dir=$4; ledger="$state_dir/app-ledger.json"
[ ! -L "$ledger" ] && { [ ! -e "$ledger" ] || [ -f "$ledger" ]; } || exit 41
mkdir -p "$state_dir"
exec 9>>"$state_dir/app-ledger.lock"
flock -n 9 || { echo "another airlock run holds the ledger lock" >&2; exit 42; }
[ "$(cat "$failed_dir/state-dir")" = "$state_dir" ] || exit 43
matches_failed() {
  name=$1; target=$2; state=$(cat "$failed_dir/$name.state")
  [ ! -L "$target" ] && { [ ! -e "$target" ] || [ -f "$target" ]; } || exit 41
  if [ "$state" = absent ]; then [ ! -e "$target" ]; return; fi
  [ "$state" = present ] && [ -f "$target" ] && cmp -s "$failed_dir/$name" "$target"
}
matches_failed app-ledger.json "$ledger" || exit 44
matches_failed plaintext-retirement.json "$state_dir/plaintext-retirement.json" || exit 44
matches_failed airlock.lock "$root/airlock.lock" || exit 44
if [ -f "$ledger" ]; then
  order="$(python3 - "$root/bin/airlock-ledger" <<'PY'
from importlib.machinery import SourceFileLoader
import sys
sys.dont_write_bytecode = True
m = SourceFileLoader("_airlock_rollback_ledger", sys.argv[1]).load_module()
s = m.load_store()
print("\n".join(m._removal_order(s, list(s["entries"]))))
PY
)"
  while IFS= read -r app; do
    [ -n "$app" ] || continue
    printf '{}\n' | python3 "$root/bin/airlock-ledger" teardown "$app"
  done <<<"$order"
fi
restore_one() {
  name=$1; target=$2; state_file="$snapshot_dir/$name.state"
  [ -f "$state_file" ] && [ ! -L "$state_file" ] || exit 43
  [ ! -L "$target" ] && { [ ! -e "$target" ] || [ -f "$target" ]; } || exit 41
  state=$(cat "$state_file")
  if [ "$state" = absent ]; then rm -f -- "$target"; return; fi
  [ "$state" = present ] && [ -f "$snapshot_dir/$name" ] && [ ! -L "$snapshot_dir/$name" ] || exit 43
  tmp="$target.airlock-rollback.$$"
  cp -- "$snapshot_dir/$name" "$tmp"
  chmod 0600 "$tmp"
  mv -f -- "$tmp" "$target"
}
restore_one app-ledger.json "$state_dir/app-ledger.json"
restore_one plaintext-retirement.json "$state_dir/plaintext-retirement.json"
restore_one airlock.lock "$root/airlock.lock"
ROLLBACK_TEARDOWN
  else
    (cd "$root" && AIRLOCK_STATE_DIR="$state_dir" bash -s -- \
      "$box_root" "$state_dir" "$snapshot_dir" "$failed_dir" <<'ROLLBACK_TEARDOWN'
set -euo pipefail
root=$1; state_dir=$2; snapshot_dir=$3; failed_dir=$4; ledger="$state_dir/app-ledger.json"
[ ! -L "$ledger" ] && { [ ! -e "$ledger" ] || [ -f "$ledger" ]; } || exit 41
mkdir -p "$state_dir"
exec 9>>"$state_dir/app-ledger.lock"
flock -n 9 || { echo "another airlock run holds the ledger lock" >&2; exit 42; }
[ "$(cat "$failed_dir/state-dir")" = "$state_dir" ] || exit 43
matches_failed() {
  name=$1; target=$2; state=$(cat "$failed_dir/$name.state")
  [ ! -L "$target" ] && { [ ! -e "$target" ] || [ -f "$target" ]; } || exit 41
  if [ "$state" = absent ]; then [ ! -e "$target" ]; return; fi
  [ "$state" = present ] && [ -f "$target" ] && cmp -s "$failed_dir/$name" "$target"
}
matches_failed app-ledger.json "$ledger" || exit 44
matches_failed plaintext-retirement.json "$state_dir/plaintext-retirement.json" || exit 44
matches_failed airlock.lock "$root/airlock.lock" || exit 44
if [ -f "$ledger" ]; then
  order="$(python3 - "$root/bin/airlock-ledger" <<'PY'
from importlib.machinery import SourceFileLoader
import sys
sys.dont_write_bytecode = True
m = SourceFileLoader("_airlock_rollback_ledger", sys.argv[1]).load_module()
s = m.load_store()
print("\n".join(m._removal_order(s, list(s["entries"]))))
PY
)"
  while IFS= read -r app; do
    [ -n "$app" ] || continue
    printf '{}\n' | python3 "$root/bin/airlock-ledger" teardown "$app"
  done <<<"$order"
fi
restore_one() {
  name=$1; target=$2; state_file="$snapshot_dir/$name.state"
  [ -f "$state_file" ] && [ ! -L "$state_file" ] || exit 43
  [ ! -L "$target" ] && { [ ! -e "$target" ] || [ -f "$target" ]; } || exit 41
  state=$(cat "$state_file")
  if [ "$state" = absent ]; then rm -f -- "$target"; return; fi
  [ "$state" = present ] && [ -f "$snapshot_dir/$name" ] && [ ! -L "$snapshot_dir/$name" ] || exit 43
  tmp="$target.airlock-rollback.$$"
  cp -- "$snapshot_dir/$name" "$tmp"
  chmod 0600 "$tmp"
  mv -f -- "$tmp" "$target"
}
restore_one app-ledger.json "$state_dir/app-ledger.json"
restore_one plaintext-retirement.json "$state_dir/plaintext-retirement.json"
restore_one airlock.lock "$root/airlock.lock"
ROLLBACK_TEARDOWN
    )
  fi
}

rollback_update() { # <root> <machine-option> <machine-marker>
  local root="$1" requested_machine="$2" marker="$3" git_dir git_common_dir dir phase before after
  local saved_platform saved_machine machine head parent dirty config_path state_dir rc=0
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)" \
    || die "git 메타데이터 경로를 읽지 못했습니다"
  git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "공통 git 메타데이터 경로를 읽지 못했습니다"
  acquire_update_mutex "$git_common_dir"
  dir="$git_dir/airlock-update-rollback"
  if [ ! -d "$dir" ] || [ -L "$dir" ]; then
    die "되돌릴 실패 업데이트 기록이 없습니다"
  fi
  for f in phase before before.sha256 after after.sha256 config-path config-path.sha256 \
           config.snapshot config.snapshot.sha256 platform platform.sha256 machine machine.sha256 \
           state-dir state-dir.sha256 \
           airlock-update status-before.json; do
    if [ ! -f "$dir/$f" ] || [ -L "$dir/$f" ]; then
      die "복구 기록이 불완전합니다: $f"
    fi
  done
  phase="$(cat "$dir/phase")"; before="$(cat "$dir/before")"; after="$(cat "$dir/after")"
  saved_platform="$(cat "$dir/platform")"; saved_machine="$(cat "$dir/machine")"
  config_path="$(cat "$dir/config-path")"; state_dir="$(cat "$dir/state-dir")"
  for f in before after config-path platform machine state-dir; do
    [ "$(snapshot_hash "$dir/$f")" = "$(cat "$dir/$f.sha256")" ] \
      || die "복구 기록의 metadata가 달라졌습니다: $f"
  done
  case "$state_dir" in /*) ;; *) die "복구 기록의 설치 상태 경로가 절대 경로가 아닙니다: $state_dir" ;; esac
  case "$phase" in
    failed|rollback-failed) ;;
    failed-unbound) die "실패 직후 설치 상태를 고정하지 못해 자동 롤백하지 않습니다" ;;
    installing) die "업데이트가 설치 중 끊겼지만 실패 직후 상태를 고정하지 못해 자동 롤백하지 않습니다" ;;
    *) die "롤백 자체가 '$phase' 단계에서 끊겨 자동 재개하지 않습니다 — 기록을 보존한 채 수동 점검이 필요합니다" ;;
  esac
  [ "$(platform)" = "$saved_platform" ] \
    || die "업데이트한 플랫폼($saved_platform)과 지금 플랫폼($(platform))이 다릅니다"
  machine="$saved_machine"
  if [ "$saved_platform" = Darwin ]; then
    [ -z "$requested_machine" ] || [ "$requested_machine" = "$saved_machine" ] \
      || die "업데이트 기록의 머신은 '$saved_machine' 입니다. '$requested_machine' 으로 바꿔 되돌리지 않습니다"
    machine="$(resolve_machine "$saved_machine" "$marker")" || return 1
  elif [ -n "$requested_machine" ]; then
    die "리눅스에서 기록하지 않은 --machine 을 붙여 되돌리지 않습니다"
  fi
  case "$before:$after" in
    *[!0-9a-f:]*|:*|*:) die "복구 기록의 Git revision 이 잘못됐습니다" ;;
  esac
  git cat-file -e "$before^{commit}" 2>/dev/null || die "업데이트 전 Git 객체가 없습니다: $before"
  git cat-file -e "$after^{commit}" 2>/dev/null || die "실패 업데이트 Git 객체가 없습니다: $after"
  if [ "$before" != "$after" ]; then
    parent="$(git rev-parse "$after^")" || die "실패 업데이트의 부모 revision 을 읽지 못했습니다"
    [ "$parent" = "$before" ] || die "실패 업데이트가 기록된 이전 revision 바로 위에 있지 않습니다"
  fi
  head="$(git rev-parse HEAD)" || die "현재 revision 을 읽지 못했습니다"
  case "$phase:$head" in
    failed:"$after"|rollback-failed:"$before") ;;
    *) die "현재 HEAD($head)가 복구 기록의 안전한 지점과 다릅니다" ;;
  esac
  dirty="$(git status --porcelain --untracked-files=all)" \
    || die "작업트리 변경 여부를 확인하지 못했습니다"
  [ -z "$dirty" ] || die "업데이트 뒤 별도 작업트리 변경이 있어 자동으로 지우지 않습니다:
$dirty"
  validate_snapshot "$dir" app-ledger.json
  validate_snapshot "$dir" plaintext-retirement.json
  validate_snapshot "$dir" airlock.lock
  [ "$(snapshot_hash "$dir/config.snapshot")" = "$(cat "$dir/config.snapshot.sha256")" ] \
    || die "보존한 airlock.toml 기준점의 해시가 달라졌습니다"
  if [ ! -f "$config_path" ] || [ -L "$config_path" ]; then
    die "업데이트 전 설정 경로가 일반 파일이 아니어서 되돌리지 않습니다: $config_path"
  fi
  cmp -s "$config_path" "$dir/config.snapshot" \
    || die "airlock.toml 의 정확한 bytes 가 업데이트 전과 달라져 자동으로 되돌리지 않습니다"

  if [ "$head" = "$after" ]; then
    if [ ! -d "$dir/failed" ] || [ -L "$dir/failed" ]; then
      die "실패 직후 설치 상태 기록이 없습니다"
    fi
    if [ ! -f "$dir/failed/state-dir" ] || [ -L "$dir/failed/state-dir" ] \
       || ! cmp -s "$dir/state-dir" "$dir/failed/state-dir"; then
      die "실패 직후 설치 상태 경로 기록이 기준점과 다릅니다"
    fi
    validate_snapshot "$dir/failed" app-ledger.json
    validate_snapshot "$dir/failed" plaintext-retirement.json
    validate_snapshot "$dir/failed" airlock.lock
    printf '%s\n' tearing-down >"$dir/phase"
    teardown_and_restore_box_state "$root" "$machine" "$state_dir" "$dir" "$dir/failed" \
      || die "실패 직후 상태가 달라졌거나 현재 설치 흔적 정리·이전 상태 복원을 끝내지 못했습니다"
    printf '%s\n' resetting-checkout >"$dir/phase"
    GIT_REFLOG_ACTION="airlock-update rollback $after -> $before" git reset --hard "$before" \
      || die "업데이트 전 checkout 으로 돌아가지 못했습니다"
  fi

  printf '%s' "$$" >"$dir/pid"
  printf '%s\n' rollback-installing >"$dir/phase"
  say "이전 설치기를 다시 적용하는 중…"
  if [ "$saved_platform" = Darwin ]; then
    orb -m "$machine" env "AIRLOCK_CONFIG=/mnt/mac$config_path" "AIRLOCK_STATE_DIR=$state_dir" \
      bash "/mnt/mac$root/install/airlock-install.sh" || rc=$?
  else
    (cd "$root" && AIRLOCK_CONFIG="$config_path" AIRLOCK_STATE_DIR="$state_dir" \
      bash install/airlock-install.sh) || rc=$?
  fi
  if [ "$rc" != 0 ]; then
    printf '%s\n' rollback-failed >"$dir/phase"
    record_update_event "$git_dir" rollback-install-failed "$before" "$after" "$rc"
    say "checkout 과 상태 기록은 이전 것으로 돌렸지만 이전 설치기 재적용이 실패했습니다 (rc=$rc)."
    say "다시 시도:  AIRLOCK_DIR=\"$root\" bash \"$dir/airlock-update\" --rollback"
    return "$rc"
  fi
  box_status "$root" "$machine" "$state_dir" "$config_path" \
    >"$dir/status-after-rollback.json"; rc=$?
  if [ "$rc" != 0 ]; then
    printf '%s\n' rollback-failed >"$dir/phase"
    record_update_event "$git_dir" rollback-status-failed "$before" "$after" "$rc"
    say "이전 설치기는 적용됐지만 복구 상태 검증은 통과하지 못했습니다 (airlock-status rc=$rc)."
    [ "$rc" != 3 ] || say "rc=3 은 실패가 없더라도 확인 못 한 항목이 있어 성공이 아닙니다."
    return "$rc"
  fi
  record_update_event "$git_dir" rollback-ok "$before" "$after" 0
  git update-ref -d refs/airlock-update/rollback "$before" \
    || die "복구용 Git ref 를 정리하지 못했습니다"
  rm -rf -- "$dir"
  say "업데이트 전 checkout 과 Airlock 관리 상태로 되돌렸고, 상태 검증도 통과했습니다 (airlock-status rc=0)."
  say "범위: 앱 데이터·OS 패키지·OrbStack 머신 자체는 박스 백업 대상이며 이 롤백이 되감지 않습니다."
  return 0
}

# A safety commit that FAILED must never be reported as one. `|| true` here is how an
# operator loses uncommitted work and is handed a recovery command that recovers a
# different tree: commit.gpgsign with no key, a pre-commit hook, a full disk — all of
# them make `git commit` fail, and all of them are invisible if its status is dropped.
#
# `--no-verify`, and `commit.gpgsign=false`, are deliberate and narrow. These two
# commits are not contributions — they are a SNAPSHOT of what was already on disk, so
# that the overwrite below is reversible. A pre-commit hook exists to judge work
# someone is authoring; pointed at a snapshot it can only do one thing, which is
# prevent the backup and leave the operator worse off than if we had never offered one.
#
# Measured, on the first real box this ran against: the checkout carried this
# repository's own leak-scan pre-commit hook, and two config backups the operator had
# made (`airlock.toml.bak-*`) contained the box's own hostname. The hook refused the
# safety commit, so the update stopped — correct, but it stops on EVERY box that
# followed our own guidance, which is every box worth updating.
#
# What is NOT bypassed is a commit that genuinely cannot be written — a full disk, a
# read-only object store. Those still stop the run, which is the property that matters:
# nothing gets overwritten unless the state before it was really recorded.
commit_or_die() {
  local out
  if ! out="$(git -c user.name=airlock -c user.email=airlock@localhost \
                  -c commit.gpgsign=false \
                  commit -q --no-verify -m "$1" 2>&1)"; then
    # An empty commit is not a failure — there was simply nothing to record.
    case "$out" in *"nothing to commit"*|*"nothing added"*) return 0 ;; esac
    die "업데이트 전 상태를 기록하지 못해 여기서 멈춥니다 — 기록 없이 덮어쓰면 되돌릴 수 없습니다.
       git 이 한 말: ${out}
       흔한 원인은 커밋 서명(commit.gpgsign)이나 pre-commit 훅입니다."
  fi
}
commit_release_or_die() {
  local message="$1" before="$2" root="$3" out
  if ! out="$(git -c user.name=airlock -c user.email=airlock@localhost \
                  -c commit.gpgsign=false \
                  commit -q --no-verify -m "$message" 2>&1)"; then
    case "$out" in *"nothing to commit"*|*"nothing added"*) return 0 ;; esac
    die "배포본 checkout 을 Git revision 으로 기록하지 못해 설치기를 실행하지 않습니다.
       이 revision 이 없으면 자동 롤백의 현재 지점을 증명할 수 없습니다.
       checkout 복원: git -C \"$root\" reset --hard $before
       git 이 한 말: ${out}"
  fi
}

# Names, not just a count: "바뀔 파일 3 개" is not something an operator can check.
report_list() {
  printf '%s' "$1" | grep -c . >/dev/null || return 0
  local total shown
  total="$(printf '%s' "$1" | grep -c .)"
  shown=12
  if [ "${AIRLOCK_UPDATE_JSON:-0}" = 1 ]; then
    awk -v shown="$shown" 'length($0) > 0 { print "         " $0; if (++count >= shown) exit }' \
      <<<"$1" >&2
    [ "$total" -gt "$shown" ] && printf '         … 그리고 %s 개 더\n' "$((total - shown))" >&2
  else
    awk -v shown="$shown" 'length($0) > 0 { print "         " $0; if (++count >= shown) exit }' \
      <<<"$1"
    [ "$total" -gt "$shown" ] && printf '         … 그리고 %s 개 더\n' "$((total - shown))"
  fi
  return 0
}

# On a Mac the install lives in an OrbStack Linux machine, and its NAME is
# per-operator: docker/orbstack-machine-setup.sh falls back to `airlock`, but the
# install guide has people pass their own. Running the setup script without one would
# not update their machine — it would CREATE A SECOND ONE and install into it, which
# looks like a successful update and leaves the box they actually use untouched.
resolve_machine() {
  local given="$1" marker="$2" listing rc name found="" count
  command -v orb >/dev/null 2>&1 \
    || die "orb 을 찾지 못했습니다. OrbStack 을 한 번 실행한 뒤 다시 시도해 주세요."

  if [ -n "$given" ]; then
    # An explicit name gets the SAME check as a detected one. It is the documented
    # escape from every detection failure, so leaving it unchecked would put the
    # "second machine" outcome one typo away — and the setup script creates a machine
    # whose name it does not recognise rather than refusing.
    if orb run -m "$given" test -d "$marker" >/dev/null 2>&1; then
      printf '%s' "$given"; return 0
    fi
    die "'$given' 에서 Airlock 설치를 찾지 못했습니다.
       이름이 정확한지 봐 주세요 — 없는 이름을 주면 설치기가 그 이름으로 새 머신을 만듭니다.
       목록: $(orb list 2>/dev/null | sed 's/[[:cntrl:]]\[[0-9;]*m//g' | awk 'NR>0 && $1!="NAME" {printf "%s ", $1}')"
  fi

  say "Airlock 이 설치된 리눅스 머신을 찾는 중…" >&2
  # `orb list` failing is a different problem from "no machine has Airlock", and
  # reporting the second when it is the first sends the operator to --machine, which
  # is the one path that can build a machine they did not ask for.
  listing="$(orb list 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    die "OrbStack 에 머신 목록을 물어보지 못했습니다 (orb list 가 실패). OrbStack 이 켜져 있는지 봐 주세요."
  fi
  # Only machines that are ALREADY RUNNING are probed. `orb run` starts a stopped
  # machine, so probing everything would boot every OrbStack machine the operator has —
  # including ones that have nothing to do with Airlock — as a side effect of asking a
  # question. Stopped ones are named at the end instead, so a stopped Airlock machine is
  # still findable, by --machine, which starts exactly the one they chose.
  #
  # Strip ANSI: orb prints no colour into a pipe today (measured on the Mac mini), but a
  # coloured name would silently match nothing and end up at --machine.
  local skipped=""
  while IFS=$'\t' read -r name state; do
    [ -n "$name" ] || continue
    case "$name" in NAME) continue ;; esac
    if [ -n "$state" ] && [ "$state" != running ]; then
      skipped="$skipped$name ($state)"$'\n'
      continue
    fi
    if orb run -m "$name" test -d "$marker" >/dev/null 2>&1; then
      found="$found$name"$'\n'
    fi
  done <<EOF
$(printf '%s\n' "$listing" | sed 's/[[:cntrl:]]\[[0-9;]*m//g' | awk '{printf "%s\t%s\n", $1, $2}')
EOF
  count="$(awk 'NF { count++ } END { print count + 0 }' <<<"$found")"
  case "$count" in
    1) name="$(awk 'NF { print; exit }' <<<"$found")"
       say "찾았습니다: $name" >&2; printf '%s' "$name"; return 0 ;;
    0) die "돌고 있는 머신 중에 Airlock 이 설치된 것을 찾지 못했습니다.$(
         [ -n "$skipped" ] && printf '\n       %s' "멈춰 있어 확인하지 않은 머신: $(printf '%s' "$skipped" | tr '\n' ' ')"
       )
       머신 이름을 아시면 이렇게 알려 주세요:  bash bin/airlock-update --machine <이름>
       (설치할 때 쓰신 이름입니다. 'orb list' 로 목록을 볼 수 있습니다)" ;;
    *) die "Airlock 이 설치된 머신이 여러 개입니다:
$(printf '%s' "$found" | grep . | sed 's/^/         /')
       어느 것을 갱신할지 골라 주세요:  bash bin/airlock-update --machine <이름>" ;;
  esac
}

main "$@"
}
unset AIRLOCK_UPDATE_CAPSULE_ROOT
airlock_update_program "$@"
