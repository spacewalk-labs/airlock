#!/usr/bin/env python3
"""airlock-agent — which agent CLI should a platform tool run on this box?

Invoke through Python; this file intentionally remains mode 100644, like
bin/airlock-backup and bin/airlock-status. A new executable under bin/ is not
allowed into this repository without an explicit catalog entry, and this tool
does not need one — every caller already spawns an interpreter.

One question, one answer, so that two tools cannot disagree about it:

  python3 bin/airlock-agent select --json            -> resolve [agent].provider from the config
  python3 bin/airlock-agent select --json --prefer X -> resolve X (auto|claude|codex) instead

Output is a single JSON line on stdout:

  {"schema_version":1,"provider":"codex","command":"codex",
   "binary":"/home/me/.npm-global/bin/codex","reason":"..."}

`provider` and `binary` are null when nothing is runnable; `reason` is always a
sentence a person can act on, in both cases. Exit status is 0 whenever the
question was answered — "no CLI is installed" is an answer, not a failure — and
2 only when the question could not be asked (bad usage, unreadable config).

Callers that cannot import Python from the platform tree use this. Callers that
can should import `agent_provider` directly; the rule lives there, and this file
is only the two pieces of evidence the platform feeds it:

  · the binary, via bin_discovery — a systemd user unit's PATH finds neither the
    npm prefix nor a native install, so `which` alone reports "not installed"
    for a CLI that works fine in a login shell
  · the credential trace, via airlock-accounts-status login-state, which reads
    the login FILES and returns one boolean per provider. It never returns the
    credential itself, and this file never learns where one lives.

Neither piece can block the other: a trace that cannot be measured is read as
"no trace", never as "not installed". The trace only orders the candidates.
"""
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

import agent_provider  # noqa: E402
import bin_discovery  # noqa: E402

USAGE = "usage: python3 bin/airlock-agent select --json [--prefer auto|claude|codex]\n"

LOGIN_STATE_TIMEOUT = 10
LOGIN_STATE_MAX_BYTES = 64 * 1024


def _config_bin():
    """The single reader of airlock.toml. AIRLOCK_CONFIG_BIN is the orchestrator's
    per-run wrapper (install/lib.sh); without it, our own sibling."""
    return os.environ.get("AIRLOCK_CONFIG_BIN") or os.path.join(HERE, "airlock-config")


def _accounts_status_bin():
    return (os.environ.get("AIRLOCK_ACCOUNTS_STATUS_BIN")
            or os.path.join(HERE, "airlock-accounts-status"))


def configured_preference():
    """`[agent].provider` as airlock-config resolves it (defaults included)."""
    proc = subprocess.run([sys.executable, _config_bin(), "get", "agent.provider"],
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if proc.returncode != 0:
        sys.stderr.write("airlock-agent: cannot read [agent].provider: %s\n"
                         % proc.stderr.decode("utf-8", "replace").strip())
        raise SystemExit(2)
    return proc.stdout.decode("utf-8", "replace").strip()


def login_traces():
    """{provider_id: bool}. Every failure collapses to "no trace at all".

    A broken probe must not be able to veto an installed CLI, so this returns
    the shape it always returns and lets selection fall through to declaration
    order. stderr and raw stdout are deliberately not logged: the platform
    contract hands back booleans and nothing else, and repeating output we did
    not parse is how credential material leaks into a log.
    """
    empty = {p.id: False for p in agent_provider.PROVIDERS}
    binary = (_accounts_status_bin() or "").strip()
    if not binary:
        return empty
    try:
        proc = subprocess.run([binary, "login-state", "--json"],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=LOGIN_STATE_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return empty
    if proc.returncode != 0 or len(proc.stdout) > LOGIN_STATE_MAX_BYTES:
        return empty
    try:
        payload = json.loads(proc.stdout.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return empty
    if not isinstance(payload, dict) or payload.get("schema_version") != 1:
        return empty
    providers = payload.get("providers")
    if not isinstance(providers, dict):
        return empty
    return {pid: providers.get(pid) is True for pid in empty}


def make_probe(traces):
    def probe(provider):
        return bin_discovery.find_bin(provider.command)[0], traces.get(provider.id, False)
    return probe


def cmd_select(argv):
    prefer = None
    as_json = False
    rest = list(argv)
    while rest:
        arg = rest.pop(0)
        if arg == "--json":
            as_json = True
        elif arg == "--prefer":
            if not rest:
                sys.stderr.write("airlock-agent: --prefer needs a value\n")
                return 2
            prefer = rest.pop(0)
        else:
            sys.stderr.write("airlock-agent: unknown argument %r\n" % arg)
            return 2
    if not as_json:
        # There is no human-readable mode on purpose: every consumer of this is a
        # program, and a second output shape would be a second thing to keep true.
        sys.stderr.write(USAGE)
        return 2
    if prefer is None:
        prefer = configured_preference()
    chosen = agent_provider.select(prefer, make_probe(login_traces()))
    print(json.dumps({
        "schema_version": 1,
        "provider": chosen.provider.id if chosen.provider else None,
        "command": chosen.provider.command if chosen.provider else None,
        "binary": chosen.binary,
        "reason": chosen.reason,
    }, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
    return 0


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["select"]:
        return cmd_select(argv[1:])
    sys.stderr.write(USAGE)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
