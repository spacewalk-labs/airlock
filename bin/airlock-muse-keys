#!/usr/bin/env python3
"""airlock-muse-keys — the current Muse vault-key map as JSON on stdout.

Prints one line: {"<1Password item>": "<key>"}. An item that cannot be read
maps to null, which the account surface turns into an err entry rather than
dropping the key from the list. Values cross on the pipe only; nothing is
printed to stderr and nothing is logged.

Discovery, not enumeration: shared-side items are those matching
^OPENCODE_[A-Z0-9_]+_API_KEY$ in the team reader's listing. No item or vault
name is spelled out here — the names that would trip the public-mirror leak
scan live in the vault and in box-local install environment, not in this file.
A new key appears on the next request with no code change; a removed one
simply stops being listed.

The shared reader is handed in, never guessed (see install/airlock-accounts-api.sh):
AIRLOCK_MUSE_SECRET_BIN supports `list` + `get <title>`. Every Muse key follows
that one shared discovery path; there is no item-specific reader or visibility rule.
"""

import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

ITEM_RE = re.compile(r"\AOPENCODE_[A-Z0-9_]+_API_KEY\Z")
READ_TIMEOUT = 25


def _lines(proc):
    try:
        out = subprocess.run(proc, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=READ_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if out.returncode != 0:
        return []
    try:
        text = (out.stdout or b"").decode("utf-8")
    except UnicodeDecodeError:
        return []
    return [line.strip() for line in text.splitlines()]


def _value(proc):
    try:
        out = subprocess.run(proc, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=READ_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    try:
        text = (out.stdout or b"").decode("utf-8")
    except UnicodeDecodeError:
        return None
    if text.endswith("\n"):
        text = text[:-1]
    return text or None


def main():
    secret_bin = os.environ.get("AIRLOCK_MUSE_SECRET_BIN", "").strip()
    jobs = []
    if secret_bin and os.path.isfile(secret_bin):
        for line in _lines([secret_bin, "list"]):
            if ITEM_RE.match(line):
                jobs.append((line, [secret_bin, "get", line]))
    seen = set()
    unique = []
    for item, argv in jobs:
        if item not in seen:
            seen.add(item)
            unique.append((item, argv))

    def read(job):
        item, argv = job
        return item, _value(argv)

    result = {}
    if unique:
        with ThreadPoolExecutor(max_workers=8) as pool:
            for item, value in pool.map(read, unique):
                result[item] = value
    sys.stdout.write(json.dumps(result) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
