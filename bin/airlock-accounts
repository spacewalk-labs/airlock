#!/usr/bin/env python3
"""airlock-accounts — log in to Claude Code accounts and switch between them, no browser.

How it works (all of this is measured against the live CLI, not guessed):
  - Claude Code reads one file: ~/.claude/.credentials.json ("live").
  - accessToken lives ~8h; the refreshToken *rotates* on every refresh (the old value
    dies instantly). So a switch must save the current account back to its pool slot
    (preserving the newest tokens) before overwriting live.
  - Switching = copy the target account's creds from the pool into live, refreshing
    directly (POST /v1/oauth/token) if the token is about to expire. `claude --continue`
    then resumes the same conversation on the new account.
  - A browser is needed exactly once per account (to seed the pool). Switching after
    that is browser-free.

Layout:
  ~/.claude/.credentials.json     live file that Claude Code reads
  ~/.claude-accounts/<name>.json  per-account pool entry, chmod 600
  ~/.claude-accounts/.active      name of the currently active account

One credential lineage = one refresher. Do not copy the same account's pool file to
another machine (log in on each). Secret values are never printed — only identity,
expiry and health.
"""
import base64, hashlib, json, os, re, stat, sys, time, shutil, subprocess, tempfile
import socket
import threading
import urllib.request, urllib.error, urllib.parse

HOME = os.path.expanduser("~")
LIVE = os.path.join(HOME, ".claude", ".credentials.json")
POOL = os.path.join(HOME, ".claude-accounts")
ACTIVE = os.path.join(POOL, ".active")
CODEX_HOME = os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex")
CODEX_AUTH = os.path.join(CODEX_HOME, "auth.json")
CODEX_AUTH_BAK = CODEX_AUTH + ".pre-relogin"
# Where `codex login --device-auth` output is captured while we scrape the pairing
# URL and code out of it. It sits beside auth.json because it belongs to the same
# login attempt and dies with it; nothing here is a credential (the device code is
# useless without the browser approval it asks for).
CODEX_LOGIN_OUT = os.path.join(CODEX_HOME, ".relogin-capture.out")
# One pending device-auth at a time. codex wipes auth.json the moment the flow starts,
# so a pending record is what lets an abandoned attempt (browser/popup closed, no
# explicit cancel) be recovered after the TTL below instead of staying wiped.
CODEX_RELOGIN_PENDING = os.path.join(CODEX_HOME, ".relogin-pending.json")
# How long an uncompleted attempt may leave the box without a login before the
# previous one is put back on its own. 15 minutes: the panel tells the person to
# enter the code "within 15 min", so past that the attempt is abandoned by definition.
CODEX_RELOGIN_TTL_SEC = 15 * 60
# No verdict inside the first minute of an attempt. A device flow cannot complete
# that fast (the person must open a browser and type the code), but codex wipes
# auth.json within milliseconds of starting — so a sweep landing in that window
# would otherwise read "a login is present" from the not-yet-wiped file and
# mistake the attempt it was meant to protect for a completed one.
CODEX_RELOGIN_GRACE_SEC = 60
_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
_CODEX_DEVICE_URL_RE = re.compile(r"https://\S*openai\.com/codex/device\S*")
_CODEX_DEVICE_CODE_RE = re.compile(r"\b([A-Z0-9]{4}-[A-Z0-9]{4,6})\b")
CODEX_DEVICE_URL_FALLBACK = "https://auth.openai.com/codex/device"
# 20 x 0.5s. Measured against the live CLI: the code appears in well under a
# second, and the ceiling only exists so a hung `codex` cannot hold the caller.
CODEX_CAPTURE_TRIES = 20
CODEX_CAPTURE_INTERVAL = 0.5
CODEX_LOGOUT_TIMEOUT = 20

# Shared runtime modules live beside this platform CLI. Keeping them with their
# consumers makes the checkout directly executable and avoids any dependency on an app
# artifact directory. Executing this file puts bin/ on sys.path implicitly, but the
# offline suites load it by absolute path, which does not — so say it explicitly.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bin_discovery  # noqa: E402
# The death-verdict marker protocol is shared with airlock-accounts-status: that tool
# observes rejections during a status read, this one during a switch, and both list it.
import account_health  # noqa: E402

CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
TOKEN_ENDPOINTS = [
    "https://platform.claude.com/v1/oauth/token",
    "https://console.anthropic.com/v1/oauth/token",
]
PROFILE_ENDPOINT = "https://api.anthropic.com/api/oauth/profile"
USAGE_ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
AUTHORIZE_ENDPOINT = "https://claude.com/cai/oauth/authorize"
REDIRECT_URI = "https://platform.claude.com/oauth/code/callback"
# Exactly the scopes `claude` itself requests. Trimming them yields a token Claude
# Code cannot use.
SCOPES = ("org:create_api_key user:profile user:inference user:sessions:claude_code "
          "user:mcp_servers user:file_upload")
PENDING = os.path.join(POOL, ".login-pending.json")
REFRESH_IF_WITHIN_SEC = 30 * 60   # pre-refresh on switch if the token expires this soon
LOGIN_CODE_MAX_BYTES = 400


# ---------- helpers ----------

def die(msg, code=1):
    print(f"  ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def _claude_bin():
    """Absolute path to the `claude` CLI, or die saying where we looked.

    The two places this is used spawned "claude" by name and left resolution to
    PATH. From a login shell that works; from anything the gate spawns it does not,
    because a systemd --user unit's PATH has none of the directories a node CLI
    installs into — and execvp's own failure is a bare "No such file or directory"
    that reads as a missing conversation rather than a missing binary."""
    path, diag = bin_discovery.find_bin("claude")
    if path is None:
        die(bin_discovery.not_found_message("claude", diag))
    return path


def _ensure_pool():
    os.makedirs(POOL, exist_ok=True)
    # Avoid a metadata write on every read-only `list`: the live pool is commonly on a
    # read-only view inside verification sandboxes, and chmod(0700) still fails there
    # even when the directory is already exactly 0700. Repair an unsafe mode when one
    # exists; leave a correct directory untouched.
    if stat.S_IMODE(os.stat(POOL).st_mode) != 0o700:
        os.chmod(POOL, 0o700)


def _load(path):
    with open(path) as f:
        return json.load(f)


def _save_atomic(path, obj, mode=0o600):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def _oauth(creds):
    return creds.get("claudeAiOauth", {})


def _get_active():
    try:
        return open(ACTIVE).read().strip() or None
    except OSError:
        return None


def _set_active(name):
    with open(ACTIVE + ".tmp", "w") as f:      # plain name, not a secret
        f.write(name)
    os.replace(ACTIVE + ".tmp", ACTIVE)


def _pool_path(name):
    if not name or "/" in name or name.startswith("."):
        die(f"invalid account name: {name!r}")
    return os.path.join(POOL, name + ".json")


def _fmt_expiry(ms):
    if not ms:
        return "?"
    dt = time.gmtime(ms / 1000)
    rel = (ms / 1000) - time.time()
    tag = f"{rel/3600:+.1f}h" if abs(rel) < 48 * 3600 else f"{rel/86400:+.1f}d"
    return f"{time.strftime('%m-%d %H:%MZ', dt)} ({tag})"


def _at_valid(o):
    return o.get("expiresAt", 0) / 1000 > time.time()


def _b64u(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


# ---------- OAuth refresh ----------

def refresh_creds(creds, quiet=False):
    """Refresh a credential blob. Returns (creds|None, kind):
      (creds, None)       success
      (None, "auth")      the server *rejected* the refreshToken — only a re-login
                          revives it (expired / logged out / rotated elsewhere).
      (None, "transient") network, 5xx, 429 — retrying later works.

    Keeping those apart is the whole point: collapsing them into one "failed" marks
    healthy accounts dead on a momentary outage."""
    o = _oauth(creds)
    rt = o.get("refreshToken")
    if not rt:
        return None, "auth"
    body = json.dumps({"grant_type": "refresh_token", "refresh_token": rt,
                       "client_id": CLIENT_ID}).encode()
    kind, last, resp = "transient", "?", None
    for url in TOKEN_ENDPOINTS:
        req = urllib.request.Request(url, data=body, method="POST",
                                     headers={"Content-Type": "application/json",
                                              "Accept": "application/json",
                                              "User-Agent": "claude-cli/2.1"})
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                resp = json.loads(r.read())
            break
        except urllib.error.HTTPError as e:
            last = f"HTTP {e.code}: {e.read()[:160].decode('utf-8','replace')}"
            if e.code in (400, 401):
                # 400 invalid_grant / 401 = the server rejected this refreshToken: a
                # verdict, not a hiccup. Stop here — asking the fallback endpoint would
                # let its unrelated answer (console.anthropic.com currently 404s)
                # overwrite the verdict with "transient" and hide a dead account.
                kind = "auth"
                break
            kind = "transient"
        except Exception as e:
            last = str(e)
            kind = "transient"
    if resp is None:
        if not quiet:
            print(f"  warn: refresh failed ({last}) — this account may need a re-login",
                  file=sys.stderr)
        return None, kind
    o["accessToken"] = resp["access_token"]
    if resp.get("refresh_token"):
        o["refreshToken"] = resp["refresh_token"]
    if resp.get("expires_in"):
        o["expiresAt"] = int((time.time() + resp["expires_in"]) * 1000)
    if resp.get("refresh_token_expires_in"):
        o["refreshTokenExpiresAt"] = int((time.time() + resp["refresh_token_expires_in"]) * 1000)
    return creds, None


# ---------- identity ----------

def _profile(token, timeout=8):
    """GET /api/oauth/profile (read-only, no rotation) -> {email, org_type} or None."""
    if not token:
        return None
    h = {"Authorization": f"Bearer {token}", "anthropic-version": "2023-06-01",
         "anthropic-beta": "oauth-2025-04-20", "User-Agent": "claude-cli/1.0"}
    try:
        with urllib.request.urlopen(urllib.request.Request(PROFILE_ENDPOINT, headers=h),
                                    timeout=timeout) as r:
            j = json.load(r)
    except Exception:
        return None
    a, o = j.get("account") or {}, j.get("organization") or {}
    return {"email": a.get("email"), "org_type": o.get("organization_type")}


def _identity(token):
    """Token -> who it belongs to. Nobody names accounts by hand: the name is derived
    from the id (email) plus org kind, because the same email can belong to both a
    team and a personal org."""
    p = _profile(token)
    if not p or not p.get("email"):
        return None
    kind = "team" if p.get("org_type") == "claude_team" else "personal"
    return {"email": p["email"], "org": p.get("org_type"), "kind": kind,
            "name": f"{p['email']} ({kind})"}


def _store_account(creds, fallback_name=None, set_active=False):
    """Write creds to the pool under the identity-derived name, recording identity in
    _meta."""
    ident = _identity(_oauth(creds).get("accessToken", ""))
    if ident:
        name = ident["name"]
        creds = dict(creds)
        creds["_meta"] = {"email": ident["email"], "org": ident["org"], "kind": ident["kind"]}
        # Backfill the subscription type: the authorization_code response carries no
        # organization, so it would otherwise show as "?" in the list. The profile
        # already told us authoritatively.
        o = _oauth(creds)
        if not o.get("subscriptionType") or o["subscriptionType"] == "?":
            o["subscriptionType"] = (ident["org"] or "").replace("claude_", "") or "?"
    elif fallback_name:
        name = fallback_name
        print("  warn: identity lookup failed (token expired?) — using the fallback name; "
              "fix it later with 'relabel'", file=sys.stderr)
    else:
        die("identity lookup failed (token expired?) — cannot derive a name")
    _save_atomic(_pool_path(name), creds)
    if set_active:
        _set_active(name)
    return name


# ---------- login (link + code: the headless path devterm uses) ----------

def _read_login_code_stdin():
    """Read one approval code from a pipe, never argv/env or an echoing terminal."""
    if sys.stdin.isatty():
        raise ValueError("login-code requires protected stdin (the DevTerm account popup handles this)")
    raw = sys.stdin.buffer.read(LOGIN_CODE_MAX_BYTES + 1)
    if not raw or len(raw) > LOGIN_CODE_MAX_BYTES:
        raise ValueError("login-code stdin is empty or too large")
    try:
        code = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ValueError("login-code stdin is not valid UTF-8") from exc
    if any(ch.isspace() for ch in code):
        raise ValueError("login-code stdin contains whitespace")
    return code


def cmd_login_url():
    """Issue just the login link (PKCE). The verifier stays on this box; the user only
    approves in a browser and hands the code back to `login-code`. No TUI, no naming."""
    _ensure_pool()
    verifier = _b64u(os.urandom(32))
    state = _b64u(os.urandom(32))
    challenge = _b64u(hashlib.sha256(verifier.encode()).digest())
    q = urllib.parse.urlencode({
        "code": "true", "client_id": CLIENT_ID, "response_type": "code",
        "redirect_uri": REDIRECT_URI, "scope": SCOPES,
        "code_challenge": challenge, "code_challenge_method": "S256", "state": state})
    _save_atomic(PENDING, {"verifier": verifier, "state": state, "ts": time.time()})
    print(AUTHORIZE_ENDPOINT + "?" + q)


def _claim_pending_login():
    """Atomically consume one PKCE flow before its one-time code can be exchanged.

    The uniquely named claim keeps a concurrently-created *new* login flow at PENDING
    intact.  Unlink after loading: once an exchange has started, an ambiguous timeout
    must require a new link rather than permit replay of the same code.
    """
    claim = f"{PENDING}.claim-{os.getpid()}-{_b64u(os.urandom(6))}"
    try:
        os.replace(PENDING, claim)
    except OSError:
        die("no login is pending — run 'airlock-accounts login-url' first")
    try:
        return _load(claim)
    except Exception:
        die("no login is pending — run 'airlock-accounts login-url' first")
    finally:
        try:
            os.remove(claim)
        except OSError:
            pass


def cmd_login_code(pasted):
    """Exchange the browser's approval code (code#state) for tokens -> stored in the
    pool under the logged-in id."""
    _ensure_pool()
    pend = _claim_pending_login()
    if time.time() - pend.get("ts", 0) > 900:
        die("that login link is stale (over 15 min) — get a fresh one with 'login-url'")
    code = pasted.strip()
    state = pend["state"]
    if "#" in code:                       # the browser hands back <code>#<state>
        code, state = code.split("#", 1)
    body = json.dumps({"grant_type": "authorization_code", "code": code, "state": state,
                       "client_id": CLIENT_ID, "redirect_uri": REDIRECT_URI,
                       "code_verifier": pend["verifier"]}).encode()
    req = urllib.request.Request(TOKEN_ENDPOINTS[0], data=body, method="POST",
                                 headers={"Content-Type": "application/json",
                                          "Accept": "application/json",
                                          "User-Agent": "claude-cli/2.1"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            resp = json.loads(r.read())
    except urllib.error.HTTPError as e:
        die(f"token exchange failed (HTTP {e.code})\n"
            "     the code is single-use and short-lived — get a new link with 'login-url'.")
    except Exception:
        die("token exchange failed\n"
            "     the code is single-use and short-lived — get a new link with 'login-url'.")
    org = (resp.get("organization") or {}).get("organization_type", "")
    creds = {"claudeAiOauth": {
        "accessToken": resp["access_token"],
        "refreshToken": resp.get("refresh_token"),
        "expiresAt": int((time.time() + resp.get("expires_in", 28800)) * 1000),
        "scopes": (resp.get("scope") or SCOPES).split(),
        "subscriptionType": org.replace("claude_", "") or "?",
    }}
    if resp.get("refresh_token_expires_in"):
        creds["claudeAiOauth"]["refreshTokenExpiresAt"] = int(
            (time.time() + resp["refresh_token_expires_in"]) * 1000)
    first = _get_active() is None
    if first:
        # A box with no `.active` may still have a live file (someone ran `claude` and
        # logged in outside airlock-accounts). Preserve it into the pool NOW, before the
        # new record lands — if it is the same identity, doing it after would overwrite
        # the tokens just issued with the older ones.
        _saveback()
    n = _store_account(creds)
    if first:
        # Pool + `.active` is not a login: Claude reads ~/.claude/.credentials.json, and
        # on a pristine box nothing else ever writes it. Go through the same atomic
        # switch a later swap uses (minus its save-back, done above), so live and the
        # pool share one lineage from the first minute and the panel's "active" row is
        # the account actually in use.
        _switch_core(n, saveback=False)
        print(f"  registered '{n}' (first account -> active, installed as live)")
    elif _refresh_live_if_same(n, creds):
        print(f"  renewed '{n}' — it is the account in use, so live was replaced too.")
        print("    (running sessions are unaffected; the next `claude` start picks it up)")
    else:
        print(f"  registered '{n}' (active unchanged)")


def _refresh_live_if_same(name, creds):
    """If the account just registered is the one currently live, move live onto the new
    lineage — that makes "re-login" also mean "renew".

    Why it matters: refreshToken expiry does not slide (measured — refreshing does not
    add a second). Re-login is the only way to extend it, so seeding only the pool while
    leaving live alone renews nothing for the person actually using it.

    A *different* account is never touched — silently changing which account someone is
    using is an accident, not a feature.

    Do not route this through _switch_core: its save-back would overwrite the freshly
    issued pool entry with the old live creds (especially when .active has drifted)."""
    if not os.path.isfile(LIVE):
        return False
    try:
        live_ident = _identity(_oauth(_load(LIVE)).get("accessToken", ""))
    except Exception:
        return False
    if not live_ident:
        print("  warn: could not identify live (token expired?) — skipping the swap. "
              f"If needed: airlock-accounts swap {name!r}", file=sys.stderr)
        return False
    if live_ident["name"] != name:
        return False                      # different account: leave it alone
    shutil.copy2(LIVE, LIVE + ".switch-bak")
    os.chmod(LIVE + ".switch-bak", 0o600)
    _save_atomic(LIVE, creds)
    _set_active(name)
    return True


# ---------- login (other seeding paths) ----------

def cmd_login(name=None, extra=()):
    """Add an account by logging in inside an isolated temp config dir, then store it in
    the pool. live is never touched, and the account is named from the id you log in as."""
    _ensure_pool()
    tmp = tempfile.mkdtemp(prefix=".login-", dir=POOL)
    try:
        print("  Adding an account in an isolated session (live account untouched).")
        print("    1. in the session that opens: /login -> approve in the browser")
        print("       (headless: paste the printed URL into any browser)")
        print("    2. /exit (or Ctrl+C) when logged in")
        print("    -> it is stored in the pool under the id you logged in as.\n")
        env = {**os.environ, "CLAUDE_CONFIG_DIR": tmp}
        subprocess.run([_claude_bin(), *extra], env=env)   # inherits the tty
        src = os.path.join(tmp, ".credentials.json")
        if not os.path.isfile(src):
            die("login did not complete (no credentials). Try `airlock-accounts login` again.")
        creds = _load(src)
        if "claudeAiOauth" not in creds:
            die("the login result is not in OAuth form.")
        first = _get_active() is None
        n = _store_account(creds, fallback_name=name, set_active=first)
        tail = " (pool was empty -> set active)" if first else " (active unchanged)"
        print(f"\n  stored '{n}' in the pool.{tail}")
        print("     check: airlock-accounts list   |   switch: the Claude icon in devterm")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_add(name=None):
    """Snapshot the current live credential into the pool and mark it active."""
    _ensure_pool()
    if not os.path.isfile(LIVE):
        die(f"no live credential: {LIVE} (log in with `claude` first)")
    creds = _load(LIVE)
    if "claudeAiOauth" not in creds:
        die("the live file is not in OAuth form")
    n = _store_account(creds, fallback_name=name, set_active=True)
    print(f"  stored '{n}' in the pool and set it active. (health/usage: list --usage)")


def cmd_import(config_dir, name=None):
    """Import creds from a dir logged in via CLAUDE_CONFIG_DIR (live untouched)."""
    _ensure_pool()
    src = os.path.join(os.path.expanduser(config_dir), ".credentials.json")
    if not os.path.isfile(src):
        die(f"{src} not found (did you log in with CLAUDE_CONFIG_DIR={config_dir}?)")
    creds = _load(src)
    if "claudeAiOauth" not in creds:
        die("the source file is not in OAuth form")
    n = _store_account(creds, fallback_name=name)
    print(f"  imported '{config_dir}' -> pool '{n}' (active unchanged).")


def cmd_relabel():
    """Rename every pool entry to its identity-derived name and fill in _meta —
    migration for hand-picked names and identity drift."""
    _ensure_pool()
    active = _get_active()
    for old in _pool_names():
        full = _load(_pool_path(old))
        ident = _identity(_oauth(full).get("accessToken", ""))
        if not ident:
            print(f"  warn: {old}: identity lookup failed (token expired?) — skipped")
            continue
        new = ident["name"]
        full["_meta"] = {"email": ident["email"], "org": ident["org"], "kind": ident["kind"]}
        # Two old names can map to the same identity (e.g. a slot re-created under a
        # newer naming scheme). Renaming blindly would overwrite the surviving slot with
        # whichever file happens to be processed last — possibly the stale lineage, which
        # silently downgrades the credential in use. Keep the fresher refreshToken.
        if new != old and os.path.isfile(_pool_path(new)):
            def _rt(c):
                return _oauth(c).get("refreshTokenExpiresAt", 0)
            if _rt(_load(_pool_path(new))) >= _rt(full):
                os.remove(_pool_path(old))
                print(f"  {old}  ->  dropped (a fresher '{new}' already exists)")
                if active == old:
                    _set_active(new); active = new
                continue
        _save_atomic(_pool_path(new), full)
        if new != old:
            os.remove(_pool_path(old))
            if active == old:
                _set_active(new); active = new
            print(f"  {old}  ->  {new}")
        else:
            print(f"  {new}  (unchanged)")
    print(f"\n  active = {_get_active()}")


# ---------- listing ----------

def _pool_names():
    """Account names in the pool. Dotfiles (.active, .login-pending.json) are internal."""
    return sorted(f[:-5] for f in os.listdir(POOL)
                  if f.endswith(".json") and not f.startswith("."))


def _usage(token, timeout=8):
    """GET /api/oauth/usage (read-only, costs no quota) -> 5h/7d utilization %.
    Only the percentages and reset times are emitted — never spend or dollar fields.

    A 429 here is a *throttle on this API*, not an exhausted account: a fully spent
    account still answers 200 with utilization=100. Judge exhaustion by utilization
    only; treat 429 as an error and fall back to the cached value."""
    if not token:
        return {"err": "no token"}
    h = {"Authorization": f"Bearer {token}", "anthropic-version": "2023-06-01",
         "anthropic-beta": "oauth-2025-04-20", "User-Agent": "claude-cli/1.0"}
    try:
        with urllib.request.urlopen(urllib.request.Request(USAGE_ENDPOINT, headers=h),
                                    timeout=timeout) as r:
            j = json.load(r)
    except urllib.error.HTTPError as e:
        return {"err": "throttled (429)" if e.code == 429 else f"HTTP {e.code}", "code": e.code}
    except Exception as e:
        return {"err": type(e).__name__}

    def pct(o):
        return round(o["utilization"]) if isinstance(o, dict) and o.get("utilization") is not None else None
    fh, sd = j.get("five_hour") or {}, j.get("seven_day") or {}
    return {"use5h": pct(fh), "use7d": pct(sd),
            "reset5h": fh.get("resets_at"), "reset7d": sd.get("resets_at")}


def _account_infos(with_usage=False):
    """Structured pool listing (no secrets)."""
    _ensure_pool()
    active = _get_active()
    infos = []
    verdicts = {}
    for n in _pool_names():
        full = _load(_pool_path(n))
        o, meta = _oauth(full), (full.get("_meta") or {})
        # Read only. This function must never write the pool: it runs in read-only
        # sandboxes (see _ensure_pool), and `list` staying a pure reader is what lets it.
        verdicts[n] = account_health.dead_marker(full)
        info = {
            "name": n,
            "email": meta.get("email"),   # display uses the real id, not a nickname
            "kind": meta.get("kind"),     # personal / team
            "active": n == active,
            "sub": o.get("subscriptionType", "?"),
            "atValid": _at_valid(o),
            # rtValid answers "can we switch to it without a re-login?"
            "rtValid": (o.get("refreshTokenExpiresAt", 0) / 1000 > time.time()),
            "atExpiry": o.get("expiresAt"),
            "rtExpiry": o.get("refreshTokenExpiresAt"),
        }
        if with_usage:
            info["usage"] = _usage(o.get("accessToken", ""))
        infos.append(info)
    # Two ways an account is known to be unusable, and both have to be here or the list
    # reports healthy accounts that no switch can reach:
    #   1. refreshToken expiry — decidable locally, no API call;
    #   2. a recorded server rejection — a real HTTP 400/401 from a refresh attempt that
    #      already happened (see account_health). A lineage can be revoked well before
    #      its stored expiry, so (1) alone called four revoked accounts "ok" on a
    #      migrated box while every switch to them failed.
    # Nothing new is probed here: (2) is evidence collected elsewhere, only now kept.
    now = time.time()
    for info in infos:
        verdict = verdicts.get(info["name"])
        if not info["rtValid"]:
            info["health"] = {"state": "dead", "since": now,
                              "reason": "refreshToken expired — re-login required"}
        elif verdict:
            info["health"] = {"state": "dead",
                              "since": verdict.get("since", now),
                              "reason": verdict.get("reason", account_health.DEAD_REASON)}
        else:
            info["health"] = {"state": "ok"}
    return infos


def cmd_list(as_json=False, with_usage=False):
    infos = _account_infos(with_usage)
    if as_json:
        print(json.dumps({"active": _get_active(), "accounts": infos}, ensure_ascii=False))
        return
    if not infos:
        print("  (pool is empty — add one with 'airlock-accounts login')")
        return
    w = max(14, min(40, max(len(i["name"]) for i in infos) + 2))
    uhdr = f"{'5h/7d':<12}" if with_usage else ""
    print(f"  {'':2}{'account (id)':<{w}}{'accessToken':<22}{'refreshToken expiry':<22}{uhdr}")
    for i in infos:
        mark = ">" if i["active"] else " "
        atv = "DEAD " if i["health"]["state"] == "dead" else ("valid " if i["atValid"] else "expired")
        us = ""
        if with_usage:
            u = i.get("usage") or {}
            if u.get("use5h") is not None:
                us = f"{u['use5h']}%/{u['use7d']}%"
            elif u.get("err"):
                us = f"?({u['err']})"
            else:
                us = "-"
        print(f"  {mark} {i['name']:<{w}}{atv+' '+_fmt_expiry(i['atExpiry']):<22}"
              f"{_fmt_expiry(i['rtExpiry']):<22}{us}")
        if i["health"]["state"] == "dead":
            print(f"    -> {i['health'].get('reason','')} — 'airlock-accounts login-url' revives this slot")
    print(f"\n  > = active. live={LIVE}")


# ---------- removal ----------

def cmd_prune(yes=False):
    """Remove dead slots, only when explicitly asked. Never automatic:
    (1) a death verdict can be wrong, and deleting on a transient failure destroys a
        healthy credential, (2) a re-login revives the same slot anyway (name = id), so
        there is little to gain, (3) pool deletion is irreversible.
    Dead accounts are already excluded from switching and show their reason in the UI.

    Only expiry-based death is deletable. A recorded server rejection also renders as
    dead, but it is a remote judgement that can be wrong in ways an expired date cannot
    (an outage answering 400, a client-id problem, a lineage revoked for one box only),
    and the cost of being wrong here is an irreversible credential deletion rather than a
    red row. An expired refreshToken is arithmetic on a stored date and needs no such
    caution."""
    _ensure_pool()
    dead = [i for i in _account_infos()
            if i["health"]["state"] == "dead" and not i["rtValid"]]
    if not dead:
        print("  no dead accounts."); return
    for i in dead:
        print(f"  dead: {i['name']} — {i['health'].get('reason','')}")
    if not yes:
        print("\n  to actually delete: airlock-accounts prune --yes")
        print("  (a re-login revives them, so you can leave them be)")
        return
    for i in dead:
        if i["active"]:
            print(f"  skip {i['name']}: it is active (switch to another account first)"); continue
        os.remove(_pool_path(i["name"]))
        print(f"  removed {i['name']}")


def cmd_remove(name, yes=False):
    """Remove one slot *by name*, regardless of health — for the case prune cannot see:
    a cancelled subscription whose refreshTokenExpiresAt is still in the future, so it
    looks healthy while the server rejects it.

    Irreversible (the pool file is deleted), but since name = id, a re-login recreates
    the same slot; all you lose is the current token lineage, which the re-login
    replaces anyway. The active account is refused — swap away first, or .active ends
    up pointing at a slot that no longer exists."""
    _ensure_pool()
    path = _pool_path(name)                 # blocks path escape (/ and leading .)
    if not os.path.isfile(path):
        die(f"'{name}' is not in the pool. Check 'airlock-accounts list'")
    if _get_active() == name:
        die(f"'{name}' is active — switch to another account before removing it")
    if not yes:
        print(f"  would remove: {name}")
        print("  to actually delete: airlock-accounts remove <name> --yes")
        print("  (a re-login recreates the same slot)")
        return
    os.remove(path)
    print(f"  removed '{name}' from the pool (a re-login recreates it)")


# ---------- switching ----------

def _saveback():
    """Save the current live creds back into *their own* slot (mandatory, because
    tokens rotate).

    Do not trust .active blindly: if someone runs plain `claude` -> /login outside
    airlock-accounts, live changes while .active still names the old account (drift).
    Writing live into the .active slot then destroys a different account's tokens
    (observed in practice). So ask live who it is and store it there."""
    if not os.path.isfile(LIVE):
        return
    try:
        creds = _load(LIVE)
    except Exception as e:
        print(f"  warn: cannot read live ({e}) — skipping save-back", file=sys.stderr)
        return
    active = _get_active()
    ident = _identity(_oauth(creds).get("accessToken", ""))
    if ident:
        target = ident["name"]
        if active and target != active:
            print(f"  warn: live is '{target}', not the active '{active}' "
                  "(logged in outside airlock-accounts?) — saving to the correct slot",
                  file=sys.stderr)
        creds = dict(creds)
        creds["_meta"] = {"email": ident["email"], "org": ident["org"], "kind": ident["kind"]}
    elif active:
        target = active   # identity lookup failed (offline/expired) -> old behaviour
        print("  warn: cannot identify live — saving back to the active slot", file=sys.stderr)
        # This branch writes live's blob into a slot we could not confirm it belongs to,
        # so anything in _meta may be about a different account. A transplanted death
        # verdict would mark a healthy slot dead — and a dead verdict is what prune reads
        # before deleting. Drop it: absence only costs us the next switch re-learning it.
        creds = dict(creds)
        creds["_meta"] = dict(creds.get("_meta") or {})
        account_health.clear_dead_marker(creds)
    else:
        return
    try:
        _save_atomic(_pool_path(target), creds)
        print(f"  save-back: preserved the newest tokens for '{target}'")
    except Exception as e:
        print(f"  warn: save-back failed ({e}) — continuing", file=sys.stderr)


def _rollback_switch(previous_live, previous_active, previous_bak, had_bak):
    """Put live, .active and the live backup back the way they were. Best-effort:
    every step is guarded, because this runs inside failure handling already."""
    try:
        if previous_live is None:
            try:
                os.unlink(LIVE)
            except OSError:
                pass
        else:
            tmp = LIVE + ".rollback-tmp"
            try:
                with open(tmp, "wb") as f:
                    f.write(previous_live)
                os.chmod(tmp, 0o600)
                os.replace(tmp, LIVE)
            except OSError:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
    except OSError:
        pass
    try:
        if previous_active is None:
            try:
                os.unlink(ACTIVE)
            except OSError:
                pass
        else:
            _set_active(previous_active)
    except OSError:
        pass
    try:
        bak = LIVE + ".switch-bak"
        if previous_bak is None:
            if not had_bak:
                # The failed commit must not leave a backup it staged itself.
                try:
                    os.unlink(bak)
                except OSError:
                    pass
            # else: a backup existed but could not be read — leave it alone.
            # Deleting the only copy of the previous login on the way out of a
            # failed switch would be the exact data loss rollback exists to stop.
        else:
            with open(bak + ".rollback-tmp", "wb") as f:
                f.write(previous_bak)
            os.chmod(bak + ".rollback-tmp", 0o600)
            os.replace(bak + ".rollback-tmp", bak)
    except OSError:
        pass


def _switch_core(name, saveback=True):
    _ensure_pool()
    target = _pool_path(name)
    if not os.path.isfile(target):
        die(f"'{name}' is not in the pool. Check 'airlock-accounts list'")
    # 1) verify the candidate BEFORE anything is written. A slot the server
    #    already rejected (a recorded death verdict) is refused here, with live,
    #    active and every pool file untouched — no refresh is attempted against a
    #    lineage that is already known dead, and no save-back can smear live's
    #    tokens across slots on the way out.
    try:
        creds = _load(target)
    except Exception as exc:
        die(f"'{name}': cannot read the stored credential ({type(exc).__name__}) — "
            "live and active are untouched")
    if not isinstance(creds, dict) or "claudeAiOauth" not in creds:
        die(f"'{name}': the stored credential is not in OAuth form — "
            "live and active are untouched")
    if account_health.dead_marker(creds) is not None:
        die(f"'{name}': the server rejected this account's refresh token — re-login "
            "required ('airlock-accounts login-url'). Live and active are untouched.")
    # 2) save the current account back (rotation-safe). A caller that has ALREADY saved
    #    live back — and then stored a newer record for the same identity — passes
    #    saveback=False, or this step would overwrite that newer record with the old live.
    if saveback and _get_active() != name:
        _saveback()
        # The save-back may have refreshed the target slot itself (live turned out to
        # be this identity under a drifted .active). Re-read so the commit below and
        # the verdict above both see the same bytes.
        try:
            creds = _load(target)
        except Exception as exc:
            die(f"'{name}': cannot re-read the stored credential ({type(exc).__name__}) — "
                "live and active are untouched")
        if account_health.dead_marker(creds) is not None:
            die(f"'{name}': the server rejected this account's refresh token — re-login "
                "required ('airlock-accounts login-url'). Live and active are untouched.")
    # 3) a last live-server verdict for a token about to expire, still before live moves
    o = _oauth(creds)
    if o.get("expiresAt", 0) / 1000 <= time.time() + REFRESH_IF_WITHIN_SEC:
        print(f"  '{name}' accessToken near expiry -> refreshing")
        refreshed, kind = refresh_creds(creds)
        if refreshed:
            # The server honoured this lineage: any recorded verdict is now wrong.
            account_health.clear_dead_marker(creds)
            creds = refreshed
            _save_atomic(target, creds)  # keep the pool in step with the rotation
        elif kind == "auth":
            # The server rejected the refreshToken. Record it so the account list stops
            # calling this slot healthy, then refuse — including when the accessToken is
            # still valid for a few more minutes. Installing it anyway "succeeds" and
            # then dies inside a session once that token runs out, with no refresh left
            # to save it; the switch is the last moment we can say so cheaply.
            account_health.mark_dead(target, creds)
            die(f"'{name}': the server rejected this account's refresh token — re-login "
                "required ('airlock-accounts login-url'). The slot is now listed as dead.")
        elif not _at_valid(o):
            die(f"'{name}': refresh failed and the accessToken is expired — re-login "
                "required ('airlock-accounts login-url')")
    # 4) commit, with auto-rollback. From here on every failure restores live, .active
    #    and the previous backup instead of leaving a half-written switch behind.
    try:
        previous_live = None
        if os.path.isfile(LIVE):
            with open(LIVE, "rb") as f:
                previous_live = f.read()
    except OSError as exc:
        die(f"cannot snapshot the live credential ({exc}) — refusing to switch blind")
    previous_active = _get_active()
    bak_path = LIVE + ".switch-bak"
    had_bak = os.path.isfile(bak_path)
    previous_bak = None
    if had_bak:
        try:
            with open(bak_path, "rb") as f:
                previous_bak = f.read()
        except OSError:
            previous_bak = None
    try:
        if os.path.isfile(LIVE):
            shutil.copy2(LIVE, bak_path)
            os.chmod(bak_path, 0o600)
        os.makedirs(os.path.dirname(LIVE), exist_ok=True)
        _save_atomic(LIVE, creds)
        _set_active(name)
    except Exception as exc:
        _rollback_switch(previous_live, previous_active, previous_bak, had_bak)
        die(f"'{name}': switch failed midway ({type(exc).__name__}) — live, active and "
            "the previous account were restored; fix the cause and retry")
    print(f"  active account -> '{name}' (no browser needed)")


def cmd_to(name, extra):
    """Switch, then resume the same conversation with `claude --continue`."""
    _switch_core(name)
    print("  continuing with claude --continue…\n")
    os.execv(_claude_bin(), ["claude", "--continue", *extra])


def cmd_swap(name):
    """Switch only, without re-launching — what the devterm button and scripts use."""
    _switch_core(name)
    print("  (not re-launched. The next `claude` run uses this account.)")


# ---------- Codex login driver (device-auth) ----------
#
# Promoted out of apps/devterm/backend/devterm-gate.py (ACCT_OWN, 2026-09-01). The
# browser surface that offers "re-login" is an app's; deciding what a Codex login DOES
# to this box's credentials is the platform's, and it was the last piece of credential
# writing still living in an app. The state machine below is the one that was there —
# the move is a re-homing, not a rewrite.
#
# Nothing here ever returns credential material. What crosses back is the pairing URL
# and the device code the user must type into a browser; both are useless without the
# approval they ask for, and both are already on the user's screen.


def _codex_bin():
    """Absolute path to the codex executable, or None when this box has none.

    PATH is not usable here: this runs from a systemd --user unit's environment, which
    carries none of the directories a node CLI installs into. The candidate list and the
    trust rules are the shared ones (bin_discovery)."""
    return bin_discovery.find_bin("codex")[0]


def _codex_missing_error():
    """Names what was searched and what to do about it, rather than "codex not available"."""
    return bin_discovery.not_found_message("codex", bin_discovery.find_bin("codex")[1])


def _codex_kill_pending_login():
    """Best-effort: stop a device-auth flow left running by an earlier attempt.

    Failure is not an error. A missing pkill, or no process to kill, both mean the same
    thing for what follows — there is no pending login of ours in the way."""
    try:
        subprocess.run(["pkill", "-f", "codex login"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except (FileNotFoundError, OSError):
        pass


def _relogin_now():
    """Clock for the relogin TTL. AIRLOCK_CODEX_RELOGIN_NOW is a test hook (an absolute
    epoch): the offline safety gate judges the 16-minute TTL instantly with a fake clock
    instead of waiting out 15 real minutes. It is honoured only together with
    AIRLOCK_CODEX_RELOGIN_TEST, so a stray NOW value in a production environment is
    inert rather than able to freeze the TTL. Production sets neither."""
    if os.environ.get("AIRLOCK_CODEX_RELOGIN_TEST", "").strip():
        raw = os.environ.get("AIRLOCK_CODEX_RELOGIN_NOW", "").strip()
        if raw:
            try:
                return float(raw)
            except ValueError:
                pass
    return time.time()


def _codex_relogin_record_pending(backed_up):
    """Write the pending record AFTER the backup verified, BEFORE codex starts.

    Returns None on success, an error string when the record cannot be written while a
    previous login exists to protect: starting then would leave a wiped auth.json with
    no TTL recovery. With no previous login there is nothing to recover, so only the
    error text differs, not the decision — the caller refuses either way when backed_up.
    """
    try:
        _save_atomic(CODEX_RELOGIN_PENDING,
                     {"startedAt": _relogin_now(), "backedUp": bool(backed_up)})
    except OSError as exc:
        if backed_up:
            return ("could not record the pending Codex login: %s — refusing to start "
                    "rather than risk the saved login" % (exc.strerror or exc))
        return "could not record the pending Codex login: %s" % (exc.strerror or exc)
    return None


def _codex_relogin_clear_pending():
    """Drop the pending record. Best-effort: a stale record only delays the next sweep's
    verdict to 'idle' one call later, it never touches a credential."""
    try:
        os.unlink(CODEX_RELOGIN_PENDING)
    except OSError:
        pass


def _codex_relogin_sweep(now=None):
    """Recover an abandoned device-auth after the TTL. Never raises, never prompts.

    States — `restored` is True only when bytes actually moved back:
      idle               no attempt was ever recorded (or the record is unreadable)
      pending            the attempt is still inside its TTL: hands off
      completed          a login newer than the attempt exists: the person finished it.
                         The pending record AND the stale backup are dropped, so a later
                         cancel cannot resurrect the OLD lineage over the new login.
      recovered          TTL lapsed with no login: the saved login was put back
      expired-no-backup  TTL lapsed and there was never a login to save: nothing to do
      recovery-failed    TTL lapsed and the saved login could not be put back. This is
                         reported, never hidden: the box still has no login.

    Completion is judged by file mtime against the recorded start, not by parsing
    id_token: codex-status=ok only parses claims and performs no authenticated call, so
    it must never be the pass line for recovery.
    """
    now = _relogin_now() if now is None else now
    try:
        pending = _load(CODEX_RELOGIN_PENDING)
    except (OSError, ValueError):
        return {"state": "idle", "restored": False}
    if not isinstance(pending, dict):
        _codex_relogin_clear_pending()
        return {"state": "idle", "restored": False}
    started = pending.get("startedAt")
    if isinstance(started, bool) or not isinstance(started, (int, float)):
        _codex_relogin_clear_pending()
        return {"state": "idle", "restored": False}
    if now - started < CODEX_RELOGIN_GRACE_SEC:
        # Too young to judge: codex may not have wiped yet (a present login would
        # read as "completed"), and no device flow completes this fast either.
        return {"state": "pending", "restored": False}
    if os.path.isfile(CODEX_AUTH):
        try:
            mtime = os.stat(CODEX_AUTH).st_mtime
        except OSError:
            return {"state": "pending", "restored": False}
        # A login is present. Newer than the attempt (2s grace for coarse mtimes)
        # = the person finished the flow; older but past the TTL = the attempt is
        # long dead and something else owns the current login. Either way the box
        # is not login-less, so there is nothing to restore — and the stale backup
        # must go, or a later cancel would resurrect the OLD lineage over it.
        if mtime >= started - 2 or now - started > CODEX_RELOGIN_TTL_SEC:
            # The person finished the flow (or something else owns the current
            # login): it stays, the attempt's leftovers go. The backup holds the
            # PREVIOUS lineage — keeping it would let a later cancel silently
            # downgrade a working login.
            _codex_relogin_clear_pending()
            try:
                os.unlink(CODEX_AUTH_BAK)
            except OSError:
                pass
            return {"state": "completed", "restored": False}
        return {"state": "pending", "restored": False}
    if now - started <= CODEX_RELOGIN_TTL_SEC:
        return {"state": "pending", "restored": False}
    try:
        restored = _codex_auth_restore()
    except OSError as exc:
        return {"state": "recovery-failed", "restored": False,
                "error": "could not restore the previous Codex login: %s"
                         % (exc.strerror or exc)}
    _codex_relogin_clear_pending()
    if restored:
        return {"state": "recovered", "restored": True}
    return {"state": "expired-no-backup", "restored": False}


def _codex_login_start():
    """Start `codex login --device-auth` and capture the pairing URL + code.

    device-auth needs no callback port: the user opens the link in any browser and types
    the code. codex wipes auth.json the moment it starts, so the previous login is backed
    up FIRST and a failure to back it up aborts before codex gets the chance — turning a
    re-login attempt into silent credential loss is the one outcome that has no recovery.
    An abandoned attempt is undone by `codex-auth login-cancel`, or on its own by
    `codex-auth login-sweep` once the TTL lapses.

    Order is the contract: sweep (a stale attempt's backup must be recovered before a
    new backup overwrites it) -> backup (verified) -> record pending -> start.
    """
    binary = _codex_bin()
    if binary is None:
        return {"ok": False, "error": _codex_missing_error()}
    # A previous attempt may have lapsed while nobody was watching (popup closed).
    # Sweep it now: otherwise the backup below overwrites the saved login that the
    # sweep would have restored, and the old lineage is gone for good.
    try:
        _codex_relogin_sweep()
    except Exception:
        pass
    # Fail closed before codex can erase auth.json. An absent old login is a successful
    # backedUp=false; a copy failure is different and must stop here.
    try:
        backup = _codex_auth_backup()
    except OSError as exc:
        return {"ok": False, "error": f"could not preserve the current Codex login: {exc.strerror or exc}"}
    # The pending record is what makes TTL recovery possible. Without it a wiped
    # auth.json stays wiped until a human runs cancel.
    pending_error = _codex_relogin_record_pending(backup)
    if pending_error is not None:
        return {"ok": False, "error": pending_error}
    _codex_kill_pending_login()
    try:
        outf = open(CODEX_LOGIN_OUT, "w")
    except OSError as exc:
        return {"ok": False, "error": f"could not open the Codex login capture file: {exc.strerror or exc}"}
    try:
        with outf:
            subprocess.Popen(
                [binary, "login", "--device-auth"],
                stdout=outf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                start_new_session=True, env={**os.environ, "BROWSER": "true"})
    except (FileNotFoundError, OSError) as exc:
        return {"ok": False, "error": f"codex launch failed: {exc}"}
    url, code = None, None
    for _ in range(CODEX_CAPTURE_TRIES):
        time.sleep(CODEX_CAPTURE_INTERVAL)
        try:
            with open(CODEX_LOGIN_OUT, encoding="utf-8", errors="replace") as f:
                txt = _ANSI_RE.sub("", f.read())
        except OSError:
            txt = ""
        mu = _CODEX_DEVICE_URL_RE.search(txt)
        mc = _CODEX_DEVICE_CODE_RE.search(txt)
        if mu:
            url = mu.group(0)
        if mc:
            code = mc.group(1)
        if code:      # the code is the essential part — the URL has a fixed fallback
            break
    if not code:
        return {"ok": False,
                "error": "failed to capture codex device-auth code (codex missing/error)"}
    return {"ok": True, "url": url or CODEX_DEVICE_URL_FALLBACK, "code": code,
            "backedUp": backup}


def _codex_login_cancel():
    """Abandon a pending device-auth and put the previous login back.

    Restoration belongs to the saved file, not to the current codex executable: the
    binary can disappear after the login starts, and cancelling must still recover.
    """
    _codex_kill_pending_login()
    try:
        sweep = _codex_relogin_sweep()
    except Exception:
        sweep = {}
    if isinstance(sweep, dict) and sweep.get("state") == "completed":
        # The attempt finished: there is nothing to undo, and restoring the stale
        # backup now would downgrade the working login to the previous lineage.
        return {"ok": True, "restored": False}
    try:
        restored = _codex_auth_restore()
    except OSError as exc:
        return {"ok": False,
                "error": f"could not restore the previous Codex login: {exc.strerror or exc}"}
    _codex_relogin_clear_pending()
    return {"ok": True, "restored": restored}


def _codex_logout():
    """`codex logout` removes auth.json. Codex is single-account, so this is
    "remove account"; a login-start reconnects."""
    binary = _codex_bin()
    if binary is None:
        return {"ok": False, "error": _codex_missing_error()}
    try:
        proc = subprocess.run([binary, "logout"], capture_output=True,
                              timeout=CODEX_LOGOUT_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "codex logout timed out"}
    except (FileNotFoundError, OSError) as exc:
        return {"ok": False, "error": str(exc)}
    if proc.returncode == 0:
        return {"ok": True}
    # Same 200-char truncation the gate applied before the move. codex's own logout
    # diagnostics are not credential material, and dropping them would leave a failed
    # logout with nothing on screen but "false".
    detail = (proc.stderr or proc.stdout or b"").decode("utf-8", "replace")[:200]
    return {"ok": False, "error": detail}


# ---------- Codex re-login preservation ----------

def _codex_auth_backup():
    """Copy the current Codex login aside. Returns whether there was one to copy."""
    if not os.path.isfile(CODEX_AUTH):
        return False
    shutil.copy2(CODEX_AUTH, CODEX_AUTH_BAK)
    return True


def _codex_auth_restore():
    """Move a backed-up Codex login back into place. Returns whether one existed."""
    if not os.path.isfile(CODEX_AUTH_BAK):
        return False
    shutil.move(CODEX_AUTH_BAK, CODEX_AUTH)
    return True


def cmd_codex_auth(action, as_json=False):
    """Codex single-account credential lifecycle — the platform side of a re-login.

    `codex login --device-auth` removes auth.json before the user has approved the
    replacement. The browser surface that starts that flow needs the lifecycle
    operations below, but it must not learn the credential path or receive any
    credential material. Keep the historical copy2/move semantics here: the ownership
    moves, the login state machine does not.
    """
    if action == "backup":
        result = {"ok": True, "backedUp": _codex_auth_backup()}
    elif action == "restore":
        result = {"ok": True, "restored": _codex_auth_restore()}
    elif action == "generation":
        # Consumers only need a change detector so an in-flight usage result from the
        # previous login cannot be committed after auth.json is replaced. Keep both
        # path knowledge and the stat here; nanosecond mtime is metadata, not credential
        # material, and an absent login has an explicit shape instead of an exception.
        #
        # Sweep first: the accounts-api server reads generation ahead of its usage
        # probes, so this is what recovers an abandoned attempt on the next poll even
        # when the browser and the popup are long closed. A sweep failure must never
        # fail the generation read itself.
        try:
            _codex_relogin_sweep()
        except Exception:
            pass
        try:
            generation = os.stat(CODEX_AUTH).st_mtime_ns
        except FileNotFoundError:
            generation = None
        except OSError:
            print("Codex auth generation could not be read", file=sys.stderr)
            return 1
        result = {"ok": True, "present": generation is not None,
                  "generation": generation}
    elif action == "login-sweep":
        # TTL recovery as an explicit verb: what the server runs ahead of its Codex
        # routes, and what the offline safety gate drives with a fake clock. `state`
        # is the whole answer; `restored` is True only when bytes actually moved back.
        # A recovery-failed state carries `error` and is never collapsed into silence.
        try:
            sweep = _codex_relogin_sweep()
        except Exception as exc:
            sweep = {"state": "recovery-failed", "restored": False,
                     "error": "sweep failed: %s" % exc}
        result = {"ok": True, **sweep}
    elif action == "login-start":
        result = _codex_login_start()
    elif action == "login-cancel":
        result = _codex_login_cancel()
    elif action == "logout":
        result = _codex_logout()
    else:
        print("codex-auth action must be backup, restore, generation, login-start, "
              "login-cancel, login-sweep or logout", file=sys.stderr)
        return 2
    if as_json:
        # JSON is the machine ABI: `ok` carries whether the OPERATION succeeded, and the
        # exit status carries whether the TOOL ran. Collapsing the two would make a
        # readable "no codex on this box" indistinguishable from a crashed CLI, and the
        # caller would have to guess which of the two it was holding.
        json.dump(result, sys.stdout)
        print()
        return 0
    if not result.get("ok"):
        # The three login verbs can fail for reasons a person can act on (no codex on
        # this box, a capture that never produced a code). Printing "no saved login"
        # for those was the shape this branch had before they existed.
        print(f"  ERROR: {result.get('error') or 'failed'}", file=sys.stderr)
    elif action == "login-start":
        # The code is what the user types; the URL is where. Neither is a secret.
        print(f"  open {result['url']} and enter {result['code']}")
    elif action == "login-sweep":
        state = result.get("state")
        if result.get("restored"):
            print("recovered the previous Codex login (abandoned attempt past its TTL)")
        elif state == "recovery-failed":
            print(f"  ERROR: {result.get('error') or 'recovery failed'}", file=sys.stderr)
        else:
            print(f"relogin state: {state}")
    elif action == "logout":
        print("logged out")
    else:
        print("backed up" if result.get("backedUp") else
              "restored" if result.get("restored") else "no saved login")
    return 0 if result.get("ok") else 1


# ---------- Muse manual key swap (MUSE_ROTATE) ----------
#
# One key per person, picked by a human on screen — NEVER auto-rotated (2026-09-20
# owner decision). The swap is backup -> verify-candidate -> commit, fixed order: the
# existing key is kept before the candidate is ever touched, and a candidate the
# provider rejects changes nothing. Running opencode sessions keep the key their
# process started with (measured 2026-09-23: a live `serve` process serves the old
# key to old AND new sessions after auth.json changes; only a restarted process
# serves the new one) — so every success reports needsRestart and the panel words
# the seat-recovery guidance from it.
#
# The live key is opencode's own `opencode-go` entry in its auth.json. Nothing here
# prints a key value: resolve failures name the item, verify failures name the
# reason, and the JSON ABI carries only the account name and the step list.
#
# The usage-shape rules (three windows, all valid numbers, never a fabricated 0%)
# mirror bin/airlock-accounts-api's _muse_window/_muse_entry by hand rather than by
# import: the API shells out to this CLI, so importing the API here would reverse
# that dependency. install/test-muse-swap.py pins the same acceptance rules on
# both sides (T-MU1..3 shape in, AC-MUSE-SWAP-* out).

MUSE_KEYS_BIN = os.environ.get("AIRLOCK_MUSE_KEYS_BIN", "").strip()
MUSE_USAGE_URL = os.environ.get("AIRLOCK_MUSE_USAGE_URL", "").strip() or "https://opencode.ai"
# Explicit override for tests and operators. Unset means opencode's own convention:
# $XDG_DATA_HOME/opencode/auth.json, i.e. ~/.local/share/opencode/auth.json.
MUSE_AUTH_JSON = os.environ.get("AIRLOCK_OPENCODE_AUTH_JSON", "").strip()
# The assignment sheet, this box's name and the cho-only screen flag ride the
# same variable names as the API: the API shells out to this CLI with its own
# environment, so one deployment sets both layers, and the mutation boundary
# enforces the picker policy itself instead of trusting the screen to have
# filtered (a crafted POST names any helper item).
MUSE_REGISTRY = os.environ.get("AIRLOCK_MUSE_REGISTRY", "").strip()
MUSE_BOX = os.environ.get("AIRLOCK_BOX_NAME", "").strip() \
    or socket.gethostname().split(".")[0]
MUSE_CHO_ITEM = "OPENCODE_CHO_API_KEY"
MUSE_CHO_VISIBLE = os.environ.get("AIRLOCK_MUSE_CHO_VISIBLE", "").strip() == "1"
MUSE_KEYS_TIMEOUT = 30
MUSE_VERIFY_TIMEOUT = 10
MUSE_MAX_KEYS = 32
MUSE_WINDOWS = ("rolling", "weekly", "monthly")
# A window read at 100% used is exhausted, not a candidate. This is the whole of the
# card's "임계": the backend guarantees provably-valid and not-exhausted, and the
# picker shows the three numbers so the human decides how close is too close.
MUSE_SWAP_MAX_USED = 100
MUSE_SWAP_BAK_SUFFIX = ".muse-swap-bak"


def _muse_auth_path():
    if MUSE_AUTH_JSON:
        return MUSE_AUTH_JSON
    data_home = os.environ.get("XDG_DATA_HOME", "").strip() \
        or os.path.join(os.path.expanduser("~"), ".local", "share")
    return os.path.join(data_home, "opencode", "auth.json")


def _muse_account(item):
    """The name the team calls the key by: OPENCODE_FINANCE_API_KEY -> finance.

    An op:// vault address contributes its item segment first, so both helper key
    shapes (bare title and op://vault/title/field) land on the same account.
    Anything outside those shapes keeps its full name lowercased rather than being
    guessed into a collision.
    """
    core = item.strip()
    if core.startswith("op://"):
        parts = core.split("/")
        if len(parts) >= 4 and parts[3]:
            core = parts[3]
    if core.upper().startswith("OPENCODE_"):
        core = core[len("OPENCODE_"):]
    for suffix in ("_API_KEY", "_KEY"):
        if core.upper().endswith(suffix) and len(core) > len(suffix):
            core = core[:-len(suffix)]
            break
    return core.strip().lower() or item.strip().lower()


def _muse_read_keys():
    """The current {item: key-or-None} map from the helper, or {}.

    Values cross on the pipe only and are never logged or returned. An item whose
    value is missing or not a string stays in the map as None and fails resolve
    rather than silently disappearing.
    """
    if not (MUSE_KEYS_BIN and os.path.isfile(MUSE_KEYS_BIN)):
        return {}
    box = {}

    def run():
        try:
            proc = subprocess.Popen([MUSE_KEYS_BIN], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL)
        except OSError:
            box["rc"] = -1
            return
        try:
            box["out"] = proc.stdout.read(65537)
        except OSError:
            box["out"] = b""
        finally:
            try:
                proc.kill()
            except OSError:
                pass
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        box["rc"] = proc.returncode

    worker = threading.Thread(target=run, daemon=True, name="muse-keys-read")
    worker.start()
    worker.join(timeout=MUSE_KEYS_TIMEOUT)
    if worker.is_alive() or box.get("rc") != 0:
        return {}
    out = box.get("out") or b""
    if len(out) > 65536:
        return {}
    try:
        raw = json.loads(out.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return {}
    if not isinstance(raw, dict):
        return {}
    keys = {}
    for item, key in sorted(raw.items()):
        if not isinstance(item, str) or not item.strip():
            continue
        item = item.strip()
        keys[item] = key if isinstance(key, str) and key else None
        if len(keys) >= MUSE_MAX_KEYS:
            break
    return keys


class _MuseNoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse redirects instead of following them: urllib would re-send the
    candidate Authorization to wherever a redirect points."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _muse_verify(key):
    """GET <base>/zen/go/v1/usage with the candidate. Returns (ok, detail).

    ok means 200 with all three windows valid and none exhausted. detail is a
    machine reason — "refused" | "unverifiable" | "exhausted" — and the caller
    words the fixed human sentence from it, so a 401 is never reported as
    exhaustion and a timeout is never reported as a refusal.
    """
    url = MUSE_USAGE_URL.rstrip("/") + "/zen/go/v1/usage"
    try:
        req = urllib.request.Request(
            url, headers={"Authorization": "Bearer " + key,
                          "User-Agent": "airlock-accounts"})
        opener = urllib.request.build_opener(_MuseNoRedirect)
        with opener.open(req, timeout=MUSE_VERIFY_TIMEOUT) as r:
            if r.status != 200:
                return False, "refused"
            raw = json.loads(r.read(65536).decode("utf-8"))
    except urllib.error.HTTPError as exc:
        if exc.code in (301, 302, 303, 307, 308):
            # The no-redirect handler turns a redirect into this: the endpoint
            # moved, which verifies nothing about the candidate either way.
            return False, "unverifiable"
        return False, "refused"
    except Exception:
        return False, "unverifiable"
    usage = raw.get("usage") if isinstance(raw, dict) else None
    if not isinstance(usage, dict):
        return False, "unverifiable"
    for window in MUSE_WINDOWS:
        entry = usage.get(window)
        if not isinstance(entry, dict):
            return False, "unverifiable"
        percent = entry.get("percent")
        if (isinstance(percent, bool) or not isinstance(percent, int)
                or not 0 <= percent <= 100):
            return False, "unverifiable"
        if not isinstance(entry.get("status"), str) or not entry.get("status"):
            return False, "unverifiable"
        if not isinstance(entry.get("resetsAt"), str) or not entry.get("resetsAt"):
            return False, "unverifiable"
        if percent >= MUSE_SWAP_MAX_USED:
            return False, "exhausted"
    return True, ""


_MUSE_VERIFY_ERROR = {
    "refused": "the provider refused the candidate key",
    "unverifiable": "the candidate key could not be verified",
    "exhausted": "the candidate key is already exhausted",
}


def _muse_item_title(key):
    """Join key for the vault map and the assignment sheet (see the API's copy:
    an op:// address contributes its item segment, a bare name itself)."""
    core = key.strip() if isinstance(key, str) else ""
    if core.startswith("op://"):
        parts = core.split("/")
        if len(parts) >= 4 and parts[3]:
            return parts[3]
    return core


def _muse_registry():
    """The assignment sheet as {title: holder}, or None when it cannot be read.

    None refuses every swap: without the sheet no box can prove a key is held
    by no one else, and offering it anyway would risk two boxes on one key.
    """
    if not MUSE_REGISTRY:
        return None
    raw = None
    if MUSE_REGISTRY.startswith(("http://", "https://")):
        try:
            with urllib.request.urlopen(MUSE_REGISTRY, timeout=6) as r:
                raw = json.load(r)
        except Exception:
            return None
    else:
        try:
            with open(MUSE_REGISTRY, encoding="utf-8") as f:
                raw = json.load(f)
        except (OSError, ValueError):
            return None
    if not isinstance(raw, dict):
        return None
    sheet = {}
    for key, holder in raw.items():
        if (not isinstance(key, str) or not isinstance(holder, str)
                or not _muse_item_title(key) or not holder.strip()):
            return None
        sheet[_muse_item_title(key)] = holder.strip()
    return sheet


def _muse_write_private(path, data):
    """Write bytes atomically with mode 0600 however the umask reads.

    A plain open() honors the umask from 0666, which on a default 022 umask
    lands a credential-adjacent file at 0644 — readable by every user on the
    box until a later chmod closes it. O_EXCL|0600 plus rename never has that
    window. os.replace on an existing symlink swaps the link itself, never the
    target it points at. A failed rename unlinks the tmp: either way no
    credential bytes outlive this call beside live.
    """
    tmp = "%s.tmp.%d" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise
    try:
        os.replace(tmp, path)
    except BaseException:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def _muse_swap_core(item):
    """Backup -> verify -> commit. Returns (ok, result dict with a step list).

    The step list is the observable order: ["backup", "verify", "commit"] on
    success, ["backup", "verify"] when the candidate is refused (commit never
    runs), ["backup", "verify", "commit", "rollback"] when the commit itself
    fails. Every refusal leaves live byte-identical and stages no debris.
    """
    steps = ["backup"]
    try:
        with open(_muse_auth_path(), "rb") as f:
            previous = f.read()
    except FileNotFoundError:
        previous = None
    except OSError:
        return False, {"ok": False, "error": "the current key file is not readable",
                       "steps": steps}
    if previous is not None:
        try:
            live = json.loads(previous.decode("utf-8"))
        except (UnicodeDecodeError, ValueError):
            return False, {"ok": False, "error": "the current key file is not readable",
                           "steps": steps}
        if not isinstance(live, dict):
            return False, {"ok": False, "error": "the current key file is not readable",
                           "steps": steps}
    else:
        live = {}

    steps.append("verify")
    keys = _muse_read_keys()
    candidate = keys.get(item)
    if not isinstance(candidate, str) or not candidate:
        return False, {"ok": False, "error": "that key is not available on this box",
                       "steps": steps}
    # The picker policy is enforced at this mutation boundary, not trusted from
    # the screen: a crafted call names any helper item, and only this check
    # keeps another box's key or the off-box cho key out of the commit.
    if _muse_item_title(item) == _muse_item_title(MUSE_CHO_ITEM) and not MUSE_CHO_VISIBLE:
        return False, {"ok": False, "error": "that key is not offered on this box",
                       "steps": steps}
    sheet = _muse_registry()
    if sheet is None:
        return False, {"ok": False, "error": "the assignment sheet is unavailable",
                       "steps": steps}
    holder = sheet.get(_muse_item_title(item))
    if holder is not None and holder != MUSE_BOX:
        return False, {"ok": False, "error": "that key is held by another box",
                       "steps": steps}
    verified, detail = _muse_verify(candidate)
    if not verified:
        return False, {"ok": False, "error": _MUSE_VERIFY_ERROR[detail], "steps": steps}

    steps.append("commit")
    auth_path = _muse_auth_path()
    # Compare-and-swap against concurrent writers: the verify above takes
    # seconds on the network, and opencode itself rewrites this file. Rebuilding
    # the commit from a stale snapshot would clobber another entry's fresh
    # tokens while promising to touch only opencode-go.key — so re-read now and
    # abort when anything outside our field moved. A spurious abort retries
    # cleanly; a clobber does not.
    try:
        with open(auth_path, "rb") as f:
            current = f.read()
    except FileNotFoundError:
        current = None
    except OSError:
        steps.append("rollback")
        return False, {"ok": False, "error": "the commit failed — the key file "
                                             "cannot be re-read, nothing was changed",
                       "steps": steps}
    if previous is not None:
        if current is None:
            steps.append("rollback")
            return False, {"ok": False, "error": "the commit failed — the key file "
                                                 "vanished during verification, nothing was changed",
                           "steps": steps}
        try:
            before = json.loads(previous.decode("utf-8"))
            now = json.loads(current.decode("utf-8"))
        except (UnicodeDecodeError, ValueError):
            before = now = None
        # Presence matters, not just value: .get() reads a missing key and an
        # explicit null identically, so strip our own field and compare whole
        # dicts instead.
        if (not isinstance(before, dict) or not isinstance(now, dict)
                or {k: v for k, v in before.items() if k != "opencode-go"}
                != {k: v for k, v in now.items() if k != "opencode-go"}):
            steps.append("rollback")
            return False, {"ok": False, "error": "the commit failed — the key file "
                                                 "changed during verification, nothing was changed",
                           "steps": steps}
        live = now
    elif current is not None:
        steps.append("rollback")
        return False, {"ok": False, "error": "the commit failed — the key file "
                                             "appeared during verification, nothing was changed",
                       "steps": steps}
    updated = dict(live)
    updated["opencode-go"] = {"type": "api", "key": candidate}
    committed = False
    try:
        os.makedirs(os.path.dirname(auth_path) or ".", mode=0o700, exist_ok=True)
        _muse_write_private(auth_path, json.dumps(updated).encode("utf-8"))
        committed = True
        with open(auth_path, "rb") as f:
            reread = json.load(f)
        if not isinstance(reread, dict) \
                or reread.get("opencode-go", {}).get("key") != candidate:
            raise ValueError("read-back mismatch")
    except (OSError, ValueError, TypeError, UnicodeError):
        steps.append("rollback")
        # A failed replace leaves its tmp beside live; a failed read-back leaves
        # live committed-but-wrong. Either way the tmp must not outlive us.
        try:
            os.remove("%s.tmp.%d" % (auth_path, os.getpid()))
        except OSError:
            pass
        restored = False
        try:
            if previous is None:
                if not committed:
                    restored = True  # nothing was ever written
                else:
                    # The file did not exist before and the commit created
                    # something the read-back rejected: removing it IS the
                    # restore, and absence after removal proves it.
                    try:
                        os.remove(auth_path)
                    except FileNotFoundError:
                        pass
                    try:
                        with open(auth_path, "rb"):
                            pass
                    except FileNotFoundError:
                        restored = True
                    except OSError:
                        restored = False
            else:
                _muse_write_private(auth_path, previous)
                with open(auth_path, "rb") as f:
                    restored = (f.read() == previous)
        except OSError:
            restored = False
        if not restored:
            return False, {"ok": False, "error": "the commit failed and the previous "
                                                 "key could not be restored — check the key file by hand",
                           "steps": steps}
        # Restored is bytes, not health: say whether the old key still works
        # rather than calling it a recovery, and keep the verify categories —
        # a refused old key is refused, not exhausted. This read happens only
        # here, on the one path the card names.
        if previous is None:
            error = "the commit failed — there was no previous key, nothing was changed"
            return False, {"ok": False, "error": error, "steps": steps}
        old_key = None
        try:
            old_entry = json.loads(previous.decode("utf-8")).get("opencode-go", {})
            old_key = old_entry.get("key") if isinstance(old_entry, dict) else None
        except (UnicodeDecodeError, ValueError, AttributeError):
            old_key = None
        if isinstance(old_key, str) and old_key:
            old_ok, old_detail = _muse_verify(old_key)
        else:
            old_ok, old_detail = False, "unverifiable"
        if old_ok:
            error = "the commit failed — the previous key is back in place and still valid"
        elif old_detail == "exhausted":
            error = ("the commit failed — the previous key is back in place "
                     "but it is exhausted, pick another key")
        elif old_detail == "refused":
            error = ("the commit failed — the previous key is back in place "
                     "but the provider refuses it, pick another key")
        else:
            error = ("the commit failed — the previous key is back in place "
                     "but it could not be re-verified, pick another key")
        return False, {"ok": False, "error": error, "steps": steps}
    bak_saved = False
    if previous is not None:
        try:
            _muse_write_private(auth_path + MUSE_SWAP_BAK_SUFFIX, previous)
            bak_saved = True
        except (OSError, TypeError):
            bak_saved = False
    return True, {"ok": True, "account": _muse_account(item), "steps": steps,
                  "needsRestart": True, "bakSaved": bak_saved}


def cmd_muse_swap(item, as_json):
    if not isinstance(item, str) or not item.strip() or len(item) > 256:
        if as_json:
            json.dump({"ok": False, "error": "not a key name", "steps": []}, sys.stdout)
            print()
            return 0
        print("airlock-accounts: muse-swap needs a vault key name", file=sys.stderr)
        return 2
    ok, result = _muse_swap_core(item.strip())
    if as_json:
        # Unlike codex-auth's ABI (where ok:false is a readable state), a refused
        # swap is a failure outcome: the JSON still lands on stdout, and the exit
        # status says whether the box changed. install/test-muse-swap.py pins rc!=0.
        json.dump(result, sys.stdout)
        print()
        return 0 if ok else 1
    if ok:
        print("swapped to %s (new sessions pick it up; running ones need seat-recovery)"
              % result["account"])
    else:
        print("  ERROR: %s" % result["error"], file=sys.stderr)
    return 0 if ok else 1


USAGE = """airlock-accounts — switch Claude accounts without a browser
Accounts are not named by hand: the name is the id you log in as, "email (personal|team)".

Register an account (browser needed once per account):
  airlock-accounts login-url                issue the login link only (devterm uses this)
  airlock-accounts login-code               finish with code on protected stdin (devterm uses this)
  airlock-accounts login                    (alternative) log in in a temp terminal session
  airlock-accounts add                      store the current live account in the pool (+active)
  airlock-accounts import <cfgdir>          import an account logged in via CLAUDE_CONFIG_DIR
  airlock-accounts relabel                  rename old hand-picked names to id-based ones

Switch / inspect:
  airlock-accounts list [--json] [--usage]  accounts + health (+ 5h/7d utilization)
  airlock-accounts to <name> [-- args...]   switch, then claude --continue
  airlock-accounts swap <name>              switch only (no re-launch; buttons/scripts)
  airlock-accounts muse-swap <item> [--json]  swap this box's Muse key (manual only:
                              backup -> verify the candidate -> commit; a refused
                              candidate leaves the old key untouched)
  airlock-accounts prune [--yes]            remove all dead slots (explicit only)
  airlock-accounts remove <name> [--yes]    remove one slot by name (active is refused)

Platform lifecycle (called through the D5 ABI; never emits credential values):
  airlock-accounts codex-auth backup [--json]
  airlock-accounts codex-auth restore [--json]
  airlock-accounts codex-auth generation [--json]
  airlock-accounts codex-auth login-start [--json]    device-auth: capture URL + code
  airlock-accounts codex-auth login-cancel [--json]   abandon it, put the old login back
  airlock-accounts codex-auth login-sweep [--json]    TTL recovery for an abandoned attempt
  airlock-accounts codex-auth logout [--json]         remove this box's Codex login"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "login":                        cmd_login(None, rest)
    elif cmd == "add":                        cmd_add(rest[0] if rest else None)
    elif cmd == "import" and rest:            cmd_import(rest[0], rest[1] if len(rest) > 1 else None)
    elif cmd == "relabel":                    cmd_relabel()
    elif cmd == "prune":                      cmd_prune("--yes" in rest)
    elif cmd == "remove":
        target = next((a for a in rest if not a.startswith("-")), None)
        if not target:
            print(USAGE, file=sys.stderr); return 2
        cmd_remove(target, "--yes" in rest)
    elif cmd == "login-url":                  cmd_login_url()
    elif cmd == "login-code-transport":
        if rest:
            print(USAGE, file=sys.stderr); return 2
        print("stdin-v1")
    elif cmd == "login-code":
        if rest:
            print("airlock-accounts: login-code accepts protected stdin only; refusing argv input",
                  file=sys.stderr)
            return 2
        try:
            pasted = _read_login_code_stdin()
        except ValueError as exc:
            print(f"airlock-accounts: {exc}", file=sys.stderr)
            return 2
        cmd_login_code(pasted)
    elif cmd == "list":                       cmd_list("--json" in rest, "--usage" in rest)
    elif cmd == "to" and rest:
        extra = rest[1:]
        if extra and extra[0] == "--":
            extra = extra[1:]
        cmd_to(rest[0], extra)
    elif cmd == "swap" and len(rest) == 1:    cmd_swap(rest[0])
    elif cmd == "muse-swap" and rest:
        item = next((a for a in rest if not a.startswith("-")), None)
        return cmd_muse_swap(item, "--json" in rest)
    elif cmd == "codex-auth" and rest:
        return cmd_codex_auth(rest[0], "--json" in rest[1:])
    else:
        print(USAGE, file=sys.stderr); return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
