[Unit]
Description=airlock — the credential freshness check failed, say so

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DEV_MONITOR_SPOOL=@SPOOL@
Environment=DEV_MONITOR_TOKEN_SNAPSHOT=@SNAPSHOT@
WorkingDirectory=@APPDIR@
ExecStart=/bin/bash @APPDIR@/token-freshness-alarm.sh
