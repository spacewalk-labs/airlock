[Unit]
Description=airlock dev-monitor — system observability (127.0.0.1:19200)
After=network.target

[Service]
Type=simple
Environment=AIRLOCK_DEV_MONITOR_BACKEND_PORT=19200
Environment=AIRLOCK_DEV_MONITOR_MESSAGES=false
Environment=AIRLOCK_IDENTITY_HEADER=Tailscale-User-Login
Environment=AIRLOCK_DEV_MONITOR_CORS_HOSTS=
Environment=AIRLOCK_DEV_MONITOR_TOKEN_FRESHNESS=false
Environment=AIRLOCK_DEV_MONITOR_TOKEN_FRESHNESS_WARN_HOURS=24
Environment=AIRLOCK_DEV_MONITOR_TOKEN_FRESHNESS_STALE_HOURS=24
# '-' = optional: with messages off the file is absent by design, and the backend
# then serves observability only. Secrets stay in this 0600 file, out of the unit.
EnvironmentFile=-/home/example/.config/airlock/dev-monitor.env
ExecStart=/usr/bin/python3 ROOT/apps/dev-monitor/backend/airlock-dev-monitor.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
