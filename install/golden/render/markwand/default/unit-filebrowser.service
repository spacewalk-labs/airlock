[Unit]
Description=airlock filebrowser — zero-login editor for /home/example/code (127.0.0.1:19501)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.config/filebrowser
ExecStart=/home/example/.local/bin/filebrowser --database /home/example/.config/filebrowser/fb.db --root /home/example/code --address 127.0.0.1 --port 19501 --followExternalSymlinks=false
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
