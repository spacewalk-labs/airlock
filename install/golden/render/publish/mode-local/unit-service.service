[Unit]
Description=airlock publish — static-share manager + uploads (127.0.0.1:19800)
After=network.target

[Service]
Type=simple
# Optional secret (the external-publish token) — safe if the file is absent.
EnvironmentFile=-%h/.config/airlock-publish.env
Environment=AIRLOCK_PUBLISH_BACKEND_PORT=19800
Environment=AIRLOCK_PUBLISH_SHARE_DIR=/opt/airlock/share
Environment=AIRLOCK_PUBLISH_UPLOADS_DIR=/home/example/uploads
Environment=AIRLOCK_IDENTITY_HEADER=Tailscale-User-Login
Environment=AIRLOCK_PUBLISH_INGEST_URL=
Environment=AIRLOCK_PUBLISH_BASE_URL=
Environment=AIRLOCK_PUBLISH_TOKEN_ENV=AIRLOCK_PUBLISH_TOKEN
Environment=AIRLOCK_PUBLISH_PUBLIC_MODE=local
Environment=AIRLOCK_PUBLISH_PUBLIC_DIR=/opt/airlock/share-public
Environment=AIRLOCK_PUBLISH_STATE_DIR=/home/example/.local/state/airlock
Environment=AIRLOCK_PUBLISH_GATED_DIR=/opt/airlock/share-gated
Environment=AIRLOCK_PUBLISH_HTPASSWD_DIR=/opt/airlock/publish-gated-auth
Environment=AIRLOCK_PUBLISH_HTPASSWD_BIN=htpasswd
Environment=AIRLOCK_PUBLISH_TOKEN_HEADER=X-Airlock-Publish-Token
ExecStart=/usr/bin/python3 ROOT/apps/publish/backend/airlock-publish.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
