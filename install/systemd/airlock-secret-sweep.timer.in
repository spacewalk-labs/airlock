[Unit]
Description=airlock — enforce the platform secret-drop TTL
X-Airlock-Owner=airlock-install

[Timer]
# CLI calls sweep opportunistically too. This timer is the floor for idle periods, when
# no relay is running and therefore no request can trigger that opportunistic path.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
