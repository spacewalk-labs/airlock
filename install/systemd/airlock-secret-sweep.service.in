[Unit]
Description=airlock — expire platform secret-drop files

# This is deliberately a PLATFORM unit, not a devterm (or paseo) unit. The TTL is a
# property of the shared value store and must keep holding when every consuming app is
# disabled, uninstalled, or stopped. A per-app sweeper quietly stops enforcing lifetime
# at exactly that boundary.
[Service]
Type=oneshot
ExecStart="@AIRLOCK_SECRET_BIN@" sweep
TimeoutStartSec=60
