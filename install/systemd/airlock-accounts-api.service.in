[Unit]
Description=airlock — platform account surface (HTTP)
X-Airlock-Owner=airlock-install
# The hub's nginx proxies to this; if it is down the proxy answers 502 and the hub
# itself stays up. That degradation is deliberate: an account panel that cannot load
# must not take the entrance with it.
After=network.target

[Service]
Type=simple
# The port and the CLI path are handed in, never derived here. bin/airlock-config owns
# the port (and validates it for uniqueness against every app), and install/lib.sh owns
# the CLI path — a default in this unit would be a second source of truth for both.
Environment=AIRLOCK_HUB_ACCOUNTS_PORT=@ACCOUNTS_PORT@
Environment=AIRLOCK_ACCOUNTS_STATUS_BIN=@ACCOUNTS_STATUS_BIN@
Environment=AIRLOCK_ACCOUNTS_BIN=@ACCOUNTS_BIN@
# The secret drop's HTTP boundary lives here too (/secret-put|list|del). The store and
# its TTL are the CLI's and the sweep timer's; this unit deliberately sets no TTL.
Environment=AIRLOCK_SECRET_BIN=@SECRET_BIN@
# Read-only pointers at the shared usage store. Empty is a normal box: the account list
# then reports "no store" rather than "collecting", because promising a collector that
# does not exist is what left seven rows collecting indefinitely on a real box.
# Where the installed account panel assets live (hub webroot). Handed in for the
# same reason the port is: the installer owns the webroot path, and a default
# here would be a second source of truth. Empty means the mount answers 503.
Environment=AIRLOCK_ACCOUNTS_PANEL_DIR=@PANEL_DIR@
Environment=AIRLOCK_ACCOUNTS_PANEL_STYLE_DIR=@PANEL_STYLE_DIR@
Environment=AIRLOCK_HUB_FLEET_STORE=@FLEET_STORE@
Environment=AIRLOCK_HUB_FLEET_STORE_URL=@FLEET_STORE_URL@
# Empty = the xAI routes answer {"enabled": false}. Set only when hub.xai is true.
Environment=AIRLOCK_OPENCODE_BIN=@OPENCODE_BIN@
# Antigravity CLI for the quota row. Empty = no agy on this box; the row says so.
Environment=AIRLOCK_AGY_BIN=@AGY_BIN@
Environment=AIRLOCK_AGY_USAGE_BIN=@AGY_USAGE_BIN@
# Muse vault-key reader. Empty KEYS_BIN = /muse-usage answers disabled. The
# helper that prints the {item: key} map ships in this repository; the two
# vault readers resolve at install time, and the brokered key's address arrives
# box-locally (never a default in this template: vault names do not ship).
Environment=AIRLOCK_MUSE_KEYS_BIN=@MUSE_KEYS_BIN@
Environment=AIRLOCK_MUSE_SECRET_BIN=@MUSE_SECRET_BIN@
Environment=AIRLOCK_MUSE_CHO_BIN=@MUSE_CHO_BIN@
Environment=AIRLOCK_MUSE_CHO_REF=@MUSE_CHO_REF@
# Muse manual swap (MUSE_ROTATE): the assignment sheet (file path or http(s) URL;
# empty = the picker offers nothing and says the sheet is why), this box's name
# for the held-by-other filter (empty = the box's own short hostname), and the
# cho-only screen flag (set to 1 on the cho reader box alone — anywhere else the cho key
# never reaches a screen even when the local helper holds it).
Environment=AIRLOCK_MUSE_REGISTRY=@MUSE_REGISTRY@
Environment=AIRLOCK_BOX_NAME=@BOX_NAME@
Environment=AIRLOCK_MUSE_CHO_VISIBLE=@MUSE_CHO_VISIBLE@
ExecStart=@PYTHON@ "@AIRLOCK_ROOT@/bin/airlock-accounts-api"
Restart=on-failure
RestartSec=2
# It shells out to a CLI that writes ~/.claude-accounts, so it cannot be sandboxed away
# from $HOME. What it can be denied is everything it never needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=256M

[Install]
WantedBy=default.target
